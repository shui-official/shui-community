+/** A deploy that leaves the service "activating"/"failed" is a crash loop, not a success. */
+export function withDeployWarning(name: string, output: string): string {
+  const state = /^state: (\S+)/m.exec(output)?.[1];
+  if (!state || state === "active") return output;
+  return `${output}\nWARNING: the service is "${state}", not running: it crashes at start. ` +
+    `Read service_logs ${name}, fix the error, then call service_deploy again. Common cause: writing files in its own ` +
+    `folder, which is read-only; write logs to stdout and data to $STATE_DIRECTORY.`;
+}
