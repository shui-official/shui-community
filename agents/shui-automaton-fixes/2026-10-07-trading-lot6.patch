+export function evaluateRangeSetup(symbol: string, mint: string, h4: Candle[], h1: Candle[], liquidityUsd: number): SetupResult {
+  const no = (reason: string): SetupResult => ({ symbol, mint, ok: false, reason: `range: ${reason}`, side: "range" });
+  if (liquidityUsd < MIN_LIQUIDITY_USD) return no(`liquidity $${Math.round(liquidityUsd)} < $50k`);
+  if (h4.length < 50 || h1.length < 50) return no("not enough candles");
+  const c4 = h4.map((c) => c.c);
+  const c1 = h1.map((c) => c.c);
+  const price = c1.at(-1)!;
+  const ema20 = emaSeries(c4, 20).at(-1)!;
+  const ema50 = emaSeries(c4, 50).at(-1)!;
+  const strength = adx(h4);
+  const trendless = (strength ? strength.adx < 20 : false) || Math.abs(ema20 - ema50) / price < 0.01;
+  if (!trendless) return no(`4h is trending (ADX ${strength?.adx.toFixed(0) ?? "?"}), not a range`);
+  const { highs, lows } = swings(h4, 3);
+  const support = lows.filter((l) => l < price).sort((x, y) => y - x)[0];
+  const top = highs.filter((h) => h > price * 1.01).sort((x, y) => y - x)[0];
+  if (support === undefined || top === undefined) return no("no clear range (support and top)");
+  const a = atr(h1);
+  if (!a) return no("no volatility data");
+  if (price - support > 1.5 * a) return no(`price not near the range bottom (support ${fmt(support)})`);
+  const r = rsi(c1);
+  const prev = rsi(c1.slice(0, -1));
+  if (r === null || prev === null || !(r < 42)) return no(`1h RSI ${r?.toFixed(0) ?? "?"} not low enough (< 42)`);
+  if (!(r > prev)) return no(`1h RSI ${r.toFixed(0)} still falling: wait for it to turn up`);
+  const stop = support - a;
+  const target = top - 0.25 * a;
+  const rr = (target - price) / (price - stop);
+  const plan = {
+    entry: price, stop, target, rr,
+    stopPct: ((price - stop) / price) * 100,
+    targetPct: ((target - price) / price) * 100,
+  };
+  if (!(rr >= RANGE_MIN_RR)) return { ...no(`reward/risk ${rr.toFixed(2)} < ${RANGE_MIN_RR}`), plan };
+  return { symbol, mint, ok: true, side: "range", reason: `4h range (support ${fmt(support)}, top ${fmt(top)}), 1h RSI ${r.toFixed(0)} turning up, reward/risk ${rr.toFixed(2)}`, plan };
