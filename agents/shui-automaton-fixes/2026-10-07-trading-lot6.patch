+import { describe, expect, it, vi } from "vitest";
+import { createDatabase } from "../state/database.js";
+import { isCreatorToken, findCreatorToken, creatorTokens } from "../solana/token-policy.js";
+import { listOrders, runOrderTick, saveOrder, type Order, recordPaperTrade } from "../solana/orders.js";
+import { evaluateRangeSetup, rangePaperRecord, setupScan, trendingCandidates } from "../solana/trading-desk.js";
+import { ensureLedgerSchema, listLedgerEntries, recordIncoming, reclassifyRevenueAsFunding } from "../solana/ledger.js";
+import { formatPositions } from "../solana/portfolio.js";
+import { isInsideInstallDir, INSTALL_DIR } from "../agent/tools.js";
+import type { Candle } from "../solana/technical-analysis.js";
+
+const SHUI = "CnrMgNn1N3uY6GqD6FeZRdd1uhPViEFxSioWhRZsCz4C";
+const USDC = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot6-")), "s.db"));
+const order = (over: Partial<Order>): Order => ({
+  id: "o", kind: "stop_loss", inputMint: SHUI, outputMint: USDC, amount: "all", watchMint: SHUI, condition: "below", triggerPriceUsd: 0.00005,
+  slippageBps: 100, venue: "jupiter", note: "", createdAt: "", expiresAt: null, status: "open", attempts: 0, updatedAt: new Date().toISOString(), ...over,
+});
+
+describe("creator token", () => {
+  it("is recognised (default + env) and its orders are cancelled by code", async () => {
+    expect(isCreatorToken(SHUI)).toBe(true);
+    expect(creatorTokens({ SHUI_CREATOR_TOKENS: "Abc, Def" }).has("Def")).toBe(true);
+    expect(findCreatorToken(USDC, SHUI)).toBe(SHUI);
+    const db = freshDb();
+    saveOrder(db.raw, order({ id: "oco_stop", group: "oco" }));
+    const swap = vi.fn();
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [SHUI]: 0.00001 }), swap, now: () => new Date() });
+    expect(swap).not.toHaveBeenCalled();
+    expect(listOrders(db.raw)[0]).toMatchObject({ status: "cancelled" });
+  });
+
+  it("is shown as the creator's token in positions, not as a trade", () => {
+    const text = formatPositions([{ mint: SHUI, amount: 10000, priceUsd: 0.0001, valueUsd: 1, costUsd: 0, avgEntryUsd: null, unrealizedPnlUsd: null, orders: [] } as any], 34);
+    expect(text).toMatch(/creator's own token/);
+    expect(text).not.toMatch(/NO STOP-LOSS/);
+  });
+
+  it("is refused by the trading tools", async () => {
+    const { createBuiltinTools } = await import("../agent/tools.js");
+    const tools = createBuiltinTools("");
+    const db = freshDb();
+    const ctx = { db, identity: {} } as any;
+    for (const [name, args] of [
+      ["protect_position", { mint: SHUI, takeProfitPriceUsd: 1, stopPriceUsd: 0.00001 }],
+      ["price_alert", { mint: SHUI, condition: "above", priceUsd: 1 }],
+      ["paper_trade", { mint: SHUI, sizeUsd: 10, takeProfitPriceUsd: 1, stopPriceUsd: 0.00001 }],
+      ["technical_analysis", { mint: SHUI }],
+    ] as const) {
+      expect(await tools.find((t) => t.name === name)!.execute(args as any, ctx)).toMatch(/creator's own token/);
+    }
+  });
+});
+
+describe("funding, not revenue", () => {
+  it("records incoming transfers as funding in trading focus and reclassifies old ones", () => {
+    const db = freshDb();
+    ensureLedgerSchema(db.raw);
+    const delta = (sig: string) => ({ signature: sig, blockTime: 1_791_000_000, failed: false, signedByWallet: false, feePayer: "Exchange111", solLamportsDelta: 529_000n, tokenDeltas: [] }) as any;
+    recordIncoming(db.raw, delta("old"), { creatorAddress: "Creator", solPriceUsd: 117 });
+    expect(listLedgerEntries(db.raw)[0]).toMatchObject({ kind: "revenue" });
+    const prev = process.env.SHUI_FOCUS;
+    process.env.SHUI_FOCUS = "trading";
+    try {
+      expect(reclassifyRevenueAsFunding(db.raw)).toBe(1);
+      recordIncoming(db.raw, delta("new"), { creatorAddress: "Creator", solPriceUsd: 117 });
+      for (const e of listLedgerEntries(db.raw)) expect(e).toMatchObject({ kind: "funding", revenueUsd: 0 });
+    } finally {
+      if (prev === undefined) delete process.env.SHUI_FOCUS; else process.env.SHUI_FOCUS = prev;
+    }
+  });
+});
+
+describe("source folder", () => {
+  it("detects paths inside the installation", () => {
+    expect(isInsideInstallDir(path.join(INSTALL_DIR, "README.md"))).toBe(true);
+    expect(isInsideInstallDir("/home/automaton/.automaton/workspace/notes.md", "/home/automaton/workspace/automaton-main")).toBe(false);
+    expect(isInsideInstallDir("/home/automaton/workspace/automaton-main/x.py", "/home/automaton/workspace/automaton-main")).toBe(true);
+  });
+});
+
+const candles = (closes: number[], wick = 0.01): Candle[] => closes.map((c, i) => ({ t: i, o: c, h: c * (1 + wick), l: c * (1 - wick), c, v: 100 }));
+
+describe("range setups and trending tokens", () => {
+  it("only proposes range rebounds in a trendless chart, near support, RSI turning up", () => {
+    // 4h: sideways 95-105 range
+    const h4 = candles(Array.from({ length: 120 }, (_, i) => 100 + 5 * Math.sin(i / 4)));
+    // 1h: slide to the bottom then a small turn up
+    const h1closes = Array.from({ length: 120 }, (_, i) => (i < 110 ? 100 - (i / 110) * 6 : 94 + (i - 110) * 0.08));
+    const r = evaluateRangeSetup("RNG", "M", h4, candles(h1closes), 1_000_000);
+    expect(r.side).toBe("range");
+    if (r.plan) {
+      expect(r.plan.stop).toBeLessThan(r.plan.entry);
+      expect(r.plan.target).toBeGreaterThan(r.plan.entry);
+      expect(r.ok).toBe(r.plan.rr >= 1.5);
+    } else {
+      expect(r.reason).toMatch(/^range:/);
+    }
+    const trending = candles(Array.from({ length: 120 }, (_, i) => 100 + i));
+    expect(evaluateRangeSetup("UP", "M", trending, trending, 1_000_000).reason).toMatch(/trending/);
+  });
+
+  it("counts range paper trades before allowing live range trades", () => {
+    const db = freshDb();
+    expect(rangePaperRecord(db.raw)).toMatchObject({ trades: 0, live: false });
+    for (let i = 0; i < 20; i++) {
+      recordPaperTrade(db.raw, { id: `p${i}`, at: `2026-10-07T00:00:${String(i).padStart(2, "0")}Z`, mint: "M", units: 1, entryUsd: 1, exitUsd: 1.1, pnlUsd: 0.1, exitKind: "take_profit", source: "[range] test" });
+    }
+    expect(rangePaperRecord(db.raw)).toMatchObject({ trades: 20, live: true });
+  });
+
+  it("adds liquid, older trending tokens and never the creator token", async () => {
+    const day = 24 * 3_600_000;
+    const now = Date.parse("2026-10-07T12:00:00Z");
+    const pool = (mint: string, liq: number, ageDays: number, vol: number) => ({
+      relationships: { base_token: { data: { id: `solana_${mint}` } } },
+      attributes: { name: `${mint.slice(0, 4)} / SOL`, reserve_in_usd: String(liq), volume_usd: { h24: String(vol) }, pool_created_at: new Date(now - ageDays * day).toISOString() },
+    });
+    const fetcher = async () => ({ data: [
+      pool("GoodMint1111", 900_000, 30, 5e6), pool("ThinMint1111", 50_000, 30, 9e6), pool("YoungMint111", 900_000, 2, 9e6),
+      pool(SHUI, 900_000, 30, 9e6), pool("JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN", 900_000, 300, 9e6),
+    ] });
+    expect(await trendingCandidates(fetcher, now)).toEqual([{ symbol: "Good", mint: "GoodMint1111" }]);
+    expect(await setupScan({ mints: [SHUI] }, async () => [], 0, false, { trending: false })).not.toMatch(/CnrMgN/);
+  });
+});
