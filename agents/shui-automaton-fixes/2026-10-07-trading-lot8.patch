+  /**
+   * Point every provider configured on a loopback URL (old Ollama tunnel) to
+   * OLLAMA_BASE_URL, with OLLAMA_API_KEY as its key. Returns the provider ids changed.
+   */
+  alignLoopbackProviders(baseUrl: string, apiKey: string | undefined): string[] {
+    const changed: string[] = [];
+    for (const provider of this.providers) {
+      if (!/^https?:\/\/(127\.0\.0\.1|localhost)(:\d+)?/i.test(provider.baseUrl)) continue;
+      provider.baseUrl = `${baseUrl.replace(/\/$/, "")}/v1`;
+      if (apiKey && !process.env[provider.apiKeyEnvVar]) process.env[provider.apiKeyEnvVar] = apiKey;
+      changed.push(provider.id);
+    }
+    return changed;
+  }
