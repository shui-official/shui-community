+      `DELETE FROM kv WHERE key LIKE 'lifespan.week_capital.%'
+       AND substr(key, 23) NOT IN (SELECT week_start FROM shui_lifespan_weeks)`,
+    ).run();
+  } catch {
+    db.prepare("DELETE FROM kv WHERE key LIKE 'lifespan.week_capital.%'").run();
+  }
+  setKv(db, "migration.lot8_valuation", new Date().toISOString());
+  return true;
+}
