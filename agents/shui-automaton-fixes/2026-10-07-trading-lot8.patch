@@ -0,0 +1,70 @@
+/**
+ * Lot 8 — hard limits on BUYS, enforced by code (audit #3). Sales and stops
+ * are never limited: protecting capital is always allowed.
+ *   - minimum trade $5 (smaller trades are eaten by fees);
+ *   - at most 20% of capital per buy and 35% of capital in one token;
+ *   - memecoins (pump.fun mints): 5% per token, 15% in total;
+ *   - buy slippage at most 100 bps;
+ *   - price impact at most 1% (0.5% above $1,000).
+ * Values can be tuned with SHUI_MIN_TRADE_USD / SHUI_MAX_TRADE_PCT.
+ */
+export function tradeLimits(env: NodeJS.ProcessEnv = process.env) {
+  const num = (v: string | undefined, d: number) => {
+    const n = Number(v);
+    return Number.isFinite(n) && n > 0 ? n : d;
+  };
+  return {
+    minTradeUsd: num(env.SHUI_MIN_TRADE_USD, 5),
+    maxTradePct: num(env.SHUI_MAX_TRADE_PCT, 20),
+    maxTokenPct: 35,
+    memePerTokenPct: 5,
+    memeTotalPct: 15,
+    maxBuySlippageBps: 100,
+    maxImpactPct: 1,
+    bigTradeUsd: 1000,
+    bigTradeImpactPct: 0.5,
+  };
+}
+
+/** pump.fun tokens have mint addresses ending in "pump". */
+export function isMemecoin(mint: string): boolean {
+  return /pump$/.test(mint);
+}
+
+export interface BuyCheck {
+  outputMint: string;
+  buyUsd: number;
+  capitalUsd: number;
+  /** Value already held in the output token. */
+  holdingUsd: number;
+  /** Value held in all memecoins (excluding the creator's token). */
+  memeTotalUsd: number;
+  slippageBps: number;
+}
+
+/** Returns a blocking reason, or null when the buy is within the limits. */
+export function checkBuyLimits(c: BuyCheck, env: NodeJS.ProcessEnv = process.env): string | null {
+  const L = tradeLimits(env);
+  const pct = (x: number) => (c.capitalUsd > 0 ? (x / c.capitalUsd) * 100 : Infinity);
+  if (c.slippageBps > L.maxBuySlippageBps) return `slippage ${c.slippageBps} bps > ${L.maxBuySlippageBps} bps allowed on buys`;
+  if (c.buyUsd < L.minTradeUsd) return `buy of $${c.buyUsd.toFixed(2)} is below the $${L.minTradeUsd} minimum (fees would eat the gain). Use amountUsd.`;
+  if (pct(c.buyUsd) > L.maxTradePct + 1e-9) {
+    return `buy of $${c.buyUsd.toFixed(2)} is ${pct(c.buyUsd).toFixed(1)}% of capital ($${c.capitalUsd.toFixed(2)}); max ${L.maxTradePct}% per buy ($${((c.capitalUsd * L.maxTradePct) / 100).toFixed(2)})`;
+  }
+  const meme = isMemecoin(c.outputMint);
+  const tokenCap = meme ? L.memePerTokenPct : L.maxTokenPct;
+  if (pct(c.holdingUsd + c.buyUsd) > tokenCap + 1e-9) {
+    return `${meme ? "memecoin " : ""}exposure would be ${pct(c.holdingUsd + c.buyUsd).toFixed(1)}% of capital in this token; max ${tokenCap}%`;
+  }
+  if (meme && pct(c.memeTotalUsd + c.buyUsd) > L.memeTotalPct + 1e-9) {
+    return `memecoins would be ${pct(c.memeTotalUsd + c.buyUsd).toFixed(1)}% of capital; max ${L.memeTotalPct}% in total`;
+  }
+  return null;
+}
+
+export function checkPriceImpact(buyUsd: number, impactPct: number | null | undefined, env: NodeJS.ProcessEnv = process.env): string | null {
+  if (impactPct === null || impactPct === undefined || !Number.isFinite(impactPct)) return null;
+  const L = tradeLimits(env);
+  const max = buyUsd > L.bigTradeUsd ? L.bigTradeImpactPct : L.maxImpactPct;
+  return impactPct > max ? `price impact ${impactPct.toFixed(2)}% > ${max}% (pool too thin for this size: buy less)` : null;
+}
