+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { createDatabase } from "../state/database.js";
+import { checkBuyLimits, checkPriceImpact, isMemecoin, tradeLimits } from "../solana/trade-limits.js";
+import { readableAmount } from "../solana/wallet-tools.js";
+import { initUntrackedSolBasisOnce, scanWalletHistory, type WalletHistorySource } from "../solana/ledger.js";
+import { resetValuationBaselinesOnce } from "../survival/risk-guard.js";
+import { getForbiddenCommandMatch } from "../agent/policy-rules/command-safety.js";
+import { TRADING_FOCUS_HIDDEN_TOOLS, tradingFocusPrompt } from "../solana/trading-desk.js";
+import { ProviderRegistry } from "../inference/provider-registry.js";
+import { alignLocalProvidersWithEndpoint } from "../agent/loop.js";
+import { checkGpuCap, computeCostOfDay, gpuDailyCapUsd, recordRunpodReading } from "../integration/runpod.js";
+import { hasPendingCreatorMessage, listOutgoingCreatorMessages, CREATOR_CHAT_SENDER } from "../integration/creator-chat.js";
+import { runJanitor, type JanitorPaths } from "../maintenance/janitor.js";
+
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot8-")), "s.db"));
+const SOL = "So11111111111111111111111111111111111111112";
+const USDC = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+const MEME = "7GCihgDB8fe6KNjn2MYtkzZcRjQy3t9GHdC8uHYmW2hrpump";
+const ORCA = "orcaEKTdK7LKz57vaAYr9QeNsVEPfiu6QeMU1kektZE";
+const setKv = (db: any, k: string, v: string) =>
+  db.raw.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(k, v);
+const getKv = (db: any, k: string) => (db.raw.prepare("SELECT value FROM kv WHERE key = ?").get(k) as any)?.value;
+
+describe("buy limits", () => {
+  const ok = { outputMint: ORCA, buyUsd: 10, capitalUsd: 100, holdingUsd: 0, memeTotalUsd: 0, slippageBps: 50 };
+  it("accepts a sane buy and blocks dust, oversize and wide slippage", () => {
+    expect(checkBuyLimits(ok)).toBeNull();
+    expect(checkBuyLimits({ ...ok, buyUsd: 0.11 })).toMatch(/below the \$5 minimum/);
+    expect(checkBuyLimits({ ...ok, buyUsd: 25 })).toMatch(/max 20% per buy/);
+    expect(checkBuyLimits({ ...ok, holdingUsd: 30 })).toMatch(/max 35%/);
+    expect(checkBuyLimits({ ...ok, slippageBps: 300 })).toMatch(/slippage/);
+  });
+  it("keeps pump.fun memecoins in a small risk pocket", () => {
+    expect(isMemecoin(MEME)).toBe(true);
+    expect(isMemecoin(ORCA)).toBe(false);
+    const cap = 200;
+    expect(checkBuyLimits({ ...ok, outputMint: MEME, buyUsd: 10, capitalUsd: cap })).toBeNull();
+    expect(checkBuyLimits({ ...ok, outputMint: MEME, buyUsd: 12, capitalUsd: cap })).toMatch(/memecoin exposure.*max 5%/);
+    expect(checkBuyLimits({ ...ok, outputMint: MEME, buyUsd: 10, capitalUsd: cap, memeTotalUsd: 25 })).toMatch(/max 15% in total/);
+  });
+  it("limits price impact, tighter for big trades, and reads env overrides", () => {
+    expect(checkPriceImpact(100, 0.8)).toBeNull();
+    expect(checkPriceImpact(100, 1.5)).toMatch(/price impact/);
+    expect(checkPriceImpact(2000, 0.8)).toMatch(/> 0.5%/);
+    expect(checkPriceImpact(100, null)).toBeNull();
+    expect(tradeLimits({ SHUI_MIN_TRADE_USD: "2", SHUI_MAX_TRADE_PCT: "10" })).toMatchObject({ minTradeUsd: 2, maxTradePct: 10 });
+    expect(tradeLimits({ SHUI_MIN_TRADE_USD: "abc" }).minTradeUsd).toBe(5);
+  });
+});
+
+describe("readable amounts", () => {
+  it("shows SOL and USDC in units and labels other tokens raw", () => {
+    expect(readableAmount("529000", SOL)).toBe("0.000529 SOL");
+    expect(readableAmount("21980000", USDC)).toBe("21.98 USDC");
+    expect(readableAmount("39288", ORCA)).toMatch(/raw units of .*divide by 10\^decimals/);
+    expect(readableAmount(null, ORCA)).toMatch(/^\?/);
+  });
+});
+
+describe("ledger migrations", () => {
+  it("gives untracked SOL a reference cost once", () => {
+    const db = freshDb();
+    expect(initUntrackedSolBasisOnce(db.raw, 2_000_000_000n, 150)).toBe(true);
+    const row = db.raw.prepare("SELECT amount_raw, cost_usd FROM shui_cost_basis WHERE mint = ?").get(SOL) as any;
+    expect(row.amount_raw).toBe("2000000000");
+    expect(row.cost_usd).toBeCloseTo(300);
+    expect(initUntrackedSolBasisOnce(db.raw, 5_000_000_000n, 200)).toBe(false);
+  });
+
+  it("backfills a token account since a date on its first scan, then follows the cursor", async () => {
+    const db = freshDb();
+    const delta = (signature: string, blockTime: number) => ({
+      signature, blockTime, failed: false, signedByWallet: false, feePayer: "Creator11111111111111111111111111111111111",
+      solLamportsDelta: 0n, feeLamports: 5000n, tokenDeltas: [{ mint: USDC, deltaRaw: 21_980_000n, decimals: 6 }],
+    });
+    let sigs = [
+      { signature: "new", failed: false, blockTime: 2_000 },
+      { signature: "old", failed: false, blockTime: 500 },
+    ];
+    const source: WalletHistorySource = {
+      getSignaturesSince: async () => sigs,
+      getWalletDelta: async (s) => delta(s, s === "old" ? 500 : 2_000),
+      getLatestSignature: async () => "new",
+    };
+    const params = { creatorAddress: "Creator11111111111111111111111111111111111", solPriceUsd: 150, cursorKey: "ledger.scan_cursor.usdc_account", backfillSince: 1_000 };
+    const first = await scanWalletHistory(db.raw, source, params);
+    expect(first.created.map((e) => e.signature)).toEqual(["new"]);
+    expect(getKv(db, "ledger.scan_cursor.usdc_account")).toBe("new");
+    sigs = [];
+    expect((await scanWalletHistory(db.raw, source, params)).created).toHaveLength(0);
+  });
+
+  it("resets the drawdown peak and unjudged week capitals once", () => {
+    const db = freshDb();
+    setKv(db, "risk.peak_value_usd", "500");
+    setKv(db, "lifespan.week_capital.2026-10-05", "480");
+    expect(resetValuationBaselinesOnce(db.raw)).toBe(true);
+    expect(getKv(db, "risk.peak_value_usd")).toBeUndefined();
+    expect(getKv(db, "lifespan.week_capital.2026-10-05")).toBeUndefined();
+    setKv(db, "risk.peak_value_usd", "120");
+    expect(resetValuationBaselinesOnce(db.raw)).toBe(false);
+    expect(getKv(db, "risk.peak_value_usd")).toBe("120");
+  });
+});
+
+describe("secrets stay out of reach", () => {
+  it("blocks reading the wallet, the env file and process environments", () => {
+    for (const cmd of [
+      "cat ~/.automaton/wallet.json", "cat /etc/shui-agent/chat.env", "printenv", "cat /proc/1/environ",
+      "cp ~/.automaton/automaton.json /tmp/x",
+    ]) {
+      expect(getForbiddenCommandMatch(cmd), cmd).not.toBeNull();
+    }
+    expect(getForbiddenCommandMatch("ls ~/.automaton/workspace")).toBeNull();
+  });
+});
+
+describe("trading focus", () => {
+  it("hides code and shell tools and states the rules", () => {
+    for (const t of ["exec", "edit_own_file", "git_clone", "install_npm_package", "system_synopsis"]) {
+      expect(TRADING_FOCUS_HIDDEN_TOOLS.has(t), t).toBe(true);
+    }
+    const prompt = tradingFocusPrompt({});
+    expect(prompt).toMatch(/amountUsd/);
+    expect(prompt).toMatch(/RANGE/);
+  });
+});
+
+describe("serverless endpoint", () => {
+  it("points loopback providers at the https endpoint, never at http", () => {
+    const make = () => new ProviderRegistry([
+      { id: "local", name: "local", baseUrl: "http://127.0.0.1:11435/v1", apiKeyEnvVar: "LOT8_TEST_KEY", models: [], maxRequestsPerMinute: 60, maxTokensPerMinute: 1e6, priority: 1, enabled: true } as any,
+      { id: "cloud", name: "cloud", baseUrl: "https://api.example.com/v1", apiKeyEnvVar: "X", models: [], maxRequestsPerMinute: 60, maxTokensPerMinute: 1e6, priority: 2, enabled: true } as any,
+    ]);
+    const reg = make();
+    expect(alignLocalProvidersWithEndpoint(reg, { OLLAMA_BASE_URL: "http://10.0.0.1:11434" })).toEqual([]);
+    delete process.env.LOT8_TEST_KEY;
+    expect(alignLocalProvidersWithEndpoint(reg, { OLLAMA_BASE_URL: "https://api.runpod.ai/v2/abc/openai/", OLLAMA_API_KEY: "k" })).toEqual(["local"]);
+    expect((reg as any).providers.find((p: any) => p.id === "local").baseUrl).toBe("https://api.runpod.ai/v2/abc/openai/v1");
+    expect((reg as any).providers.find((p: any) => p.id === "cloud").baseUrl).toBe("https://api.example.com/v1");
+    expect(process.env.LOT8_TEST_KEY).toBe("k");
+    delete process.env.LOT8_TEST_KEY;
+  });
+});
+
+describe("GPU daily budget", () => {
+  it("counts the balance drop as cost, ignoring top-ups", () => {
+    const db = freshDb();
+    recordRunpodReading(db.raw, { balanceUsd: 50, spendPerHr: 0, hoursLeft: null, at: "2026-10-07T10:00:00.000Z" });
+    recordRunpodReading(db.raw, { balanceUsd: 48.8, spendPerHr: 0, hoursLeft: null, at: "2026-10-07T10:15:00.000Z" });
+    expect(computeCostOfDay(db.raw, "2026-10-07")).toBeCloseTo(1.2);
+    recordRunpodReading(db.raw, { balanceUsd: 248.8, spendPerHr: 0, hoursLeft: null, at: "2026-10-07T10:30:00.000Z" });
+    expect(computeCostOfDay(db.raw, "2026-10-07")).toBeCloseTo(1.2);
+  });
+
+  it("puts SHUI to sleep until 00:00 UTC once the cap is reached, telling the creator once", () => {
+    const db = freshDb();
+    expect(gpuDailyCapUsd({})).toBe(8);
+    expect(gpuDailyCapUsd({ SHUI_GPU_DAILY_CAP_USD: "5" })).toBe(5);
+    const now = new Date("2026-10-07T18:00:00Z");
+    expect(checkGpuCap(db.raw, now, {}).capped).toBe(false); // Runpod not connected
+    recordRunpodReading(db.raw, { balanceUsd: 50, spendPerHr: 1.2, hoursLeft: 40, at: "2026-10-07T17:00:00.000Z" });
+    recordRunpodReading(db.raw, { balanceUsd: 41, spendPerHr: 1.2, hoursLeft: 34, at: "2026-10-07T17:45:00.000Z" });
+    const cap = checkGpuCap(db.raw, now, {});
+    expect(cap).toMatchObject({ capped: true, capUsd: 8, resumeAt: "2026-10-08T00:00:00.000Z" });
+    checkGpuCap(db.raw, now, {});
+    expect(listOutgoingCreatorMessages(db.raw).filter((m) => /GPU budget reached/.test(m.content))).toHaveLength(1);
+    expect(checkGpuCap(db.raw, now, { SHUI_GPU_DAILY_CAP_USD: "0" }).capped).toBe(false);
+    expect(checkGpuCap(db.raw, new Date("2026-10-08T01:00:00Z"), {}).capped).toBe(false);
+  });
+
+  it("sees a waiting creator message", () => {
+    const db = freshDb();
+    expect(hasPendingCreatorMessage(db.raw)).toBe(false);
+    db.raw.prepare("INSERT INTO inbox_messages (id, from_address, to_address, content, received_at, status) VALUES ('m1', ?, 'shui', 'hi', ?, 'received')")
+      .run(CREATOR_CHAT_SENDER, new Date().toISOString());
+    expect(hasPendingCreatorMessage(db.raw)).toBe(true);
+  });
+});
+
+describe("janitor (lot 8)", () => {
+  it("expires messages stuck in progress for 2 h and backs up state.db once a day", async () => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), "lot8-jan-"));
+    const paths: JanitorPaths = {
+      home: root, workspaceRoot: path.join(root, "w"), servicesRoot: path.join(root, "s"),
+      archiveRoot: path.join(root, "a"), repoRoot: path.join(root, "r"),
+    };
+    for (const p of [paths.workspaceRoot, paths.servicesRoot, paths.archiveRoot, paths.repoRoot]) fs.mkdirSync(p, { recursive: true });
+    const db = createDatabase(path.join(root, "state.db"));
+    const ins = db.raw.prepare("INSERT INTO inbox_messages (id, from_address, to_address, content, received_at, status) VALUES (?, 'x', 'shui', 'c', ?, 'in_progress')");
+    ins.run("old", new Date(Date.now() - 3 * 3_600_000).toISOString());
+    ins.run("recent", new Date(Date.now() - 10 * 60_000).toISOString());
+    db.raw.prepare("INSERT INTO inbox_messages (id, from_address, to_address, content, received_at, status) VALUES ('sqlfmt', 'x', 'shui', 'c', datetime('now'), 'in_progress')").run();
+    const deps = { db: db.raw, paths, helper: async () => ({ ok: true, output: "" }), untracked: async () => [] };
+    const report = await runJanitor(deps);
+    expect(report.expiredMessages).toBe(1);
+    const status = Object.fromEntries((db.raw.prepare("SELECT id, status FROM inbox_messages WHERE from_address = 'x'").all() as any[]).map((m) => [m.id, m.status]));
+    expect(status).toEqual({ old: "failed", recent: "in_progress", sqlfmt: "in_progress" });
+    expect(report.backup).toMatch(/state-daily\/state-\d{4}-\d{2}-\d{2}\.db$/);
+    expect(fs.existsSync(report.backup!)).toBe(true);
+    expect((await runJanitor(deps)).backup ?? null).toBeNull();
+  });
+});
