+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { createDatabase } from "../state/database.js";
+import { clampBuyUsd, decisionLine, heldCostUsd } from "../solana/decisions.js";
+import { ensureLedgerSchema } from "../solana/ledger.js";
+
+const ORCA = "orcaEKTdK7LKz57vaAYr9QeNsVEPfiu6QeMU1kektZE";
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot9c-")), "s.db")).raw;
+
+describe("DECIDE size counts what is already held", () => {
+  it("leaves only the room under the 35% per-token cap", () => {
+    // 13:24 on 09/10: capital ~$67, ORCA held ~$15 (22%); the scan proposed $13.03 → 37.7%.
+    expect(clampBuyUsd(13.03, 67, {}, ORCA, 0)).toBe(13.03);
+    expect(clampBuyUsd(13.03, 67, {}, ORCA, 15)).toBe(8.44); // 35% of 67 = 23.45 - 15, rounded down to stay under the cap
+    expect(clampBuyUsd(13.03, 67, {}, ORCA, 20)).toBeNull(); // room $3.45 < $5
+  });
+
+  it("reads the held cost and says so in the DECIDE line", () => {
+    const db = freshDb();
+    ensureLedgerSchema(db);
+    expect(heldCostUsd(db, ORCA)).toBe(0);
+    db.prepare("INSERT INTO shui_cost_basis (mint, amount_raw, cost_usd) VALUES (?, '5051012', 12.18)").run(ORCA);
+    expect(heldCostUsd(db, ORCA)).toBe(12.18);
+    const line = decisionLine({ symbol: "ORCA", mint: ORCA, entry: 2.43, stop: 2.3, target: 3.08, rr: 5, amountUsd: 8.45, action: "buy", heldPct: 18.2 });
+    expect(line).toMatch(/^ORCA \(already held: 18\.2% of capital; this adds to it\): BUY → jupiter_swap .*amountUsd=8\.45/);
+  });
+});
