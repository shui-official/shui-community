+ * cost of the last full days when known.
+ */
+export function averageSpendPerHr(db: Database, acc: RunpodAccount, now: Date = new Date()): number {
+  const costs: number[] = [];
+  for (let d = 1; d <= 3; d++) {
+    const day = new Date(now.getTime() - d * 86_400_000).toISOString().slice(0, 10);
+    if (getKv(db, `${COST_PREFIX}${day}`) !== null) costs.push(computeCostOfDay(db, day));
+  }
+  return costs.length ? costs.reduce((a, b) => a + b, 0) / costs.length / 24 : acc.spendPerHr;
+}
+
+export function estimatedHoursLeft(db: Database, acc: RunpodAccount, now: Date = new Date()): number | null {
+  const perHr = averageSpendPerHr(db, acc, now);
+  return perHr > 0 ? acc.balanceUsd / perHr : null;
+}
