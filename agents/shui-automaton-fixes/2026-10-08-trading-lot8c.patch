+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { createDatabase } from "../state/database.js";
+import { clampBuyUsd, decisionLine, recordPendingSetups, sleepGuard, undecidedSetups } from "../solana/decisions.js";
+import { ensureLedgerSchema } from "../solana/ledger.js";
+import { saveOrder } from "../solana/orders.js";
+import { averageSpendPerHr, checkLowBalance, estimatedHoursLeft, recordRunpodReading } from "../integration/runpod.js";
+
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot8c-")), "s.db")).raw;
+const CATE = "Ai66LHZG9MCzg1WKdawwqduVAXpNDUuV8M3uyq5ppump";
+const ORCA = "orcaEKTdK7LKz57vaAYr9QeNsVEPfiu6QeMU1kektZE";
+const t0 = new Date("2026-10-08T04:30:00Z");
+const later = (min: number) => new Date(t0.getTime() + min * 60_000);
+const setKv = (db: any, k: string, v: string) =>
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(k, v);
+
+describe("memecoin size", () => {
+  it("uses the 5% memecoin cap, so a small capital cannot buy memecoins", () => {
+    expect(clampBuyUsd(20, 57.76, {}, CATE)).toBeNull(); // 5% = $2.89 < $5
+    expect(clampBuyUsd(20, 200, {}, CATE)).toBe(10);
+    expect(clampBuyUsd(20, 57.76, {}, ORCA)).toBe(11.55);
+  });
+});
+
+describe("range setups are paper decisions", () => {
+  const range = { symbol: "CATE", mint: CATE, entry: 0.05613, stop: 0.05382, target: 0.0729, rr: 7, amountUsd: 10, action: "paper" as const };
+  it("asks for a paper trade or a skip, and counts an open paper position as the decision", () => {
+    const db = freshDb();
+    expect(decisionLine(range)).toMatch(/PAPER → paper_trade setup="range" mint=Ai66.* sizeUsd=10 stopPriceUsd=0\.05382 takeProfitPriceUsd=0\.07290/);
+    recordPendingSetups(db, [range], t0);
+    expect("blocked" in sleepGuard(db, 7200, true, later(2))).toBe(true);
+    saveOrder(db, {
+      id: "paper_x_stop", group: "paper_x", kind: "stop_loss", condition: "below", triggerPriceUsd: 0.05382, inputMint: CATE,
+      outputMint: "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v", amount: "0", watchMint: CATE, slippageBps: 0, venue: "jupiter",
+      note: "[range] paper", createdAt: later(3).toISOString(), expiresAt: null, status: "open", attempts: 0,
+      updatedAt: later(3).toISOString(), paper: true, paperUnits: 178, paperEntryUsd: 0.05613,
+    } as any);
+    expect(undecidedSetups(db, later(4))).toBeNull();
+  });
+});
+
+describe("dust positions", () => {
+  it("does not shorten sleep for a $0.11 position", () => {
+    const db = freshDb();
+    ensureLedgerSchema(db);
+    db.prepare("INSERT INTO shui_cost_basis (mint, amount_raw, cost_usd) VALUES (?, '39288', 0.1086)").run(ORCA);
+    expect(sleepGuard(db, 14400, true, t0)).toMatchObject({ durationS: 7200 });
+  });
+});
+
+describe("GPU time left", () => {
+  it("uses the average cost of the last days, not the instant rate", () => {
+    const db = freshDb();
+    const now = new Date("2026-10-08T02:02:00Z");
+    const acc = { balanceUsd: 58.53, spendPerHr: 1.22, hoursLeft: 48, at: now.toISOString() };
+    expect(averageSpendPerHr(db, acc, now)).toBe(1.22);
+    setKv(db, "compute.cost.2026-10-07", "6.72");
+    expect(averageSpendPerHr(db, acc, now)).toBeCloseTo(0.28);
+    expect(estimatedHoursLeft(db, acc, now)! / 24).toBeCloseTo(8.7, 1);
+  });
+
+  it("does not raise a false alarm, and a real one does not wake SHUI", () => {
+    const db = freshDb();
+    const now = new Date("2026-10-08T02:02:00Z");
+    setKv(db, "compute.cost.2026-10-07", "6.72");
+    recordRunpodReading(db, { balanceUsd: 58.53, spendPerHr: 1.22, hoursLeft: 48, at: now.toISOString() });
+    expect(checkLowBalance(db, now)).toBe(false);
+    recordRunpodReading(db, { balanceUsd: 15, spendPerHr: 1.22, hoursLeft: 12, at: now.toISOString() });
+    expect(checkLowBalance(db, now)).toBe(true);
+    expect((db.prepare("SELECT COUNT(*) c FROM wake_events").get() as any).c).toBe(0);
+    expect((db.prepare("SELECT COUNT(*) c FROM inbox_messages WHERE from_address = 'system:compute'").get() as any).c).toBe(1);
+  });
+});
