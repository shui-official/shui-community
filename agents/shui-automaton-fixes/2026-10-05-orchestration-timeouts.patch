+import type BetterSqlite3 from "better-sqlite3";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ulid } from "ulid";
+import { Orchestrator } from "../../orchestration/orchestrator.js";
+import { validatePlannerOutput } from "../../orchestration/planner.js";
+import { buildWisdomFromGoal } from "../../agent/harness-types.js";
+import { AgentWorkspace } from "../../orchestration/workspace.js";
+import { ColonyMessaging, type MessageTransport } from "../../orchestration/messaging.js";
+import type { AgentTracker, FundingProtocol } from "../../orchestration/types.js";
+import type { AutomatonDatabase } from "../../types.js";
+import { createInMemoryDb } from "./test-db.js";
+
+const IDENTITY = {
+  name: "test",
+  address: "0x1234" as any,
+  account: {} as any,
+  creatorAddress: "0x0000" as any,
+  sandboxId: "sb-1",
+  apiKey: "key",
+  createdAt: "2026-01-01T00:00:00Z",
+};
+
+const GOAL_TITLE = "Build ONE simple arbitrage monitoring dashboard";
+
+function makeOrchestrator(db: BetterSqlite3.Database, opts: { inference?: any; config?: any } = {}): Orchestrator {
+  const transport: MessageTransport = {
+    deliver: vi.fn().mockResolvedValue(undefined),
+    getRecipients: vi.fn().mockReturnValue([]),
+  };
+  const automataDb = {
+    raw: db,
+    getIdentity: (key: string) => (key === "address" ? "0x1234" : undefined),
+    getChildren: () => [],
+    getUnprocessedInboxMessages: () => [],
+    markInboxMessageProcessed: () => {},
+  } as unknown as AutomatonDatabase;
+  const tracker: AgentTracker = {
+    getIdle: vi.fn().mockReturnValue([]),
+    getBestForTask: vi.fn().mockReturnValue(null),
+    updateStatus: vi.fn(),
+    register: vi.fn(),
+  };
+  const funding: FundingProtocol = {
+    fundChild: vi.fn().mockResolvedValue({ success: true }),
+    recallCredits: vi.fn().mockResolvedValue({ success: true, amountCents: 0 }),
+    getBalance: vi.fn().mockResolvedValue(0),
+  };
+  return new Orchestrator({
+    db,
+    agentTracker: tracker,
+    funding,
+    messaging: new ColonyMessaging(transport, automataDb),
+    inference: opts.inference ?? { chat: vi.fn().mockRejectedValue(new Error("ollama timeout")) },
+    identity: IDENTITY,
+    config: opts.config ?? {},
+  });
+}
+
+function setState(db: BetterSqlite3.Database, state: Record<string, unknown>): void {
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))")
+    .run("orchestrator.state", JSON.stringify({ replanCount: 0, failedTaskId: null, failedError: null, ...state }));
+}
+
+function insertGoal(db: BetterSqlite3.Database, title = GOAL_TITLE): string {
+  const id = ulid();
+  db.prepare("INSERT INTO goals (id, title, description, status, created_at) VALUES (?, ?, ?, 'active', ?)")
+    .run(id, title, "Monitor Solana price spreads", new Date().toISOString());
+  return id;
+}
+
+let clock = 0;
+function insertTask(db: BetterSqlite3.Database, goalId: string, o: {
+  title?: string; status?: string; dependencies?: string[]; result?: unknown; assignedTo?: string | null;
+} = {}): string {
+  const id = ulid();
+  clock += 1;
+  db.prepare(
+    `INSERT INTO task_graph
+     (id, goal_id, title, description, status, assigned_to, agent_role, priority, dependencies, result, created_at)
+     VALUES (?, ?, ?, ?, ?, ?, 'generalist', 50, ?, ?, ?)`,
+  ).run(
+    id, goalId, o.title ?? GOAL_TITLE, "desc", o.status ?? "pending", o.assignedTo ?? null,
+    JSON.stringify(o.dependencies ?? []),
+    o.result === undefined ? null : JSON.stringify(o.result),
+    new Date(Date.UTC(2026, 9, 5, 0, 0, clock)).toISOString(),
+  );
+  return id;
+}
+
+function openTasks(db: BetterSqlite3.Database, goalId: string) {
+  return db.prepare(
+    "SELECT id, title, status, dependencies, timeout_ms FROM task_graph WHERE goal_id = ? AND status NOT IN ('cancelled')",
+  ).all(goalId) as { id: string; title: string; status: string; dependencies: string; timeout_ms: number }[];
+}
+
+describe("orchestrator consolidation fixes", () => {
+  let db: BetterSqlite3.Database;
+  beforeEach(() => { db = createInMemoryDb(); });
+  afterEach(() => { db.close(); });
+
+  it("replan fallback reuses the failed task instead of adding a copy", async () => {
+    const goalId = insertGoal(db);
+    const failedId = insertTask(db, goalId, { status: "failed", result: { success: false, output: "Budget exhausted: timeout" } });
+    setState(db, { phase: "replanning", goalId, failedTaskId: failedId });
+
+    for (let i = 0; i < 3; i++) {
+      setState(db, { phase: "replanning", goalId, failedTaskId: failedId, replanCount: i });
+      db.prepare("UPDATE task_graph SET status = 'failed' WHERE id = ?").run(failedId);
+      await makeOrchestrator(db).tick();
+    }
+
+    const tasks = openTasks(db, goalId);
+    expect(tasks).toHaveLength(1);
+    expect(tasks[0].id).toBe(failedId);
+    expect(tasks[0].status).toBe("pending");
+  });
+
+  it("replan cancels existing open duplicates and redirects dependencies", async () => {
+    const goalId = insertGoal(db);
+    const first = insertTask(db, goalId, { status: "failed" });
+    const dup1 = insertTask(db, goalId, { status: "pending" });
+    insertTask(db, goalId, { status: "pending", title: `  ${GOAL_TITLE.toLowerCase()} ` });
+    const dependent = insertTask(db, goalId, { title: "Deploy dashboard", status: "blocked", dependencies: [dup1] });
+    setState(db, { phase: "replanning", goalId, failedTaskId: first });
+
+    await makeOrchestrator(db).tick();
+
+    const tasks = openTasks(db, goalId);
+    const dashboards = tasks.filter((t) => t.title.trim().toLowerCase() === GOAL_TITLE.toLowerCase());
+    expect(dashboards.map((t) => t.id)).toEqual([first]);
+    const dep = tasks.find((t) => t.id === dependent)!;
+    expect(JSON.parse(dep.dependencies)).toEqual([first]);
+  });
+
+  it("replanner output keeps new tasks and maps dependencies onto existing ones", async () => {
+    const goalId = insertGoal(db);
+    const failedId = insertTask(db, goalId, { status: "failed" });
+    setState(db, { phase: "replanning", goalId, failedTaskId: failedId });
+    const inference = {
+      chat: vi.fn().mockResolvedValue({
+        content: JSON.stringify({
+          analysis: "a", strategy: "s", customRoles: [],
+          tasks: [
+            { title: GOAL_TITLE, description: "Resume from existing files", agentRole: "generalist", dependencies: [], estimatedCostCents: 0, priority: 50, timeoutMs: 60000 },
+            { title: "Document Solana price APIs", description: "Write docs", agentRole: "researcher", dependencies: [0], estimatedCostCents: 0, priority: 40, timeoutMs: 60000 },
+          ],
+          risks: [{ risk: "API key required", mitigation: "use public endpoints" }],
+          estimatedTotalCostCents: 0, estimatedTimeMinutes: 10,
+        }),
+      }),
+    };
+
+    await makeOrchestrator(db, { inference }).tick();
+
+    const tasks = openTasks(db, goalId);
+    expect(tasks).toHaveLength(2);
+    const doc = tasks.find((t) => t.title === "Document Solana price APIs")!;
+    expect(JSON.parse(doc.dependencies)).toEqual([failedId]);
+    expect(doc.timeout_ms).toBe(900_000);
+    const desc = db.prepare("SELECT description FROM task_graph WHERE id = ?").get(failedId) as { description: string };
+    expect(desc.description).toBe("Resume from existing files");
+  });
+
+  it("does not assign more tasks than maxChildren", async () => {
+    const goalId = insertGoal(db);
+    for (let i = 0; i < 4; i++) insertTask(db, goalId, { title: `Task ${i}` });
+    setState(db, { phase: "executing", goalId });
+    let n = 0;
+    const spawnAgent = vi.fn(async () => ({ address: `local://w${++n}`, name: `w${n}`, sandboxId: `w${n}` }));
+
+    const result = await makeOrchestrator(db, { config: { maxChildren: 3, spawnAgent } }).tick();
+    expect(result.tasksAssigned).toBe(3);
+
+    const second = await makeOrchestrator(db, { config: { maxChildren: 3, spawnAgent } }).tick();
+    expect(second.tasksAssigned).toBe(0);
+  });
+
+  it("planner timeouts are persisted with a configurable floor", async () => {
+    const goalId = insertGoal(db, "Complex goal");
+    setState(db, { phase: "planning", goalId });
+    const inference = {
+      chat: vi.fn().mockResolvedValue({
+        content: JSON.stringify({
+          analysis: "a", strategy: "s", customRoles: [],
+          tasks: [
+            { title: "Short", description: "d", agentRole: "generalist", dependencies: [], estimatedCostCents: 10, priority: 50, timeoutMs: 60000 },
+            { title: "Long", description: "d", agentRole: "generalist", dependencies: [], estimatedCostCents: 10, priority: 50, timeoutMs: 3600000 },
+          ],
+          risks: [], estimatedTotalCostCents: 20, estimatedTimeMinutes: 10,
+        }),
+      }),
+    };
+
+    await makeOrchestrator(db, { inference, config: { workerTaskTimeoutMs: 600_000 } }).tick();
+    const byTitle = Object.fromEntries(openTasks(db, goalId).map((t) => [t.title, t.timeout_ms]));
+    expect(byTitle).toEqual({ Short: 600_000, Long: 3_600_000 });
+  });
+});
+
+describe("planner validator", () => {
+  it("accepts risks returned as objects by small models", () => {
+    const out = validatePlannerOutput({
+      analysis: "a", strategy: "s", customRoles: [],
+      tasks: [{ title: "t", description: "d", agentRole: "generalist", dependencies: [], estimatedCostCents: 0, priority: 50, timeoutMs: 1000 }],
+      risks: ["plain", { risk: "rate limit", mitigation: "cache" }],
+      estimatedTotalCostCents: 0, estimatedTimeMinutes: 1,
+    });
+    expect(out.risks).toEqual(["plain", "rate limit — cache"]);
+  });
+
+  it("still rejects non-text risks", () => {
+    expect(() => validatePlannerOutput({
+      analysis: "a", strategy: "s", customRoles: [], tasks: [], risks: [42],
+      estimatedTotalCostCents: 0, estimatedTimeMinutes: 1,
+    })).toThrow(/risks\[0\]/);
+  });
+});
+
+describe("worker wisdom", () => {
+  it("includes the previous attempt of a retried task", () => {
+    const db = createInMemoryDb();
+    const goalId = insertGoal(db);
+    insertTask(db, goalId, {
+      status: "pending",
+      result: { success: false, output: "Budget exhausted: timeout (300s / 300s). Progress kept — files already written: arbitrage-dashboard/vite.config.js" },
+    });
+    const wisdom = buildWisdomFromGoal(db, goalId, new AgentWorkspace(goalId));
+    expect(wisdom.failures.join("\n")).toContain("arbitrage-dashboard/vite.config.js");
+    db.close();
+  });
+});
