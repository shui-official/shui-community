+export function evaluateShortSetup(symbol: string, mint: string, perp: string, h4: Candle[], h1: Candle[], liquidityUsd: number): SetupResult {
+  const no = (reason: string): SetupResult => ({ symbol, mint, ok: false, reason, side: "short", perp });
+  if (liquidityUsd < MIN_LIQUIDITY_USD) return no(`liquidity $${Math.round(liquidityUsd)} < $50k`);
+  if (h4.length < 50 || h1.length < 50) return no("not enough candles");
+  const c4 = h4.map((c) => c.c);
+  const c1 = h1.map((c) => c.c);
+  const ema20h4 = emaSeries(c4, 20).at(-1)!;
+  const ema50h4 = emaSeries(c4, 50).at(-1)!;
+  const price = c1.at(-1)!;
+  if (!(ema20h4 < ema50h4 && price < ema50h4)) return no("4h trend not down either: no short");
+  const r = rsi(c1);
+  if (r === null || r < 32) return no(`short: 1h RSI ${r?.toFixed(0) ?? "?"} too low, do not short an oversold market — wait for a bounce`);
+  if (r > 65) return no(`short: 1h RSI ${r.toFixed(0)}: bounce still strong, wait for it to fade`);
+  const m = macd(c1);
+  if (m && m.hist > 0 && m.hist > m.prevHist) return no("short: 1h momentum still rising (MACD histogram up)");
+  const a = atr(h1);
+  if (!a) return no("no volatility data");
+  const { highs } = swings(h1);
+  const resistance = highs.filter((h) => h > price).sort((x, y) => x - y)[0];
+  const stop = Math.min(resistance !== undefined ? resistance + 0.5 * a : Infinity, price + 2 * a);
+  const supports = swings(h4, 3).lows.filter((l) => l < price * 0.998).sort((x, y) => y - x);
+  const fib = fibonacci(h4);
+  const fibTarget = fib?.direction === "down" ? fib.extensions[0].price : NaN;
+  const target = supports[0] ?? (fibTarget > 0 ? fibTarget : price - 3 * a);
+  const rr = (price - target) / (stop - price);
+  const plan = {
+    entry: price, stop, target, rr,
+    stopPct: ((stop - price) / price) * 100,
+    targetPct: ((price - target) / price) * 100,
+  };
+  if (!(target > 0) || !(rr >= 2)) return { ...no(`short: reward/risk ${rr.toFixed(2)} < 2 (target ${fmt(target)} too close to support)`), plan };
+  return { symbol, mint, ok: true, side: "short", perp, reason: `4h downtrend, 1h bounce fading (RSI ${r.toFixed(0)}), reward/risk ${rr.toFixed(2)}`, plan };
+}
