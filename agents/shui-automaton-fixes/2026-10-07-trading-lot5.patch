 }
+
+// ─── Loss-streak stop (playbook rule 12, enforced by code) ───────
+
+export const MEANINGFUL_LOSS_PCT = 0.5;
+const MIN_MEANINGFUL_LOSS_USD = 0.05;
+export const MAX_LOSS_STREAK = 2;
+
+/** Total capital (wallet incl. Drift) from the last complete valuation, or null. */
+export function lastCapitalUsd(db: Database): number | null {
+  try {
+    const raw = getKv(db, "last_known_balance");
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as { walletValueUsd?: number | null; walletValueComplete?: boolean };
+    return parsed.walletValueComplete && typeof parsed.walletValueUsd === "number" && parsed.walletValueUsd > 0
+      ? parsed.walletValueUsd
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+/** A loss counts for the streak only above 0.5% of capital (dust test swaps do not). */
+export function meaningfulLossUsd(capitalUsd: number | null): number {
+  return capitalUsd && capitalUsd > 0 ? Math.max(MIN_MEANINGFUL_LOSS_USD, (capitalUsd * MEANINGFUL_LOSS_PCT) / 100) : MIN_MEANINGFUL_LOSS_USD;
+}
+
+/** Closed trades of a UTC day, oldest first (sales into USDC and Drift PnL). */
+function closedTradesOfDay(db: Database, day: string): number[] {
+  try {
+    return (db.prepare(
+      `SELECT realized_pnl_usd AS pnl FROM shui_ledger
+       WHERE day = ? AND ((kind = 'swap' AND output_mint = ? AND input_mint != ?) OR kind = 'perp_pnl') ORDER BY ts`,
+    ).all(day, USDC, USDC) as Array<{ pnl: number }>).map((r) => r.pnl);
+  } catch {
+    return [];
+  }
+}
+
+/** Consecutive meaningful losses today; a win resets it, tiny losses are ignored. */
+export function lossStreakToday(db: Database, now: Date = new Date(), capitalUsd: number | null = lastCapitalUsd(db)): number {
+  const threshold = meaningfulLossUsd(capitalUsd);
+  let streak = 0;
+  for (const pnl of closedTradesOfDay(db, now.toISOString().slice(0, 10))) {
+    if (pnl > 0) streak = 0;
+    else if (pnl <= -threshold) streak += 1;
+  }
+  return streak;
+}
+
+/** After 2 meaningful losses today, new entries are blocked until 00:00 UTC. */
+export function lossStopUntil(db: Database, now: Date = new Date()): string | null {
+  if (lossStreakToday(db, now) < MAX_LOSS_STREAK) return null;
+  const next = new Date(now);
+  next.setUTCHours(24, 0, 0, 0);
+  return next.toISOString();
+}
