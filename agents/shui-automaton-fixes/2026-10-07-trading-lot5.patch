+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { createDatabase } from "../state/database.js";
+import { ensureLedgerSchema } from "../solana/ledger.js";
+import { evaluateShortSetup, setupScan, computeTradeStats } from "../solana/trading-desk.js";
+import { lossStopUntil, lossStreakToday, meaningfulLossUsd } from "../survival/risk-guard.js";
+import { classifySwapResult } from "../solana/orders.js";
+import { validatePerpOpen } from "../solana/perps.js";
+import type { Candle } from "../solana/technical-analysis.js";
+
+const USDC = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+const SOL = "So11111111111111111111111111111111111111112";
+const candles = (closes: number[], wick = 0.01): Candle[] =>
+  closes.map((c, i) => ({ t: i, o: c, h: c * (1 + wick), l: c * (1 - wick), c, v: 100 }));
+const uptrend = (n: number) => Array.from({ length: n }, (_, i) => 100 + i * 0.6 + Math.sin(i / 2.5) * 4);
+const mirror = (xs: number[]) => xs.map((x) => 400 - x);
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot5-")), "s.db"));
+
+function ledgerWith(pnls: number[], day: string) {
+  const db = freshDb();
+  ensureLedgerSchema(db.raw);
+  const ins = db.raw.prepare(
+    "INSERT INTO shui_ledger (signature, ts, day, kind, input_mint, input_amount_raw, output_mint, output_amount_raw, realized_pnl_usd) VALUES (?, ?, ?, 'swap', 'TOKEN', '1', ?, '1', ?)",
+  );
+  pnls.forEach((p, i) => ins.run(`s${i}`, `${day}T0${i + 1}:00:00Z`, day, USDC, p));
+  return db;
+}
+
+describe("short setups", () => {
+  it("mirrors the long rules in a 4h downtrend: stop above, target below, R/R >= 2", () => {
+    const h4 = candles(mirror(uptrend(120)));
+    const h1 = candles(mirror(uptrend(120).map((c, i) => (i > 112 ? c - (i - 112) * 1.2 : c))));
+    const r = evaluateShortSetup("SOL", SOL, "SOL-PERP", h4, h1, 2_000_000);
+    expect(r.side).toBe("short");
+    if (r.plan) {
+      expect(r.plan.stop).toBeGreaterThan(r.plan.entry);
+      expect(r.plan.target).toBeLessThan(r.plan.entry);
+      expect(r.ok).toBe(r.plan.rr >= 2);
+    } else {
+      expect(r.reason).toMatch(/short/);
+    }
+    expect(evaluateShortSetup("SOL", SOL, "SOL-PERP", candles(uptrend(120)), candles(uptrend(120)), 2_000_000).reason)
+      .toMatch(/not down either/);
+  });
+
+  it("checks shorts only for tokens with a Drift market", async () => {
+    const ohlcv = (closes: number[]) => ({ data: { attributes: { ohlcv_list: closes.map((c, i) => [i, c, c * 1.01, c * 0.99, c, 10]) } } });
+    const fetcher = async (url: string) => url.includes("dexscreener")
+      ? [{ chainId: "solana", pairAddress: "P", dexId: "orca", liquidity: { usd: 5_000_000 }, baseToken: { symbol: "SOL" } }]
+      : ohlcv(uptrend(120).reverse());
+    const sol = await setupScan({ mints: [SOL] }, fetcher, 0);
+    expect(sol).toMatch(/SHORT SETUP SOL|SOL: (short|4h trend not down)/);
+    expect(sol).not.toMatch(/SOL: 4h trend not up/);
+    const other = await setupScan({ mints: ["JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN"] }, fetcher, 0);
+    expect(other).not.toMatch(/SHORT/);
+  });
+});
+
+describe("loss-streak stop", () => {
+  const day = "2026-10-07";
+  const noon = new Date(`${day}T12:00:00Z`);
+
+  it("ignores dust losses and counts only losses above 0.5% of capital", () => {
+    expect(meaningfulLossUsd(34)).toBeCloseTo(0.17);
+    expect(meaningfulLossUsd(null)).toBe(0.05);
+    expect(lossStreakToday(ledgerWith([-0.012, -0.012], day).raw, noon, 34)).toBe(0); // this morning's test swaps
+    expect(lossStreakToday(ledgerWith([-0.3, -0.01, -0.5], day).raw, noon, 34)).toBe(2);
+    expect(lossStreakToday(ledgerWith([-0.3, 0.2, -0.5], day).raw, noon, 34)).toBe(1); // a win resets
+    expect(computeTradeStats(ledgerWith([-0.012, -0.012], day).raw, day, 34).lossStreakToday).toBe(0);
+  });
+
+  it("blocks new entries until 00:00 UTC, not 24 h", () => {
+    const db = ledgerWith([-0.3, -0.4], day);
+    db.raw.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES ('last_known_balance', ?, datetime('now'))")
+      .run(JSON.stringify({ walletValueUsd: 34, walletValueComplete: true }));
+    expect(lossStopUntil(db.raw, noon)).toBe("2026-10-08T00:00:00.000Z");
+    expect(lossStopUntil(db.raw, new Date("2026-10-08T00:00:01Z"))).toBeNull();
+    expect(classifySwapResult(JSON.stringify({ success: false, reason: "LOSS_STREAK_STOP", message: "x" }))).toMatchObject({ transient: true });
+    const v = validatePerpOpen({
+      direction: "short", entryPrice: 100, sizeUsd: 10, stopPrice: 102, capitalUsd: 100, accountValueUsd: 20,
+      otherNotionalUsd: 0, liqPrice: null, openedCount: 0, pausedUntil: null, lossStopUntil: "2026-10-08T00:00:00.000Z",
+    });
+    expect(v.reasons.join()).toMatch(/2 losing trades today/);
+  });
+});
