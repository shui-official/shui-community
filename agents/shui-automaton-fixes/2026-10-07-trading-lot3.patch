+/**
+ * Lot 3 trading tools: DCA plans, paper trading (simulated positions, no
+ * funds move) and liquid staking of idle SOL (jitoSOL).
+ */
+import { randomUUID } from "node:crypto";
+import { PublicKey } from "@solana/web3.js";
+import type { AutomatonTool } from "../types.js";
+import { USDC_MINT } from "./raydium.js";
+import { NATIVE_SOL_MINT } from "./trading.js";
+import { jupiterPrices, listOrders, listPaperTrades, saveOrder, type Order } from "./orders.js";
+import { runSwap } from "./swap-engine.js";
+import { jupiterVenue } from "./jupiter.js";
+
+export const JITOSOL_MINT = "J1toso1uCk3RLmjorhTtrVwY9HJ7X8V9yYac6Y7kGCPn";
+const MAX_OPEN = 20;
+
+const validMint = (m: string) => {
+  try { new PublicKey(m); return true; } catch { return false; }
+};
+
+export function paperStatsText(trades: ReturnType<typeof listPaperTrades>, open: Order[]): string {
+  const wins = trades.filter((t) => t.pnlUsd > 0).length;
+  const total = trades.reduce((s, t) => s + t.pnlUsd, 0);
+  const lines = [
+    `Paper trades closed: ${trades.length} | win rate ${trades.length ? `${((wins / trades.length) * 100).toFixed(0)}%` : "?"} | ` +
+    `simulated PnL ${total >= 0 ? "+" : ""}$${total.toFixed(4)}${trades.length ? ` | avg ${(total / trades.length).toFixed(4)}$/trade` : ""}`,
+  ];
+  for (const t of trades.slice(-5)) {
+    lines.push(`- ${t.at.slice(0, 16)} ${t.mint.slice(0, 6)}… ${t.exitKind}: entry ${t.entryUsd.toPrecision(5)} exit ${t.exitUsd.toPrecision(5)} -> ${t.pnlUsd >= 0 ? "+" : ""}$${t.pnlUsd.toFixed(4)}`);
+  }
+  const groups = new Set(open.filter((o) => o.paper).map((o) => o.group));
+  lines.push(`Open paper positions: ${groups.size}`);
+  if (trades.length >= 20) {
+    lines.push(total > 0 ? "20+ paper trades with a positive result: the method can go live with a small size." : "20+ paper trades and still negative: change the method before using real money.");
+  }
+  return lines.join("\n");
+}
+
+export function createTradingExtraTools(): AutomatonTool[] {
+  return [
+    {
+      name: "dca_create",
+      description: "Dollar-cost averaging: buy usdcPerBuy of a token every everyHours, count times, skipping buys when the price is above maxPriceUsd. Runs in code (no need to be awake). Cancel with order_cancel.",
+      category: "financial",
+      riskLevel: "dangerous",
+      parameters: {
+        type: "object",
+        properties: {
+          mint: { type: "string" },
+          usdcPerBuy: { type: "number" },
+          everyHours: { type: "number" },
+          count: { type: "number" },
+          maxPriceUsd: { type: "number", description: "Optional: skip a buy when the price is above." },
+        },
+        required: ["mint", "usdcPerBuy", "everyHours", "count"],
+      },
+      execute: async (args, ctx) => {
+        const mint = String(args.mint ?? "");
+        const usdc = Number(args.usdcPerBuy);
+        const hours = Number(args.everyHours);
+        const count = Math.floor(Number(args.count));
+        if (!validMint(mint) || mint === USDC_MINT) return "Blocked: invalid mint.";
+        if (!(usdc >= 0.5) || !(hours >= 1) || !(count >= 1 && count <= 100)) return "Blocked: usdcPerBuy >= 0.5, everyHours >= 1, count 1-100.";
+        const db = ctx.db.raw;
+        if (listOrders(db).filter((o) => o.status === "open").length >= MAX_OPEN) return "Blocked: too many open orders.";
+        const now = new Date();
+        const order: Order = {
+          id: `dca_${now.getTime().toString(36)}_${randomUUID().slice(0, 4)}`, kind: "dca", inputMint: USDC_MINT, outputMint: mint,
+          amount: String(Math.floor(usdc * 1_000_000)), watchMint: mint, condition: "below", triggerPriceUsd: args.maxPriceUsd ? Number(args.maxPriceUsd) : 1e12,
+          slippageBps: 100, venue: "jupiter", note: `DCA ${usdc} USDC x${count}`, createdAt: now.toISOString(), expiresAt: null,
+          status: "open", attempts: 0, updatedAt: now.toISOString(), intervalHours: hours, remaining: count, nextAt: now.toISOString(),
+          ...(args.maxPriceUsd ? { maxPriceUsd: Number(args.maxPriceUsd) } : {}),
+        };
+        saveOrder(db, order);
+        return `DCA ${order.id}: ${usdc} USDC of ${mint} every ${hours} h, ${count} times (first buy within a minute). Total ${(usdc * count).toFixed(2)} USDC.`;
+      },
+    },
+    {
+      name: "paper_trade",
+      description:
+        "Simulated trade, no funds move: opens a paper position of sizeUsd at the current price with a stop (stopPriceUsd or " +
+        "trailPct) and a take-profit, linked OCO; the code closes it like a real one. Use it to test a method before real money. See paper_stats.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: {
+        type: "object",
+        properties: {
+          mint: { type: "string" },
+          sizeUsd: { type: "number" },
+          stopPriceUsd: { type: "number" },
+          trailPct: { type: "number" },
+          takeProfitPriceUsd: { type: "number" },
+          note: { type: "string" },
+        },
+        required: ["mint", "sizeUsd", "takeProfitPriceUsd"],
+      },
+      execute: async (args, ctx) => {
+        const mint = String(args.mint ?? "");
+        const size = Number(args.sizeUsd);
+        const tp = Number(args.takeProfitPriceUsd);
+        const stop = args.stopPriceUsd === undefined ? NaN : Number(args.stopPriceUsd);
+        const trail = args.trailPct === undefined ? NaN : Number(args.trailPct);
+        if (!validMint(mint) || !(size > 0) || !(tp > 0)) return "Blocked: give a valid mint, sizeUsd and takeProfitPriceUsd.";
+        if (!(stop > 0) && !(trail > 0 && trail < 50)) return "Blocked: give stopPriceUsd or trailPct.";
+        let price: number | undefined;
+        try { price = (await jupiterPrices([mint]))[mint]; } catch { price = undefined; }
+        if (!price) return "Blocked: price unavailable.";
+        const stopPrice = stop > 0 ? stop : price * (1 - trail / 100);
+        if (!(stopPrice < price && tp > price)) return `Blocked: stop must be below and target above the current price ($${price}).`;
+        const db = ctx.db.raw;
+        if (listOrders(db).filter((o) => o.status === "open").length + 2 > MAX_OPEN) return "Blocked: too many open orders.";
+        const now = new Date();
+        const group = `paper_${now.getTime().toString(36)}`;
+        const units = size / price;
+        const base = {
+          inputMint: mint, outputMint: USDC_MINT, amount: "0", watchMint: mint, slippageBps: 0, venue: "jupiter" as const,
+          note: String(args.note ?? "paper").slice(0, 200), createdAt: now.toISOString(), expiresAt: null, status: "open" as const,
+          attempts: 0, updatedAt: now.toISOString(), group, paper: true, paperUnits: units, paperEntryUsd: price,
+        };
+        const stopOrder: Order = trail > 0 && !(stop > 0)
+          ? { ...base, id: `${group}_stop`, kind: "trailing_stop", condition: "below", triggerPriceUsd: stopPrice, trailPct: trail, highestPriceUsd: price }
+          : { ...base, id: `${group}_stop`, kind: "stop_loss", condition: "below", triggerPriceUsd: stopPrice };
+        saveOrder(db, stopOrder);
+        saveOrder(db, { ...base, id: `${group}_tp`, kind: "take_profit", condition: "above", triggerPriceUsd: tp });
+        return `Paper position ${group}: ${units.toPrecision(6)} units at $${price} ($${size}), stop $${stopPrice.toPrecision(6)}, target $${tp}. No funds moved.`;
+      },
+    },
+    {
+      name: "paper_stats",
+      description: "Results of your paper (simulated) trades: count, win rate, simulated PnL, recent trades, open paper positions.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: {} },
+      execute: async (_args, ctx) => paperStatsText(listPaperTrades(ctx.db.raw), listOrders(ctx.db.raw).filter((o) => o.status === "open")),
+    },
+    {
+      name: "stake_sol",
+      description:
+        "Liquid staking for idle SOL: swap SOL into jitoSOL (~7%/year staking yield, swap back anytime with unstake_sol). " +
+        "jitoSOL follows the SOL price: it is not a cash position. 0.01 SOL always stays for fees. amountSol in SOL units.",
+      category: "financial",
+      riskLevel: "dangerous",
+      parameters: { type: "object", properties: { amountSol: { type: "number" }, dryRun: { type: "boolean" } }, required: ["amountSol"] },
+      execute: async (args, ctx) => {
+        if (!ctx.identity.chainIdentity || ctx.identity.chainIdentity.chainType !== "solana") return "Solana identity unavailable.";
+        const lamports = Math.floor(Number(args.amountSol) * 1e9);
+        if (!(lamports > 0)) return "Blocked: amountSol must be positive.";
+        return runSwap({ db: ctx.db, chainIdentity: ctx.identity.chainIdentity },
+          { inputMint: NATIVE_SOL_MINT, outputMint: JITOSOL_MINT, amount: String(lamports), slippageBps: 50, dryRun: args.dryRun === true }, jupiterVenue);
+      },
+    },
+    {
+      name: "unstake_sol",
+      description: 'Swap jitoSOL back into SOL. amountRaw in jitoSOL raw units (9 decimals) or "all".',
+      category: "financial",
+      riskLevel: "dangerous",
+      parameters: { type: "object", properties: { amountRaw: { type: "string" }, dryRun: { type: "boolean" } }, required: ["amountRaw"] },
+      execute: async (args, ctx) => {
+        if (!ctx.identity.chainIdentity || ctx.identity.chainIdentity.chainType !== "solana") return "Solana identity unavailable.";
+        let amount = String(args.amountRaw ?? "");
+        if (amount === "all") {
+          const { SolanaTradingService } = await import("./trading.js");
+          const balances = await new SolanaTradingService(ctx.identity.chainIdentity).getTokenBalances();
+          amount = balances.filter((b) => b.mint === JITOSOL_MINT).reduce((s, b) => s + BigInt(b.amount), 0n).toString();
+          if (amount === "0") return "No jitoSOL to unstake.";
+        }
+        return runSwap({ db: ctx.db, chainIdentity: ctx.identity.chainIdentity },
+          { inputMint: JITOSOL_MINT, outputMint: NATIVE_SOL_MINT, amount, slippageBps: 50, dryRun: args.dryRun === true }, jupiterVenue);
+      },
+    },
+  ];
+}
