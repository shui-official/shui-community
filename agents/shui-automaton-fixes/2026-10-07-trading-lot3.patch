+}
+
+export function recordPaperTrade(db: Database, trade: PaperTrade): void {
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))")
+    .run(`paper.trade.${trade.at}_${trade.id}`, JSON.stringify(trade));
+}
+
+export function listPaperTrades(db: Database): PaperTrade[] {
+  return (db.prepare("SELECT value FROM kv WHERE key LIKE 'paper.trade.%' ORDER BY key").all() as Array<{ value: string }>)
+    .map((r) => JSON.parse(r.value) as PaperTrade);
+}
+
 export function isTriggered(order: Pick<Order, "condition" | "triggerPriceUsd">, priceUsd: number): boolean {
   return order.condition === "below" ? priceUsd <= order.triggerPriceUsd : priceUsd >= order.triggerPriceUsd;
 }
