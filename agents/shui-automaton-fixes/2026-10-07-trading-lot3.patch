+/** Rolling VWAP over the last n candles (typical price x volume). */
+export function vwap(candles: Candle[], n = 24): number | null {
+  const w = candles.slice(-n);
+  const vol = w.reduce((s, c) => s + c.v, 0);
+  if (w.length === 0 || vol <= 0) return null;
+  return w.reduce((s, c) => s + ((c.h + c.l + c.c) / 3) * c.v, 0) / vol;
+}
+
+/** Stochastic RSI %K (0-100) and its previous value. */
+export function stochRsi(closes: number[], n = 14): { k: number; prevK: number } | null {
+  if (closes.length < n * 2 + 2) return null;
+  const series: number[] = [];
+  for (let end = closes.length - n - 1; end <= closes.length; end++) {
+    const v = rsi(closes.slice(0, end), n);
+    if (v !== null) series.push(v);
+  }
+  if (series.length < n + 1) return null;
+  const k = (arr: number[]) => {
+    const w = arr.slice(-n);
+    const lo = Math.min(...w);
+    const hi = Math.max(...w);
+    return hi === lo ? 50 : ((w[w.length - 1] - lo) / (hi - lo)) * 100;
+  };
+  return { k: k(series), prevK: k(series.slice(0, -1)) };
+}
+
+/** ADX (trend strength) with +DI / -DI. */
+export function adx(candles: Candle[], n = 14): { adx: number; plusDi: number; minusDi: number } | null {
+  if (candles.length < n * 2 + 1) return null;
+  let trS = 0, pS = 0, mS = 0;
+  const dxs: number[] = [];
+  for (let i = 1; i < candles.length; i++) {
+    const c = candles[i];
+    const p = candles[i - 1];
+    const up = c.h - p.h;
+    const down = p.l - c.l;
+    const pdm = up > down && up > 0 ? up : 0;
+    const mdm = down > up && down > 0 ? down : 0;
+    const tr = Math.max(c.h - c.l, Math.abs(c.h - p.c), Math.abs(c.l - p.c));
+    if (i <= n) { trS += tr; pS += pdm; mS += mdm; if (i < n) continue; }
+    else { trS = trS - trS / n + tr; pS = pS - pS / n + pdm; mS = mS - mS / n + mdm; }
+    const pdi = trS ? (100 * pS) / trS : 0;
+    const mdi = trS ? (100 * mS) / trS : 0;
+    dxs.push(pdi + mdi ? (100 * Math.abs(pdi - mdi)) / (pdi + mdi) : 0);
+  }
+  if (dxs.length < n) return null;
+  let value = dxs.slice(0, n).reduce((s, x) => s + x, 0) / n;
+  for (let i = n; i < dxs.length; i++) value = (value * (n - 1) + dxs[i]) / n;
+  const pdi = trS ? (100 * pS) / trS : 0;
+  const mdi = trS ? (100 * mS) / trS : 0;
+  return { adx: value, plusDi: pdi, minusDi: mdi };
+}
+
+/** On-balance volume trend over the last n candles: rising, falling or flat. */
+export function obvTrend(candles: Candle[], n = 20): "rising" | "falling" | "flat" | null {
+  if (candles.length < n + 1) return null;
+  let obv = 0;
+  const series: number[] = [0];
+  for (let i = 1; i < candles.length; i++) {
+    obv += candles[i].c > candles[i - 1].c ? candles[i].v : candles[i].c < candles[i - 1].c ? -candles[i].v : 0;
+    series.push(obv);
+  }
+  const delta = series[series.length - 1] - series[series.length - 1 - n];
+  const scale = candles.slice(-n).reduce((s, c) => s + c.v, 0) || 1;
+  return delta / scale > 0.15 ? "rising" : delta / scale < -0.15 ? "falling" : "flat";
+}
