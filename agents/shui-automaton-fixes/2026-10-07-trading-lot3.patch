+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { createDatabase, claimInboxMessages } from "../state/database.js";
+import { adx, obvTrend, stochRsi, vwap, type Candle } from "../solana/technical-analysis.js";
+import { listOrders, listPaperTrades, runOrderTick, saveOrder, type Order } from "../solana/orders.js";
+import { paperStatsText } from "../solana/trading-extras.js";
+import { listStrategies, runStrategyTick, saveStrategy } from "../solana/strategies.js";
+import { entrySignals } from "../solana/backtest.js";
+import { buildDailyReport, maybeSendDailyReport } from "../maintenance/daily-report.js";
+import { listOutgoingCreatorMessages } from "../integration/creator-chat.js";
+
+const TOKEN = "TokenMint1111111111111111111111111111111111";
+const USDC = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+const mk = (closes: number[], vol = (i: number) => 100): Candle[] => closes.map((c, i) => ({ t: i * 3600, o: c, h: c * 1.01, l: c * 0.99, c, v: vol(i) }));
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot3-")), "s.db"));
+const order = (over: Partial<Order>): Order => ({
+  id: "o", kind: "stop_loss", inputMint: TOKEN, outputMint: USDC, amount: "0", watchMint: TOKEN, condition: "below", triggerPriceUsd: 1,
+  slippageBps: 100, venue: "jupiter", note: "", createdAt: "", expiresAt: null, status: "open", attempts: 0, updatedAt: new Date().toISOString(), ...over,
+});
+
+describe("advanced indicators", () => {
+  it("reads trend strength, momentum, VWAP and volume flow", () => {
+    const up = mk(Array.from({ length: 120 }, (_, i) => 100 + i), (i) => 100 + i);
+    const a = adx(up)!;
+    expect(a.adx).toBeGreaterThan(25);
+    expect(a.plusDi).toBeGreaterThan(a.minusDi);
+    expect(obvTrend(up)).toBe("rising");
+    expect(vwap(up)!).toBeLessThan(up[up.length - 1].c);
+    const st = stochRsi(up.map((c) => c.c));
+    expect(st).not.toBeNull();
+    const flat = mk(Array.from({ length: 120 }, (_, i) => 100 + Math.sin(i) * 0.5));
+    expect(adx(flat)!.adx).toBeLessThan(25);
+  });
+});
+
+describe("DCA", () => {
+  it("buys on schedule, skips above the max price and completes", async () => {
+    const db = freshDb();
+    const now = Date.now();
+    saveOrder(db.raw, order({ id: "dca1", kind: "dca", inputMint: USDC, outputMint: TOKEN, amount: "1000000", intervalHours: 24, remaining: 2, nextAt: new Date(now - 1000).toISOString(), maxPriceUsd: 2 }));
+    const swap = vi.fn(async () => JSON.stringify({ success: true, signature: "S" }));
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [TOKEN]: 1.5 }), swap, now: () => new Date(now) });
+    expect(swap).toHaveBeenCalledWith(expect.objectContaining({ id: "dca1" }), "1000000");
+    expect(listOrders(db.raw)[0]).toMatchObject({ status: "open", remaining: 1 });
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [TOKEN]: 1.5 }), swap, now: () => new Date(now + 3_600_000) });
+    expect(swap).toHaveBeenCalledTimes(1); // not due yet
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [TOKEN]: 3 }), swap, now: () => new Date(now + 25 * 3_600_000) });
+    expect(swap).toHaveBeenCalledTimes(1); // skipped: above max price
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [TOKEN]: 1.8 }), swap, now: () => new Date(now + 50 * 3_600_000) });
+    expect(listOrders(db.raw)[0]).toMatchObject({ status: "filled", remaining: 0 });
+  });
+});
+
+describe("paper trading", () => {
+  it("closes paper positions without any swap and records simulated PnL", async () => {
+    const db = freshDb();
+    const paper = { paper: true, paperUnits: 10, paperEntryUsd: 1, group: "p1" };
+    saveOrder(db.raw, order({ id: "p1_stop", ...paper, triggerPriceUsd: 0.9 }));
+    saveOrder(db.raw, order({ id: "p1_tp", ...paper, kind: "take_profit", condition: "above", triggerPriceUsd: 1.2 }));
+    const swap = vi.fn();
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [TOKEN]: 1.25 }), swap });
+    expect(swap).not.toHaveBeenCalled();
+    const trades = listPaperTrades(db.raw);
+    expect(trades).toHaveLength(1);
+    expect(trades[0].pnlUsd).toBeCloseTo(2.5, 6);
+    expect(Object.fromEntries(listOrders(db.raw).map((o) => [o.id, o.status]))).toEqual({ p1_stop: "cancelled", p1_tp: "filled" });
+    expect(paperStatsText(trades, [])).toMatch(/win rate 100%.*\+\$2\.5000/);
+  });
+
+  it("runs a paper strategy without spending", async () => {
+    const db = freshDb();
+    const closes = [...Array.from({ length: 60 }, (_, i) => 100 - i * 0.3), ...Array.from({ length: 8 }, (_, i) => 82 + i * 1.5)];
+    const candles = mk(closes);
+    const last = entrySignals("ema_cross", candles).lastIndexOf(true);
+    saveStrategy(db.raw, {
+      id: "pp", mint: TOKEN, symbol: "TKN", timeframe: "1h", rule: "ema_cross", params: {}, sizeUsd: 10, active: true, state: "flat",
+      group: null, lastSignalTs: null, trades: 0, note: "", lastError: null, paper: true, createdAt: "", updatedAt: "",
+    });
+    const swap = vi.fn();
+    await runStrategyTick({ db, chainIdentity: {} as any, candles: async () => candles.slice(0, last + 2), swap });
+    expect(swap).not.toHaveBeenCalled();
+    expect(listOrders(db.raw).every((o) => o.paper)).toBe(true);
+    expect(listStrategies(db.raw)[0].state).toBe("long");
+  });
+});
+
+describe("daily report", () => {
+  it("sends one verified report per day after 20:00 UTC", () => {
+    const db = freshDb();
+    db.raw.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES ('last_known_balance', ?, datetime('now'))").run(JSON.stringify({ walletValueUsd: 36.5 }));
+    expect(buildDailyReport(db.raw, new Date("2026-10-07T20:30:00Z"))).toMatch(/Wallet: \$36\.50/);
+    expect(maybeSendDailyReport(db.raw, new Date("2026-10-07T12:00:00Z"))).toBe(false);
+    expect(maybeSendDailyReport(db.raw, new Date("2026-10-07T20:30:00Z"))).toBe(true);
+    expect(maybeSendDailyReport(db.raw, new Date("2026-10-07T21:30:00Z"))).toBe(false);
+    expect(listOutgoingCreatorMessages(db.raw)[0].content).toMatch(/^Daily report 2026-10-07/);
+  });
+});
