+/**
+ * Daily report to the creator (Control Center chat), written by code from
+ * verified data, once a day after REPORT_HOUR_UTC. No model involved, so it
+ * cannot embellish: wallet value, realized PnL, trades, life, open orders,
+ * strategies, paper results and the latest lesson from the journal.
+ */
+import type { Database } from "better-sqlite3";
+import { saveOutgoingCreatorMessage } from "../integration/creator-chat.js";
+import { computeTradeStats, recentJournal } from "../solana/trading-desk.js";
+import { formatLifespanLine } from "../survival/lifespan.js";
+import { listOrders, listPaperTrades } from "../solana/orders.js";
+import { listStrategies } from "../solana/strategies.js";
+
+export const REPORT_HOUR_UTC = 20;
+const LAST_KEY = "report.last_day";
+
+export function buildDailyReport(db: Database, now: Date = new Date()): string {
+  const day = now.toISOString().slice(0, 10);
+  let walletUsd: number | null = null;
+  try {
+    const row = db.prepare("SELECT value FROM kv WHERE key = 'last_known_balance'").get() as { value: string } | undefined;
+    const v = row ? (JSON.parse(row.value) as { walletValueUsd?: number }).walletValueUsd : undefined;
+    walletUsd = typeof v === "number" ? v : null;
+  } catch {
+    walletUsd = null;
+  }
+  const stats = computeTradeStats(db, day);
+  const open = listOrders(db).filter((o) => o.status === "open");
+  const strategies = listStrategies(db).filter((s) => s.active);
+  const paper = listPaperTrades(db).filter((t) => t.at.startsWith(day));
+  const lesson = recentJournal(db, 20).find((j) => j.kind === "lesson");
+  const life = (formatLifespanLine(db, now) ?? "").split("\n")[0];
+  const lines = [
+    `Daily report ${day} (automatic, from verified data)`,
+    `Wallet: ${walletUsd === null ? "value unknown" : `$${walletUsd.toFixed(2)}`} | realized PnL today ${stats.todayPnlUsd >= 0 ? "+" : ""}$${stats.todayPnlUsd.toFixed(4)} | total ${stats.totalPnlUsd >= 0 ? "+" : ""}$${stats.totalPnlUsd.toFixed(4)}`,
+    `Trades closed: ${stats.closedTrades} (win rate ${stats.winRate === null ? "?" : `${(stats.winRate * 100).toFixed(0)}%`})`,
+    `Open orders: ${open.filter((o) => !o.paper && o.kind !== "alert").length} | alerts ${open.filter((o) => o.kind === "alert").length} | strategies active ${strategies.length}${strategies.some((s) => s.paper) ? ` (${strategies.filter((s) => s.paper).length} paper)` : ""}`,
+    `Paper trades today: ${paper.length}${paper.length ? ` (simulated PnL ${paper.reduce((s, t) => s + t.pnlUsd, 0).toFixed(4)}$)` : ""}`,
+  ];
+  if (life) lines.push(life);
+  if (lesson) lines.push(`Latest lesson: ${lesson.text.slice(0, 200)}`);
+  return lines.join("\n");
+}
+
+export function maybeSendDailyReport(db: Database, now: Date = new Date()): boolean {
+  if (now.getUTCHours() < REPORT_HOUR_UTC) return false;
+  const day = now.toISOString().slice(0, 10);
+  const last = (db.prepare("SELECT value FROM kv WHERE key = ?").get(LAST_KEY) as { value: string } | undefined)?.value;
+  if (last === day) return false;
+  const saved = saveOutgoingCreatorMessage(db, buildDailyReport(db, now), now);
+  if (typeof saved === "string") return false;
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(LAST_KEY, day);
+  return true;
+}
+
+export function startDailyReport(db: Database, log?: (m: string) => void): () => void {
+  const timer = setInterval(() => {
+    try {
+      if (maybeSendDailyReport(db)) log?.("[REPORT] daily report sent to the creator chat");
+    } catch (error) {
+      log?.(`[REPORT] failed: ${error instanceof Error ? error.message : String(error)}`);
+    }
+  }, 15 * 60_000);
+  timer.unref?.();
+  return () => clearInterval(timer);
+}
