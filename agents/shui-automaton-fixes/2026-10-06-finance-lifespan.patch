+  scanWalletHistory,
+  utcDay,
+} from "./ledger.js";
+import { RaydiumQuoteService } from "./raydium.js";
+import { fetchSolUsdPriceFromRaydium } from "./wallet-valuation.js";
+
+function solanaService(ctx: ToolContext): SolanaTradingService | null {
+  if (
+    ctx.identity.chainType !== "solana" ||
+    !ctx.identity.chainIdentity ||
+    ctx.identity.chainIdentity.chainType !== "solana"
+  ) {
+    return null;
+  }
+  return new SolanaTradingService(ctx.identity.chainIdentity);
+}
+
+export function createSolanaTransferTool(): AutomatonTool {
+  return {
+    name: "solana_transfer",
+    description:
+      "Send native SOL or an SPL token (e.g. USDC) from your central Solana wallet to another address. " +
