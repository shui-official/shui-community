@@ -0,0 +1,125 @@
+/**
+ * Lock for Solana transactions whose on-chain outcome is not yet known.
+ *
+ * While a broadcast transaction is unresolved, no new financial transaction
+ * (swap or transfer) is allowed: rebuilding and resending could execute the
+ * same action twice. The lock is released once the transaction is confirmed,
+ * failed, or provably expired (its blockhash can no longer land).
+ */
+
+import type { AutomatonDatabase } from "../types.js";
+import type {
+  SolanaTradingService,
+  SolanaTransactionUncertainError,
+  TransactionOutcome,
+} from "./trading.js";
+
+export const PENDING_TX_KEY = "solana.pending_swap_signature";
+
+export interface PendingTransaction {
+  signature: string;
+  recentBlockhash: string | null;
+  submittedAt: number;
+  kind: string;
+  /** Free-form details used to journal the transaction once confirmed. */
+  details?: Record<string, unknown>;
+}
+
+export function readPendingTransaction(db: AutomatonDatabase): PendingTransaction | null {
+  const raw = db.getKV(PENDING_TX_KEY);
+  if (!raw) return null;
+
+  try {
+    const parsed = JSON.parse(raw) as Partial<PendingTransaction>;
+    if (parsed && typeof parsed.signature === "string") {
+      return {
+        signature: parsed.signature,
+        recentBlockhash: typeof parsed.recentBlockhash === "string" ? parsed.recentBlockhash : null,
+        submittedAt: typeof parsed.submittedAt === "number" ? parsed.submittedAt : Date.now(),
+        kind: typeof parsed.kind === "string" ? parsed.kind : "swap",
+        details: parsed.details && typeof parsed.details === "object" ? parsed.details : undefined,
+      };
+    }
+  } catch {
+    // Legacy format: the key held the bare signature string.
+  }
+
+  // Legacy value: start the expiry clock now and persist the structured form.
+  const legacy: PendingTransaction = {
+    signature: raw,
+    recentBlockhash: null,
+    submittedAt: Date.now(),
+    kind: "swap",
+  };
+  db.setKV(PENDING_TX_KEY, JSON.stringify(legacy));
+  return legacy;
+}
+
+export function recordPendingTransaction(
+  db: AutomatonDatabase,
+  error: SolanaTransactionUncertainError,
+  kind: string,
+  details?: Record<string, unknown>,
+): void {
+  const pending: PendingTransaction = {
+    signature: error.signature,
+    recentBlockhash: error.recentBlockhash,
+    submittedAt: Date.now(),
+    kind,
+    details,
+  };
+  db.setKV(PENDING_TX_KEY, JSON.stringify(pending));
+}
+
+export type PendingCheck =
+  | { blocked: false; resolved?: { pending: PendingTransaction; outcome: TransactionOutcome } }
+  | { blocked: true; response: string };
+
+/**
+ * Resolve the pending transaction, if any. Returns a blocking JSON response
+ * while it is still unresolved, otherwise clears the lock.
+ */
+export async function checkPendingTransaction(
+  db: AutomatonDatabase,
+  service: SolanaTradingService,
+): Promise<PendingCheck> {
+  const pending = readPendingTransaction(db);
+  if (!pending) return { blocked: false };
+
+  let outcome: TransactionOutcome;
+  try {
+    outcome = await service.getTransactionOutcome(pending.signature, {
+      recentBlockhash: pending.recentBlockhash,
+      submittedAt: pending.submittedAt,
+    });
+  } catch {
+    return {
+      blocked: true,
+      response: JSON.stringify({
+        success: false,
+        blocked: true,
+        reason: "PREVIOUS_TRANSACTION_RPC_STATUS_UNKNOWN",
+        signature: pending.signature,
+        message:
+          "The previous transaction was broadcast, but its status cannot currently be verified. No new transaction is allowed.",
+      }),
+    };
+  }
+
+  if (outcome.state === "pending") {
+    return {
+      blocked: true,
+      response: JSON.stringify({
+        success: false,
+        blocked: true,
+        reason: "PREVIOUS_TRANSACTION_OUTCOME_UNCERTAIN",
+        signature: pending.signature,
+        message:
+          "The previous transaction is still unresolved on-chain. No new transaction is allowed until it confirms, fails or expires.",
+      }),
+    };
+  }
+
+  db.deleteKV(PENDING_TX_KEY);
+  return { blocked: false, resolved: { pending, outcome } };
+}
