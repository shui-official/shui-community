diff --git a/src/__tests__/solana/ledger-lifespan.test.ts b/src/__tests__/solana/ledger-lifespan.test.ts
new file mode 100644
index 0000000..c890c56
--- /dev/null
+++ b/src/__tests__/solana/ledger-lifespan.test.ts
@@ -0,0 +1,173 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import type BetterSqlite3 from "better-sqlite3";
+import { createInMemoryDb } from "../orchestration/test-db.js";
+import {
+  getDailyGain,
+  recordIncoming,
+  recordSwap,
+  recordTransferOut,
+  scanWalletHistory,
+  type WalletTransactionDelta,
+} from "../../solana/ledger.js";
+import {
+  checkLifeEnd,
+  classifyGain,
+  evaluateCompletedDays,
+  formatLifespanLine,
+  getLifespanStatus,
+  isLifeEnded,
+} from "../../survival/lifespan.js";
+import { SOL_MINT, USDC_MINT } from "../../solana/raydium.js";
+
+const TOKEN = "TokenMint1111111111111111111111111111111111";
+const CREATOR = "Creator11111111111111111111111111111111111";
+const CUSTOMER = "Customer1111111111111111111111111111111111";
+const day = (d: string, h = 12) => new Date(`${d}T${String(h).padStart(2, "0")}:00:00.000Z`);
+
+function incoming(sig: string, payer: string, opts: Partial<WalletTransactionDelta> = {}): WalletTransactionDelta {
+  return {
+    signature: sig, blockTime: Math.floor(day("2026-10-06").getTime() / 1000), failed: false,
+    signedByWallet: false, feePayer: payer, solLamportsDelta: 0n, feeLamports: 5000n, tokenDeltas: [], ...opts,
+  };
+}
+
+describe("ledger", () => {
+  let db: BetterSqlite3.Database;
+  beforeEach(() => { db = createInMemoryDb(); });
+  afterEach(() => { db.close(); });
+
+  it("realizes profit only when a tracked position is sold into USDC", () => {
+    // Buy 1000 tokens for 10 USDC (no profit realized on a buy).
+    recordSwap(db, { signature: "buy", at: day("2026-10-06"), inputMint: USDC_MINT, inputAmountRaw: 10_000_000n, outputMint: TOKEN, outputAmountRaw: 1000n });
+    // Sell half for 8 USDC: cost 5 -> +3 realized.
+    const sell = recordSwap(db, { signature: "sell", at: day("2026-10-06"), inputMint: TOKEN, inputAmountRaw: 500n, outputMint: USDC_MINT, outputAmountRaw: 8_000_000n });
+    expect(sell!.realizedPnlUsd).toBeCloseTo(3);
+    // Sell the rest for 4 USDC: cost 5 -> -1 realized.
+    const sell2 = recordSwap(db, { signature: "sell2", at: day("2026-10-06"), inputMint: TOKEN, inputAmountRaw: 500n, outputMint: USDC_MINT, outputAmountRaw: 4_000_000n });
+    expect(sell2!.realizedPnlUsd).toBeCloseTo(-1);
+    expect(getDailyGain(db, "2026-10-06").gainUsd).toBeCloseTo(2);
+  });
+
+  it("does not count units held before the ledger as profit", () => {
+    // Selling pre-existing SOL into USDC realizes nothing (no recorded cost).
+    const entry = recordSwap(db, { signature: "s", at: day("2026-10-06"), inputMint: SOL_MINT, inputAmountRaw: 50_000_000n, outputMint: USDC_MINT, outputAmountRaw: 6_000_000n });
+    expect(entry!.realizedPnlUsd).toBe(0);
+  });
+
+  it("carries SOL market value into a token bought with pre-existing SOL", () => {
+    recordSwap(db, { signature: "b", at: day("2026-10-06"), inputMint: SOL_MINT, inputAmountRaw: 100_000_000n, outputMint: TOKEN, outputAmountRaw: 100n, inputValueUsd: 12 });
+    const s = recordSwap(db, { signature: "s", at: day("2026-10-06"), inputMint: TOKEN, inputAmountRaw: 100n, outputMint: USDC_MINT, outputAmountRaw: 15_000_000n });
+    expect(s!.realizedPnlUsd).toBeCloseTo(3);
+  });
+
+  it("counts payments from others as revenue, not creator deposits", () => {
+    const usdcIn = (sig: string, payer: string, raw: bigint) => incoming(sig, payer, { tokenDeltas: [{ mint: USDC_MINT, deltaRaw: raw, decimals: 6 }] });
+    expect(recordIncoming(db, usdcIn("r1", CUSTOMER, 25_000_000n), { creatorAddress: CREATOR, solPriceUsd: 120 })!.revenueUsd).toBe(25);
+    const dep = recordIncoming(db, usdcIn("d1", CREATOR, 50_000_000n), { creatorAddress: CREATOR, solPriceUsd: 120 })!;
+    expect(dep.kind).toBe("creator_deposit");
+    expect(dep.revenueUsd).toBe(0);
+    const sol = recordIncoming(db, incoming("r2", CUSTOMER, { solLamportsDelta: 500_000_000n }), { creatorAddress: CREATOR, solPriceUsd: 120 })!;
+    expect(sol.revenueUsd).toBeCloseTo(60);
+    // SOL revenue without a price is flagged incomplete (day becomes unknown).
+    const unpriced = recordIncoming(db, incoming("r3", CUSTOMER, { solLamportsDelta: 1_000_000n }), { creatorAddress: CREATOR, solPriceUsd: null })!;
+    expect(unpriced.incomplete).toBe(true);
+    // SHUI-signed and failed transactions are never revenue.
+    expect(recordIncoming(db, incoming("own", "SHUI", { signedByWallet: true, solLamportsDelta: 1n }), { creatorAddress: CREATOR, solPriceUsd: 1 })!.kind).toBe("own_unjournaled");
+    expect(recordIncoming(db, incoming("f", CUSTOMER, { failed: true, solLamportsDelta: 1n }), { creatorAddress: CREATOR, solPriceUsd: 1 })).toBeNull();
+  });
+
+  it("journals transfers out without deducting them from the gain", () => {
+    recordTransferOut(db, { signature: "t", at: day("2026-10-06"), mint: USDC_MINT, amountRaw: 5_000_000n, recipient: CUSTOMER });
+    expect(getDailyGain(db, "2026-10-06").gainUsd).toBe(0);
+  });
+
+  it("scans history oldest first, skips journaled transactions and moves the cursor", async () => {
+    const deltas: Record<string, WalletTransactionDelta> = {
+      a: incoming("a", CUSTOMER, { tokenDeltas: [{ mint: USDC_MINT, deltaRaw: 1_000_000n, decimals: 6 }] }),
+      b: incoming("b", CUSTOMER, { tokenDeltas: [{ mint: USDC_MINT, deltaRaw: 2_000_000n, decimals: 6 }] }),
+    };
+    const source = {
+      getLatestSignature: async () => "start",
+      getSignaturesSince: async (until: string | null) => (until === "start"
+        ? [{ signature: "b", failed: false, blockTime: 1 }, { signature: "a", failed: false, blockTime: 1 }]
+        : []),
+      getWalletDelta: async (sig: string) => deltas[sig] ?? null,
+    };
+    await scanWalletHistory(db, source, { creatorAddress: CREATOR, solPriceUsd: 100 }); // sets cursor only
+    const result = await scanWalletHistory(db, source, { creatorAddress: CREATOR, solPriceUsd: 100 });
+    expect(result.created.map((e) => e.signature)).toEqual(["a", "b"]);
+    expect(getDailyGain(db, "2026-10-06").revenueUsd).toBeCloseTo(3);
+    const again = await scanWalletHistory(db, source, { creatorAddress: CREATOR, solPriceUsd: 100 });
+    expect(again.processed).toBe(0);
+  });
+});
+
+describe("lifespan", () => {
+  let db: BetterSqlite3.Database;
+  beforeEach(() => {
+    db = createInMemoryDb();
+    db.prepare("INSERT INTO identity (key, value) VALUES ('createdAt', '2026-10-02T17:11:16.959Z')").run();
+  });
+  afterEach(() => { db.close(); });
+
+  const setScanOk = (iso: string) =>
+    db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES ('ledger.scan_last_ok', ?, datetime('now'))").run(iso);
+
+  it("classifies the daily gain against the 100 / 500 USD thresholds", () => {
+    expect(classifyGain(0)).toEqual({ status: "penalty", adjustment: -1 });
+    expect(classifyGain(99.99).adjustment).toBe(-1);
+    expect(classifyGain(100).adjustment).toBe(0);
+    expect(classifyGain(500).adjustment).toBe(0);
+    expect(classifyGain(500.01)).toEqual({ status: "bonus", adjustment: 1 });
+  });
+
+  it("starts with 90 days from birth and only evaluates days after deployment", () => {
+    const status = getLifespanStatus(db, day("2026-10-06", 0))!;
+    expect(status.endsAt.slice(0, 10)).toBe("2026-12-31");
+    expect(evaluateCompletedDays(db, day("2026-10-06"))).toEqual([]); // first run sets start day
+    expect(evaluateCompletedDays(db, day("2026-10-06", 23))).toEqual([]); // day not over yet
+  });
+
+  it("applies a penalty, a bonus, or no adjustment once the day is verified", () => {
+    evaluateCompletedDays(db, day("2026-10-06"));
+    recordIncoming(db, incoming("big", CUSTOMER, { tokenDeltas: [{ mint: USDC_MINT, deltaRaw: 600_000_000n, decimals: 6 }], blockTime: Math.floor(day("2026-10-07").getTime() / 1000) }), { creatorAddress: CREATOR, solPriceUsd: 100 });
+    setScanOk("2026-10-08T00:05:00.000Z");
+    const days = evaluateCompletedDays(db, day("2026-10-08", 1));
+    expect(days.map((d) => [d.day, d.status, d.adjustment])).toEqual([
+      ["2026-10-06", "penalty", -1],
+      ["2026-10-07", "bonus", 1],
+    ]);
+    expect(getLifespanStatus(db)!.adjustmentDays).toBe(0);
+  });
+
+  it("never penalizes an unverifiable day", () => {
+    evaluateCompletedDays(db, day("2026-10-06"));
+    // No successful scan after the day ended: wait, then settle as unknown.
+    expect(evaluateCompletedDays(db, day("2026-10-07", 6))).toEqual([]);
+    const settled = evaluateCompletedDays(db, day("2026-10-09", 1));
+    expect(settled[0]).toMatchObject({ day: "2026-10-06", status: "unknown", adjustment: 0 });
+    // A day containing an unpriced entry is unknown too.
+    recordIncoming(db, incoming("x", CUSTOMER, { solLamportsDelta: 1_000n, blockTime: Math.floor(day("2026-10-09").getTime() / 1000) }), { creatorAddress: CREATOR, solPriceUsd: null });
+    setScanOk("2026-10-10T00:01:00.000Z");
+    const next = evaluateCompletedDays(db, day("2026-10-10", 1));
+    expect(next.find((d) => d.day === "2026-10-09")).toMatchObject({ status: "unknown", adjustment: 0 });
+  });
+
+  it("ends life at zero remaining time or at 1M verified value, and stays ended", () => {
+    expect(checkLifeEnd(db, 50, day("2026-10-06"))).toBeNull();
+    expect(checkLifeEnd(db, 1_000_000, day("2026-10-06"))!.reason).toBe("goal_reached");
+    expect(isLifeEnded(db)).toBe(true);
+    expect(formatLifespanLine(db)).toContain("ENDED");
+
+    const db2 = createInMemoryDb();
+    db2.prepare("INSERT INTO identity (key, value) VALUES ('createdAt', '2026-10-02T17:11:16.959Z')").run();
+    expect(checkLifeEnd(db2, null, new Date("2027-01-01T00:00:00Z"))!.reason).toBe("lifespan_expired");
+    db2.close();
+  });
+
+  it("shows remaining days and today's gain in SHUI's status line", () => {
+    const line = formatLifespanLine(db, day("2026-10-06"))!;
+    expect(line).toMatch(/Lifespan: \d+\.\d days remaining \(ends 2026-12-31/);
+    expect(line).toContain("Today's verified gain");
+  });
+});
diff --git a/src/__tests__/solana/trading-safety.test.ts b/src/__tests__/solana/trading-safety.test.ts
new file mode 100644
index 0000000..a74bfdf
--- /dev/null
+++ b/src/__tests__/solana/trading-safety.test.ts
@@ -0,0 +1,185 @@
+import { describe, expect, it, vi } from "vitest";
+import { Keypair, PublicKey, SystemProgram } from "@solana/web3.js";
+import bs58 from "bs58";
+import {
+  ASSOCIATED_TOKEN_PROGRAM_ID,
+  NATIVE_SOL_MINT,
+  SolanaTradingService,
+  SolanaTransactionUncertainError,
+  TOKEN_2022_PROGRAM_ID,
+  TOKEN_PROGRAM_ID,
+} from "../../solana/trading.js";
+import { checkPendingTransaction, readPendingTransaction, recordPendingTransaction, PENDING_TX_KEY } from "../../solana/pending-tx.js";
+import { fetchTokenUsdValuesFromRaydium, buildCentralWalletValuation } from "../../solana/wallet-valuation.js";
+import { USDC_MINT } from "../../solana/raydium.js";
+import type { AutomatonDatabase } from "../../types.js";
+
+const wallet = Keypair.generate().publicKey.toBase58();
+
+function serviceWith(connection: Record<string, unknown>): SolanaTradingService {
+  const service = new SolanaTradingService({ address: wallet, chainType: "solana" } as any, "http://127.0.0.1:1");
+  Object.defineProperty(service, "connection", { value: connection });
+  return service;
+}
+
+function memDb(): AutomatonDatabase {
+  const kv = new Map<string, string>();
+  return {
+    getKV: (k: string) => kv.get(k),
+    setKV: (k: string, v: string) => { kv.set(k, v); },
+    deleteKV: (k: string) => { kv.delete(k); },
+  } as unknown as AutomatonDatabase;
+}
+
+const fakeTx = () => ({
+  signatures: [new Uint8Array(64).fill(7)],
+  message: { recentBlockhash: "Blockhash111" },
+  serialize: () => new Uint8Array([1, 2, 3]),
+}) as any;
+
+describe("transaction outcome", () => {
+  it("reports a dropped transaction as expired once its blockhash is no longer valid", async () => {
+    const service = serviceWith({
+      getSignatureStatuses: vi.fn().mockResolvedValue({ value: [null] }),
+      isBlockhashValid: vi.fn().mockResolvedValue({ value: false }),
+    });
+    await expect(service.getTransactionOutcome("sig", { recentBlockhash: "bh" })).resolves.toEqual({ state: "expired" });
+  });
+
+  it("keeps waiting while the blockhash is still valid", async () => {
+    const service = serviceWith({
+      getSignatureStatuses: vi.fn().mockResolvedValue({ value: [null] }),
+      isBlockhashValid: vi.fn().mockResolvedValue({ value: true }),
+    });
+    await expect(service.getTransactionOutcome("sig", { recentBlockhash: "bh" })).resolves.toEqual({ state: "pending" });
+  });
+
+  it("expires legacy pending signatures (no blockhash) after the time limit", async () => {
+    const service = serviceWith({ getSignatureStatuses: vi.fn().mockResolvedValue({ value: [null] }) });
+    await expect(service.getTransactionOutcome("sig", { submittedAt: Date.now() - 11 * 60_000 })).resolves.toEqual({ state: "expired" });
+    await expect(service.getTransactionOutcome("sig", { submittedAt: Date.now() })).resolves.toEqual({ state: "pending" });
+  });
+});
+
+describe("broadcast safety", () => {
+  it("treats polling errors after broadcast as uncertain (never a plain failure)", async () => {
+    const service = serviceWith({
+      sendRawTransaction: vi.fn().mockResolvedValue("ignored"),
+      getSignatureStatuses: vi.fn().mockRejectedValue(new Error("429 Too Many Requests")),
+    });
+    const error = await service.broadcastAndConfirm(fakeTx(), 10).catch((e) => e);
+    expect(error).toBeInstanceOf(SolanaTransactionUncertainError);
+    expect(error.signature).toBe(bs58.encode(new Uint8Array(64).fill(7)));
+    expect(error.recentBlockhash).toBe("Blockhash111");
+  });
+
+  it("treats a network error while sending as uncertain", async () => {
+    const service = serviceWith({ sendRawTransaction: vi.fn().mockRejectedValue(new Error("fetch failed")) });
+    await expect(service.broadcastAndConfirm(fakeTx(), 10)).rejects.toBeInstanceOf(SolanaTransactionUncertainError);
+  });
+
+  it("treats a preflight rejection as not sent", async () => {
+    const rejection = Object.assign(new Error("Transaction simulation failed: insufficient funds"), { logs: ["Program log: x"] });
+    const service = serviceWith({ sendRawTransaction: vi.fn().mockRejectedValue(rejection) });
+    const error = await service.broadcastAndConfirm(fakeTx(), 10).catch((e) => e);
+    expect(error).not.toBeInstanceOf(SolanaTransactionUncertainError);
+  });
+});
+
+describe("pending transaction lock", () => {
+  it("blocks while unresolved and releases once expired", async () => {
+    const db = memDb();
+    recordPendingTransaction(db, new SolanaTransactionUncertainError("sig1", "bh"), "swap");
+    const blocked = await checkPendingTransaction(db, serviceWith({
+      getSignatureStatuses: vi.fn().mockResolvedValue({ value: [null] }),
+      isBlockhashValid: vi.fn().mockResolvedValue({ value: true }),
+    }));
+    expect(blocked.blocked).toBe(true);
+
+    const released = await checkPendingTransaction(db, serviceWith({
+      getSignatureStatuses: vi.fn().mockResolvedValue({ value: [null] }),
+      isBlockhashValid: vi.fn().mockResolvedValue({ value: false }),
+    }));
+    expect(released).toMatchObject({ blocked: false, resolved: { outcome: { state: "expired" } } });
+    expect(db.getKV(PENDING_TX_KEY)).toBeUndefined();
+  });
+
+  it("upgrades a legacy bare-signature value", () => {
+    const db = memDb();
+    db.setKV(PENDING_TX_KEY, "legacySig");
+    const pending = readPendingTransaction(db)!;
+    expect(pending.signature).toBe("legacySig");
+    expect(JSON.parse(db.getKV(PENDING_TX_KEY)!).signature).toBe("legacySig");
+  });
+});
+
+describe("balances and transfers", () => {
+  it("reads token balances from both the classic and Token-2022 programs", async () => {
+    const account = (mint: string, amount: string) => ({ account: { data: { parsed: { info: { mint, tokenAmount: { amount, decimals: 6, uiAmount: Number(amount) / 1e6 } } } } } });
+    const getParsedTokenAccountsByOwner = vi.fn(async (_owner: PublicKey, filter: { programId: PublicKey }) => ({
+      value: filter.programId.equals(TOKEN_PROGRAM_ID) ? [account("classic", "1")] : [account("t22", "2")],
+    }));
+    const service = serviceWith({ getParsedTokenAccountsByOwner });
+    const tokens = await service.getTokenBalances();
+    expect(tokens.map((t) => t.mint).sort()).toEqual(["classic", "t22"]);
+    expect(getParsedTokenAccountsByOwner.mock.calls.map((c) => c[1].programId.toBase58()).sort())
+      .toEqual([TOKEN_PROGRAM_ID.toBase58(), TOKEN_2022_PROGRAM_ID.toBase58()].sort());
+  });
+
+  it("builds a native SOL transfer", async () => {
+    const recipient = Keypair.generate().publicKey.toBase58();
+    const service = serviceWith({ getLatestBlockhash: vi.fn().mockResolvedValue({ blockhash: Keypair.generate().publicKey.toBase58() }) });
+    const { transaction } = await service.buildTransferTransaction({ recipient, mint: NATIVE_SOL_MINT, amountRaw: 1234n });
+    const keys = transaction.message.staticAccountKeys.map((k) => k.toBase58());
+    expect(keys[0]).toBe(wallet);
+    expect(keys).toContain(SystemProgram.programId.toBase58());
+    expect(keys).toContain(recipient);
+  });
+
+  it("builds an SPL transferChecked with idempotent recipient account creation", async () => {
+    const recipient = Keypair.generate().publicKey.toBase58();
+    const service = serviceWith({
+      getParsedAccountInfo: vi.fn().mockResolvedValue({ value: { owner: TOKEN_PROGRAM_ID, data: { parsed: { info: { decimals: 6 } } } } }),
+      getLatestBlockhash: vi.fn().mockResolvedValue({ blockhash: Keypair.generate().publicKey.toBase58() }),
+    });
+    const { transaction, decimals } = await service.buildTransferTransaction({ recipient, mint: USDC_MINT, amountRaw: 5_000_000n });
+    expect(decimals).toBe(6);
+    const ixs = transaction.message.compiledInstructions;
+    const programOf = (i: number) => transaction.message.staticAccountKeys[ixs[i].programIdIndex].toBase58();
+    expect(programOf(0)).toBe(ASSOCIATED_TOKEN_PROGRAM_ID.toBase58());
+    expect(Buffer.from(ixs[0].data)).toEqual(Buffer.from([1]));
+    expect(programOf(1)).toBe(TOKEN_PROGRAM_ID.toBase58());
+    const data = Buffer.from(ixs[1].data);
+    expect(data[0]).toBe(12);
+    expect(data.readBigUInt64LE(1)).toBe(5_000_000n);
+    expect(data[9]).toBe(6);
+  });
+
+  it("refuses unknown mints and self-transfers", async () => {
+    const service = serviceWith({ getParsedAccountInfo: vi.fn().mockResolvedValue({ value: null }) });
+    await expect(service.buildTransferTransaction({ recipient: Keypair.generate().publicKey.toBase58(), mint: Keypair.generate().publicKey.toBase58(), amountRaw: 1n })).rejects.toThrow(/unsupported token mint/);
+    await expect(service.buildTransferTransaction({ recipient: wallet, mint: NATIVE_SOL_MINT, amountRaw: 1n })).rejects.toThrow(/itself/);
+  });
+});
+
+describe("token valuation", () => {
+  it("prices other tokens by quoting the whole position into USDC, leaving failures unpriced", async () => {
+    const quoteService = {
+      getQuote: vi.fn(async (req: { inputMint: string; amount: bigint }) => {
+        if (req.inputMint === "bad") throw new Error("no route");
+        return { success: true, raw: { success: true, data: { inputMint: req.inputMint, outputMint: USDC_MINT, inputAmount: req.amount.toString(), outputAmount: "7500000", otherAmountThreshold: "7400000", slippageBps: 100, routePlan: [] } } };
+      }),
+    };
+    const tokens = [
+      { mint: "good", amount: 100, amountRaw: "100000000", decimals: 6 },
+      { mint: "bad", amount: 5, amountRaw: "5000000", decimals: 6 },
+    ];
+    const values = await fetchTokenUsdValuesFromRaydium(quoteService, tokens);
+    expect(values.get("good")).toBeCloseTo(7.5);
+    expect(values.has("bad")).toBe(false);
+
+    const valuation = buildCentralWalletValuation({ balances: { sol: 0, usdc: 10, tokens }, solPriceUsd: 100, tokenValuesUsd: values });
+    expect(valuation.knownValueUsd).toBeCloseTo(17.5);
+    expect(valuation.complete).toBe(false); // "bad" stays unpriced, never zero
+  });
+});
diff --git a/src/agent/loop.ts b/src/agent/loop.ts
index f731375..82a12f7 100644
--- a/src/agent/loop.ts
+++ b/src/agent/loop.ts
@@ -43,9 +43,18 @@ import { RaydiumQuoteService } from "../solana/raydium.js";
 import {
   readCentralWalletBalances,
   fetchSolUsdPriceFromRaydium,
+  fetchTokenUsdValuesFromRaydium,
   buildCentralWalletValuation,
 } from "../solana/wallet-valuation.js";
 import type { ChainIdentity } from "../identity/chain.js";
+import { scanWalletHistory, getDailyGain, utcDay } from "../solana/ledger.js";
+import {
+  checkLifeEnd,
+  evaluateCompletedDays,
+  getLifespanStatus,
+  isLifeEnded,
+  listLifespanDays,
+} from "../survival/lifespan.js";
 import {
   claimInboxMessages,
   markInboxProcessed,
@@ -92,6 +101,70 @@ let persistentLocalWorkerPool: LocalWorkerPool | undefined;
 let persistentOrchestrator: Orchestrator | undefined;
 let backgroundTickInFlight = false;
 
+const LIFESPAN_TICK_INTERVAL_MS = 10 * 60_000;
+let lastLifespanTickAt = 0;
+let lifespanTickInFlight = false;
+
+/**
+ * Lifespan rule (genesis) in code: refresh the verified financial journal from
+ * on-chain history, evaluate completed UTC days, and detect the end of life
+ * (no time left, or verified wallet value >= 1M USD). Network failures leave
+ * days unevaluated; they never cause a penalty. Throttled unless forced.
+ */
+export async function runLifespanTick(params: {
+  db: AutomatonDatabase;
+  identity: AutomatonIdentity;
+  config: AutomatonConfig;
+  verifiedWalletValueUsd?: number | null;
+  force?: boolean;
+}): Promise<{ ended: ReturnType<typeof checkLifeEnd>; evaluated: number }> {
+  const raw = params.db.raw;
+  if (isLifeEnded(raw)) {
+    return { ended: checkLifeEnd(raw, null), evaluated: 0 };
+  }
+  if (lifespanTickInFlight || (!params.force && Date.now() - lastLifespanTickAt < LIFESPAN_TICK_INTERVAL_MS)) {
+    return { ended: null, evaluated: 0 };
+  }
+
+  lifespanTickInFlight = true;
+  lastLifespanTickAt = Date.now();
+  try {
+    const chainIdentity = params.identity.chainIdentity;
+    if (params.identity.chainType === "solana" && chainIdentity?.chainType === "solana") {
+      try {
+        const service = new SolanaTradingService(chainIdentity);
+        const solPriceUsd = await fetchSolUsdPriceFromRaydium(new RaydiumQuoteService());
+        await scanWalletHistory(raw, service, {
+          creatorAddress: params.config.creatorAddress ?? null,
+          solPriceUsd,
+        });
