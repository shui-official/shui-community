+/**
+ * Central-wallet tools: send SOL / SPL tokens and read the financial ledger.
+ *
+ * solana_transfer follows the same safety pipeline as raydium_swap: lock on
+ * unresolved transactions, confirmed on-chain balance check, simulation,
+ * local signing, confirmation, journal. It has no amount limit.
+ */
+
+import { PublicKey } from "@solana/web3.js";
+import type { AutomatonTool, ToolContext } from "../types.js";
+import {
+  NATIVE_SOL_MINT,
+  SOL_FEE_RESERVE_LAMPORTS,
+  SolanaTradingService,
+  SolanaTransactionUncertainError,
+} from "./trading.js";
+import { checkPendingTransaction, recordPendingTransaction } from "./pending-tx.js";
+import { journalResolvedPending } from "./journal.js";
+import {
