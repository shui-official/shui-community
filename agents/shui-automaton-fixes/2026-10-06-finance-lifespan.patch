+    },
+    execute: async (args, ctx) => {
+      const service = solanaService(ctx);
+      if (!service) return "Blocked: active Solana chain identity is unavailable.";
+      const limit = Math.max(1, Math.min(50, Number(args.limit ?? 15) || 15));
+
+      let scanNote = "history refreshed";
+      try {
+        const solPriceUsd = await fetchSolUsdPriceFromRaydium(new RaydiumQuoteService());
+        await scanWalletHistory(ctx.db.raw, service, {
+          creatorAddress: ctx.config.creatorAddress ?? null,
+          solPriceUsd,
+        });
+      } catch (error) {
+        scanNote = `history refresh failed (${error instanceof Error ? error.message : String(error)}); showing journal as last verified`;
+      }
+
+      const today = getDailyGain(ctx.db.raw, utcDay(new Date()));
+      const entries = listLedgerEntries(ctx.db.raw, limit);
+      const lines = [
+        `Central wallet: ${service.address}`,
+        `Journal: ${scanNote} (last successful scan: ${getLastSuccessfulScan(ctx.db.raw) ?? "never"})`,
+        `Today (${today.day} UTC): revenue $${today.revenueUsd.toFixed(2)} + realized profit $${today.realizedPnlUsd.toFixed(2)} = gain $${today.gainUsd.toFixed(2)}${today.incompleteEntries > 0 ? ` (${today.incompleteEntries} entr${today.incompleteEntries > 1 ? "ies" : "y"} not fully priced)` : ""}`,
+        "",
+        entries.length === 0 ? "No journal entries yet." : "Recent entries (newest first):",
+        ...entries.map((entry) => {
+          const parts = [`${entry.ts} ${entry.kind}`];
+          if (entry.inputMint) parts.push(`in ${entry.inputAmountRaw} ${entry.inputMint}`);
+          if (entry.outputMint) parts.push(`out ${entry.outputAmountRaw} ${entry.outputMint}`);
+          if (entry.revenueUsd) parts.push(`revenue $${entry.revenueUsd.toFixed(2)}`);
+          if (entry.realizedPnlUsd) parts.push(`realized $${entry.realizedPnlUsd.toFixed(2)}`);
+          if (entry.counterparty) parts.push(`counterparty ${entry.counterparty}`);
+          if (entry.incomplete) parts.push("(not fully priced)");
+          parts.push(`sig ${entry.signature}`);
+          return `- ${parts.join(" | ")}`;
+        }),
+      ];
+      return lines.join("\n");
+    },
+  };
+}
