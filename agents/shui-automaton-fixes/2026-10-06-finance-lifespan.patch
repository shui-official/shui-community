+    riskLevel: "dangerous",
+    parameters: {
+      type: "object",
+      properties: {
+        recipient: { type: "string", description: "Destination wallet address (base58)." },
+        mint: { type: "string", description: "Token mint, or the native SOL mint for SOL." },
+        amount: { type: "string", description: "Positive raw integer amount in smallest units." },
+        reason: { type: "string", description: "Why this payment is made (journaled)." },
+      },
+      required: ["recipient", "mint", "amount"],
+    },
+    execute: async (args, ctx) => {
+      const service = solanaService(ctx);
+      if (!service) return "Blocked: active Solana chain identity is unavailable.";
+
+      const recipient = String(args.recipient ?? "");
+      const mint = String(args.mint ?? "");
+      const amountString = String(args.amount ?? "");
+      const reason = typeof args.reason === "string" ? args.reason.slice(0, 300) : undefined;
+
+      if (!/^[1-9][0-9]*$/.test(amountString)) return "Blocked: amount must be a positive raw integer.";
+      try { new PublicKey(recipient); new PublicKey(mint); } catch { return "Blocked: invalid recipient or mint address."; }
+      if (recipient === service.address) return "Blocked: recipient is the central wallet itself.";
