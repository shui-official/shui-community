+/**
+ * SHUI lifespan rule (genesis), enforced in code.
+ *
+ * - 90 days of life counted from birth (identity createdAt).
+ * - Once per completed UTC day, the day's verified gain is evaluated:
+ *     gain = revenue received + realized trading profit (see solana/ledger.ts)
+ *     gain < 100 USD  -> one extra day is lost
+ *     gain > 500 USD  -> one day is gained
+ *     otherwise       -> no adjustment
+ * - Unknown data (RPC/API down, unpriced entry) never penalizes: the day is
+ *   recorded as "unknown" with no adjustment.
+ * - Life ends when remaining time reaches zero, or when the verified wallet
+ *   value reaches 1,000,000 USD: SHUI stops cleanly and preserves funds.
+ *
+ * Days before this code was deployed are not evaluated (no ledger existed).
+ */
+
+import type { Database } from "better-sqlite3";
+import { getDailyGain, getLastSuccessfulScan, utcDay } from "../solana/ledger.js";
+
+export const LIFESPAN_DAYS = 90;
+export const PENALTY_BELOW_USD = 100;
+export const BONUS_ABOVE_USD = 500;
+export const STOP_AT_VALUE_USD = 1_000_000;
+const DAY_MS = 86_400_000;
+/** After this long without a successful history scan covering a day, the
+ *  day is settled as unknown (no adjustment) instead of waiting forever. */
+const UNKNOWN_AFTER_MS = 2 * DAY_MS;
+
+const START_DAY_KEY = "lifespan.start_day";
+const ENDED_KEY = "lifespan.ended";
+
+export type DayStatus = "penalty" | "bonus" | "neutral" | "unknown";
+
+export interface LifespanDay {
+  day: string;
+  status: DayStatus;
+  adjustment: number;
+  gainUsd: number | null;
+  revenueUsd: number | null;
+  realizedPnlUsd: number | null;
+  evaluatedAt: string;
+  note: string | null;
+}
+
+export interface LifespanStatus {
+  bornAt: string;
+  adjustmentDays: number;
+  endsAt: string;
+  remainingDays: number;
+  evaluatedDays: number;
+  ended: { reason: string; at: string; detail?: string } | null;
+}
+
+function ensureSchema(db: Database): void {
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS shui_lifespan_days (
+      day TEXT PRIMARY KEY,
+      status TEXT NOT NULL,
+      adjustment INTEGER NOT NULL,
+      gain_usd REAL,
+      revenue_usd REAL,
+      realized_pnl_usd REAL,
+      evaluated_at TEXT NOT NULL,
+      note TEXT
+    );
+  `);
+}
+
+function getKv(db: Database, key: string): string | null {
+  const row = db.prepare("SELECT value FROM kv WHERE key = ?").get(key) as { value: string } | undefined;
+  return row?.value ?? null;
+}
+
+function setKv(db: Database, key: string, value: string): void {
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(key, value);
+}
+
+export function resolveBornAt(db: Database): string | null {
+  const row = db.prepare("SELECT value FROM identity WHERE key = 'createdAt'").get() as { value: string } | undefined;
+  if (row?.value && !Number.isNaN(Date.parse(row.value))) return row.value;
+  return null;
+}
+
+export function getLifespanStatus(db: Database, now: Date = new Date()): LifespanStatus | null {
+  ensureSchema(db);
+  const bornAt = resolveBornAt(db);
+  if (!bornAt) return null;
+
+  const adj = db.prepare("SELECT COALESCE(SUM(adjustment), 0) AS total, COUNT(*) AS days FROM shui_lifespan_days")
+    .get() as { total: number; days: number };
+  const endsAtMs = Date.parse(bornAt) + (LIFESPAN_DAYS + adj.total) * DAY_MS;
+  const endedRaw = getKv(db, ENDED_KEY);
+
+  return {
+    bornAt,
+    adjustmentDays: adj.total,
+    endsAt: new Date(endsAtMs).toISOString(),
+    remainingDays: Math.max(0, (endsAtMs - now.getTime()) / DAY_MS),
+    evaluatedDays: adj.days,
+    ended: endedRaw ? JSON.parse(endedRaw) : null,
+  };
+}
+
+export function listLifespanDays(db: Database, limit = 14): LifespanDay[] {
+  ensureSchema(db);
+  const rows = db.prepare("SELECT * FROM shui_lifespan_days ORDER BY day DESC LIMIT ?").all(limit) as Array<Record<string, unknown>>;
+  return rows.map((row) => ({
+    day: String(row.day),
+    status: row.status as DayStatus,
+    adjustment: Number(row.adjustment),
+    gainUsd: row.gain_usd === null ? null : Number(row.gain_usd),
+    revenueUsd: row.revenue_usd === null ? null : Number(row.revenue_usd),
+    realizedPnlUsd: row.realized_pnl_usd === null ? null : Number(row.realized_pnl_usd),
+    evaluatedAt: String(row.evaluated_at),
+    note: (row.note as string | null) ?? null,
+  }));
+}
+
+function addDays(day: string, n: number): string {
+  return utcDay(new Date(Date.parse(`${day}T00:00:00.000Z`) + n * DAY_MS));
+}
+
+export function classifyGain(gainUsd: number): { status: DayStatus; adjustment: number } {
+  if (gainUsd < PENALTY_BELOW_USD) return { status: "penalty", adjustment: -1 };
+  if (gainUsd > BONUS_ABOVE_USD) return { status: "bonus", adjustment: 1 };
+  return { status: "neutral", adjustment: 0 };
+}
+
+/**
+ * Evaluate every completed UTC day not yet evaluated. A day is evaluated
+ * once the wallet history scan has succeeded after the day ended; if that
+ * does not happen within UNKNOWN_AFTER_MS, the day is settled as unknown.
+ */
+export function evaluateCompletedDays(db: Database, now: Date = new Date()): LifespanDay[] {
+  ensureSchema(db);
+  const today = utcDay(now);
+  let startDay = getKv(db, START_DAY_KEY);
+  if (!startDay) {
+    // First run: start evaluating with today (no ledger existed before).
+    setKv(db, START_DAY_KEY, today);
+    return [];
+  }
+
+  const lastScan = getLastSuccessfulScan(db);
+  const lastScanMs = lastScan ? Date.parse(lastScan) : 0;
+  const evaluated: LifespanDay[] = [];
+  const exists = db.prepare("SELECT 1 FROM shui_lifespan_days WHERE day = ?");
+  const insert = db.prepare(
+    `INSERT OR IGNORE INTO shui_lifespan_days
+     (day, status, adjustment, gain_usd, revenue_usd, realized_pnl_usd, evaluated_at, note)
+     VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
+  );
+
+  for (let day = startDay; day < today; day = addDays(day, 1)) {
+    if (exists.get(day)) continue;
+    const dayEndMs = Date.parse(`${addDays(day, 1)}T00:00:00.000Z`);
+    let record: LifespanDay;
+
+    if (lastScanMs >= dayEndMs) {
+      const gain = getDailyGain(db, day);
+      if (gain.incompleteEntries > 0) {
+        record = {
+          day, status: "unknown", adjustment: 0,
+          gainUsd: null, revenueUsd: gain.revenueUsd, realizedPnlUsd: gain.realizedPnlUsd,
+          evaluatedAt: now.toISOString(),
+          note: `${gain.incompleteEntries} journal entr${gain.incompleteEntries > 1 ? "ies" : "y"} could not be priced; no penalty`,
+        };
+      } else {
+        const { status, adjustment } = classifyGain(gain.gainUsd);
+        record = {
+          day, status, adjustment,
+          gainUsd: gain.gainUsd, revenueUsd: gain.revenueUsd, realizedPnlUsd: gain.realizedPnlUsd,
+          evaluatedAt: now.toISOString(), note: null,
+        };
+      }
+    } else if (now.getTime() - dayEndMs >= UNKNOWN_AFTER_MS) {
+      record = {
+        day, status: "unknown", adjustment: 0,
+        gainUsd: null, revenueUsd: null, realizedPnlUsd: null,
+        evaluatedAt: now.toISOString(),
+        note: "wallet history could not be verified for this day; no penalty",
+      };
+    } else {
+      break; // wait for a successful scan covering this day
+    }
+
+    insert.run(record.day, record.status, record.adjustment, record.gainUsd,
+      record.revenueUsd, record.realizedPnlUsd, record.evaluatedAt, record.note);
+    evaluated.push(record);
+  }
+
+  return evaluated;
+}
+
+/**
+ * Decide whether life has ended. Persists the end so it cannot be undone by
+ * a restart. `verifiedWalletValueUsd` must come from a fresh, complete
+ * valuation (pass null otherwise).
+ */
+export function checkLifeEnd(
+  db: Database,
+  verifiedWalletValueUsd: number | null,
+  now: Date = new Date(),
+): LifespanStatus["ended"] {
+  const status = getLifespanStatus(db, now);
+  if (!status) return null;
+  if (status.ended) return status.ended;
+
+  let ended: NonNullable<LifespanStatus["ended"]> | null = null;
+  if (verifiedWalletValueUsd !== null && verifiedWalletValueUsd >= STOP_AT_VALUE_USD) {
+    ended = {
+      reason: "goal_reached",
+      at: now.toISOString(),
+      detail: `Verified wallet value $${verifiedWalletValueUsd.toFixed(2)} reached $${STOP_AT_VALUE_USD}`,
+    };
+  } else if (Date.parse(status.endsAt) <= now.getTime()) {
+    ended = {
+      reason: "lifespan_expired",
+      at: now.toISOString(),
+      detail: `Lifespan ended at ${status.endsAt} (adjustments: ${status.adjustmentDays} days)`,
+    };
+  }
+
+  if (ended) setKv(db, ENDED_KEY, JSON.stringify(ended));
+  return ended;
+}
+
+export function isLifeEnded(db: Database): boolean {
+  return getKv(db, ENDED_KEY) !== null;
+}
+
+/** One-line summary for SHUI's status block. */
+export function formatLifespanLine(db: Database, now: Date = new Date()): string | null {
+  const status = getLifespanStatus(db, now);
+  if (!status) return null;
+  if (status.ended) return `Lifespan: ENDED (${status.ended.reason}) — ${status.ended.detail ?? ""}`;
+  const today = getDailyGain(db, utcDay(now));
+  return (
+    `Lifespan: ${status.remainingDays.toFixed(1)} days remaining (ends ${status.endsAt.slice(0, 10)}, ` +
+    `adjustments ${status.adjustmentDays >= 0 ? "+" : ""}${status.adjustmentDays} days)\n` +
+    `Today's verified gain (UTC): $${today.gainUsd.toFixed(2)} = revenue $${today.revenueUsd.toFixed(2)} + realized profit $${today.realizedPnlUsd.toFixed(2)} ` +
+    `(below $${PENALTY_BELOW_USD}: -1 extra day; above $${BONUS_ABOVE_USD}: +1 day)`
+  );
+}
