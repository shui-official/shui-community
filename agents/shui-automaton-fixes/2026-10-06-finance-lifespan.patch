new file mode 100644
index 0000000..8a46bdf
--- /dev/null
+++ b/src/solana/journal.ts
@@ -0,0 +1,134 @@
+/**
+ * Glue between confirmed on-chain actions and the financial ledger.
+ *
+ * Journaling never throws: the transaction already happened, so a journaling
+ * problem is reported in the result instead of being mistaken for a failed
+ * trade.
+ */
+
+import type { AutomatonDatabase } from "../types.js";
+import { createLogger } from "../observability/logger.js";
+import { RaydiumQuoteService, USDC_MINT } from "./raydium.js";
+import { recordSwap, recordTransferOut, rawToUi } from "./ledger.js";
+import type { PendingTransaction } from "./pending-tx.js";
+import type { SolanaTradingService, TransactionOutcome } from "./trading.js";
+import { NATIVE_SOL_MINT } from "./trading.js";
+import { fetchSolUsdPriceFromRaydium } from "./wallet-valuation.js";
+
+const logger = createLogger("solana.journal");
+
+async function readDeltaWithRetry(service: SolanaTradingService, signature: string) {
+  for (let attempt = 0; attempt < 3; attempt++) {
+    try {
+      const delta = await service.getWalletDelta(signature);
+      if (delta) return delta;
+    } catch {
+      // retry
+    }
+    await new Promise((resolve) => setTimeout(resolve, 1500 * (attempt + 1)));
+  }
+  return null;
+}
+
+export async function journalConfirmedSwap(
+  db: AutomatonDatabase,
+  service: SolanaTradingService,
+  params: {
+    signature: string;
+    inputMint: string;
+    outputMint: string;
+    inputAmount: bigint;
+    quotedOutputAmount: bigint;
+  },
+): Promise<{ realizedPnlUsd: number; outputAmountRaw: string; outputSource: string } | { error: string } | null> {
+  try {
+    // Prefer the amount actually received on-chain over the quote.
+    let outputAmountRaw = params.quotedOutputAmount;
+    let outputSource = "quote";
+    const delta = await readDeltaWithRetry(service, params.signature);
+    if (delta) {
+      if (params.outputMint === NATIVE_SOL_MINT) {
+        const received = delta.solLamportsDelta + delta.feeLamports;
+        if (received > 0n) {
+          outputAmountRaw = received;
+          outputSource = "onchain";
+        }
+      } else {
+        const token = delta.tokenDeltas.find((t) => t.mint === params.outputMint);
+        if (token && token.deltaRaw > 0n) {
+          outputAmountRaw = token.deltaRaw;
+          outputSource = "onchain";
+        }
+      }
+    }
+
+    let inputValueUsd: number | null = null;
+    if (params.inputMint === USDC_MINT) {
+      inputValueUsd = rawToUi(params.inputAmount, 6);
+    } else if (params.inputMint === NATIVE_SOL_MINT) {
+      const price = await fetchSolUsdPriceFromRaydium(new RaydiumQuoteService());
+      inputValueUsd = price === null ? null : rawToUi(params.inputAmount, 9) * price;
+    }
+
+    const entry = recordSwap(db.raw, {
+      signature: params.signature,
+      at: delta?.blockTime ? new Date(delta.blockTime * 1000) : new Date(),
+      inputMint: params.inputMint,
+      inputAmountRaw: params.inputAmount,
+      outputMint: params.outputMint,
+      outputAmountRaw,
+      inputValueUsd,
+      details: { outputSource },
+    });
+
+    return {
+      realizedPnlUsd: entry?.realizedPnlUsd ?? 0,
+      outputAmountRaw: outputAmountRaw.toString(),
+      outputSource,
+    };
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    logger.warn("Swap journaling failed", { signature: params.signature, error: message });
+    return { error: `journal failed: ${message}` };
+  }
+}
+
+/** Journal a previously uncertain transaction once it is known to be confirmed. */
+export async function journalResolvedPending(
+  db: AutomatonDatabase,
+  service: SolanaTradingService,
+  resolved: { pending: PendingTransaction; outcome: TransactionOutcome },
+): Promise<void> {
+  if (resolved.outcome.state !== "confirmed") return;
+  const details = resolved.pending.details ?? {};
+
+  try {
+    if (resolved.pending.kind === "swap"
+      && typeof details.inputMint === "string"
+      && typeof details.outputMint === "string"
+      && typeof details.inputAmount === "string") {
+      await journalConfirmedSwap(db, service, {
+        signature: resolved.pending.signature,
+        inputMint: details.inputMint,
+        outputMint: details.outputMint,
+        inputAmount: BigInt(details.inputAmount),
+        quotedOutputAmount: BigInt(typeof details.quotedOutputAmount === "string" ? details.quotedOutputAmount : "0"),
+      });
+    } else if (resolved.pending.kind === "transfer"
+      && typeof details.mint === "string"
+      && typeof details.amountRaw === "string"
+      && typeof details.recipient === "string") {
+      recordTransferOut(db.raw, {
+        signature: resolved.pending.signature,
+        mint: details.mint,
+        amountRaw: BigInt(details.amountRaw),
+        recipient: details.recipient,
+      });
+    }
+  } catch (error) {
+    logger.warn("Journaling of resolved pending transaction failed", {
+      signature: resolved.pending.signature,
+      error: error instanceof Error ? error.message : String(error),
+    });
+  }
+}
diff --git a/src/solana/ledger.ts b/src/solana/ledger.ts
new file mode 100644
index 0000000..b1965ef
--- /dev/null
+++ b/src/solana/ledger.ts
@@ -0,0 +1,457 @@
+/**
+ * SHUI financial ledger.
+ *
+ * Journals the central wallet's confirmed activity ("Journalise les fonds,
+ * revenus, dépenses et transactions") and derives the two components of the
+ * daily gain used by the lifespan rule:
+ *
+ *   - revenue: SOL/USDC received on-chain from any address other than the
+ *     creator (creator deposits are funding, not revenue);
+ *   - realized profit: when a position is sold into USDC, USDC received minus
+ *     the average cost of the units sold.
+ *
+ * Unrealized price moves never count. Outgoing transfers (expenses) are
+ * journaled but not deducted from the gain.
+ *
+ * Every amount comes from confirmed on-chain data. When something cannot be
+ * established (RPC failure, missing price), the entry is flagged instead of
+ * being guessed, and the day is treated as unknown by the lifespan rule.
+ */
+
+import type { Database } from "better-sqlite3";
+import { SOL_MINT, USDC_MINT } from "./raydium.js";
+
+const USDC_DECIMALS = 6;
+const SOL_DECIMALS = 9;
+const SCAN_CURSOR_KEY = "ledger.scan_cursor";
+const SCAN_LAST_OK_KEY = "ledger.scan_last_ok";
+
+export type LedgerKind =
+  | "swap"
+  | "transfer_out"
+  | "revenue"
+  | "creator_deposit"
+  | "own_unjournaled";
+
+export interface LedgerEntry {
+  signature: string;
+  ts: string;
+  day: string;
+  kind: LedgerKind;
+  inputMint: string | null;
+  inputAmountRaw: string | null;
+  outputMint: string | null;
+  outputAmountRaw: string | null;
+  revenueUsd: number;
+  realizedPnlUsd: number;
+  /** True when part of the USD figures could not be established. */
+  incomplete: boolean;
+  counterparty: string | null;
+  details: string | null;
+}
+
+export function ensureLedgerSchema(db: Database): void {
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS shui_ledger (
+      signature TEXT PRIMARY KEY,
+      ts TEXT NOT NULL,
+      day TEXT NOT NULL,
+      kind TEXT NOT NULL,
+      input_mint TEXT,
+      input_amount_raw TEXT,
+      output_mint TEXT,
+      output_amount_raw TEXT,
+      revenue_usd REAL NOT NULL DEFAULT 0,
+      realized_pnl_usd REAL NOT NULL DEFAULT 0,
+      incomplete INTEGER NOT NULL DEFAULT 0,
+      counterparty TEXT,
+      details TEXT
+    );
+    CREATE INDEX IF NOT EXISTS idx_shui_ledger_day ON shui_ledger(day);
+    CREATE TABLE IF NOT EXISTS shui_cost_basis (
+      mint TEXT PRIMARY KEY,
+      amount_raw TEXT NOT NULL,
+      cost_usd REAL NOT NULL
+    );
+  `);
+}
+
+export function utcDay(date: Date): string {
+  return date.toISOString().slice(0, 10);
+}
+
+function hasEntry(db: Database, signature: string): boolean {
+  return !!db.prepare("SELECT 1 FROM shui_ledger WHERE signature = ?").get(signature);
+}
+
+function insertEntry(db: Database, entry: LedgerEntry): boolean {
+  const result = db.prepare(
+    `INSERT OR IGNORE INTO shui_ledger
+     (signature, ts, day, kind, input_mint, input_amount_raw, output_mint, output_amount_raw,
+      revenue_usd, realized_pnl_usd, incomplete, counterparty, details)
+     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+  ).run(
+    entry.signature,
+    entry.ts,
+    entry.day,
+    entry.kind,
+    entry.inputMint,
+    entry.inputAmountRaw,
+    entry.outputMint,
+    entry.outputAmountRaw,
+    entry.revenueUsd,
+    entry.realizedPnlUsd,
+    entry.incomplete ? 1 : 0,
+    entry.counterparty,
+    entry.details,
+  );
+  return result.changes > 0;
+}
+
+interface Basis {
+  amountRaw: bigint;
+  costUsd: number;
+}
+
+function getBasis(db: Database, mint: string): Basis {
+  const row = db.prepare("SELECT amount_raw, cost_usd FROM shui_cost_basis WHERE mint = ?")
+    .get(mint) as { amount_raw: string; cost_usd: number } | undefined;
+  return row ? { amountRaw: BigInt(row.amount_raw), costUsd: row.cost_usd } : { amountRaw: 0n, costUsd: 0 };
+}
+
+function setBasis(db: Database, mint: string, basis: Basis): void {
+  if (basis.amountRaw <= 0n) {
+    db.prepare("DELETE FROM shui_cost_basis WHERE mint = ?").run(mint);
+    return;
+  }
+  db.prepare(
+    "INSERT OR REPLACE INTO shui_cost_basis (mint, amount_raw, cost_usd) VALUES (?, ?, ?)",
+  ).run(mint, basis.amountRaw.toString(), Math.max(0, basis.costUsd));
+}
+
+function addBasis(db: Database, mint: string, amountRaw: bigint, costUsd: number): void {
+  if (mint === USDC_MINT || amountRaw <= 0n) return; // USDC is cash
+  const current = getBasis(db, mint);
+  setBasis(db, mint, { amountRaw: current.amountRaw + amountRaw, costUsd: current.costUsd + costUsd });
+}
+
+/**
+ * Remove `amountRaw` units from a position and return the cost of the
+ * tracked part. Units bought before the ledger existed have no recorded cost
+ * ("untracked"); their sale realizes no profit or loss.
+ */
+function consumeBasis(db: Database, mint: string, amountRaw: bigint): { trackedRaw: bigint; costUsd: number } {
+  if (mint === USDC_MINT) {
+    return { trackedRaw: amountRaw, costUsd: rawToUi(amountRaw, USDC_DECIMALS) };
+  }
+  const basis = getBasis(db, mint);
+  if (basis.amountRaw <= 0n) return { trackedRaw: 0n, costUsd: 0 };
+  const trackedRaw = amountRaw < basis.amountRaw ? amountRaw : basis.amountRaw;
+  const costUsd = basis.costUsd * Number(trackedRaw) / Number(basis.amountRaw);
+  setBasis(db, mint, { amountRaw: basis.amountRaw - trackedRaw, costUsd: basis.costUsd - costUsd });
+  return { trackedRaw, costUsd };
+}
+
+export function rawToUi(raw: bigint, decimals: number): number {
+  return Number(raw) / Math.pow(10, decimals);
+}
+
+/**
+ * Journal a confirmed swap and compute its realized profit.
+ *
+ * Profit is realized only when the output is USDC (cash). Any other output
+ * inherits the cost of what was sold. `inputValueUsd` values untracked input
+ * units (held before the ledger existed) when known, e.g. SOL at market price.
+ */
+export function recordSwap(db: Database, params: {
+  signature: string;
+  at?: Date;
+  inputMint: string;
+  inputAmountRaw: bigint;
+  outputMint: string;
+  outputAmountRaw: bigint;
+  /** USD value of the full input amount at execution, when known. */
+  inputValueUsd?: number | null;
+  details?: Record<string, unknown>;
+}): LedgerEntry | null {
+  ensureLedgerSchema(db);
+  if (hasEntry(db, params.signature)) return null;
+
+  const at = params.at ?? new Date();
+  let realizedPnlUsd = 0;
+  let incomplete = false;
+
+  const tx = db.transaction(() => {
+    const { trackedRaw, costUsd } = consumeBasis(db, params.inputMint, params.inputAmountRaw);
+    const untrackedRaw = params.inputAmountRaw - trackedRaw;
+    const untrackedShare = params.inputAmountRaw > 0n ? Number(untrackedRaw) / Number(params.inputAmountRaw) : 0;
+
+    if (params.outputMint === USDC_MINT) {
+      const received = rawToUi(params.outputAmountRaw, USDC_DECIMALS);
+      const trackedShare = 1 - untrackedShare;
+      realizedPnlUsd = received * trackedShare - costUsd;
+    } else {
+      let untrackedValue = 0;
+      if (untrackedRaw > 0n) {
+        if (typeof params.inputValueUsd === "number" && Number.isFinite(params.inputValueUsd)) {
+          untrackedValue = params.inputValueUsd * untrackedShare;
+        } else {
+          incomplete = true;
+        }
+      }
+      addBasis(db, params.outputMint, params.outputAmountRaw, costUsd + untrackedValue);
+    }
+
+    const entry: LedgerEntry = {
+      signature: params.signature,
+      ts: at.toISOString(),
+      day: utcDay(at),
+      kind: "swap",
+      inputMint: params.inputMint,
+      inputAmountRaw: params.inputAmountRaw.toString(),
+      outputMint: params.outputMint,
+      outputAmountRaw: params.outputAmountRaw.toString(),
+      revenueUsd: 0,
+      realizedPnlUsd,
+      incomplete,
+      counterparty: null,
+      details: params.details ? JSON.stringify(params.details) : null,
+    };
+    insertEntry(db, entry);
+    return entry;
+  });
+
+  return tx();
+}
+
+/** Journal an outgoing transfer (expense). Not deducted from the gain. */
+export function recordTransferOut(db: Database, params: {
+  signature: string;
+  at?: Date;
+  mint: string;
+  amountRaw: bigint;
+  recipient: string;
+  details?: Record<string, unknown>;
+}): void {
+  ensureLedgerSchema(db);
+  if (hasEntry(db, params.signature)) return;
+  const at = params.at ?? new Date();
+  db.transaction(() => {
+    consumeBasis(db, params.mint, params.amountRaw);
+    insertEntry(db, {
+      signature: params.signature,
+      ts: at.toISOString(),
+      day: utcDay(at),
+      kind: "transfer_out",
+      inputMint: params.mint,
+      inputAmountRaw: params.amountRaw.toString(),
+      outputMint: null,
+      outputAmountRaw: null,
+      revenueUsd: 0,
+      realizedPnlUsd: 0,
+      incomplete: false,
+      counterparty: params.recipient,
+      details: params.details ? JSON.stringify(params.details) : null,
+    });
+  })();
+}
+
+/** Balance changes of the central wallet in one confirmed transaction. */
+export interface WalletTransactionDelta {
+  signature: string;
+  blockTime: number | null;
+  failed: boolean;
+  /** True when the central wallet signed it (SHUI's own transaction). */
+  signedByWallet: boolean;
+  feePayer: string | null;
+  /** Net native SOL change in lamports, fee included. */
+  solLamportsDelta: bigint;
+  feeLamports: bigint;
+  tokenDeltas: Array<{ mint: string; deltaRaw: bigint; decimals: number }>;
+}
+
+/**
+ * Journal incoming funds found in confirmed wallet history.
+ * SHUI's own transactions are skipped (journaled at execution time or marked
+ * own_unjournaled). Returns the entries created.
+ */
+export function recordIncoming(db: Database, delta: WalletTransactionDelta, params: {
+  creatorAddress: string | null;
+  solPriceUsd: number | null;
+}): LedgerEntry | null {
+  ensureLedgerSchema(db);
+  if (delta.failed || hasEntry(db, delta.signature)) return null;
+
+  const at = delta.blockTime ? new Date(delta.blockTime * 1000) : new Date();
+
+  if (delta.signedByWallet) {
+    const entry: LedgerEntry = {
+      signature: delta.signature,
+      ts: at.toISOString(),
+      day: utcDay(at),
+      kind: "own_unjournaled",
+      inputMint: null,
+      inputAmountRaw: null,
+      outputMint: null,
+      outputAmountRaw: null,
+      revenueUsd: 0,
+      realizedPnlUsd: 0,
+      incomplete: false,
+      counterparty: null,
+      details: JSON.stringify({ note: "SHUI-signed transaction not journaled at execution time" }),
+    };
+    insertEntry(db, entry);
+    return entry;
+  }
+
+  const received: Array<{ mint: string; raw: bigint; decimals: number }> = [];
+  if (delta.solLamportsDelta > 0n) {
+    received.push({ mint: SOL_MINT, raw: delta.solLamportsDelta, decimals: SOL_DECIMALS });
+  }
+  for (const token of delta.tokenDeltas) {
+    if (token.deltaRaw > 0n) received.push({ mint: token.mint, raw: token.deltaRaw, decimals: token.decimals });
+  }
+  if (received.length === 0) return null;
+
+  const fromCreator = !!params.creatorAddress && delta.feePayer === params.creatorAddress;
+  let valueUsd = 0;
+  let incomplete = false;
+
+  for (const item of received) {
+    let itemValue: number | null = null;
+    if (item.mint === USDC_MINT) itemValue = rawToUi(item.raw, USDC_DECIMALS);
+    else if (item.mint === SOL_MINT && params.solPriceUsd !== null) itemValue = rawToUi(item.raw, SOL_DECIMALS) * params.solPriceUsd;
+
+    if (itemValue === null) {
+      // Unpriced token (e.g. unsolicited airdrop): kept at zero cost.
+      incomplete = item.mint === SOL_MINT;
+      addBasis(db, item.mint, item.raw, 0);
+      continue;
+    }
+    valueUsd += itemValue;
+    addBasis(db, item.mint, item.raw, itemValue);
+  }
+
+  const main = received[0];
+  const entry: LedgerEntry = {
+    signature: delta.signature,
+    ts: at.toISOString(),
+    day: utcDay(at),
+    kind: fromCreator ? "creator_deposit" : "revenue",
+    inputMint: null,
+    inputAmountRaw: null,
+    outputMint: main.mint,
+    outputAmountRaw: main.raw.toString(),
+    revenueUsd: fromCreator ? 0 : valueUsd,
+    realizedPnlUsd: 0,
+    incomplete,
+    counterparty: delta.feePayer,
+    details: received.length > 1
+      ? JSON.stringify({ received: received.map((r) => ({ mint: r.mint, raw: r.raw.toString() })) })
+      : null,
+  };
+  insertEntry(db, entry);
+  return entry;
+}
+
+export interface WalletHistorySource {
+  /** Signatures newer than `until`, newest first (Solana RPC order). */
+  getSignaturesSince(until: string | null, limit: number): Promise<Array<{ signature: string; failed: boolean; blockTime: number | null }>>;
+  getWalletDelta(signature: string): Promise<WalletTransactionDelta | null>;
+  getLatestSignature(): Promise<string | null>;
+}
+
+/**
+ * Scan wallet history since the last cursor and journal incoming funds.
+ * The first run only sets the cursor: history before the ledger existed is
+ * not counted. Throws on RPC failure so callers can mark the period unknown.
+ */
+export async function scanWalletHistory(db: Database, source: WalletHistorySource, params: {
+  creatorAddress: string | null;
+  solPriceUsd: number | null;
+  maxTransactions?: number;
+}): Promise<{ processed: number; created: LedgerEntry[] }> {
+  ensureLedgerSchema(db);
+  const cursorRow = db.prepare("SELECT value FROM kv WHERE key = ?").get(SCAN_CURSOR_KEY) as { value: string } | undefined;
+  const setKv = db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))");
+
+  if (!cursorRow) {
+    const latest = await source.getLatestSignature();
+    setKv.run(SCAN_CURSOR_KEY, latest ?? "");
+    setKv.run(SCAN_LAST_OK_KEY, new Date().toISOString());
+    return { processed: 0, created: [] };
+  }
+
+  const until = cursorRow.value || null;
+  const limit = params.maxTransactions ?? 200;
+  const signatures = await source.getSignaturesSince(until, limit);
+  const created: LedgerEntry[] = [];
+
+  // Oldest first, so the cursor only advances over processed transactions.
+  for (const sig of [...signatures].reverse()) {
+    if (!sig.failed && !hasEntry(db, sig.signature)) {
+      const delta = await source.getWalletDelta(sig.signature);
+      if (!delta) {
+        throw new Error(`Transaction ${sig.signature} could not be read`);
+      }
+      const entry = recordIncoming(db, delta, params);
+      if (entry) created.push(entry);
+    }
+    setKv.run(SCAN_CURSOR_KEY, sig.signature);
+  }
+
+  setKv.run(SCAN_LAST_OK_KEY, new Date().toISOString());
+  return { processed: signatures.length, created };
+}
+
+/** Last time the wallet history scan completed without error (ISO), if any. */
+export function getLastSuccessfulScan(db: Database): string | null {
+  const row = db.prepare("SELECT value FROM kv WHERE key = ?").get(SCAN_LAST_OK_KEY) as { value: string } | undefined;
+  return row?.value ?? null;
+}
+
+export interface DailyGain {
+  day: string;
+  revenueUsd: number;
+  realizedPnlUsd: number;
+  gainUsd: number;
+  incompleteEntries: number;
+}
+
+export function getDailyGain(db: Database, day: string): DailyGain {
+  ensureLedgerSchema(db);
+  const row = db.prepare(
+    `SELECT COALESCE(SUM(revenue_usd), 0) AS revenue, COALESCE(SUM(realized_pnl_usd), 0) AS pnl,
+            COALESCE(SUM(incomplete), 0) AS incomplete
+     FROM shui_ledger WHERE day = ?`,
+  ).get(day) as { revenue: number; pnl: number; incomplete: number };
+  return {
+    day,
+    revenueUsd: row.revenue,
+    realizedPnlUsd: row.pnl,
+    gainUsd: row.revenue + row.pnl,
+    incompleteEntries: row.incomplete,
+  };
+}
+
+export function listLedgerEntries(db: Database, limit = 20): LedgerEntry[] {
+  ensureLedgerSchema(db);
+  const rows = db.prepare(
+    "SELECT * FROM shui_ledger ORDER BY ts DESC LIMIT ?",
+  ).all(limit) as Array<Record<string, unknown>>;
+  return rows.map((row) => ({
+    signature: String(row.signature),
+    ts: String(row.ts),
+    day: String(row.day),
+    kind: row.kind as LedgerKind,
+    inputMint: (row.input_mint as string | null) ?? null,
+    inputAmountRaw: (row.input_amount_raw as string | null) ?? null,
+    outputMint: (row.output_mint as string | null) ?? null,
+    outputAmountRaw: (row.output_amount_raw as string | null) ?? null,
+    revenueUsd: Number(row.revenue_usd),
+    realizedPnlUsd: Number(row.realized_pnl_usd),
+    incomplete: Number(row.incomplete) === 1,
+    counterparty: (row.counterparty as string | null) ?? null,
+    details: (row.details as string | null) ?? null,
+  }));
+}
