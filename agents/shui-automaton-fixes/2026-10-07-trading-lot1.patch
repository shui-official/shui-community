@@ -0,0 +1,257 @@
+/**
+ * Portfolio view and token safety check.
+ * - positions: every token held, its value, average entry (ledger cost
+ *   basis), unrealized PnL and the automatic orders protecting it.
+ * - token_safety: on-chain red flags before buying a token (mint/freeze
+ *   authority, Token-2022 extensions that let the issuer take or block
+ *   tokens, holder concentration, liquidity and age of the pool).
+ */
+import { Connection, PublicKey } from "@solana/web3.js";
+import type { Database } from "better-sqlite3";
+import type { AutomatonTool } from "../types.js";
+import { DEFAULT_SOLANA_RPC, NATIVE_SOL_MINT, SolanaTradingService } from "./trading.js";
+import { USDC_MINT } from "./raydium.js";
+import { jupiterPrices, listOrders, type Order, type PriceFetcher } from "./orders.js";
+import { fetchJson } from "./http-json.js";
+
+export interface Holding {
+  mint: string;
+  amountRaw: bigint;
+  decimals: number;
+}
+
+export interface PositionView {
+  mint: string;
+  amount: number;
+  priceUsd: number | null;
+  valueUsd: number | null;
+  avgEntryUsd: number | null;
+  costUsd: number | null;
+  unrealizedPnlUsd: number | null;
+  untrackedShare: number;
+  orders: Order[];
+}
+
+function basisOf(db: Database, mint: string): { amountRaw: bigint; costUsd: number } | null {
+  try {
+    const row = db.prepare("SELECT amount_raw, cost_usd FROM shui_cost_basis WHERE mint = ?").get(mint) as
+      | { amount_raw: string; cost_usd: number } | undefined;
+    return row ? { amountRaw: BigInt(row.amount_raw), costUsd: row.cost_usd } : null;
+  } catch {
+    return null;
+  }
+}
+
+export function buildPositions(db: Database, holdings: Holding[], prices: Record<string, number>): PositionView[] {
+  const openOrders = listOrders(db).filter((o) => o.status === "open");
+  return holdings
+    .filter((h) => h.mint !== USDC_MINT && h.amountRaw > 0n)
+    .map((h) => {
+      const amount = Number(h.amountRaw) / 10 ** h.decimals;
+      const priceUsd = prices[h.mint] ?? null;
+      const valueUsd = priceUsd === null ? null : amount * priceUsd;
+      const basis = basisOf(db, h.mint);
+      const trackedRaw = basis ? (basis.amountRaw < h.amountRaw ? basis.amountRaw : h.amountRaw) : 0n;
+      const costUsd = basis && basis.amountRaw > 0n ? basis.costUsd * Number(trackedRaw) / Number(basis.amountRaw) : null;
+      const trackedAmount = Number(trackedRaw) / 10 ** h.decimals;
+      return {
+        mint: h.mint,
+        amount,
+        priceUsd,
+        valueUsd,
+        avgEntryUsd: costUsd !== null && trackedAmount > 0 ? costUsd / trackedAmount : null,
+        costUsd,
+        unrealizedPnlUsd: costUsd !== null && priceUsd !== null ? trackedAmount * priceUsd - costUsd : null,
+        untrackedShare: h.amountRaw > 0n ? 1 - Number(trackedRaw) / Number(h.amountRaw) : 0,
+        orders: openOrders.filter((o) => o.inputMint === h.mint || o.watchMint === h.mint),
+      };
+    });
+}
+
+export function formatPositions(positions: PositionView[], usdc: number): string {
+  const money = (x: number | null) => (x === null ? "?" : `$${x.toFixed(4)}`);
+  const lines = [`Cash: ${usdc.toFixed(4)} USDC`];
+  for (const p of positions) {
+    const label = p.mint === NATIVE_SOL_MINT ? "SOL" : `${p.mint.slice(0, 6)}…`;
+    const pnl = p.unrealizedPnlUsd === null ? "entry unknown (held before the ledger or received)"
+      : `unrealized ${p.unrealizedPnlUsd >= 0 ? "+" : ""}${money(p.unrealizedPnlUsd)} (${((p.unrealizedPnlUsd / (p.costUsd || 1)) * 100).toFixed(2)}%)`;
+    const protection = p.orders.length
+      ? p.orders.map((o) => `${o.kind}@${o.triggerPriceUsd.toPrecision(5)}${o.group ? " (OCO)" : ""}`).join(", ")
+      : p.mint === NATIVE_SOL_MINT ? "none (SOL also pays fees)" : "⚠ NO STOP-LOSS: use protect_position";
+    lines.push(
+      `${label} mint=${p.mint}: ${p.amount} @ ${money(p.priceUsd)} = ${money(p.valueUsd)} | avg entry ${money(p.avgEntryUsd)} | ${pnl} | orders: ${protection}`,
+    );
+  }
+  if (positions.length === 0) lines.push("No token position.");
+  return lines.join("\n");
+}
+
+// ─── Token safety ──────────────────────────────────────────────
+
+export interface MintInfo {
+  program: "spl-token" | "token-2022";
+  mintAuthority: string | null;
+  freezeAuthority: string | null;
+  supply: string;
+  decimals: number;
+  extensions: string[];
+}
+
+export interface SafetyInputs {
+  mint: MintInfo | null;
+  topHoldersPct: number[];
+  liquidityUsd: number | null;
+  pairCreatedAt: number | null;
+  dex: string | null;
+}
+
+const DANGEROUS_EXTENSIONS: Record<string, string> = {
+  permanentDelegate: "permanent delegate: the issuer can move or burn YOUR tokens",
+  transferHook: "transfer hook: custom code runs on every transfer (can block sales)",
+  transferFeeConfig: "transfer fee: a fee is taken on every transfer",
+  nonTransferable: "non-transferable token",
+  defaultAccountState: "accounts can start frozen",
+  pausableConfig: "transfers can be paused by the issuer",
+};
+
+export function assessSafety(input: SafetyInputs, now = Date.now()): { verdict: "HIGH RISK" | "CAUTION" | "OK"; flags: string[]; facts: string[] } {
+  const flags: string[] = [];
+  const facts: string[] = [];
+  let severe = 0;
+  if (!input.mint) {
+    flags.push("mint account not found or not a token");
+    severe += 1;
+  } else {
+    facts.push(`${input.mint.program}, decimals ${input.mint.decimals}, supply ${input.mint.supply}`);
+    if (input.mint.mintAuthority) { flags.push(`mint authority active (${input.mint.mintAuthority.slice(0, 6)}…): supply can be inflated`); severe += 1; }
+    if (input.mint.freezeAuthority) { flags.push(`freeze authority active: your tokens can be frozen (honeypot risk)`); severe += 1; }
+    for (const ext of input.mint.extensions) {
+      if (DANGEROUS_EXTENSIONS[ext]) {
+        flags.push(DANGEROUS_EXTENSIONS[ext]);
+        if (ext === "permanentDelegate" || ext === "transferHook" || ext === "nonTransferable" || ext === "pausableConfig") severe += 1;
+      }
+    }
+  }
+  const top1 = input.topHoldersPct[0] ?? 0;
+  const top10 = input.topHoldersPct.slice(0, 10).reduce((s, x) => s + x, 0);
+  if (input.topHoldersPct.length) {
+    facts.push(`top holder ${top1.toFixed(1)}%, top 10 ${top10.toFixed(1)}% of supply (pool vaults included)`);
+    if (top1 > 30) flags.push(`one wallet holds ${top1.toFixed(1)}% of the supply (dump risk; may be the pool)`);
+    if (top10 > 60) flags.push(`top 10 wallets hold ${top10.toFixed(1)}% of the supply`);
+  }
+  if (input.liquidityUsd !== null) {
+    facts.push(`liquidity $${Math.round(input.liquidityUsd).toLocaleString("en-US")} on ${input.dex ?? "?"}`);
+    if (input.liquidityUsd < 50_000) flags.push("liquidity under $50k: high slippage, easy to manipulate");
+  } else {
+    flags.push("no liquid pool found");
+    severe += 1;
+  }
+  if (input.pairCreatedAt) {
+    const ageH = (now - input.pairCreatedAt) / 3_600_000;
+    facts.push(`pool age ${ageH < 48 ? `${ageH.toFixed(1)} h` : `${(ageH / 24).toFixed(0)} days`}`);
+    if (ageH < 24) flags.push("pool younger than 24 h: most rug pulls happen here");
+  }
+  facts.push("LP lock/burn is NOT verified by this check");
+  const verdict = severe > 0 ? "HIGH RISK" : flags.length ? "CAUTION" : "OK";
+  return { verdict, flags, facts };
+}
+
+export async function readMintInfo(connection: Connection, mint: string): Promise<MintInfo | null> {
+  const info = await connection.getParsedAccountInfo(new PublicKey(mint), "confirmed");
+  const data = info.value?.data as { program?: string; parsed?: { type?: string; info?: Record<string, any> } } | undefined;
+  if (!data?.parsed || data.parsed.type !== "mint" || !data.parsed.info) return null;
+  const i = data.parsed.info;
+  return {
+    program: data.program === "spl-token-2022" ? "token-2022" : "spl-token",
+    mintAuthority: i.mintAuthority ?? null,
+    freezeAuthority: i.freezeAuthority ?? null,
+    supply: String(i.supply ?? "0"),
+    decimals: Number(i.decimals ?? 0),
+    extensions: Array.isArray(i.extensions) ? i.extensions.map((e: { extension?: string }) => String(e.extension ?? "")) : [],
+  };
+}
+
+export async function tokenSafety(mint: string, connection: Connection = new Connection(DEFAULT_SOLANA_RPC, "confirmed")): Promise<string> {
+  try {
+    new PublicKey(mint);
+  } catch {
+    return "Blocked: invalid mint.";
+  }
+  const mintInfo = await readMintInfo(connection, mint).catch(() => null);
+  let topHoldersPct: number[] = [];
+  if (mintInfo && BigInt(mintInfo.supply) > 0n) {
+    try {
+      const largest = await connection.getTokenLargestAccounts(new PublicKey(mint), "confirmed");
+      const supply = Number(mintInfo.supply);
+      topHoldersPct = largest.value.map((a) => (Number(a.amount) / supply) * 100);
+    } catch {
+      topHoldersPct = [];
+    }
+  }
+  let liquidityUsd: number | null = null;
+  let pairCreatedAt: number | null = null;
+  let dex: string | null = null;
+  try {
+    const res = await fetchJson(`https://api.dexscreener.com/tokens/v1/solana/${mint}`);
+    const pairs = (Array.isArray(res.body) ? res.body : []) as Array<Record<string, any>>;
+    const deepest = pairs.sort((a, b) => (b.liquidity?.usd ?? 0) - (a.liquidity?.usd ?? 0))[0];
+    if (deepest) {
+      liquidityUsd = Number(deepest.liquidity?.usd ?? 0);
+      pairCreatedAt = Number(deepest.pairCreatedAt) || null;
+      dex = String(deepest.dexId ?? "");
+    }
+  } catch {
+    // market data unavailable: reported as no pool
+  }
+  const r = assessSafety({ mint: mintInfo, topHoldersPct, liquidityUsd, pairCreatedAt, dex });
+  return `Token safety ${mint}: ${r.verdict}\n` +
+    (r.flags.length ? `Red flags:\n${r.flags.map((f) => `- ${f}`).join("\n")}\n` : "No red flag found.\n") +
+    `Facts: ${r.facts.join("; ")}.` +
+    (r.verdict === "HIGH RISK" ? "\nDo not buy, or only a tiny size you accept to lose entirely." : "");
+}
+
+export function createPortfolioTools(prices: PriceFetcher = jupiterPrices): AutomatonTool[] {
+  return [
+    {
+      name: "positions",
+      description: "Your open positions: every token held with value, average entry price (from your ledger), unrealized PnL, and the automatic orders protecting it. Flags positions without a stop-loss.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: {} },
+      execute: async (_args, ctx) => {
+        if (!ctx.identity.chainIdentity || ctx.identity.chainIdentity.chainType !== "solana") return "Solana identity unavailable.";
+        const service = new SolanaTradingService(ctx.identity.chainIdentity);
+        const [sol, tokens] = await Promise.all([service.getSolBalance(), service.getTokenBalances()]);
+        const holdings: Holding[] = [
+          { mint: NATIVE_SOL_MINT, amountRaw: BigInt(sol.lamports), decimals: 9 },
+          ...tokens.map((t) => ({ mint: t.mint, amountRaw: BigInt(t.amount), decimals: t.decimals })),
+        ];
+        const usdc = tokens.filter((t) => t.mint === USDC_MINT).reduce((s, t) => s + (t.uiAmount ?? 0), 0);
+        let priceMap: Record<string, number> = {};
+        try {
+          priceMap = await prices(holdings.filter((h) => h.mint !== USDC_MINT && h.amountRaw > 0n).map((h) => h.mint));
+        } catch {
+          priceMap = {};
+        }
+        return formatPositions(buildPositions(ctx.db.raw, holdings, priceMap), usdc);
+      },
+    },
+    {
+      name: "token_safety",
+      description:
+        "Check a token for scam red flags before buying: mint authority (supply can be inflated), freeze authority (honeypot), " +
+        "Token-2022 extensions (permanent delegate, transfer hook, fees, pause), holder concentration, liquidity and pool age. " +
+        "Use it before buying any token other than SOL/major tokens.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: { mint: { type: "string" } }, required: ["mint"] },
+      execute: async (args) => {
+        try {
+          return await tokenSafety(String(args.mint ?? ""));
+        } catch (error) {
+          return `token_safety failed: ${error instanceof Error ? error.message : String(error)}`;
+        }
+      },
+    },
+  ];
+}
