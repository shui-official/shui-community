@@ -0,0 +1,144 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { createInMemoryDb } from "./orchestration/test-db.js";
+import { createDatabase, claimInboxMessages } from "../state/database.js";
+import { recordSwap } from "../solana/ledger.js";
+import {
+  classifyWeek, ensureRulesV2, evaluateCompletedDays, evaluateCompletedWeeks, formatLifespanLine, getLifespanStatus, recordWeekCapital,
+} from "../survival/lifespan.js";
+import { isBuy, tradingPausedUntil, updateDrawdownGuard } from "../survival/risk-guard.js";
+import { listOrders, runOrderTick, saveOrder, type Order } from "../solana/orders.js";
+import { assessSafety, buildPositions } from "../solana/portfolio.js";
+import { SOL_MINT, USDC_MINT } from "../solana/raydium.js";
+
+const TOKEN = "TokenMint1111111111111111111111111111111111";
+const at = (d: string, h = 12) => new Date(`${d}T${String(h).padStart(2, "0")}:00:00.000Z`);
+const scanOk = (db: any, d: Date) => db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES ('ledger.scan_last_ok', ?, datetime('now'))").run(d.toISOString());
+function birth(db: any, d: string) {
+  db.prepare("INSERT OR REPLACE INTO identity (key, value) VALUES ('createdAt', ?)").run(`${d}T00:00:00.000Z`);
+}
+
+describe("lifespan rules v2", () => {
+  it("classifies weekly gains in % of capital with a neutral zone", () => {
+    expect(classifyWeek(12).adjustment).toBe(3);
+    expect(classifyWeek(5).adjustment).toBe(2);
+    expect(classifyWeek(2).adjustment).toBe(1);
+    expect(classifyWeek(0).adjustment).toBe(0);
+    expect(classifyWeek(-1.9).adjustment).toBe(0);
+    expect(classifyWeek(-3).adjustment).toBe(-1);
+    expect(classifyWeek(-15).adjustment).toBe(-2);
+  });
+
+  it("evaluates completed weeks against the capital at week start, waiving losses in the learning period", () => {
+    const db = createInMemoryDb();
+    birth(db, "2026-10-01");
+    evaluateCompletedDays(db, at("2026-10-07")); // sets daily start day
+    ensureRulesV2(db, at("2026-10-07"));
+    recordWeekCapital(db, 40, at("2026-10-07"));
+    // Week 1: +1.2 USD realized on 40 = +3% -> +1 day.
+    recordSwap(db, { signature: "b", at: at("2026-10-08"), inputMint: USDC_MINT, inputAmountRaw: 10_000_000n, outputMint: TOKEN, outputAmountRaw: 100n });
+    recordSwap(db, { signature: "s", at: at("2026-10-09"), inputMint: TOKEN, inputAmountRaw: 100n, outputMint: USDC_MINT, outputAmountRaw: 11_200_000n });
+    scanOk(db, at("2026-10-14", 1));
+    const w1 = evaluateCompletedWeeks(db, at("2026-10-14", 2));
+    expect(w1).toHaveLength(1);
+    expect(w1[0]).toMatchObject({ weekStart: "2026-10-07", adjustment: 1, status: "bonus" });
+    expect(w1[0].gainPct).toBeCloseTo(3, 5);
+    // Week 2 (still learning): -2 USD on 41.2 = -4.9% -> waived.
+    recordWeekCapital(db, 41.2, at("2026-10-14", 3));
+    recordSwap(db, { signature: "b2", at: at("2026-10-15"), inputMint: USDC_MINT, inputAmountRaw: 10_000_000n, outputMint: TOKEN, outputAmountRaw: 100n });
+    recordSwap(db, { signature: "s2", at: at("2026-10-16"), inputMint: TOKEN, inputAmountRaw: 100n, outputMint: USDC_MINT, outputAmountRaw: 8_000_000n });
+    scanOk(db, at("2026-10-21", 1));
+    const w2 = evaluateCompletedWeeks(db, at("2026-10-21", 2));
+    expect(w2[0]).toMatchObject({ weekStart: "2026-10-14", adjustment: 0, status: "neutral" });
+    expect(w2[0].note).toMatch(/learning period/);
+    // Days from v2 on are no longer judged daily.
+    expect(evaluateCompletedDays(db, at("2026-10-21", 2))).toEqual([]);
+    expect(getLifespanStatus(db, at("2026-10-21", 2))!.adjustmentDays).toBe(1);
+    expect(formatLifespanLine(db, at("2026-10-22", 2))).toMatch(/This week \(day 2\/7\).*Patience costs nothing/s);
+  });
+
+  it("never changes life when the week-start capital is unknown", () => {
+    const db = createInMemoryDb();
+    birth(db, "2026-10-01");
+    ensureRulesV2(db, at("2026-10-07"));
+    scanOk(db, at("2026-10-14", 1));
+    expect(evaluateCompletedWeeks(db, at("2026-10-14", 2))[0]).toMatchObject({ status: "unknown", adjustment: 0 });
+  });
+});
+
+describe("drawdown circuit breaker", () => {
+  it("pauses new buys for 24 h after a 15% drawdown, then measures from the new level", () => {
+    const db = createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "dd-")), "s.db")).raw;
+    const t0 = at("2026-10-07");
+    updateDrawdownGuard(db, 40, t0);
+    expect(updateDrawdownGuard(db, 36, t0).triggered).toBe(false);
+    expect(updateDrawdownGuard(db, 33.9, t0).triggered).toBe(true);
+    expect(tradingPausedUntil(db, t0)).not.toBeNull();
+    expect(tradingPausedUntil(db, new Date(t0.getTime() + 25 * 3_600_000))).toBeNull();
+    expect(updateDrawdownGuard(db, 33, new Date(t0.getTime() + 25 * 3_600_000)).triggered).toBe(false);
+    expect(isBuy(TOKEN)).toBe(true);
+    expect(isBuy(USDC_MINT)).toBe(false);
+    expect(isBuy(SOL_MINT)).toBe(false);
+    expect(claimInboxMessages(db, 5)[0].content).toMatch(/Circuit breaker/);
+  });
+});
+
+describe("OCO and trailing stops", () => {
+  const order = (over: Partial<Order>): Order => ({
+    id: "x", kind: "stop_loss", inputMint: TOKEN, outputMint: USDC_MINT, amount: "100", watchMint: TOKEN, condition: "below",
+    triggerPriceUsd: 1, slippageBps: 100, venue: "jupiter", note: "", createdAt: "", expiresAt: null, status: "open",
+    attempts: 0, updatedAt: new Date().toISOString(), ...over,
+  });
+  const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot1-")), "s.db"));
+
+  it("cancels the sibling when one order of an OCO group fills", async () => {
+    const db = freshDb();
+    saveOrder(db.raw, order({ id: "g_stop", group: "g", triggerPriceUsd: 0.9 }));
+    saveOrder(db.raw, order({ id: "g_tp", group: "g", kind: "take_profit", condition: "above", triggerPriceUsd: 1.3 }));
+    const swap = vi.fn(async () => JSON.stringify({ success: true, signature: "S" }));
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [TOKEN]: 1.35 }), swap });
+    const byId = Object.fromEntries(listOrders(db.raw).map((o) => [o.id, o.status]));
+    expect(byId).toEqual({ g_stop: "cancelled", g_tp: "filled" });
+    expect(swap).toHaveBeenCalledTimes(1);
+    expect(claimInboxMessages(db.raw, 5)[0].content).toMatch(/g_stop cancelled \(OCO\)/);
+  });
+
+  it("raises a trailing stop with the price and sells on the pullback", async () => {
+    const db = freshDb();
+    saveOrder(db.raw, order({ id: "t", kind: "trailing_stop", trailPct: 10, highestPriceUsd: 1, triggerPriceUsd: 0.9 }));
+    const swap = vi.fn(async () => JSON.stringify({ success: true, signature: "S" }));
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [TOKEN]: 2 }), swap });
+    expect(listOrders(db.raw)[0]).toMatchObject({ highestPriceUsd: 2, triggerPriceUsd: 1.8, status: "open" });
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [TOKEN]: 1.95 }), swap });
+    expect(swap).not.toHaveBeenCalled();
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [TOKEN]: 1.79 }), swap });
+    expect(listOrders(db.raw)[0].status).toBe("filled");
+  });
+});
+
+describe("positions and token safety", () => {
+  it("computes average entry, unrealized PnL and flags unprotected positions", () => {
+    const db = createInMemoryDb();
+    recordSwap(db, { signature: "b", at: at("2026-10-07"), inputMint: USDC_MINT, inputAmountRaw: 10_000_000n, outputMint: TOKEN, outputAmountRaw: 1000n });
+    const [p] = buildPositions(db, [{ mint: TOKEN, amountRaw: 1000n, decimals: 0 }, { mint: USDC_MINT, amountRaw: 5n, decimals: 6 }], { [TOKEN]: 0.012 });
+    expect(p.avgEntryUsd).toBeCloseTo(0.01, 6);
+    expect(p.unrealizedPnlUsd).toBeCloseTo(2, 6);
+    expect(p.orders).toEqual([]);
+  });
+
+  it("rates a token with active authorities and a young thin pool as high risk", () => {
+    const risky = assessSafety({
+      mint: { program: "token-2022", mintAuthority: "Auth1111", freezeAuthority: "Frz1111", supply: "1000", decimals: 6, extensions: ["permanentDelegate"] },
+      topHoldersPct: [45, 10, 5], liquidityUsd: 8000, pairCreatedAt: Date.now() - 3_600_000, dex: "pumpswap",
+    });
+    expect(risky.verdict).toBe("HIGH RISK");
+    expect(risky.flags.join(" ")).toMatch(/mint authority.*freeze authority.*permanent delegate/s);
+    const clean = assessSafety({
+      mint: { program: "spl-token", mintAuthority: null, freezeAuthority: null, supply: "1000", decimals: 6, extensions: [] },
+      topHoldersPct: [8, 5, 4], liquidityUsd: 3_000_000, pairCreatedAt: Date.now() - 90 * 86_400_000, dex: "orca",
+    });
+    expect(clean.verdict).toBe("OK");
+  });
+});
