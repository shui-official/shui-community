+/**
+ * Drawdown circuit breaker: if the verified wallet value falls 15% below its
+ * peak, new buys are paused for 24 h. Sales (stop-losses, take-profits,
+ * exits to USDC/SOL) stay allowed: protecting capital is never blocked.
+ * The peak restarts from the current value when the pause starts, so the
+ * breaker does not fire again immediately afterwards.
+ */
+import type { Database } from "better-sqlite3";
+import { queueSystemNotice } from "../integration/creator-chat.js";
+
+export const MAX_DRAWDOWN_PCT = 15;
+export const PAUSE_MS = 24 * 3_600_000;
+const PEAK_KEY = "risk.peak_value_usd";
+const PAUSE_KEY = "risk.trading_paused_until";
+
+const getKv = (db: Database, key: string) =>
+  (db.prepare("SELECT value FROM kv WHERE key = ?").get(key) as { value: string } | undefined)?.value ?? null;
+const setKv = (db: Database, key: string, value: string) =>
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(key, value);
+
+export function tradingPausedUntil(db: Database, now: Date = new Date()): string | null {
+  const until = getKv(db, PAUSE_KEY);
+  return until && Date.parse(until) > now.getTime() ? until : null;
+}
+
+export function updateDrawdownGuard(
+  db: Database,
+  verifiedWalletValueUsd: number | null,
+  now: Date = new Date(),
+): { peakUsd: number | null; drawdownPct: number | null; triggered: boolean } {
+  if (verifiedWalletValueUsd === null || !(verifiedWalletValueUsd > 0)) {
+    const peak = getKv(db, PEAK_KEY);
+    return { peakUsd: peak ? Number(peak) : null, drawdownPct: null, triggered: false };
+  }
+  const stored = Number(getKv(db, PEAK_KEY) ?? 0);
+  const peak = Math.max(stored, verifiedWalletValueUsd);
+  if (peak !== stored) setKv(db, PEAK_KEY, String(peak));
+  const drawdownPct = ((peak - verifiedWalletValueUsd) / peak) * 100;
+  if (drawdownPct >= MAX_DRAWDOWN_PCT && !tradingPausedUntil(db, now)) {
+    const until = new Date(now.getTime() + PAUSE_MS).toISOString();
+    setKv(db, PAUSE_KEY, until);
+    setKv(db, PEAK_KEY, String(verifiedWalletValueUsd));
+    queueSystemNotice(db, "system:risk",
+      `Circuit breaker: the wallet is ${drawdownPct.toFixed(1)}% below its peak ($${verifiedWalletValueUsd.toFixed(2)} vs $${peak.toFixed(2)}). ` +
+      `New buys are paused until ${until}. Sales and stop-losses still work. Use this time to review trade_stats and your journal.`);
+    return { peakUsd: peak, drawdownPct, triggered: true };
+  }
+  return { peakUsd: peak, drawdownPct, triggered: false };
+}
+
+/** A buy = a swap into anything other than USDC or SOL. */
+export function isBuy(outputMint: string): boolean {
+  return outputMint !== "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v" && outputMint !== "So11111111111111111111111111111111111111112";
+}
