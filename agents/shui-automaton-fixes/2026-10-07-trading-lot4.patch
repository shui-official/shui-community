+/** USDC moved between the wallet and Drift: not a gain, journaled so the history scan skips it. */
+export function recordPerpTransfer(db: Database, params: { signature: string; direction: "deposit" | "withdraw"; usdc: number; at?: Date }): void {
+  ensureLedgerSchema(db);
+  const at = params.at ?? new Date();
+  const raw = String(Math.round(params.usdc * 1_000_000));
+  insertEntry(db, {
+    signature: params.signature,
+    ts: at.toISOString(),
+    day: utcDay(at),
+    kind: "perp_transfer",
+    inputMint: params.direction === "deposit" ? USDC_MINT : null,
+    inputAmountRaw: params.direction === "deposit" ? raw : null,
+    outputMint: params.direction === "withdraw" ? USDC_MINT : null,
+    outputAmountRaw: params.direction === "withdraw" ? raw : null,
+    revenueUsd: 0,
+    realizedPnlUsd: 0,
+    incomplete: false,
+    counterparty: "drift",
+    details: JSON.stringify({ direction: params.direction }),
+  });
+}
+
+/** Realized PnL of Drift perpetuals (closed trades, fees, funding), recorded when the account is flat. */
+export function recordPerpPnl(db: Database, params: { pnlUsd: number; at?: Date; details?: Record<string, unknown> }): void {
+  ensureLedgerSchema(db);
+  const at = params.at ?? new Date();
+  insertEntry(db, {
+    signature: `perp_pnl:${at.toISOString()}`,
+    ts: at.toISOString(),
+    day: utcDay(at),
+    kind: "perp_pnl",
+    inputMint: null,
+    inputAmountRaw: null,
+    outputMint: null,
+    outputAmountRaw: null,
+    revenueUsd: 0,
+    realizedPnlUsd: params.pnlUsd,
+    incomplete: false,
+    counterparty: "drift",
+    details: params.details ? JSON.stringify(params.details) : null,
+  });
+}
