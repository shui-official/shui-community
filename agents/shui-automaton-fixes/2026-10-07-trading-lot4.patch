+++ b/src/__tests__/lot4-perps.test.ts
@@ -0,0 +1,186 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { createDatabase } from "../state/database.js";
+import {
+  createPerpTools,
+  maxDepositUsd,
+  perpValuationAsset,
+  runPerpTick,
+  validatePerpOpen,
+  type DriftAccountView,
+  type DriftAdapter,
+  type PerpOpenCheck,
+} from "../solana/perps.js";
+import { getDailyGain, listLedgerEntries } from "../solana/ledger.js";
+import { computeTradeStats } from "../solana/trading-desk.js";
+import { buildCentralWalletValuation } from "../solana/wallet-valuation.js";
+
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot4-")), "s.db"));
+const identity = { chainType: "solana", address: "Shui1111111111111111111111111111111111111111" } as any;
+const setKv = (db: any, k: string, v: string) =>
+  db.raw.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(k, v);
+const setCapital = (db: any, usd: number) =>
+  setKv(db, "last_known_balance", JSON.stringify({ walletValueUsd: usd, walletValueComplete: true }));
+
+const base: PerpOpenCheck = {
+  direction: "long", entryPrice: 100, sizeUsd: 50, stopPrice: 96, capitalUsd: 200, accountValueUsd: 50,
+  otherNotionalUsd: 0, liqPrice: null, openedCount: 10, pausedUntil: null,
+};
+
+function fakeAdapter(state: { account: DriftAccountView; price?: number; liq?: number | null }) {
+  const calls = { open: vi.fn(), deposit: vi.fn(), withdraw: vi.fn(), close: vi.fn() };
+  const adapter: DriftAdapter = {
+    account: async () => structuredClone(state.account),
+    oraclePrice: async () => state.price ?? 100,
+    sizeRules: async () => ({ min: 0.01, step: 0.01 }),
+    estimateLiqPrice: async () => state.liq ?? null,
+    deposit: async (usdc) => {
+      calls.deposit(usdc);
+      state.account.exists = true;
+      state.account.valueUsd += usdc;
+      state.account.freeCollateralUsd += usdc;
+      return `dep_${usdc}`;
+    },
+    withdraw: async (usdc) => {
+      calls.withdraw(usdc);
+      state.account.valueUsd -= usdc;
+      state.account.freeCollateralUsd -= usdc;
+      return `wd_${usdc}`;
+    },
+    open: async (p) => {
+      calls.open(p);
+      return "open_sig";
+    },
+    close: async (mi) => {
+      calls.close(mi);
+      state.account.positions = state.account.positions.filter((p) => p.marketIndex !== mi);
+      return "close_sig";
+    },
+    dispose: async () => {},
+  };
+  return { adapter, calls, factory: async () => adapter };
+}
+
+const tool = (tools: ReturnType<typeof createPerpTools>, name: string) => tools.find((t) => t.name === name)!;
+const ctx = (db: any) => ({ db, identity: { chainIdentity: identity } }) as any;
+
+describe("perp validation", () => {
+  it("accepts a sane trade", () => {
+    const v = validatePerpOpen(base);
+    expect(v.ok).toBe(true);
+    expect(v.leverage).toBeCloseTo(1);
+  });
+  it("caps leverage at 5x, and 1x for the first 5 trades", () => {
+    expect(validatePerpOpen({ ...base, sizeUsd: 300, stopPrice: 99.5 }).reasons.join()).toMatch(/leverage 6.00x > max 5x/);
+    expect(validatePerpOpen({ ...base, sizeUsd: 250, stopPrice: 99.5 }).ok).toBe(true);
+    expect(validatePerpOpen({ ...base, sizeUsd: 100, stopPrice: 99, openedCount: 2 }).reasons.join()).toMatch(/max 1x \(first 5 trades/);
+  });
+  it("limits the loss at the stop to 2% of capital", () => {
+    const v = validatePerpOpen({ ...base, stopPrice: 90 }); // 0.5 unit * 10 = $5 > $4
+    expect(v.ok).toBe(false);
+    expect(v.reasons.join()).toMatch(/risk at stop/);
+  });
+  it("needs the stop on the right side and the liquidation far enough", () => {
+    expect(validatePerpOpen({ ...base, stopPrice: 101 }).reasons.join()).toMatch(/stopPrice below/);
+    expect(validatePerpOpen({ ...base, direction: "short", stopPrice: 99 }).reasons.join()).toMatch(/stopPrice above/);
+    expect(validatePerpOpen({ ...base, liqPrice: 95 }).reasons.join()).toMatch(/liquidation \$95.*too close/);
+    expect(validatePerpOpen({ ...base, liqPrice: 93 }).ok).toBe(true);
+    expect(validatePerpOpen({ ...base, direction: "short", stopPrice: 104, liqPrice: 105 }).ok).toBe(false);
+  });
+  it("respects the circuit breaker and caps collateral at 50%", () => {
+    expect(validatePerpOpen({ ...base, pausedUntil: "2099-01-01" }).reasons.join()).toMatch(/circuit breaker/);
+    expect(maxDepositUsd(200, 60)).toBe(40);
+    expect(maxDepositUsd(200, 120)).toBe(0);
+  });
+});
+
+describe("perp tools", () => {
+  it("deposits within the 50% cap and journals the transfer", async () => {
+    const db = freshDb();
+    setCapital(db, 100);
+    const state = { account: { exists: false, valueUsd: 0, freeCollateralUsd: 0, positions: [], openOrders: 0 } };
+    const { factory, calls } = fakeAdapter(state);
+    const tools = createPerpTools(factory);
+    expect(await tool(tools, "perp_deposit").execute({ usdc: 60 }, ctx(db))).toMatch(/Max deposit now: \$50.00/);
+    expect(await tool(tools, "perp_deposit").execute({ usdc: 40 }, ctx(db))).toMatch(/Deposited 40 USDC/);
+    expect(calls.deposit).toHaveBeenCalledWith(40);
+    const entry = listLedgerEntries(db.raw).find((e) => e.signature === "dep_40")!;
+    expect(entry.kind).toBe("perp_transfer");
+    expect(getDailyGain(db.raw, entry.day).gainUsd).toBe(0);
+    expect(perpValuationAsset(db.raw)).toMatchObject({ amount: 40, priceUsd: 1 });
+  });
+
+  it("opens with the stop on Drift, counts the trade and blocks unsafe ones", async () => {
+    const db = freshDb();
+    setCapital(db, 200);
+    setKv(db, "perp.net_deposits", "50");
+    const state = { account: { exists: true, valueUsd: 50, freeCollateralUsd: 50, positions: [], openOrders: 0 }, price: 100, liq: null };
+    const { factory, calls } = fakeAdapter(state);
+    const tools = createPerpTools(factory);
+    const open = tool(tools, "perp_open");
+    // starter: 1x max
+    expect(await open.execute({ market: "SOL-PERP", direction: "long", sizeUsd: 100, stopPrice: 99 }, ctx(db))).toMatch(/Blocked: leverage 2.00x > max 1x/);
+    expect(await open.execute({ market: "SOL-PERP", direction: "long", sizeUsd: 50, stopPrice: 97, dryRun: true }, ctx(db))).toMatch(/Dry run OK/);
+    expect(calls.open).not.toHaveBeenCalled();
+    expect(await open.execute({ market: "SOL-PERP", direction: "short", sizeUsd: 50, stopPrice: 103, takeProfitPrice: 92 }, ctx(db))).toMatch(/Opened/);
+    expect(calls.open).toHaveBeenCalledWith(expect.objectContaining({ marketIndex: 0, direction: "short", baseAmount: 0.5, stopPrice: 103, takeProfitPrice: 92, worstPrice: 99 }));
+    expect(await open.execute({ market: "DOGE-PERP", direction: "long", sizeUsd: 10, stopPrice: 1 }, ctx(db))).toMatch(/market must be/);
+    expect(await open.execute({ market: "BTC-PERP", direction: "long", sizeUsd: 30, stopPrice: 80 }, ctx(db))).toMatch(/risk at stop/);
+  });
+
+  it("records realized PnL when flat, counted by trade_stats and the weekly gain", async () => {
+    const db = freshDb();
+    setKv(db, "perp.net_deposits", "50");
+    const state = {
+      account: {
+        exists: true, valueUsd: 53, freeCollateralUsd: 40, openOrders: 1,
+        positions: [{ market: "SOL-PERP", marketIndex: 0, baseAmount: 0.5, entryPrice: 100, notionalUsd: 53, unrealizedPnlUsd: 3, liqPrice: 20 }],
+      },
+      price: 106,
+    };
+    const { factory } = fakeAdapter(state);
+    await runPerpTick(db.raw, identity, factory);
+    expect(listLedgerEntries(db.raw).filter((e) => e.kind === "perp_pnl")).toHaveLength(0); // open position: nothing realized
+    const tools = createPerpTools(factory);
+    expect(await tool(tools, "perp_close").execute({ market: "SOL-PERP" }, ctx(db))).toMatch(/Realized PnL recorded: \+\$3.00/);
+    const pnl = listLedgerEntries(db.raw).filter((e) => e.kind === "perp_pnl");
+    expect(pnl).toHaveLength(1);
+    expect(getDailyGain(db.raw, pnl[0].day).gainUsd).toBeCloseTo(3);
+    expect(computeTradeStats(db.raw).totalPnlUsd).toBeCloseTo(3);
+    await runPerpTick(db.raw, identity, factory); // no double count
+    expect(listLedgerEntries(db.raw).filter((e) => e.kind === "perp_pnl")).toHaveLength(1);
+  });
+
+  it("warns once when a position nears liquidation", async () => {
+    const db = freshDb();
+    setKv(db, "perp.net_deposits", "50");
+    const state = {
+      account: {
+        exists: true, valueUsd: 30, freeCollateralUsd: 2, openOrders: 1,
+        positions: [{ market: "SOL-PERP", marketIndex: 0, baseAmount: 2, entryPrice: 100, notionalUsd: 192, unrealizedPnlUsd: -20, liqPrice: 92 }],
+      },
+      price: 95,
+    };
+    const { factory } = fakeAdapter(state);
+    await runPerpTick(db.raw, identity, factory);
+    await runPerpTick(db.raw, identity, factory);
+    const notices = db.raw.prepare("SELECT content FROM inbox_messages WHERE from_address = 'system:perps'").all();
+    expect(notices).toHaveLength(1);
+  });
+});
+
+describe("valuation with Drift", () => {
+  it("adds a fresh Drift value and marks a stale one incomplete, never zero", () => {
+    const db = freshDb();
+    expect(perpValuationAsset(db.raw)).toBeNull();
+    setKv(db, "perp.net_deposits", "40");
+    setKv(db, "perp.account", JSON.stringify({ valueUsd: 41, freeCollateralUsd: 41, positions: [], openOrders: 0, at: new Date().toISOString() }));
+    const balances = { sol: 0, usdc: 59, tokens: [] };
+    const fresh = buildCentralWalletValuation({ balances, solPriceUsd: 150, extraAssets: [perpValuationAsset(db.raw)!] });
+    expect(fresh).toMatchObject({ knownValueUsd: 100, complete: true });
+    const stale = perpValuationAsset(db.raw, new Date(Date.now() + 3_600_000))!;
+    expect(buildCentralWalletValuation({ balances, solPriceUsd: 150, extraAssets: [stale] })).toMatchObject({ knownValueUsd: 59, complete: false });
+  });
+});
