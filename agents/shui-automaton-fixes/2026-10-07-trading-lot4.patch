diff --git a/src/solana/perps.ts b/src/solana/perps.ts
new file mode 100644
index 0000000..3cff29d
--- /dev/null
+++ b/src/solana/perps.ts
@@ -0,0 +1,707 @@
+/**
+ * Lot 4: leveraged perpetuals on Drift (SOL-PERP, BTC-PERP, ETH-PERP), long or
+ * short, with the safeguards validated by the creator:
+ *   - leverage max 5x (the first 5 trades at 1x);
+ *   - at most 50% of the total capital as Drift collateral;
+ *   - a stop-loss is mandatory and lives on Drift (reduce-only trigger order
+ *     placed in the same transaction as the entry), so it works while SHUI sleeps;
+ *   - the estimated liquidation price must be at least 1.5x the stop distance away;
+ *   - at most 2% of the total capital lost if the stop is hit;
+ *   - the drawdown breaker blocks new positions (closing always works).
+ *
+ * The Drift SDK is loaded on demand (pnpm add @drift-labs/sdk@2.156.0), so SHUI
+ * keeps working without it. The signing key stays inside this process, exactly
+ * like the swap pipeline.
+ *
+ * Accounting: the Drift account value (collateral + unrealized PnL) is cached in
+ * kv `perp.account` and added to the wallet valuation. Realized PnL is journaled
+ * in the ledger (kind perp_pnl) whenever the account is flat:
+ * value - net deposits, minus what was already recorded.
+ */
+import type { Database } from "better-sqlite3";
+import type { AutomatonTool } from "../types.js";
+import type { ChainIdentity } from "../identity/chain.js";
+import { recordPerpPnl, recordPerpTransfer } from "./ledger.js";
+import { tradingPausedUntil } from "../survival/risk-guard.js";
+import { queueSystemNotice } from "../integration/creator-chat.js";
+
+export const PERP_LIMITS = {
+  maxLeverage: 5,
+  starterLeverage: 1,
+  starterTrades: 5,
+  maxCollateralShare: 0.5,
+  liqBufferRatio: 1.5,
+  maxRiskPct: 2,
+  /** Taker fee + slippage per side, used in the risk estimate. */
+  feePct: 0.1,
+  /** Worst fill accepted for the market entry, vs the oracle price. */
+  entrySlippagePct: 1,
+} as const;
+
+export const PERP_MARKETS: Record<string, number> = { "SOL-PERP": 0, "BTC-PERP": 1, "ETH-PERP": 2 };
+export const DRIFT_SDK_VERSION = "2.156.0";
+const CACHE_KEY = "perp.account";
+const NET_DEPOSITS_KEY = "perp.net_deposits";
+const RECORDED_CUM_KEY = "perp.recorded_cum";
+const OPENED_COUNT_KEY = "perp.opened_count";
+const CACHE_FRESH_MS = 15 * 60_000;
+const MONITOR_MS = 5 * 60_000;
+
+export type PerpDirection = "long" | "short";
+
+export interface PerpPositionView {
+  market: string;
+  marketIndex: number;
+  /** Signed size in base units (positive = long). */
+  baseAmount: number;
+  entryPrice: number;
+  notionalUsd: number;
+  unrealizedPnlUsd: number;
+  liqPrice: number | null;
+}
+
+export interface DriftAccountView {
+  exists: boolean;
+  /** Collateral + unrealized PnL (USD). */
+  valueUsd: number;
+  freeCollateralUsd: number;
+  positions: PerpPositionView[];
+  openOrders: number;
+}
+
+export interface DriftAdapter {
+  account(): Promise<DriftAccountView>;
+  oraclePrice(marketIndex: number): Promise<number>;
+  /** Minimum size and step for an order, in base units. */
+  sizeRules(marketIndex: number): Promise<{ min: number; step: number }>;
+  /** Liquidation price if the position changed by baseDelta (signed); null = none. */
+  estimateLiqPrice(marketIndex: number, baseDelta: number, entryPrice: number): Promise<number | null>;
+  deposit(usdc: number): Promise<string>;
+  withdraw(usdc: number): Promise<string>;
+  open(params: {
+    marketIndex: number;
+    direction: PerpDirection;
+    baseAmount: number;
+    worstPrice: number;
+    stopPrice: number;
+    takeProfitPrice?: number;
+  }): Promise<string>;
+  /** Cancel the market's orders and close its position at market. */
+  close(marketIndex: number): Promise<string>;
+  dispose(): Promise<void>;
+}
+
+export type AdapterFactory = (identity: ChainIdentity) => Promise<DriftAdapter>;
+
+const getKv = (db: Database, key: string) =>
+  (db.prepare("SELECT value FROM kv WHERE key = ?").get(key) as { value: string } | undefined)?.value ?? null;
+const setKv = (db: Database, key: string, value: string) =>
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(key, value);
+const num = (db: Database, key: string) => Number(getKv(db, key) ?? 0) || 0;
+
+export function marketName(marketIndex: number): string {
+  return Object.entries(PERP_MARKETS).find(([, i]) => i === marketIndex)?.[0] ?? `PERP-${marketIndex}`;
+}
+
+// ─── Pure validation ────────────────────────────────────────────
+
+export interface PerpOpenCheck {
+  direction: PerpDirection;
+  entryPrice: number;
+  sizeUsd: number;
+  stopPrice: number;
+  takeProfitPrice?: number;
+  /** Total capital: wallet + Drift account (USD). */
+  capitalUsd: number;
+  /** Drift account value (USD). */
+  accountValueUsd: number;
+  /** Notional of the other open positions (USD). */
+  otherNotionalUsd: number;
+  liqPrice: number | null;
+  openedCount: number;
+  pausedUntil: string | null;
+}
+
+export interface PerpOpenVerdict {
+  ok: boolean;
+  reasons: string[];
+  leverage: number;
+  maxLeverage: number;
+  riskUsd: number;
+  maxRiskUsd: number;
+}
+
+export function validatePerpOpen(c: PerpOpenCheck): PerpOpenVerdict {
+  const reasons: string[] = [];
+  const starter = c.openedCount < PERP_LIMITS.starterTrades;
+  const maxLeverage = starter ? PERP_LIMITS.starterLeverage : PERP_LIMITS.maxLeverage;
+  const leverage = c.accountValueUsd > 0 ? (c.otherNotionalUsd + c.sizeUsd) / c.accountValueUsd : Infinity;
+  const stopDistance = c.direction === "long" ? c.entryPrice - c.stopPrice : c.stopPrice - c.entryPrice;
+  const units = c.sizeUsd / c.entryPrice;
+  const riskUsd = units * Math.max(0, stopDistance) + c.sizeUsd * (2 * PERP_LIMITS.feePct) / 100;
+  const maxRiskUsd = (c.capitalUsd * PERP_LIMITS.maxRiskPct) / 100;
+
+  if (c.pausedUntil) reasons.push(`circuit breaker active until ${c.pausedUntil}: no new positions (closing still works)`);
+  if (!(c.capitalUsd > 0)) reasons.push("total capital unknown: wait for a fresh wallet valuation");
+  if (!(stopDistance > 0)) {
+    reasons.push(c.direction === "long" ? "a long needs stopPrice below the entry price" : "a short needs stopPrice above the entry price");
+  }
+  if (c.takeProfitPrice !== undefined) {
+    const tpOk = c.direction === "long" ? c.takeProfitPrice > c.entryPrice : c.takeProfitPrice < c.entryPrice;
+    if (!tpOk) reasons.push(c.direction === "long" ? "takeProfitPrice must be above the entry" : "takeProfitPrice must be below the entry");
+  }
+  if (leverage > maxLeverage + 1e-9) {
+    reasons.push(
+      `leverage ${Number.isFinite(leverage) ? leverage.toFixed(2) : "∞"}x > max ${maxLeverage}x` +
+      (starter ? ` (first ${PERP_LIMITS.starterTrades} trades at 1x; ${c.openedCount} done)` : "") +
+      ` — reduce sizeUsd or deposit more collateral`,
+    );
+  }
+  if (stopDistance > 0 && riskUsd > maxRiskUsd + 1e-9) {
+    reasons.push(`risk at stop $${riskUsd.toFixed(2)} > ${PERP_LIMITS.maxRiskPct}% of capital ($${maxRiskUsd.toFixed(2)}) — reduce sizeUsd or tighten the stop`);
+  }
+  if (stopDistance > 0 && c.liqPrice !== null && c.liqPrice > 0) {
+    const liqDistance = c.direction === "long" ? c.entryPrice - c.liqPrice : c.liqPrice - c.entryPrice;
+    if (liqDistance < PERP_LIMITS.liqBufferRatio * stopDistance) {
+      reasons.push(
+        `liquidation $${c.liqPrice.toPrecision(6)} too close: it must be at least ${PERP_LIMITS.liqBufferRatio}x the stop distance away ` +
+        `(stop ${stopDistance.toPrecision(4)}, liquidation ${liqDistance.toPrecision(4)}) — lower the leverage`,
+      );
+    }
+  }
+  return { ok: reasons.length === 0, reasons, leverage, maxLeverage, riskUsd, maxRiskUsd };
+}
+
+/** Max new Drift collateral allowed: 50% of total capital minus what is already there. */
+export function maxDepositUsd(capitalUsd: number, accountValueUsd: number): number {
+  return Math.max(0, capitalUsd * PERP_LIMITS.maxCollateralShare - accountValueUsd);
+}
+
+export function roundToStep(value: number, step: number): number {
+  if (!(step > 0)) return value;
+  return Math.floor(value / step + 1e-9) * step;
+}
+
+// ─── Account cache, valuation, PnL ──────────────────────────────
+
+export interface PerpCache {
+  valueUsd: number;
+  freeCollateralUsd: number;
+  positions: PerpPositionView[];
+  openOrders: number;
+  at: string;
+}
+
+export function savePerpCache(db: Database, account: DriftAccountView, now: Date = new Date()): void {
+  const cache: PerpCache = {
+    valueUsd: account.valueUsd,
+    freeCollateralUsd: account.freeCollateralUsd,
+    positions: account.positions,
+    openOrders: account.openOrders,
+    at: now.toISOString(),
+  };
+  setKv(db, CACHE_KEY, JSON.stringify(cache));
+}
+
+export function readPerpCache(db: Database): PerpCache | null {
+  try {
+    const raw = getKv(db, CACHE_KEY);
+    return raw ? (JSON.parse(raw) as PerpCache) : null;
+  } catch {
+    return null;
+  }
+}
+
+/** True once SHUI ever deposited on Drift. */
+export function perpsInUse(db: Database): boolean {
+  return getKv(db, NET_DEPOSITS_KEY) !== null;
+}
+
+/**
+ * The Drift account as a wallet asset for the valuation: priced when the cache
+ * is fresh, unpriced (valuation incomplete, never zero) when it is stale.
+ */
+export function perpValuationAsset(db: Database, now: Date = new Date()):
+  { assetId: string; symbol: string; amount: number; priceUsd: number | null } | null {
+  if (!perpsInUse(db)) return null;
+  const cache = readPerpCache(db);
+  const fresh = cache && now.getTime() - Date.parse(cache.at) <= CACHE_FRESH_MS;
+  if (fresh && cache) return { assetId: "DRIFT", symbol: "DRIFT", amount: Math.max(0, cache.valueUsd), priceUsd: 1 };
+  if (num(db, NET_DEPOSITS_KEY) <= 0 && cache && cache.valueUsd <= 0.01) return null;
+  return { assetId: "DRIFT", symbol: "DRIFT", amount: 1, priceUsd: null };
+}
+
+function addNetDeposits(db: Database, deltaUsd: number): void {
+  setKv(db, NET_DEPOSITS_KEY, String(num(db, NET_DEPOSITS_KEY) + deltaUsd));
+}
+
+/**
+ * When the account is flat, journal the PnL not yet recorded
+ * (value - net deposits - already recorded): fees, funding and closed trades.
+ */
+export function recordFlatPnl(db: Database, account: DriftAccountView, now: Date = new Date()): number | null {
+  if (!account.exists || account.positions.length > 0 || !perpsInUse(db)) return null;
+  const cum = account.valueUsd - num(db, NET_DEPOSITS_KEY);
+  const delta = cum - num(db, RECORDED_CUM_KEY);
+  if (Math.abs(delta) < 0.005) return null;
+  recordPerpPnl(db, { at: now, pnlUsd: delta, details: { valueUsd: account.valueUsd, netDeposits: num(db, NET_DEPOSITS_KEY) } });
+  setKv(db, RECORDED_CUM_KEY, String(cum));
+  return delta;
+}
+
+export function formatPerpAccount(account: DriftAccountView, db: Database): string {
+  if (!account.exists) return "No Drift account yet. Use perp_deposit first (it creates the account).";
+  const net = num(db, NET_DEPOSITS_KEY);
+  const lines = [
+    `Drift account: value $${account.valueUsd.toFixed(2)} | free collateral $${account.freeCollateralUsd.toFixed(2)} | ` +
+    `net deposits $${net.toFixed(2)} | all-time PnL ${account.valueUsd - net >= 0 ? "+" : ""}$${(account.valueUsd - net).toFixed(2)} | open orders ${account.openOrders}`,
+  ];
+  if (account.positions.length === 0) lines.push("No open position.");
+  for (const p of account.positions) {
+    lines.push(
+      `- ${p.market} ${p.baseAmount > 0 ? "LONG" : "SHORT"} ${Math.abs(p.baseAmount)} @ $${p.entryPrice.toPrecision(6)} ` +
+      `(notional $${p.notionalUsd.toFixed(2)}, uPnL ${p.unrealizedPnlUsd >= 0 ? "+" : ""}$${p.unrealizedPnlUsd.toFixed(2)}, ` +
+      `liquidation ${p.liqPrice ? `$${p.liqPrice.toPrecision(6)}` : "none"})`,
+    );
+  }
+  const opened = num(db, OPENED_COUNT_KEY);
+  lines.push(
+    `Limits: leverage max ${opened < PERP_LIMITS.starterTrades ? `1x (starter: ${opened}/${PERP_LIMITS.starterTrades} trades done, then 5x)` : `${PERP_LIMITS.maxLeverage}x`}, ` +
+    `collateral max ${PERP_LIMITS.maxCollateralShare * 100}% of capital, risk max ${PERP_LIMITS.maxRiskPct}% at the stop.`,
+  );
+  return lines.join("\n");
+}
+
+/** Total capital (wallet incl. Drift) from the last valuation, or null. */
+export function lastCapitalUsd(db: Database): number | null {
+  try {
+    const raw = getKv(db, "last_known_balance");
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as { walletValueUsd?: number | null; walletValueComplete?: boolean };
+    return parsed.walletValueComplete && typeof parsed.walletValueUsd === "number" && parsed.walletValueUsd > 0
+      ? parsed.walletValueUsd
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+// ─── Real adapter (Drift SDK, loaded on demand) ─────────────────
+
+export const sdkAdapterFactory: AdapterFactory = async (identity) => {
+  const moduleName = "@drift-labs/sdk";
+  let sdk: any;
+  try {
+    sdk = await import(moduleName);
+  } catch {
+    throw new Error(`Drift SDK not installed. Ask your creator to run, in /home/automaton/workspace/automaton-main: pnpm add @drift-labs/sdk@${DRIFT_SDK_VERSION} && pnpm build, then restart SHUI.`);
+  }
+  const web3 = await import("@solana/web3.js");
+  const { DEFAULT_SOLANA_RPC } = await import("./trading.js");
+  const withKey = identity as ChainIdentity & { getSecretKey?: () => Uint8Array };
+  if (typeof withKey.getSecretKey !== "function") throw new Error("Solana identity does not expose a local signer");
+  const keypair = web3.Keypair.fromSecretKey(withKey.getSecretKey());
+  if (keypair.publicKey.toBase58() !== identity.address) throw new Error("Signer public key does not match central SHUI wallet");
+
+  const connection = new web3.Connection(DEFAULT_SOLANA_RPC, "confirmed");
+  const programId = new web3.PublicKey(sdk.DRIFT_PROGRAM_ID);
+  const userKey = sdk.getUserAccountPublicKeySync(programId, keypair.publicKey, 0);
+  let exists = !!(await connection.getAccountInfo(userKey));
+  const accountLoader = new sdk.BulkAccountLoader(connection, "confirmed", 0);
+  const client = new sdk.DriftClient({
+    connection,
+    wallet: new sdk.Wallet(keypair),
+    env: "mainnet-beta",
+    accountSubscription: { type: "polling", accountLoader },
+    perpMarketIndexes: Object.values(PERP_MARKETS),
+    spotMarketIndexes: [0],
+    subAccountIds: [0],
+    skipLoadUsers: !exists,
+  });
+  await client.subscribe();
+  const BN = sdk.BN;
+  const P = { base: 1e9, price: 1e6, quote: 1e6 };
+  const toBn = (value: number, precision: number) => new BN(Math.round(value * precision).toString());
+  const toNum = (bn: any, precision: number) => Number(bn.toString()) / precision;
+
+  const user = () => client.getUser();
+  const refresh = async () => {
+    if (exists) await user().fetchAccounts();
+    await accountLoader.load();
+  };
+  const ata = () => client.getAssociatedTokenAccount(0);
+
+  const adapter: DriftAdapter = {
+    async account() {
+      if (!exists) return { exists: false, valueUsd: 0, freeCollateralUsd: 0, positions: [], openOrders: 0 };
+      await refresh();
+      const u = user();
+      const positions: PerpPositionView[] = u.getActivePerpPositions().map((p: any) => {
+        const base = toNum(p.baseAssetAmount, P.base);
+        const quoteEntry = Math.abs(toNum(p.quoteEntryAmount, P.quote));
+        const oracle = toNum(client.getOracleDataForPerpMarket(p.marketIndex).price, P.price);
+        const liq = toNum(u.liquidationPrice(p.marketIndex), P.price);
+        return {
+          market: marketName(p.marketIndex),
+          marketIndex: p.marketIndex,
+          baseAmount: base,
+          entryPrice: base !== 0 ? quoteEntry / Math.abs(base) : 0,
+          notionalUsd: Math.abs(base) * oracle,
+          unrealizedPnlUsd: toNum(u.getUnrealizedPNL(true, p.marketIndex), P.quote),
+          liqPrice: liq > 0 ? liq : null,
+        };
+      }).filter((p: PerpPositionView) => p.baseAmount !== 0);
+      return {
+        exists: true,
+        valueUsd: toNum(u.getNetUsdValue(), P.quote),
+        freeCollateralUsd: toNum(u.getFreeCollateral(), P.quote),
+        positions,
+        openOrders: u.getOpenOrders().length,
+      };
+    },
+    async oraclePrice(marketIndex) {
+      return toNum(client.getOracleDataForPerpMarket(marketIndex).price, P.price);
+    },
+    async sizeRules(marketIndex) {
+      const market = client.getPerpMarketAccount(marketIndex);
+      return { min: toNum(market.amm.minOrderSize, P.base), step: toNum(market.amm.orderStepSize, P.base) };
+    },
+    async estimateLiqPrice(marketIndex, baseDelta, entryPrice) {
+      if (!exists) return null;
+      const liq = toNum(user().liquidationPrice(marketIndex, toBn(baseDelta, P.base), toBn(entryPrice, P.price)), P.price);
+      return liq > 0 ? liq : null;
+    },
+    async deposit(usdc) {
+      const amount = toBn(usdc, P.quote);
+      if (!exists) {
+        const [sig] = await client.initializeUserAccountAndDepositCollateral(amount, await ata(), 0, 0);
+        exists = true;
+        try {
+          await client.addUser(0);
+        } catch {
+          // the deposit landed; the next call loads the new account
+        }
+        return sig;
+      }
+      return client.deposit(amount, 0, await ata());
+    },
+    async withdraw(usdc) {
+      return client.withdraw(toBn(usdc, P.quote), 0, await ata(), true);
+    },
+    async open(p) {
+      const dir = p.direction === "long" ? sdk.PositionDirection.LONG : sdk.PositionDirection.SHORT;
+      const exit = p.direction === "long" ? sdk.PositionDirection.SHORT : sdk.PositionDirection.LONG;
+      const base = toBn(p.baseAmount, P.base);
+      const orders = [
+        sdk.getMarketOrderParams({ marketIndex: p.marketIndex, marketType: sdk.MarketType.PERP, direction: dir, baseAssetAmount: base, price: toBn(p.worstPrice, P.price) }),
+        sdk.getTriggerMarketOrderParams({
+          marketIndex: p.marketIndex, marketType: sdk.MarketType.PERP, direction: exit, baseAssetAmount: base, reduceOnly: true,
+          triggerPrice: toBn(p.stopPrice, P.price),
+          triggerCondition: p.direction === "long" ? sdk.OrderTriggerCondition.BELOW : sdk.OrderTriggerCondition.ABOVE,
+        }),
+      ];
+      if (p.takeProfitPrice) {
+        orders.push(sdk.getTriggerMarketOrderParams({
+          marketIndex: p.marketIndex, marketType: sdk.MarketType.PERP, direction: exit, baseAssetAmount: base, reduceOnly: true,
+          triggerPrice: toBn(p.takeProfitPrice, P.price),
+          triggerCondition: p.direction === "long" ? sdk.OrderTriggerCondition.ABOVE : sdk.OrderTriggerCondition.BELOW,
+        }));
+      }
+      return client.placeOrders(orders.map((o: any) => sdk.getOrderParams(o)));
+    },
+    async close(marketIndex) {
+      await refresh();
+      try {
+        await client.cancelOrders(sdk.MarketType.PERP, marketIndex);
+      } catch {
+        // no open order on this market
+      }
+      const pos = user().getPerpPosition(marketIndex);
+      if (!pos || pos.baseAssetAmount.isZero()) return "no-position";
+      return client.closePosition(marketIndex);
+    },
+    async dispose() {
+      try {
+        await client.unsubscribe();
+      } catch {
+        // ignore
+      }
+    },
+  };
+  return adapter;
+};
+
+// ─── Tools ───────────────────────────────────────────────────────
+
+function solanaIdentity(ctx: { identity: { chainIdentity?: ChainIdentity } }): ChainIdentity | null {
+  const id = ctx.identity.chainIdentity;
+  return id && id.chainType === "solana" ? id : null;
+}
+
+async function withAdapter<T>(factory: AdapterFactory, identity: ChainIdentity, fn: (a: DriftAdapter) => Promise<T>): Promise<T> {
+  const adapter = await factory(identity);
+  try {
+    return await fn(adapter);
+  } finally {
+    await adapter.dispose();
+  }
+}
+
+const errText = (err: unknown) => (err instanceof Error ? err.message : String(err)).slice(0, 400);
+
+export function createPerpTools(factory: AdapterFactory = sdkAdapterFactory): AutomatonTool[] {
+  const marketParam = { type: "string", enum: Object.keys(PERP_MARKETS), description: "SOL-PERP, BTC-PERP or ETH-PERP." };
+  return [
+    {
+      name: "perp_positions",
+      description: "Your Drift perpetuals account: value, free collateral, open long/short positions with PnL and liquidation price, limits.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: {} },
+      execute: async (_args, ctx) => {
+        const identity = solanaIdentity(ctx);
+        if (!identity) return "Solana identity unavailable.";
+        try {
+          return await withAdapter(factory, identity, async (a) => {
+            const account = await a.account();
+            if (account.exists) {
+              savePerpCache(ctx.db.raw, account);
+              recordFlatPnl(ctx.db.raw, account);
+            }
+            return formatPerpAccount(account, ctx.db.raw);
+          });
+        } catch (err) {
+          return `Drift unavailable: ${errText(err)}`;
+        }
+      },
+    },
+    {
+      name: "perp_deposit",
+      description:
+        "Move USDC from your wallet to your Drift account as collateral for perpetuals (creates the account the first time, " +
+        "~0.035 SOL rent, refundable). Max 50% of your total capital on Drift.",
+      category: "financial",
+      riskLevel: "dangerous",
+      parameters: { type: "object", properties: { usdc: { type: "number" }, dryRun: { type: "boolean" } }, required: ["usdc"] },
+      execute: async (args, ctx) => {
+        const identity = solanaIdentity(ctx);
+        if (!identity) return "Solana identity unavailable.";
+        const usdc = Number(args.usdc);
+        if (!(usdc >= 1)) return "Blocked: usdc must be at least 1.";
+        const db = ctx.db.raw;
+        const capital = lastCapitalUsd(db);
+        if (capital === null) return "Blocked: total capital unknown (wallet valuation incomplete). Try again after the next valuation.";
+        try {
+          return await withAdapter(factory, identity, async (a) => {
+            const account = await a.account();
+            const room = maxDepositUsd(capital, account.valueUsd);
+            if (usdc > room + 1e-6) {
+              return `Blocked: Drift collateral would exceed ${PERP_LIMITS.maxCollateralShare * 100}% of your capital ` +
+                `($${capital.toFixed(2)}; already $${account.valueUsd.toFixed(2)} on Drift). Max deposit now: $${room.toFixed(2)}.`;
+            }
+            if (args.dryRun === true) {
+              return `Dry run: would deposit ${usdc} USDC to Drift${account.exists ? "" : " (account creation first)"}. Room left after: $${(room - usdc).toFixed(2)}.`;
+            }
+            const sig = await a.deposit(usdc);
+            addNetDeposits(db, usdc);
+            recordPerpTransfer(db, { signature: sig, direction: "deposit", usdc });
+            const after = await a.account();
+            savePerpCache(db, after);
+            return `Deposited ${usdc} USDC to Drift (tx ${sig}). Account value $${after.valueUsd.toFixed(2)}, free collateral $${after.freeCollateralUsd.toFixed(2)}.`;
+          });
+        } catch (err) {
+          return `Drift deposit failed: ${errText(err)}`;
+        }
+      },
+    },
+    {
+      name: "perp_withdraw",
+      description: 'Move USDC from Drift back to your wallet (only free collateral, never borrows). usdc as a number or "all".',
+      category: "financial",
+      riskLevel: "dangerous",
+      parameters: { type: "object", properties: { usdc: { type: "string" } }, required: ["usdc"] },
+      execute: async (args, ctx) => {
+        const identity = solanaIdentity(ctx);
+        if (!identity) return "Solana identity unavailable.";
+        const db = ctx.db.raw;
+        try {
+          return await withAdapter(factory, identity, async (a) => {
+            const account = await a.account();
+            if (!account.exists) return "No Drift account.";
+            const all = String(args.usdc).trim() === "all";
+            const usdc = all ? Math.floor(account.freeCollateralUsd * 1e6) / 1e6 : Number(args.usdc);
+            if (!(usdc > 0)) return "Blocked: nothing to withdraw (free collateral $" + account.freeCollateralUsd.toFixed(2) + ").";
+            if (usdc > account.freeCollateralUsd + 1e-6) return `Blocked: only $${account.freeCollateralUsd.toFixed(2)} of free collateral.`;
+            const sig = await a.withdraw(usdc);
+            addNetDeposits(db, -usdc);
+            recordPerpTransfer(db, { signature: sig, direction: "withdraw", usdc });
+            const after = await a.account();
+            savePerpCache(db, after);
+            recordFlatPnl(db, after);
+            return `Withdrew ${usdc} USDC from Drift (tx ${sig}). Account value now $${after.valueUsd.toFixed(2)}.`;
+          });
+        } catch (err) {
+          return `Drift withdraw failed: ${errText(err)}`;
+        }
+      },
+    },
+    {
+      name: "perp_open",
+      description:
+        "Open a leveraged LONG or SHORT on Drift (SOL-PERP, BTC-PERP, ETH-PERP). sizeUsd = position notional. stopPrice is mandatory " +
+        "and is placed on Drift with the entry (works while you sleep); takeProfitPrice optional. Checked by code: leverage max 5x " +
+        "(first 5 trades 1x), max 2% of capital lost at the stop, liquidation at least 1.5x the stop distance away, circuit breaker. " +
+        "Use dryRun first to see leverage, risk and liquidation.",
+      category: "financial",
+      riskLevel: "dangerous",
+      parameters: {
+        type: "object",
+        properties: {
+          market: marketParam,
+          direction: { type: "string", enum: ["long", "short"] },
+          sizeUsd: { type: "number" },
+          stopPrice: { type: "number" },
+          takeProfitPrice: { type: "number" },
+          dryRun: { type: "boolean" },
+        },
+        required: ["market", "direction", "sizeUsd", "stopPrice"],
+      },
+      execute: async (args, ctx) => {
+        const identity = solanaIdentity(ctx);
+        if (!identity) return "Solana identity unavailable.";
+        const marketIndex = PERP_MARKETS[String(args.market ?? "")];
+        if (marketIndex === undefined) return `Blocked: market must be one of ${Object.keys(PERP_MARKETS).join(", ")}.`;
+        const direction = String(args.direction) as PerpDirection;
+        if (direction !== "long" && direction !== "short") return 'Blocked: direction must be "long" or "short".';
+        const sizeUsd = Number(args.sizeUsd);
+        const stopPrice = Number(args.stopPrice);
+        const takeProfitPrice = args.takeProfitPrice === undefined ? undefined : Number(args.takeProfitPrice);
+        if (!(sizeUsd > 0) || !(stopPrice > 0) || (takeProfitPrice !== undefined && !(takeProfitPrice > 0))) {
+          return "Blocked: sizeUsd and stopPrice must be positive numbers.";
+        }
+        const db = ctx.db.raw;
+        try {
+          return await withAdapter(factory, identity, async (a) => {
+            const account = await a.account();
+            if (!account.exists || !(account.valueUsd > 0)) return "Blocked: no collateral on Drift. Use perp_deposit first.";
+            if (account.positions.some((p) => p.marketIndex === marketIndex)) {
+              return `Blocked: you already have a ${marketName(marketIndex)} position. Close it first (perp_close) — one position per market.`;
+            }
+            const entryPrice = await a.oraclePrice(marketIndex);
+            const rules = await a.sizeRules(marketIndex);
+            const baseAmount = roundToStep(sizeUsd / entryPrice, rules.step);
+            if (baseAmount < rules.min) {
+              return `Blocked: size too small. ${marketName(marketIndex)} minimum is ${rules.min} units (~$${(rules.min * entryPrice).toFixed(2)}).`;
+            }
+            const realSize = baseAmount * entryPrice;
+            const liqPrice = await a.estimateLiqPrice(marketIndex, direction === "long" ? baseAmount : -baseAmount, entryPrice);
+            const walletCapital = lastCapitalUsd(db);
+            const verdict = validatePerpOpen({
+              direction, entryPrice, sizeUsd: realSize, stopPrice, takeProfitPrice,
+              capitalUsd: walletCapital ?? 0,
+              accountValueUsd: account.valueUsd,
+              otherNotionalUsd: account.positions.reduce((s, p) => s + p.notionalUsd, 0),
+              liqPrice,
+              openedCount: num(db, OPENED_COUNT_KEY),
+              pausedUntil: tradingPausedUntil(db),
+            });
+            const summary =
+              `${marketName(marketIndex)} ${direction.toUpperCase()} ${baseAmount} units (~$${realSize.toFixed(2)}) at ~$${entryPrice.toPrecision(6)}, ` +
+              `stop $${stopPrice}${takeProfitPrice ? `, target $${takeProfitPrice}` : ""} | leverage ${verdict.leverage.toFixed(2)}x (max ${verdict.maxLeverage}x) | ` +
+              `risk at stop $${verdict.riskUsd.toFixed(2)} (max $${verdict.maxRiskUsd.toFixed(2)}) | liquidation ${liqPrice ? `$${liqPrice.toPrecision(6)}` : "none"}`;
+            if (!verdict.ok) return `Blocked: ${verdict.reasons.join("; ")}.\nPlan: ${summary}`;
+            if (args.dryRun === true) return `Dry run OK: ${summary}`;
+            const worstPrice = entryPrice * (direction === "long" ? 1 + PERP_LIMITS.entrySlippagePct / 100 : 1 - PERP_LIMITS.entrySlippagePct / 100);
+            const sig = await a.open({ marketIndex, direction, baseAmount, worstPrice, stopPrice, takeProfitPrice });
+            setKv(db, OPENED_COUNT_KEY, String(num(db, OPENED_COUNT_KEY) + 1));
+            try {
+              savePerpCache(db, await a.account());
+            } catch {
+              // the monitor refreshes it
+            }
+            return `Opened: ${summary} (tx ${sig}). The stop${takeProfitPrice ? " and target are" : " is"} on Drift. ` +
+              "Journal the plan (journal_add) and check it with perp_positions.";
+          });
+        } catch (err) {
+          return `Drift order failed: ${errText(err)}`;
+        }
+      },
+    },
+    {
+      name: "perp_close",
+      description: "Close your Drift position on a market at market price and cancel its stop/target orders. Always allowed.",
+      category: "financial",
+      riskLevel: "dangerous",
+      parameters: { type: "object", properties: { market: marketParam }, required: ["market"] },
+      execute: async (args, ctx) => {
+        const identity = solanaIdentity(ctx);
+        if (!identity) return "Solana identity unavailable.";
+        const marketIndex = PERP_MARKETS[String(args.market ?? "")];
+        if (marketIndex === undefined) return `Blocked: market must be one of ${Object.keys(PERP_MARKETS).join(", ")}.`;
+        const db = ctx.db.raw;
+        try {
+          return await withAdapter(factory, identity, async (a) => {
+            const sig = await a.close(marketIndex);
+            if (sig === "no-position") return `No ${marketName(marketIndex)} position (its open orders were cancelled).`;
+            const after = await a.account();
+            savePerpCache(db, after);
+            const pnl = recordFlatPnl(db, after);
+            return `Closed ${marketName(marketIndex)} (tx ${sig}).` +
+              (pnl !== null ? ` Realized PnL recorded: ${pnl >= 0 ? "+" : ""}$${pnl.toFixed(2)}.` : "") +
+              ` Account value $${after.valueUsd.toFixed(2)}. Write the lesson (journal_add).`;
+          });
+        } catch (err) {
+          return `Drift close failed: ${errText(err)}`;
+        }
+      },
+    },
+  ];
+}
+
+// ─── Monitor ─────────────────────────────────────────────────────
+
+/**
+ * One monitor pass: refresh the cache (valuation), record PnL when flat,
+ * warn when a position gets close to liquidation.
+ */
+export async function runPerpTick(db: Database, identity: ChainIdentity, factory: AdapterFactory = sdkAdapterFactory, now: Date = new Date()): Promise<void> {
+  if (!perpsInUse(db)) return;
+  await withAdapter(factory, identity, async (a) => {
+    const account = await a.account();
+    if (!account.exists) return;
+    savePerpCache(db, account, now);
+    recordFlatPnl(db, account, now);
+    for (const p of account.positions) {
+      if (!p.liqPrice) continue;
+      const price = await a.oraclePrice(p.marketIndex);
+      const distPct = (Math.abs(price - p.liqPrice) / price) * 100;
+      const warnKey = `perp.liq_warned.${p.marketIndex}`;
+      if (distPct < 5 && getKv(db, warnKey) !== p.entryPrice.toString()) {
+        setKv(db, warnKey, p.entryPrice.toString());
+        queueSystemNotice(db, "system:perps",
+          `${p.market} is ${distPct.toFixed(1)}% from liquidation (price $${price.toPrecision(6)}, liquidation $${p.liqPrice.toPrecision(6)}). ` +
+          "Check that your stop is still in place (perp_positions) or reduce the position (perp_close).", now);
+      }
+    }
+  });
+}
+
+export function startPerpMonitor(db: Database, identity: ChainIdentity | undefined, log: (m: string) => void = () => {}): NodeJS.Timeout | null {
+  if (!identity || identity.chainType !== "solana") return null;
+  let running = false;
+  const tick = async () => {
+    if (running || !perpsInUse(db)) return;
+    running = true;
+    try {
+      await runPerpTick(db, identity);
+    } catch (err) {
+      log(`[PERPS] monitor: ${errText(err)}`);
+    } finally {
+      running = false;
+    }
+  };
+  const timer = setInterval(() => void tick(), MONITOR_MS);
+  timer.unref();
+  void tick();
+  return timer;
+}
