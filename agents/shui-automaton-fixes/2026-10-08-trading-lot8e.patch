+/**
+ * Lot 8e: SOL needed before a swap. With 0.00987 SOL every stop-loss was
+ * refused by the 0.01 SOL reserve, leaving real positions unprotected.
+ *   - sale into USDC (stops, take-profits): 0.002 SOL (fees are ~0.00001);
+ *   - into SOL (refill): 0.003 SOL (temporary wrapped-SOL account);
+ *   - buy of any other token: 0.0125 SOL, so the 0.01 reserve survives the
+ *     ~0.002 SOL rent of a new token account.
+ */
+export function minSolLamportsFor(inputMint: string, outputMint: string): bigint {
+  if (outputMint === USDC_MINT && inputMint !== NATIVE_SOL_MINT) return 2_000_000n;
+  if (outputMint === NATIVE_SOL_MINT) return 3_000_000n;
+  if (outputMint === USDC_MINT) return SOL_FEE_RESERVE_LAMPORTS;
+  return 12_500_000n;
+}
+
 export interface SwapExpectation {
   inputMint: string;
   outputMint: string;
