+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { createDatabase } from "../state/database.js";
+import { minSolLamportsFor } from "../solana/swap-engine.js";
+import { checkSolReserve } from "../solana/sol-reserve.js";
+import { listOutgoingCreatorMessages } from "../integration/creator-chat.js";
+import { tradingFocusPrompt } from "../solana/trading-desk.js";
+
+const SOL = "So11111111111111111111111111111111111111112";
+const USDC = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+const ORCA = "orcaEKTdK7LKz57vaAYr9QeNsVEPfiu6QeMU1kektZE";
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot8e-")), "s.db")).raw;
+
+describe("SOL needed per swap", () => {
+  it("lets stops sell with 0.00987 SOL, allows a refill, and keeps buys above the reserve", () => {
+    const held = 9_869_297n; // the wallet on 08/10
+    expect(held >= minSolLamportsFor(ORCA, USDC)).toBe(true); // stop-loss / take-profit
+    expect(held >= minSolLamportsFor(USDC, SOL)).toBe(true); // refill
+    expect(held >= minSolLamportsFor(USDC, ORCA)).toBe(false); // new buy
+    expect(minSolLamportsFor(USDC, ORCA)).toBe(12_500_000n);
+    expect(minSolLamportsFor(SOL, USDC)).toBe(10_000_000n); // selling SOL itself keeps the reserve
+  });
+});
+
+describe("low SOL notice", () => {
+  it("tells SHUI to refill once a day, and asks the creator when even a refill is impossible", () => {
+    const db = freshDb();
+    const now = new Date("2026-10-08T21:00:00Z");
+    expect(checkSolReserve(db, 12_000_000n, now)).toBe("ok");
+    expect(checkSolReserve(db, 9_869_297n, now)).toBe("refill");
+    expect(checkSolReserve(db, 9_869_297n, now)).toBe("already");
+    const notice = db.prepare("SELECT content FROM inbox_messages WHERE from_address = 'system:wallet'").get() as { content: string };
+    expect(notice.content).toMatch(/jupiter_swap inputMint=EPjF.* outputMint=So111.* amountUsd=2/);
+    expect(checkSolReserve(freshDb(), 1_000_000n, now)).toBe("creator");
+    const db2 = freshDb();
+    checkSolReserve(db2, 1_000_000n, now);
+    expect(listOutgoingCreatorMessages(db2).at(-1)!.content).toMatch(/send ~0.03 SOL/);
+  });
+
+  it("tells SHUI that paper losses never stop real trading", () => {
+    expect(tradingFocusPrompt({})).toMatch(/PAPER losses never stop real trading/);
+  });
+});
