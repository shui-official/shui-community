index 0000000..6ba87b8
--- /dev/null
+++ b/src/solana/sol-reserve.ts
@@ -0,0 +1,32 @@
+/**
+ * Lot 8e: when SOL falls under the 0.01 reserve, SHUI is told once a day how
+ * to refill it from its USDC (sales and stops keep working meanwhile), and the
+ * creator is told when the SOL is too low even for that.
+ */
+import type { Database } from "better-sqlite3";
+import { queueSystemNotice, saveOutgoingCreatorMessage } from "../integration/creator-chat.js";
+import { NATIVE_SOL_MINT, SOL_FEE_RESERVE_LAMPORTS } from "./trading.js";
+
+const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+const ALERT_KEY = "sol_reserve.alert_day";
+/** Below this, even the refill swap cannot pay its temporary account. */
+export const SOL_REFILL_MIN_LAMPORTS = 3_000_000n;
+
+export function checkSolReserve(db: Database, solLamports: bigint, now: Date = new Date()): "ok" | "refill" | "creator" | "already" {
+  if (solLamports >= SOL_FEE_RESERVE_LAMPORTS) return "ok";
+  const day = now.toISOString().slice(0, 10);
+  const last = (db.prepare("SELECT value FROM kv WHERE key = ?").get(ALERT_KEY) as { value: string } | undefined)?.value;
+  if (last === day) return "already";
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(ALERT_KEY, day);
+  const sol = (Number(solLamports) / 1e9).toFixed(6);
+  if (solLamports >= SOL_REFILL_MIN_LAMPORTS) {
+    queueSystemNotice(db, "system:wallet",
+      `SOL low: ${sol} SOL < 0.01 reserve. New buys are blocked; sales and stops still work. ` +
+      `Refill now: jupiter_swap inputMint=${USDC_MINT} outputMint=${NATIVE_SOL_MINT} amountUsd=2.`, now);
+    return "refill";
+  }
+  saveOutgoingCreatorMessage(db,
+    `My SOL is ${sol} SOL: too low even to swap USDC into SOL. Please send ~0.03 SOL to my wallet so my stops can execute.`, now);
+  queueSystemNotice(db, "system:wallet", `SOL critically low (${sol} SOL): your creator was asked to send SOL.`, now);
+  return "creator";
+}
