index 0000000..29b5e4c
--- /dev/null
+++ b/src/solana/quant.ts
@@ -0,0 +1,140 @@
+/**
+ * Quantitative helpers adapted from OpenBB (github.com/OpenBB-finance/OpenBB,
+ * Apache-2.0): openbb_technical (Clenow momentum, Yang-Zhang volatility) and
+ * openbb_quantitative (Sharpe, Sortino, Omega). Rewritten in TypeScript, no
+ * dependency.
+ */
+import type { Candle } from "./technical-analysis.js";
+
+/**
+ * Clenow volatility-adjusted momentum: slope of a linear regression on log
+ * prices, annualized, multiplied by the R² of the fit. A steady trend scores
+ * high; a jumpy one with the same gain scores low.
+ */
+export function clenowMomentum(closes: number[], window = 90, periodsPerYear = 2190):
+  { r2: number; annualizedPct: number; score: number } | null {
+  const values = closes.slice(-window).filter((v) => v > 0);
+  if (values.length < Math.min(window, 30)) return null;
+  const y = values.map(Math.log);
+  const n = y.length;
+  const xMean = (n - 1) / 2;
+  const yMean = y.reduce((s, v) => s + v, 0) / n;
+  let sxy = 0;
+  let sxx = 0;
+  for (let i = 0; i < n; i++) {
+    sxy += (i - xMean) * (y[i] - yMean);
+    sxx += (i - xMean) ** 2;
+  }
+  const slope = sxx ? sxy / sxx : 0;
+  const intercept = yMean - slope * xMean;
+  let ssRes = 0;
+  let ssTot = 0;
+  for (let i = 0; i < n; i++) {
+    ssRes += (y[i] - (slope * i + intercept)) ** 2;
+    ssTot += (y[i] - yMean) ** 2;
+  }
+  const r2 = ssTot === 0 ? 0 : 1 - ssRes / ssTot;
+  // Cap the exponent: a few days of a parabolic move would otherwise annualize to infinity.
+  const annualizedPct = (Math.exp(Math.max(-50, Math.min(50, slope * periodsPerYear))) - 1) * 100;
+  return { r2, annualizedPct, score: annualizedPct * r2 };
+}
+
+const variance = (xs: number[]): number => {
+  if (xs.length < 2) return 0;
+  const m = xs.reduce((s, v) => s + v, 0) / xs.length;
+  return xs.reduce((s, v) => s + (v - m) ** 2, 0) / (xs.length - 1);
+};
+
+/**
+ * Yang-Zhang volatility per candle (standard deviation of log returns): uses
+ * open, high, low and close, so it reads the real intrabar range and the gaps.
+ */
+export function yangZhang(candles: Candle[], window = 30): number | null {
+  const c = candles.slice(-(window + 1));
+  if (c.length < Math.min(window + 1, 10)) return null;
+  const overnight: number[] = [];
+  const openClose: number[] = [];
+  const rs: number[] = [];
+  for (let i = 1; i < c.length; i++) {
+    const { o, h, l, c: close } = c[i];
+    if (!(o > 0 && h > 0 && l > 0 && close > 0 && c[i - 1].c > 0)) continue;
+    overnight.push(Math.log(o / c[i - 1].c));
+    openClose.push(Math.log(close / o));
+    const ho = Math.log(h / o);
+    const lo = Math.log(l / o);
+    const co = Math.log(close / o);
+    rs.push(ho * (ho - co) + lo * (lo - co));
+  }
+  const n = rs.length;
+  if (n < 2) return null;
+  const k = 0.34 / (1.34 + (n + 1) / (n - 1));
+  const sigma2 = variance(overnight) + k * variance(openClose) + (1 - k) * (rs.reduce((s, v) => s + v, 0) / n);
+  return sigma2 > 0 ? Math.sqrt(sigma2) : 0;
+}
+
+/**
+ * Share of capital to risk at the stop, from the token's daily volatility:
+ * calm tokens keep the playbook's 2%, wild ones risk less.
+ */
+export function volAdjustedRiskPct(dailyVolPct: number | null): number {
+  if (dailyVolPct === null || !Number.isFinite(dailyVolPct)) return 1;
+  if (dailyVolPct <= 4) return 2;
+  if (dailyVolPct <= 8) return 1.5;
+  return 1;
+}
+
+export interface PerformanceMetrics {
+  trades: number;
+  profitFactor: number | null;
+  /** Mean / standard deviation of trade results (per trade, not annualized). */
+  sharpe: number | null;
+  /** Mean / downside deviation (only losses count as risk). */
+  sortino: number | null;
+  /** Sum of gains / sum of losses around 0 (Omega ratio at threshold 0). */
+  omega: number | null;
+  maxDrawdownUsd: number;
+  avgWinUsd: number | null;
+  avgLossUsd: number | null;
+}
+
+export function performanceMetrics(pnls: number[]): PerformanceMetrics {
+  const trades = pnls.length;
+  const wins = pnls.filter((p) => p > 0);
+  const losses = pnls.filter((p) => p < 0);
+  const gross = wins.reduce((s, p) => s + p, 0);
+  const lost = -losses.reduce((s, p) => s + p, 0);
+  const mean = trades ? pnls.reduce((s, p) => s + p, 0) / trades : 0;
+  const sd = Math.sqrt(variance(pnls));
+  const downside = trades ? Math.sqrt(pnls.reduce((s, p) => s + Math.min(0, p) ** 2, 0) / trades) : 0;
+  let peak = 0;
+  let cum = 0;
+  let maxDrawdownUsd = 0;
+  for (const p of pnls) {
+    cum += p;
+    peak = Math.max(peak, cum);
+    maxDrawdownUsd = Math.max(maxDrawdownUsd, peak - cum);
+  }
+  return {
+    trades,
+    profitFactor: lost > 0 ? gross / lost : gross > 0 ? Infinity : null,
+    sharpe: trades >= 2 && sd > 0 ? mean / sd : null,
+    sortino: trades >= 2 && downside > 0 ? mean / downside : null,
+    omega: lost > 0 ? gross / lost : null,
+    maxDrawdownUsd,
+    avgWinUsd: wins.length ? gross / wins.length : null,
+    avgLossUsd: losses.length ? -lost / losses.length : null,
+  };
+}
+
+export function formatPerformance(m: PerformanceMetrics, capitalUsd: number | null = null): string {
+  if (m.trades < 5) return `Quality metrics: need 5+ closed trades (${m.trades} so far).`;
+  const f = (x: number | null, d = 2) => (x === null ? "?" : x === Infinity ? "∞" : x.toFixed(d));
+  const dd = capitalUsd ? ` (${((m.maxDrawdownUsd / capitalUsd) * 100).toFixed(1)}% of capital)` : "";
+  const verdict = m.profitFactor !== null && m.profitFactor >= 1.5 && (m.sharpe ?? 0) > 0.2
+    ? "edge confirmed so far"
+    : m.profitFactor !== null && m.profitFactor < 1
+      ? "losing method: fix it before trading bigger"
+      : "no clear edge yet";
+  return `Quality: profit factor ${f(m.profitFactor)} | Sharpe/trade ${f(m.sharpe)} | Sortino/trade ${f(m.sortino)} | ` +
+    `max drawdown $${m.maxDrawdownUsd.toFixed(2)}${dd} → ${verdict}.`;
+}
