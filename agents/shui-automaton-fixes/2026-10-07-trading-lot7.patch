+import { describe, expect, it } from "vitest";
+import { clenowMomentum, formatPerformance, performanceMetrics, volAdjustedRiskPct, yangZhang } from "../solana/quant.js";
+import { classifyRegime, readDeribit } from "../solana/market-regime.js";
+import { annotateSetup } from "../solana/trading-desk.js";
+import type { Candle } from "../solana/technical-analysis.js";
+
+const candles = (closes: number[], wick = 0.01): Candle[] =>
+  closes.map((c, i) => ({ t: i, o: i ? closes[i - 1] : c, h: Math.max(c, i ? closes[i - 1] : c) * (1 + wick), l: Math.min(c, i ? closes[i - 1] : c) * (1 - wick), c, v: 100 }));
+
+describe("Clenow momentum", () => {
+  it("ranks a steady trend above a jumpy one with the same gain", () => {
+    const steady = Array.from({ length: 90 }, (_, i) => 100 * Math.exp(0.002 * i));
+    const jumpy = steady.map((v, i) => v * (1 + (i % 2 ? 0.08 : -0.08)));
+    const a = clenowMomentum(steady)!;
+    const b = clenowMomentum(jumpy)!;
+    expect(a.r2).toBeGreaterThan(0.99);
+    expect(a.annualizedPct).toBeGreaterThan(0);
+    expect(a.score).toBeGreaterThan(b.score);
+    expect(clenowMomentum([1, 2])).toBeNull();
+  });
+});
+
+describe("Yang-Zhang volatility and sizing", () => {
+  it("is higher for wider candles and sets the risk per trade", () => {
+    const base = Array.from({ length: 60 }, (_, i) => 100 + Math.sin(i / 3));
+    const calm = yangZhang(candles(base, 0.002))!;
+    const wild = yangZhang(candles(base, 0.05))!;
+    expect(wild).toBeGreaterThan(calm);
+    expect(volAdjustedRiskPct(3)).toBe(2);
+    expect(volAdjustedRiskPct(6)).toBe(1.5);
+    expect(volAdjustedRiskPct(15)).toBe(1);
+    expect(volAdjustedRiskPct(null)).toBe(1);
+  });
+
+  it("annotates a setup with momentum, volatility and a size that risks the right share", () => {
+    const closes = Array.from({ length: 120 }, (_, i) => 100 * Math.exp(0.003 * i));
+    const r = annotateSetup(
+      { symbol: "X", mint: "M", ok: true, reason: "", side: "long", plan: { entry: 100, stop: 95, target: 115, rr: 3, stopPct: 5, targetPct: 15 } },
+      candles(closes, 0.003), candles(closes, 0.003), 100,
+    );
+    expect(r.momentum!.score).toBeGreaterThan(0);
+    expect(r.sizeUsd).toBeCloseTo((100 * r.riskPct!) / 5);
+  });
+});
+
+describe("performance metrics", () => {
+  it("computes profit factor, Sharpe, Sortino and drawdown", () => {
+    const m = performanceMetrics([2, -1, 3, -1, -1, 2]);
+    expect(m.profitFactor).toBeCloseTo(7 / 3);
+    expect(m.sharpe).toBeGreaterThan(0);
+    expect(m.sortino).toBeGreaterThan(m.sharpe!);
+    expect(m.maxDrawdownUsd).toBeCloseTo(2);
+    expect(formatPerformance(m, 100)).toMatch(/profit factor 2.33.*edge confirmed/);
+    expect(formatPerformance(performanceMetrics([1, -1]))).toMatch(/need 5\+/);
+  });
+});
+
+describe("Deribit in the market regime", () => {
+  it("flags crowded longs and a volatility spike", async () => {
+    const now = Date.parse("2026-10-07T12:00:00Z");
+    const get = async (url: string) => {
+      if (url.includes("get_book_summary_by_instrument")) return { result: [{ funding_8h: 0.0005 }] };
+      return { result: { data: [[now - 24 * 3_600_000, 0, 0, 0, 40], [now - 3_600_000, 0, 0, 0, 50]] } };
+    };
+    const d = await readDeribit(get, now);
+    expect(d.funding8hPct).toBeCloseTo(0.05);
+    expect(d.dvol).toBe(50);
+    expect(d.dvolChange24hPct).toBeCloseTo(25);
+    const base = { btc7d: null, btc24h: null, sol7d: null, sol24h: null, fearGreed: null, solDexVolume24h: null, solDexVolumeChange7d: null, solDailyTrendUp: null };
+    const r = classifyRegime({ ...base, ...d });
+    expect(r.score).toBe(-2);
+    expect(r.reasons.join()).toMatch(/crowded leveraged longs/);
+    expect(r.reasons.join()).toMatch(/volatility jumping/);
+    const failing = await readDeribit(async () => { throw new Error("down"); }, now);
+    expect(failing).toMatchObject({ funding8hPct: null, dvol: null });
+  });
+});
