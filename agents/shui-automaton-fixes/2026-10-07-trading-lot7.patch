+/**
+ * Rank and size a setup (lot 7): Clenow momentum on the 4h chart, Yang-Zhang
+ * daily volatility from 1h candles, risk 2% / 1.5% / 1% of capital depending
+ * on that volatility, and the position size that loses exactly that at the stop.
+ */
+export function annotateSetup(result: SetupResult, h4: Candle[], h1: Candle[], capitalUsd: number | null): SetupResult {
+  const momentum = clenowMomentum(h4.map((c) => c.c), 90, 6 * 365);
+  const sigma1h = yangZhang(h1, 48);
+  const dailyVolPct = sigma1h === null ? null : sigma1h * Math.sqrt(24) * 100;
+  const riskPct = volAdjustedRiskPct(dailyVolPct);
+  const stopPct = result.plan!.stopPct;
+  const sizeUsd = capitalUsd && stopPct > 0 ? Math.min(capitalUsd, (capitalUsd * riskPct) / stopPct) : null;
+  const stopInNoise = sigma1h !== null && stopPct < sigma1h * 2 * 100;
+  return { ...result, momentum, dailyVolPct, riskPct, sizeUsd, stopInNoise };
+}
+
+function sizingText(s: SetupResult): string {
+  const parts: string[] = [];
