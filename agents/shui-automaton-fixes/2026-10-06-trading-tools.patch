+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createDatabase, claimInboxMessages } from "../state/database.js";
+import { buildRaydiumSwapTransactions, USDC_MINT, SOL_MINT } from "../solana/raydium.js";
+import { parseJupiterQuote, validateJupiterSwap, JUPITER_PROGRAM_ID } from "../solana/jupiter.js";
+import { marketScan, formatRow } from "../solana/market-scan.js";
+import { classifySwapResult, isTriggered, listOrders, runOrderTick, saveOrder, type Order } from "../solana/orders.js";
+import { parsePublicListeners, stopPublicListeners } from "../services/public-listeners.js";
+import { listOutgoingCreatorMessages, saveOutgoingCreatorMessage } from "../integration/creator-chat.js";
+import { createPaymentTools } from "../solana/payment-tools.js";
+
+const WALLET = "7VHUFJHWu2CuExkJcJrzhQPJ2oygupTWkL2A2For4BmE";
+const BONK = "DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263";
+
+function freshDb() {
+  return createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "trade-")), "state.db"));
+}
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe("raydium build", () => {
+  it("sends the wallet's input token account (fixes REQ_INPUT_ACCOUT_ERROR)", async () => {
+    const fetchMock = vi.fn(async () => new Response(JSON.stringify({ success: true, id: "x", version: "V0", data: [{ transaction: "AA==" }] })));
+    vi.stubGlobal("fetch", fetchMock);
+    await buildRaydiumSwapTransactions({
+      wallet: WALLET, swapResponse: {}, inputMint: USDC_MINT, outputMint: SOL_MINT, inputAccount: "USDCACCOUNT", outputAccount: null,
+    });
+    const body = JSON.parse((fetchMock.mock.calls[0] as any)[1].body);
+    expect(body).toMatchObject({ inputAccount: "USDCACCOUNT", wrapSol: false, unwrapSol: true });
+    expect(body.outputAccount).toBeUndefined();
+  });
+});
+
+describe("jupiter", () => {
+  const quote = { inputMint: USDC_MINT, outputMint: SOL_MINT, inAmount: "5000000", outAmount: "41000000", otherAmountThreshold: "40795000", swapMode: "ExactIn", slippageBps: 50, priceImpactPct: "0.0001" };
+
+  it("parses an exact-in quote and rejects mismatches", () => {
+    const q = parseJupiterQuote(quote, { inputMint: USDC_MINT, outputMint: SOL_MINT, inputAmount: 5_000_000n });
+    expect(q).toMatchObject({ outputAmount: 41_000_000n, minimumOutputAmount: 40_795_000n, slippageBps: 50, priceImpactPct: 0.01 });
+    expect(() => parseJupiterQuote(quote, { inputMint: USDC_MINT, outputMint: SOL_MINT, inputAmount: 1n })).toThrow(/input amount/);
+    expect(() => parseJupiterQuote({ ...quote, swapMode: "ExactOut" }, { inputMint: USDC_MINT, outputMint: SOL_MINT, inputAmount: 5_000_000n })).toThrow(/exact-in/);
+  });
+
+  function routeData(inAmount: bigint, out: bigint, slippage: number): string {
+    const b = Buffer.alloc(8 + 4 + 19);
+    b.writeBigUInt64LE(inAmount, 12);
+    b.writeBigUInt64LE(out, 20);
+    b.writeUInt16LE(slippage, 28);
+    return b.toString("hex");
+  }
+
+  function fakeService(instructions: any[], signers = [WALLET]) {
+    return { address: WALLET, inspectTransaction: async () => ({ payer: WALLET, requiredSigners: signers, programs: [], instructions, addressLookupTables: [] }) } as any;
+  }
+
+  const expected = { inputMint: USDC_MINT, outputMint: SOL_MINT, inputAmount: 5_000_000n, minimumOutputAmount: 40_795_000n };
+  const venueQuote = { outputAmount: 41_000_000n, minimumOutputAmount: 40_795_000n, slippageBps: 50, raw: quote };
+
+  it("accepts the quoted route and refuses tampered transactions", async () => {
+    const route = { programId: JUPITER_PROGRAM_ID, accounts: [], dataHex: routeData(5_000_000n, 41_000_000n, 50), dataLength: 31 };
+    await expect(validateJupiterSwap(fakeService([route]), {} as any, expected, venueQuote)).resolves.toBeUndefined();
+    const other = { ...route, dataHex: routeData(9_000_000n, 41_000_000n, 50) };
+    await expect(validateJupiterSwap(fakeService([other]), {} as any, expected, venueQuote)).rejects.toThrow(/quoted input/);
+    const approve = { programId: "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA", accounts: [], dataHex: "04", dataLength: 1 };
+    await expect(validateJupiterSwap(fakeService([route, approve]), {} as any, expected, venueQuote)).rejects.toThrow(/authority/);
+    const transfer = { programId: "11111111111111111111111111111111", accounts: [WALLET, "Attacker1111111111111111111111111111111111"], dataHex: "0200000000e1f50500000000", dataLength: 12 };
+    await expect(validateJupiterSwap(fakeService([route, transfer]), {} as any, expected, venueQuote)).rejects.toThrow(/outside/);
+    await expect(validateJupiterSwap(fakeService([route], [WALLET, "X"]), {} as any, expected, venueQuote)).rejects.toThrow(/signers/);
+  });
+});
+
+describe("market_scan", () => {
+  it("formats trending pools with warnings", async () => {
+    const fetcher = async () => ({
+      data: [{
+        attributes: {
+          name: "BONK / SOL", address: "POOL", base_token_price_usd: "0.0000201", reserve_in_usd: "12000",
+          price_change_percentage: { m5: "1.2", h1: "-3", h6: "5", h24: "12.5" }, volume_usd: { h24: "900000" },
+          fdv_usd: "1500000000", pool_created_at: new Date(Date.now() - 3_600_000).toISOString(), transactions: { h24: { buys: 10, sells: 4 } },
+        },
+        relationships: { base_token: { data: { id: `solana_${BONK}` } } },
+      }],
+    });
+    const text = await marketScan({ mode: "trending" }, fetcher);
+    expect(text).toContain(`BONK mint=${BONK}`);
+    expect(text).toContain("24h +12.5%");
+    expect(text).toContain("THIN LIQUIDITY");
+    expect(text).toContain("NEW PAIR");
+  });
+
+  it("summarises the deepest pool and its candles for a token", async () => {
+    const fetcher = async (url: string) => url.includes("dexscreener")
+      ? [
+        { chainId: "solana", baseToken: { symbol: "BONK", address: BONK }, priceUsd: "0.00002", liquidity: { usd: 5_000_000 }, pairAddress: "DEEP", dexId: "raydium", priceChange: { h24: 2 } },
+        { chainId: "solana", baseToken: { symbol: "BONK", address: BONK }, priceUsd: "0.00002", liquidity: { usd: 10_000 }, pairAddress: "SHALLOW" },
+      ]
+      : { data: { attributes: { ohlcv_list: [[2, 1, 3, 0.5, 2, 10], [1, 1, 2, 0.8, 1, 10]] } } };
+    const text = await marketScan({ mode: "token", query: BONK }, fetcher);
+    expect(text).toContain("dex=raydium");
+    expect(text).toContain("2h candles");
+    expect(text).toContain("2 pools");
+  });
+
+  it("formats a row without data", () => {
+    expect(formatRow({ symbol: "X", mint: "M", priceUsd: null, change: {}, volume24hUsd: null, liquidityUsd: null, fdvUsd: null, createdAt: null })).toContain("price=?");
+  });
+});
+
+describe("automatic orders", () => {
+  const base = (over: Partial<Order> = {}): Order => ({
+    id: "ord_1", kind: "stop_loss", inputMint: BONK, outputMint: USDC_MINT, amount: "1000", watchMint: BONK,
+    condition: "below", triggerPriceUsd: 0.00002, slippageBps: 100, venue: "jupiter", note: "protect", createdAt: new Date().toISOString(),
+    expiresAt: null, status: "open", attempts: 0, updatedAt: new Date().toISOString(), ...over,
+  });
+
+  it("triggers on the right side", () => {
+    expect(isTriggered({ condition: "below", triggerPriceUsd: 10 }, 9)).toBe(true);
+    expect(isTriggered({ condition: "below", triggerPriceUsd: 10 }, 11)).toBe(false);
+    expect(isTriggered({ condition: "above", triggerPriceUsd: 10 }, 10)).toBe(true);
+  });
+
+  it("executes a triggered order, then tells SHUI in its inbox", async () => {
+    const db = freshDb();
+    saveOrder(db.raw, base());
+    const swap = vi.fn(async () => JSON.stringify({ success: true, signature: "SIG" }));
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [BONK]: 0.000019 }), swap });
+    expect(swap).toHaveBeenCalledWith(expect.objectContaining({ id: "ord_1" }), "1000");
+    expect(listOrders(db.raw)[0].status).toBe("filled");
+    const [notice] = claimInboxMessages(db.raw, 10);
+    expect(notice.fromAddress).toBe("system:orders");
+    expect(notice.content).toContain("EXECUTED");
+  });
+
+  it("waits while untriggered, retries a pending lock, fails after 3 errors", async () => {
+    const db = freshDb();
+    saveOrder(db.raw, base());
+    const swap = vi.fn(async () => JSON.stringify({ success: false, blocked: true, reason: "PREVIOUS_TRANSACTION_OUTCOME_UNCERTAIN" }));
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [BONK]: 0.00003 }), swap });
+    expect(swap).not.toHaveBeenCalled();
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [BONK]: 0.00001 }), swap });
+    expect(listOrders(db.raw)[0]).toMatchObject({ status: "open", attempts: 0 });
+    const failing = vi.fn(async () => "error: Jupiter quote HTTP 500");
+    for (let i = 0; i < 3; i++) await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [BONK]: 0.00001 }), swap: failing });
+    expect(listOrders(db.raw)[0]).toMatchObject({ status: "failed", attempts: 3 });
+  });
+
+  it("expires orders and never retries an interrupted execution", async () => {
+    const db = freshDb();
+    saveOrder(db.raw, base({ id: "ord_old", expiresAt: new Date(Date.now() - 1000).toISOString() }));
+    saveOrder(db.raw, base({ id: "ord_exec", status: "executing", updatedAt: new Date(Date.now() - 3_600_000).toISOString() }));
+    const swap = vi.fn();
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({}), swap });
+    const byId = Object.fromEntries(listOrders(db.raw).map((o) => [o.id, o.status]));
+    expect(byId).toEqual({ ord_old: "expired", ord_exec: "failed" });
+    expect(swap).not.toHaveBeenCalled();
+  });
+
+  it("classifies swap results", () => {
+    expect(classifySwapResult(JSON.stringify({ success: true, signature: "S" })).done).toBe(true);
+    expect(classifySwapResult("Blocked: amount must be a positive raw integer.").transient).toBe(false);
+  });
+});
+
+describe("public listeners after exec", () => {
+  const ss = [
+    'LISTEN 0 511 0.0.0.0:3000 0.0.0.0:* users:(("node",pid=4242,fd=18))',
+    'LISTEN 0 511 127.0.0.1:8101 0.0.0.0:* users:(("python3",pid=4343,fd=3))',
+    'LISTEN 0 511 [::]:5000 [::]:* users:(("python3",pid=4444,fd=3))',
+    "LISTEN 0 4096 0.0.0.0:22 0.0.0.0:*",
+  ].join("\n");
+
+  it("finds this user's public listeners only", () => {
+    expect(parsePublicListeners(ss, 1).map((l) => l.pid)).toEqual([4242, 4444]);
+  });
+
+  it("stops them and explains service_deploy", async () => {
+    const killed: number[] = [];
+    const notice = await stopPublicListeners(async () => ss, (pid) => { killed.push(pid); });
+    expect(killed).toEqual([4242, 4444]);
+    expect(notice).toContain("service_deploy");
+    expect(await stopPublicListeners(async () => "", () => {})).toBe("");
+  });
+});
+
+describe("message_creator and payment links", () => {
+  it("stores outgoing messages with an hourly limit", () => {
+    const db = freshDb();
+    const now = new Date();
+    for (let i = 0; i < 6; i++) expect(typeof saveOutgoingCreatorMessage(db.raw, `msg ${i}`, new Date(now.getTime() + i))).toBe("object");
+    expect(saveOutgoingCreatorMessage(db.raw, "one more", new Date(now.getTime() + 10))).toMatch(/Blocked/);
+    expect(listOutgoingCreatorMessages(db.raw).map((m) => m.content)).toEqual(["msg 0", "msg 1", "msg 2", "msg 3", "msg 4", "msg 5"]);
+  });
+
+  it("payment_request says a link is not revenue", async () => {
+    const db = freshDb();
+    const tool = createPaymentTools().find((t) => t.name === "payment_request")!;
+    const out = await tool.execute({ amountUsdc: 1, label: "test" }, { db, identity: { address: WALLET, chainIdentity: { address: WALLET } } } as any);
+    expect(JSON.parse(out).note).toContain("not revenue");
+  });
+});
