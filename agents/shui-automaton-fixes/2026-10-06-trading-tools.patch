diff --git a/src/services/public-listeners.ts b/src/services/public-listeners.ts
new file mode 100644
index 0000000..80dffc8
--- /dev/null
+++ b/src/services/public-listeners.ts
@@ -0,0 +1,59 @@
+import { execFile } from "node:child_process";
+
+/**
+ * Servers started with exec run outside the services sandbox (they can read
+ * /home, including the wallet key) and, when they listen on all interfaces,
+ * outside the reverse proxy. A Node test server was left on 0.0.0.0:3000 this
+ * way. After each exec, processes of this user that listen on a non-loopback
+ * address are stopped; tests on 127.0.0.1 stay allowed. Unprivileged `ss`
+ * only shows the PIDs of this user's own processes.
+ */
+export interface PublicListener {
+  address: string;
+  process: string;
+  pid: number;
+}
+
+const LOOPBACK = /^(127\.|\[::1\]|\[::ffff:127\.|localhost)/;
+
+export function parsePublicListeners(ssOutput: string, ownPid: number = process.pid): PublicListener[] {
+  const out: PublicListener[] = [];
+  for (const line of ssOutput.split("\n")) {
+    const cols = line.trim().split(/\s+/);
+    if (cols.length < 5 || cols[0] !== "LISTEN") continue;
+    const address = cols[3];
+    if (LOOPBACK.test(address)) continue;
+    for (const m of line.matchAll(/\("([^"]+)",pid=(\d+)/g)) {
+      const pid = Number(m[2]);
+      if (pid > 1 && pid !== ownPid) out.push({ address, process: m[1], pid });
+    }
+  }
+  return out;
+}
+
+function listListeners(): Promise<string> {
+  return new Promise((resolve) => {
+    execFile("ss", ["-ltnpH"], { timeout: 5000 }, (error, stdout) => resolve(error ? "" : stdout));
+  });
+}
+
+/** Stop this user's public listeners; returns a notice for the agent, or "" if none. */
+export async function stopPublicListeners(
+  read: () => Promise<string> = listListeners,
+  kill: (pid: number) => void = (pid) => process.kill(pid, "SIGTERM"),
+): Promise<string> {
+  const found = parsePublicListeners(await read());
+  if (found.length === 0) return "";
+  const stopped: string[] = [];
+  for (const l of found) {
+    try {
+      kill(l.pid);
+      stopped.push(`${l.process} (pid ${l.pid}) on ${l.address}`);
+    } catch {
+      // already gone or not ours
+    }
+  }
+  if (stopped.length === 0) return "";
+  return `\n[STOPPED: ${stopped.join(", ")} listened on a public address outside the services sandbox. ` +
+    "Test servers must listen on 127.0.0.1; to publish a service use service_deploy (folder /srv/shui/services/<name>, run.sh, port 8100-8199).]";
+}
