new file mode 100644
index 0000000..6a8ec03
--- /dev/null
+++ b/src/solana/swap-engine.ts
@@ -0,0 +1,179 @@
+/**
+ * One safe path for every swap venue (Raydium, Jupiter) and for automatic
+ * orders: confirmed on-chain balance check with the 0.01 SOL reserve, the
+ * pending-transaction lock, venue-specific validation of the built
+ * transaction, simulation, then signing and journaling in the ledger.
+ */
+import { PublicKey, type VersionedTransaction } from "@solana/web3.js";
+import type { AutomatonDatabase } from "../types.js";
+import type { ChainIdentity } from "../identity/chain.js";
+import {
+  NATIVE_SOL_MINT,
+  SOL_FEE_RESERVE_LAMPORTS,
+  SolanaTradingService,
+  SolanaTransactionUncertainError,
+} from "./trading.js";
+import { checkPendingTransaction, recordPendingTransaction } from "./pending-tx.js";
+import { journalConfirmedSwap, journalResolvedPending } from "./journal.js";
+
+export interface SwapExpectation {
+  inputMint: string;
+  outputMint: string;
+  inputAmount: bigint;
+  minimumOutputAmount: bigint;
+}
+
+export interface VenueQuote {
+  outputAmount: bigint;
+  minimumOutputAmount: bigint;
+  slippageBps: number;
+  priceImpactPct?: number | null;
+  raw: unknown;
+}
+
+export interface SwapVenue {
+  name: "raydium" | "jupiter";
+  quote(params: { inputMint: string; outputMint: string; amount: bigint; slippageBps: number }): Promise<VenueQuote>;
+  build(service: SolanaTradingService, params: {
+    quote: VenueQuote; inputMint: string; outputMint: string; inputAccount: string | null; outputAccount: string | null;
+  }): Promise<VersionedTransaction>;
+  /** Throws if the built transaction is not exactly the quoted swap for SHUI's wallet. */
+  validate(service: SolanaTradingService, transaction: VersionedTransaction, expected: SwapExpectation, quote: VenueQuote): Promise<void>;
+}
+
+export interface SwapRequest {
+  inputMint: string;
+  outputMint: string;
+  amount: string;
+  slippageBps?: number;
+  dryRun?: boolean;
+}
+
+export async function runSwap(
+  ctx: { db: AutomatonDatabase; chainIdentity: ChainIdentity },
+  request: SwapRequest,
+  venue: SwapVenue,
+): Promise<string> {
+  const service = new SolanaTradingService(ctx.chainIdentity);
+  const pendingCheck = await checkPendingTransaction(ctx.db, service);
+  if (pendingCheck.blocked) return pendingCheck.response;
+  if (pendingCheck.resolved) await journalResolvedPending(ctx.db, service, pendingCheck.resolved);
+
+  const { inputMint, outputMint } = request;
+  const amountString = String(request.amount ?? "");
+  const slippageBps = Number(request.slippageBps ?? 50);
+  if (!/^[1-9][0-9]*$/.test(amountString)) return "Blocked: amount must be a positive raw integer.";
+  if (!Number.isInteger(slippageBps) || slippageBps < 1 || slippageBps > 500) return "Blocked: slippage must be between 1 and 500 bps.";
+  try { new PublicKey(inputMint); new PublicKey(outputMint); } catch { return "Blocked: invalid Solana mint address."; }
+  if (inputMint === outputMint) return "Blocked: input and output mints must differ.";
+  const inputAmount = BigInt(amountString);
+
+  // Never trust model arithmetic: re-read the confirmed on-chain balance.
+  const solLamports = BigInt((await service.getSolBalance()).lamports);
+  let availableRaw: bigint;
+  if (inputMint === NATIVE_SOL_MINT) {
+    availableRaw = solLamports > SOL_FEE_RESERVE_LAMPORTS ? solLamports - SOL_FEE_RESERVE_LAMPORTS : 0n;
+  } else {
+    if (solLamports < SOL_FEE_RESERVE_LAMPORTS) {
+      return JSON.stringify({
+        success: false,
+        blocked: true,
+        reason: "INSUFFICIENT_SOL_FOR_FEES",
+        requiredLamports: SOL_FEE_RESERVE_LAMPORTS.toString(),
+        availableLamports: solLamports.toString(),
+        message: "Not enough SOL to pay network fees and token-account rent.",
+      });
+    }
+    availableRaw = (await service.getTokenBalances())
+      .filter((token) => token.mint === inputMint)
+      .reduce((total, token) => total + BigInt(token.amount), 0n);
+  }
+  if (inputAmount > availableRaw) {
+    return JSON.stringify({
+      success: false,
+      blocked: true,
+      reason: "INSUFFICIENT_CONFIRMED_ONCHAIN_BALANCE",
+      inputMint,
+      requestedRaw: inputAmount.toString(),
+      availableRaw: availableRaw.toString(),
+      ...(inputMint === NATIVE_SOL_MINT ? { note: `${SOL_FEE_RESERVE_LAMPORTS} lamports are kept for network fees.` } : {}),
+    });
+  }
+
+  const quote = await venue.quote({ inputMint, outputMint, amount: inputAmount, slippageBps });
+  if (quote.slippageBps !== slippageBps) throw new Error(`${venue.name} quote slippage mismatch`);
+  const [inputAccount, outputAccount] = await Promise.all([
+    service.getTokenAccountFor(inputMint),
+    service.getTokenAccountFor(outputMint),
+  ]);
+  if (inputMint !== NATIVE_SOL_MINT && !inputAccount) return "Blocked: the wallet has no token account for the input mint.";
+  const transaction = await venue.build(service, { quote, inputMint, outputMint, inputAccount, outputAccount });
+  const expected: SwapExpectation = { inputMint, outputMint, inputAmount, minimumOutputAmount: quote.minimumOutputAmount };
+  await venue.validate(service, transaction, expected, quote);
+
+  const summary = {
+    venue: venue.name,
+    inputMint,
+    outputMint,
+    inputAmount: inputAmount.toString(),
+    quotedOutputAmount: quote.outputAmount.toString(),
+    minimumOutputAmount: quote.minimumOutputAmount.toString(),
+    slippageBps,
+    ...(quote.priceImpactPct != null ? { priceImpactPct: quote.priceImpactPct } : {}),
+  };
+
+  const simulation = await service.simulateTransaction(transaction);
+  if (request.dryRun === true) {
+    let networkFeeLamports: number | null = null;
+    try {
+      const fee = await service.connection.getFeeForMessage(transaction.message);
+      networkFeeLamports = typeof fee.value === "number" ? fee.value : null;
+    } catch {
+      networkFeeLamports = null;
+    }
+    return JSON.stringify({
+      dryRun: true,
+      signed: false,
+      broadcast: false,
+      wouldSucceed: !simulation.value.err,
+      error: simulation.value.err ? JSON.stringify(simulation.value.err) : null,
+      unitsConsumed: simulation.value.unitsConsumed,
+      networkFeeLamports,
+      logsTail: (simulation.value.logs ?? []).slice(-5),
+      ...summary,
+      solReserveLamports: SOL_FEE_RESERVE_LAMPORTS.toString(),
+    });
+  }
+  if (simulation.value.err) throw new Error(`Solana simulation failed: ${JSON.stringify(simulation.value.err)}`);
+
+  try {
+    const signed = service.signTransactionLocally(transaction);
+    const result = await service.broadcastAndConfirm(signed);
+    const journal = await journalConfirmedSwap(ctx.db, service, {
+      signature: result.signature,
+      inputMint,
+      outputMint,
+      inputAmount,
+      quotedOutputAmount: quote.outputAmount,
+    });
+    return JSON.stringify({
+      success: true,
+      ...(journal ? { journal } : {}),
+      signature: result.signature,
+      slot: result.slot,
+      confirmationStatus: result.confirmationStatus,
+      unitsConsumed: simulation.value.unitsConsumed,
+      ...summary,
+    });
+  } catch (error) {
+    if (error instanceof SolanaTransactionUncertainError) {
+      recordPendingTransaction(ctx.db, error, "swap", {
+        inputMint,
+        outputMint,
+        inputAmount: inputAmount.toString(),
+        quotedOutputAmount: quote.outputAmount.toString(),
+      });
+    }
+    throw error;
+  }
+}
