@@ -0,0 +1,189 @@
+/**
+ * Jupiter aggregator: best price across Solana DEXes (Raydium, Orca, Meteora…)
+ * and almost every token. Free "lite" API, no key. Override the base URL with
+ * JUPITER_API_URL if Jupiter moves it.
+ */
+import { PublicKey, SystemProgram, type VersionedTransaction } from "@solana/web3.js";
+import type { AutomatonTool } from "../types.js";
+import {
+  ASSOCIATED_TOKEN_PROGRAM_ID,
+  NATIVE_SOL_MINT,
+  TOKEN_2022_PROGRAM_ID,
+  TOKEN_PROGRAM_ID,
+  type SolanaTradingService,
+} from "./trading.js";
+import { runSwap, type SwapExpectation, type SwapVenue, type VenueQuote } from "./swap-engine.js";
+
+export const JUPITER_PROGRAM_ID = "JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4";
+const COMPUTE_BUDGET_PROGRAM_ID = "ComputeBudget111111111111111111111111111111";
+const MAX_PRIORITY_FEE_LAMPORTS = 200_000; // 0.0002 SOL cap per swap
+
+export function jupiterBaseUrl(): string {
+  return (process.env.JUPITER_API_URL ?? "https://lite-api.jup.ag/swap/v1").replace(/\/$/, "");
+}
+
+export interface JupiterQuoteResponse {
+  inputMint: string;
+  outputMint: string;
+  inAmount: string;
+  outAmount: string;
+  otherAmountThreshold: string;
+  swapMode: string;
+  slippageBps: number;
+  priceImpactPct?: string;
+  routePlan?: Array<{ swapInfo?: { label?: string } }>;
+  platformFee?: { amount?: string } | null;
+}
+
+export function parseJupiterQuote(raw: unknown, expected: { inputMint: string; outputMint: string; inputAmount: bigint }): VenueQuote {
+  const q = raw as Partial<JupiterQuoteResponse> & { error?: string };
+  if (!q || typeof q !== "object" || q.error) throw new Error(`Jupiter quote rejected: ${JSON.stringify(raw).slice(0, 300)}`);
+  if (q.inputMint !== expected.inputMint || q.outputMint !== expected.outputMint) throw new Error("Jupiter quote mint mismatch");
+  if (q.swapMode !== "ExactIn") throw new Error("Jupiter quote is not exact-in");
+  for (const v of [q.inAmount, q.outAmount, q.otherAmountThreshold]) {
+    if (!/^[1-9][0-9]*$/.test(String(v ?? ""))) throw new Error("Jupiter quote contains invalid amounts");
+  }
+  if (BigInt(q.inAmount!) !== expected.inputAmount) throw new Error("Jupiter quote input amount mismatch");
+  if (q.platformFee && q.platformFee.amount && q.platformFee.amount !== "0") throw new Error("Jupiter quote carries a platform fee");
+  const slippageBps = Number(q.slippageBps);
+  if (!Number.isInteger(slippageBps) || slippageBps < 1 || slippageBps > 500) throw new Error("Jupiter quote contains invalid slippage");
+  const impact = q.priceImpactPct === undefined ? null : Number(q.priceImpactPct) * 100;
+  return {
+    outputAmount: BigInt(q.outAmount!),
+    minimumOutputAmount: BigInt(q.otherAmountThreshold!),
+    slippageBps,
+    priceImpactPct: impact !== null && Number.isFinite(impact) ? Math.round(impact * 1000) / 1000 : null,
+    raw,
+  };
+}
+
+function u64le(value: bigint): Buffer {
+  const b = Buffer.alloc(8);
+  b.writeBigUInt64LE(value);
+  return b;
+}
+
+function ata(owner: string, mint: string, programId: PublicKey): string {
+  return PublicKey.findProgramAddressSync(
+    [new PublicKey(owner).toBuffer(), programId.toBuffer(), new PublicKey(mint).toBuffer()],
+    ASSOCIATED_TOKEN_PROGRAM_ID,
+  )[0].toBase58();
+}
+
+/**
+ * The built transaction must be exactly the quoted swap for SHUI's wallet:
+ * SHUI is payer and only signer; one Jupiter route instruction whose data
+ * carries our input amount, the quoted output and our slippage (the program
+ * enforces the minimum output on-chain); no token Approve/SetAuthority; SOL
+ * only moves into SHUI's own wrapped-SOL account; accounts are closed only to
+ * SHUI; priority fee capped.
+ */
+export async function validateJupiterSwap(
+  service: SolanaTradingService,
+  transaction: VersionedTransaction,
+  expected: SwapExpectation,
+  quote: VenueQuote,
+): Promise<void> {
+  const inspection = await service.inspectTransaction(transaction);
+  if (inspection.payer !== service.address) throw new Error("Jupiter transaction payer is not SHUI's wallet");
+  if (inspection.requiredSigners.length !== 1 || inspection.requiredSigners[0] !== service.address) {
+    throw new Error("Jupiter transaction contains unexpected required signers");
+  }
+  const wsolAccount = ata(service.address, NATIVE_SOL_MINT, TOKEN_PROGRAM_ID);
+  const routes = inspection.instructions.filter((ix) => ix.programId === JUPITER_PROGRAM_ID);
+  if (routes.length === 0) throw new Error("No Jupiter route instruction in the transaction");
+  const tail = Buffer.concat([u64le(expected.inputAmount), u64le(quote.outputAmount), Buffer.from([quote.slippageBps & 0xff, quote.slippageBps >> 8])]);
+  if (!routes.some((ix) => Buffer.from(ix.dataHex, "hex").includes(tail))) {
+    throw new Error("Jupiter route does not carry the quoted input amount, output and slippage");
+  }
+  for (const ix of inspection.instructions) {
+    const data = Buffer.from(ix.dataHex, "hex");
+    if (ix.programId === TOKEN_PROGRAM_ID.toBase58() || ix.programId === TOKEN_2022_PROGRAM_ID.toBase58()) {
+      if ([4, 6, 13].includes(data[0])) throw new Error("Jupiter transaction delegates or changes token authority");
+      if (data[0] === 9 && ix.accounts[1] !== service.address) throw new Error("Jupiter transaction closes an account to another wallet");
+    } else if (ix.programId === SystemProgram.programId.toBase58()) {
+      const kind = data.readUInt32LE(0);
+      if (kind !== 2 || ix.accounts[1] !== wsolAccount) throw new Error("Jupiter transaction moves SOL outside SHUI's wrapped-SOL account");
+    }
+  }
+  const limitIx = inspection.instructions.find((ix) => ix.programId === COMPUTE_BUDGET_PROGRAM_ID && ix.dataHex.startsWith("02"));
+  const priceIx = inspection.instructions.find((ix) => ix.programId === COMPUTE_BUDGET_PROGRAM_ID && ix.dataHex.startsWith("03"));
+  if (priceIx) {
+    const units = limitIx ? BigInt(Buffer.from(limitIx.dataHex, "hex").readUInt32LE(1)) : 1_400_000n;
+    const microLamports = Buffer.from(priceIx.dataHex, "hex").readBigUInt64LE(1);
+    if ((units * microLamports) / 1_000_000n > BigInt(MAX_PRIORITY_FEE_LAMPORTS) * 2n) {
+      throw new Error("Jupiter transaction priority fee is above the cap");
+    }
+  }
+}
+
+export const jupiterVenue: SwapVenue = {
+  name: "jupiter",
+  async quote({ inputMint, outputMint, amount, slippageBps }) {
+    const url = new URL(`${jupiterBaseUrl()}/quote`);
+    url.searchParams.set("inputMint", inputMint);
+    url.searchParams.set("outputMint", outputMint);
+    url.searchParams.set("amount", amount.toString());
+    url.searchParams.set("slippageBps", String(slippageBps));
+    url.searchParams.set("swapMode", "ExactIn");
+    const response = await fetch(url, { headers: { accept: "application/json" }, signal: AbortSignal.timeout(15_000) });
+    const raw: unknown = await response.json();
+    if (!response.ok) throw new Error(`Jupiter quote HTTP ${response.status}: ${JSON.stringify(raw).slice(0, 300)}`);
+    return parseJupiterQuote(raw, { inputMint, outputMint, inputAmount: amount });
+  },
+  async build(service, { quote }) {
+    const response = await fetch(`${jupiterBaseUrl()}/swap`, {
+      method: "POST",
+      headers: { "content-type": "application/json", accept: "application/json" },
+      body: JSON.stringify({
+        quoteResponse: quote.raw,
+        userPublicKey: service.address,
+        wrapAndUnwrapSol: true,
+        dynamicComputeUnitLimit: true,
+        prioritizationFeeLamports: { priorityLevelWithMaxLamports: { maxLamports: MAX_PRIORITY_FEE_LAMPORTS, priorityLevel: "medium" } },
+      }),
+      signal: AbortSignal.timeout(20_000),
+    });
+    const body = (await response.json()) as { swapTransaction?: string; error?: string };
+    if (!response.ok || !body.swapTransaction) throw new Error(`Jupiter swap build failed: ${JSON.stringify(body).slice(0, 300)}`);
+    return service.deserializeSwapTransaction(body.swapTransaction);
+  },
+  validate: validateJupiterSwap,
+};
+
+export function createJupiterSwapTool(): AutomatonTool {
+  return {
+    name: "jupiter_swap",
+    description:
+      "Swap tokens through Jupiter, which compares all Solana DEXes (Raydium, Orca, Meteora…) for the best price and supports " +
+      "almost every SPL token. Same rules as raydium_swap: exact input, amount in raw units, 0.01 SOL always kept for fees and " +
+      "token-account rent, dryRun=true to simulate without signing. Check priceImpactPct in the result: above 1% the pool is " +
+      "too thin for that size. Liquid staking also works through it: SOL -> jitoSOL (J1toso1uCk3RLmjorhTtrVwY9HJ7X8V9yYac6Y7kGCPn) " +
+      "or mSOL (mSoLzYCxHdYgdzU16g5QSh3i5K3z3KZK7ytfqcJm7So) earns about 7%/year, swap back anytime.",
+    category: "financial",
+    riskLevel: "dangerous",
+    parameters: {
+      type: "object",
+      properties: {
+        inputMint: { type: "string" },
+        outputMint: { type: "string" },
+        amount: { type: "string", description: "Positive raw integer amount in smallest token units." },
+        slippageBps: { type: "number", description: "Slippage in basis points (default 50)." },
+        dryRun: { type: "boolean", description: "true: build, validate and simulate only (no signature, no funds moved)." },
+      },
+      required: ["inputMint", "outputMint", "amount"],
+    },
+    execute: async (args, ctx) => {
+      if (ctx.identity.chainType !== "solana" || !ctx.identity.chainIdentity || ctx.identity.chainIdentity.chainType !== "solana") {
+        return "Blocked: active Solana chain identity is unavailable.";
+      }
+      return runSwap({ db: ctx.db, chainIdentity: ctx.identity.chainIdentity }, {
+        inputMint: String(args.inputMint ?? ""),
+        outputMint: String(args.outputMint ?? ""),
+        amount: String(args.amount ?? ""),
+        slippageBps: args.slippageBps === undefined ? undefined : Number(args.slippageBps),
+        dryRun: args.dryRun === true,
+      }, jupiterVenue);
+    },
+  };
+}
diff --git a/src/solana/market-scan.ts b/src/solana/market-scan.ts
new file mode 100644
index 0000000..492d19d
--- /dev/null
+++ b/src/solana/market-scan.ts
@@ -0,0 +1,188 @@
+/**
+ * Market data for trading decisions, from free public APIs (no key):
+ * GeckoTerminal (trending pools, hourly candles) and DexScreener (token pairs,
+ * search). Compact text: a small local model reads it better than raw JSON.
+ */
+import type { AutomatonTool } from "../types.js";
+
+const GECKO = "https://api.geckoterminal.com/api/v2";
+const DEXSCREENER = "https://api.dexscreener.com";
+const THIN_LIQUIDITY_USD = 50_000;
+const NEW_PAIR_MS = 24 * 3_600_000;
+
+export interface MarketRow {
+  symbol: string;
+  mint: string;
+  priceUsd: number | null;
+  change: { m5?: number; h1?: number; h6?: number; h24?: number };
+  volume24hUsd: number | null;
+  liquidityUsd: number | null;
+  fdvUsd: number | null;
+  createdAt: number | null;
+  buys24h?: number;
+  sells24h?: number;
+  dex?: string;
+  pool?: string;
+}
+
+type Fetcher = (url: string) => Promise<unknown>;
+
+const defaultFetch: Fetcher = async (url) => {
+  const response = await fetch(url, {
+    headers: { accept: "application/json;version=20230302" },
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) throw new Error(`HTTP ${response.status} from ${new URL(url).host}`);
+  return response.json();
+};
+
+const num = (v: unknown): number | null => {
+  const n = typeof v === "string" ? Number(v) : typeof v === "number" ? v : NaN;
+  return Number.isFinite(n) ? n : null;
+};
+
+function pct(v: number | undefined): string {
+  return v === undefined || v === null ? "?" : `${v > 0 ? "+" : ""}${v.toFixed(1)}%`;
+}
+
+function usd(v: number | null): string {
+  if (v === null) return "?";
+  if (v >= 1e9) return `$${(v / 1e9).toFixed(2)}B`;
+  if (v >= 1e6) return `$${(v / 1e6).toFixed(2)}M`;
+  if (v >= 1e3) return `$${(v / 1e3).toFixed(1)}k`;
+  return `$${v.toFixed(2)}`;
+}
+
+function price(v: number | null): string {
+  if (v === null) return "?";
+  return v >= 1 ? `$${v.toFixed(4)}` : `$${v.toPrecision(4)}`;
+}
+
+export function formatRow(r: MarketRow, now = Date.now()): string {
+  const warnings: string[] = [];
+  if (r.liquidityUsd !== null && r.liquidityUsd < THIN_LIQUIDITY_USD) warnings.push("THIN LIQUIDITY");
+  if (r.createdAt !== null && now - r.createdAt < NEW_PAIR_MS) warnings.push("NEW PAIR <24h (rug risk)");
+  const flow = r.buys24h !== undefined && r.sells24h !== undefined ? ` buys/sells24h ${r.buys24h}/${r.sells24h}` : "";
+  return `${r.symbol} mint=${r.mint} price=${price(r.priceUsd)} 5m ${pct(r.change.m5)} 1h ${pct(r.change.h1)} ` +
+    `6h ${pct(r.change.h6)} 24h ${pct(r.change.h24)} vol24h=${usd(r.volume24hUsd)} liq=${usd(r.liquidityUsd)} ` +
+    `fdv=${usd(r.fdvUsd)}${flow}${r.dex ? ` dex=${r.dex}` : ""}${warnings.length ? ` ⚠ ${warnings.join(", ")}` : ""}`;
+}
+
+export function rowsFromGeckoPools(body: unknown): MarketRow[] {
+  const data = ((body as { data?: unknown[] })?.data ?? []) as Array<Record<string, any>>;
+  return data.map((pool) => {
+    const a = pool.attributes ?? {};
+    const baseId = String(pool.relationships?.base_token?.data?.id ?? "");
+    const ch = a.price_change_percentage ?? {};
+    return {
+      symbol: String(a.name ?? "?").split(" / ")[0],
+      mint: baseId.replace(/^solana_/, ""),
+      priceUsd: num(a.base_token_price_usd),
+      change: { m5: num(ch.m5) ?? undefined, h1: num(ch.h1) ?? undefined, h6: num(ch.h6) ?? undefined, h24: num(ch.h24) ?? undefined },
+      volume24hUsd: num(a.volume_usd?.h24),
+      liquidityUsd: num(a.reserve_in_usd),
+      fdvUsd: num(a.fdv_usd),
+      createdAt: a.pool_created_at ? Date.parse(a.pool_created_at) : null,
+      buys24h: num(a.transactions?.h24?.buys) ?? undefined,
+      sells24h: num(a.transactions?.h24?.sells) ?? undefined,
+      pool: String(a.address ?? ""),
+    };
+  });
+}
+
+export function rowsFromDexPairs(pairs: unknown): MarketRow[] {
+  const list = (Array.isArray(pairs) ? pairs : []) as Array<Record<string, any>>;
+  return list
+    .filter((p) => p.chainId === undefined || p.chainId === "solana")
+    .map((p) => ({
+      symbol: String(p.baseToken?.symbol ?? "?"),
+      mint: String(p.baseToken?.address ?? ""),
+      priceUsd: num(p.priceUsd),
+      change: { m5: num(p.priceChange?.m5) ?? undefined, h1: num(p.priceChange?.h1) ?? undefined, h6: num(p.priceChange?.h6) ?? undefined, h24: num(p.priceChange?.h24) ?? undefined },
+      volume24hUsd: num(p.volume?.h24),
+      liquidityUsd: num(p.liquidity?.usd),
+      fdvUsd: num(p.fdv),
+      createdAt: num(p.pairCreatedAt),
+      buys24h: num(p.txns?.h24?.buys) ?? undefined,
+      sells24h: num(p.txns?.h24?.sells) ?? undefined,
+      dex: String(p.dexId ?? ""),
+      pool: String(p.pairAddress ?? ""),
+    }));
+}
+
+export function candleSummary(body: unknown): string {
+  const list = ((body as any)?.data?.attributes?.ohlcv_list ?? []) as number[][];
+  if (list.length === 0) return "no candles";
+  const ordered = [...list].sort((a, b) => a[0] - b[0]);
+  const closes = ordered.map((c) => c[4]);
+  const high = Math.max(...ordered.map((c) => c[2]));
+  const low = Math.min(...ordered.map((c) => c[3]));
+  const last = closes[closes.length - 1];
+  const sma = closes.reduce((s, c) => s + c, 0) / closes.length;
+  return `${ordered.length}h candles: low ${price(low)} high ${price(high)} last ${price(last)} ` +
+    `avg ${price(sma)} (last is ${last >= sma ? "above" : "below"} the ${ordered.length}h average); ` +
+    `closes: ${closes.slice(-12).map((c) => c.toPrecision(4)).join(" ")}`;
+}
+
+export async function marketScan(
+  args: { mode?: string; query?: string; limit?: number },
+  fetcher: Fetcher = defaultFetch,
+): Promise<string> {
+  const mode = String(args.mode ?? "trending");
+  const limit = Math.min(20, Math.max(1, Math.floor(Number(args.limit ?? 10)) || 10));
+  if (mode === "trending") {
+    const rows = rowsFromGeckoPools(await fetcher(`${GECKO}/networks/solana/trending_pools?include=base_token`)).slice(0, limit);
+    return `Trending Solana pools (GeckoTerminal):\n${rows.map((r) => `- ${formatRow(r)}`).join("\n")}`;
+  }
+  const query = String(args.query ?? "").trim();
+  if (!query) return "Blocked: query is required (token mint for mode=token, text for mode=search).";
+  if (mode === "search") {
+    const body = (await fetcher(`${DEXSCREENER}/latest/dex/search?q=${encodeURIComponent(query)}`)) as { pairs?: unknown[] };
+    const rows = rowsFromDexPairs(body.pairs ?? []).filter((r) => r.mint).slice(0, limit);
+    return rows.length ? `Search "${query}" (DexScreener, Solana):\n${rows.map((r) => `- ${formatRow(r)}`).join("\n")}` : `No Solana pair found for "${query}".`;
+  }
+  if (mode === "token") {
+    const rows = rowsFromDexPairs(await fetcher(`${DEXSCREENER}/tokens/v1/solana/${encodeURIComponent(query)}`))
+      .sort((a, b) => (b.liquidityUsd ?? 0) - (a.liquidityUsd ?? 0));
+    if (rows.length === 0) return `No pair found for mint ${query}.`;
+    const top = rows[0];
+    let candles = "";
+    if (top.pool) {
+      try {
+        candles = candleSummary(await fetcher(`${GECKO}/networks/solana/pools/${top.pool}/ohlcv/hour?limit=24`));
+      } catch (error) {
+        candles = `candles unavailable (${error instanceof Error ? error.message : String(error)})`;
+      }
+    }
+    return `Token ${query} — deepest pool:\n- ${formatRow(top)}\n${candles}\n${rows.length} pools in total.`;
+  }
+  return 'Blocked: mode must be "trending", "search" or "token".';
+}
+
+export function createMarketScanTool(): AutomatonTool {
+  return {
+    name: "market_scan",
+    description:
+      "Live Solana market data (free public APIs): mode=trending lists trending pools with price changes (5m/1h/6h/24h), " +
+      "24h volume, liquidity, FDV and buy/sell counts; mode=search finds tokens by name or symbol (query); mode=token gives " +
+      "the deepest pool of a mint (query) plus a 24h hourly-candle summary. Warns about thin liquidity and pairs younger " +
+      "than 24h. Use it before any trade; never trade a token you have not scanned.",
+    category: "financial",
+    riskLevel: "safe",
+    parameters: {
+      type: "object",
+      properties: {
+        mode: { type: "string", description: '"trending" (default), "search" or "token".' },
+        query: { type: "string", description: "Token mint (mode=token) or name/symbol (mode=search)." },
+        limit: { type: "number", description: "Max rows (default 10, max 20)." },
+      },
+    },
+    execute: async (args) => {
+      try {
+        return await marketScan(args as { mode?: string; query?: string; limit?: number });
+      } catch (error) {
+        return `market_scan failed: ${error instanceof Error ? error.message : String(error)}`;
+      }
+    },
+  };
+}
diff --git a/src/solana/orders.ts b/src/solana/orders.ts
new file mode 100644
index 0000000..2689507
--- /dev/null
+++ b/src/solana/orders.ts
@@ -0,0 +1,331 @@
+/**
+ * Automatic orders: stop-loss, take-profit and price-triggered buys.
+ *
+ * A turn of the local model takes one to two minutes and SHUI sleeps between
+ * turns, so it cannot watch a price itself. Orders are stored in kv and a
+ * background executor (every 30 s, no model involved) checks Jupiter prices
+ * and runs the swap through the same safe engine as the swap tools. SHUI is
+ * told the outcome in its inbox.
+ */
+import { randomUUID } from "node:crypto";
+import { PublicKey } from "@solana/web3.js";
+import type { Database } from "better-sqlite3";
+import type { AutomatonDatabase, AutomatonTool } from "../types.js";
+import type { ChainIdentity } from "../identity/chain.js";
+import { NATIVE_SOL_MINT, SolanaTradingService } from "./trading.js";
+import { runSwap, type SwapVenue } from "./swap-engine.js";
+import { jupiterVenue } from "./jupiter.js";
+import { raydiumVenue } from "./swap-tool.js";
+import { queueSystemNotice } from "../integration/creator-chat.js";
+
+const ORDER_PREFIX = "order.";
+const MAX_OPEN_ORDERS = 20;
+const MAX_ATTEMPTS = 3;
+export const ORDER_CHECK_MS = 30_000;
+
+export type OrderStatus = "open" | "executing" | "filled" | "failed" | "cancelled" | "expired";
+
+export interface Order {
+  id: string;
+  kind: "stop_loss" | "take_profit" | "buy_below" | "custom";
+  inputMint: string;
+  outputMint: string;
+  /** Raw input units, or "all" (whole balance of a non-SOL input at trigger time). */
+  amount: string;
+  watchMint: string;
+  condition: "below" | "above";
+  triggerPriceUsd: number;
+  slippageBps: number;
+  venue: "jupiter" | "raydium";
+  note: string;
+  createdAt: string;
+  expiresAt: string | null;
+  status: OrderStatus;
+  attempts: number;
+  lastError?: string;
+  triggeredPriceUsd?: number;
+  result?: string;
+  updatedAt: string;
+}
+
+export function saveOrder(db: Database, order: Order): void {
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))")
+    .run(`${ORDER_PREFIX}${order.id}`, JSON.stringify(order));
+}
+
+export function listOrders(db: Database): Order[] {
+  const rows = db.prepare("SELECT value FROM kv WHERE key LIKE 'order.%' ORDER BY key").all() as Array<{ value: string }>;
+  const out: Order[] = [];
+  for (const row of rows) {
+    try {
+      out.push(JSON.parse(row.value) as Order);
+    } catch {
+      // ignore damaged rows
+    }
+  }
+  return out;
+}
+
+export function isTriggered(order: Pick<Order, "condition" | "triggerPriceUsd">, priceUsd: number): boolean {
+  return order.condition === "below" ? priceUsd <= order.triggerPriceUsd : priceUsd >= order.triggerPriceUsd;
+}
+
+export type PriceFetcher = (mints: string[]) => Promise<Record<string, number>>;
+
+export const jupiterPrices: PriceFetcher = async (mints) => {
+  const base = (process.env.JUPITER_PRICE_URL ?? "https://lite-api.jup.ag/price/v3").replace(/\/$/, "");
+  const response = await fetch(`${base}?ids=${mints.join(",")}`, { signal: AbortSignal.timeout(10_000) });
+  if (!response.ok) throw new Error(`Jupiter price HTTP ${response.status}`);
+  const body = (await response.json()) as Record<string, { usdPrice?: number; price?: string } | null>;
+  const data = ((body as { data?: unknown }).data ?? body) as Record<string, { usdPrice?: number; price?: string } | null>;
+  const prices: Record<string, number> = {};
+  for (const mint of mints) {
+    const entry = data[mint];
+    const value = entry ? Number(entry.usdPrice ?? entry.price) : NaN;
+    if (Number.isFinite(value) && value > 0) prices[mint] = value;
+  }
+  return prices;
+};
+
+function venueOf(order: Order): SwapVenue {
+  return order.venue === "raydium" ? raydiumVenue : jupiterVenue;
+}
+
+/** Outcome of one swap attempt from the engine's text result. */
+export function classifySwapResult(text: string): { done: boolean; transient: boolean; message: string } {
+  let parsed: Record<string, unknown> | null = null;
+  try {
+    parsed = JSON.parse(text) as Record<string, unknown>;
+  } catch {
+    parsed = null;
+  }
+  if (parsed?.success === true) return { done: true, transient: false, message: `filled, signature ${String(parsed.signature)}` };
+  // A previous transaction still unresolved: try again on a later tick.
+  if (typeof parsed?.reason === "string" && parsed.reason.startsWith("PREVIOUS_TRANSACTION")) {
+    return { done: false, transient: true, message: String(parsed.message ?? parsed.reason) };
+  }
+  return { done: false, transient: false, message: (parsed?.reason ? String(parsed.reason) : text).slice(0, 300) };
+}
+
+export interface OrderExecutorDeps {
+  db: AutomatonDatabase;
+  chainIdentity: ChainIdentity;
+  prices?: PriceFetcher;
+  swap?: (order: Order, amount: string) => Promise<string>;
+  now?: () => Date;
+  log?: (message: string) => void;
+}
+
+async function resolveAmount(deps: OrderExecutorDeps, order: Order): Promise<string> {
+  if (order.amount !== "all") return order.amount;
+  const service = new SolanaTradingService(deps.chainIdentity);
+  const total = (await service.getTokenBalances())
+    .filter((t) => t.mint === order.inputMint)
+    .reduce((sum, t) => sum + BigInt(t.amount), 0n);
+  return total.toString();
+}
+
+/** One pass over open orders. Returns the ids of orders that changed. */
+export async function runOrderTick(deps: OrderExecutorDeps): Promise<string[]> {
+  const db = deps.db.raw;
+  const now = (deps.now ?? (() => new Date()))();
+  const open = listOrders(db).filter((o) => o.status === "open");
+  if (open.length === 0 && !listOrders(db).some((o) => o.status === "executing")) return [];
+  const changed: string[] = [];
+
+  for (const order of open) {
+    if (order.expiresAt && Date.parse(order.expiresAt) <= now.getTime()) {
+      saveOrder(db, { ...order, status: "expired", updatedAt: now.toISOString() });
+      queueSystemNotice(db, "system:orders", `Order ${order.id} (${order.kind}) expired without triggering.`);
+      changed.push(order.id);
+    }
+  }
+  // An order left "executing" by a restart may or may not have swapped: never
+  // retry it blindly; the pending-transaction lock covers a real broadcast.
+  for (const order of listOrders(db).filter((o) => o.status === "executing")) {
+    if (now.getTime() - Date.parse(order.updatedAt) > 10 * 60_000) {
+      saveOrder(db, { ...order, status: "failed", lastError: "interrupted while executing; check the wallet", updatedAt: now.toISOString() });
+      queueSystemNotice(db, "system:orders", `Order ${order.id} was interrupted while executing. Check the wallet before re-creating it.`);
+      changed.push(order.id);
+    }
+  }
+  const live = listOrders(db).filter((o) => o.status === "open");
+  if (live.length === 0) return changed;
+
+  const prices = await (deps.prices ?? jupiterPrices)([...new Set(live.map((o) => o.watchMint))]);
+  for (const order of live) {
+    const price = prices[order.watchMint];
+    if (price === undefined || !isTriggered(order, price)) continue;
+
+    saveOrder(db, { ...order, status: "executing", triggeredPriceUsd: price, updatedAt: now.toISOString() });
+    let text: string;
+    try {
+      const amount = await resolveAmount(deps, order);
+      text = amount === "0"
+        ? "Blocked: nothing left to sell for this order."
+        : await (deps.swap ?? ((o, a) => runSwap(
+          { db: deps.db, chainIdentity: deps.chainIdentity },
+          { inputMint: o.inputMint, outputMint: o.outputMint, amount: a, slippageBps: o.slippageBps },
+          venueOf(o),
+        )))(order, amount);
+    } catch (error) {
+      text = `error: ${error instanceof Error ? error.message : String(error)}`;
+    }
+    const outcome = classifySwapResult(text);
+    const attempts = order.attempts + 1;
+    const status: OrderStatus = outcome.done ? "filled" : outcome.transient || attempts < MAX_ATTEMPTS ? "open" : "failed";
+    saveOrder(db, {
+      ...order,
+      status,
+      attempts: outcome.transient ? order.attempts : attempts,
+      triggeredPriceUsd: price,
+      lastError: outcome.done ? undefined : outcome.message,
+      result: outcome.done ? text.slice(0, 1000) : order.result,
+      updatedAt: now.toISOString(),
+    });
+    changed.push(order.id);
+    deps.log?.(`[ORDERS] ${order.id} ${order.kind} at $${price}: ${status} (${outcome.message.slice(0, 120)})`);
+    if (status === "filled" || status === "failed") {
+      queueSystemNotice(db, "system:orders",
+        `Order ${order.id} (${order.kind}, ${order.note || "no note"}) ${status === "filled" ? "EXECUTED" : "FAILED"} ` +
+        `when the price of ${order.watchMint} was $${price} (trigger ${order.condition} $${order.triggerPriceUsd}): ${outcome.message}`);
+    }
+  }
+  return changed;
+}
+
+export function startOrderExecutor(deps: OrderExecutorDeps): () => void {
+  let running = false;
+  const timer = setInterval(() => {
+    if (running) return;
+    running = true;
+    runOrderTick(deps)
+      .catch((error) => deps.log?.(`[ORDERS] tick failed: ${error instanceof Error ? error.message : String(error)}`))
+      .finally(() => { running = false; });
+  }, ORDER_CHECK_MS);
+  timer.unref?.();
+  return () => clearInterval(timer);
+}
+
+function validMint(mint: string): boolean {
+  try {
+    new PublicKey(mint);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export function createOrderTools(): AutomatonTool[] {
+  return [
+    {
+      name: "order_create",
+      description:
+        "Create an automatic order executed by code without waiting for you (checked every 30 s with Jupiter prices): " +
+        "kind=stop_loss (sell when the price falls below), take_profit (sell when it rises above), buy_below (buy when it " +
+        "falls below). For a sell: inputMint = the token you hold, outputMint = USDC (or SOL), watchMint = that token, " +
+        'amount = raw units or "all". For buy_below: inputMint = USDC, outputMint = watchMint = the token to buy. ' +
+        "You get an inbox message when an order executes or fails. Protect every position with a stop_loss.",
+      category: "financial",
+      riskLevel: "dangerous",
+      parameters: {
+        type: "object",
+        properties: {
+          kind: { type: "string", description: '"stop_loss", "take_profit" or "buy_below".' },
+          inputMint: { type: "string" },
+          outputMint: { type: "string" },
+          amount: { type: "string", description: 'Raw input units, or "all" for the whole balance of a non-SOL input.' },
+          watchMint: { type: "string", description: "Token whose USD price triggers the order." },
+          triggerPriceUsd: { type: "number" },
+          slippageBps: { type: "number", description: "Default 100 (1%)." },
+          expiresHours: { type: "number", description: "Optional lifetime in hours." },
+          venue: { type: "string", description: '"jupiter" (default) or "raydium".' },
+          note: { type: "string", description: "Why this order exists." },
+        },
+        required: ["kind", "inputMint", "outputMint", "amount", "watchMint", "triggerPriceUsd"],
+      },
+      execute: async (args, ctx) => {
+        const kind = String(args.kind ?? "") as Order["kind"];
+        const condition = kind === "take_profit" ? "above" : kind === "stop_loss" || kind === "buy_below" ? "below" : null;
+        if (!condition) return 'Blocked: kind must be "stop_loss", "take_profit" or "buy_below".';
+        const inputMint = String(args.inputMint ?? "");
+        const outputMint = String(args.outputMint ?? "");
+        const watchMint = String(args.watchMint ?? "");
+        if (![inputMint, outputMint, watchMint].every(validMint) || inputMint === outputMint) return "Blocked: invalid mints.";
+        const amount = String(args.amount ?? "");
+        if (amount === "all" ? inputMint === NATIVE_SOL_MINT : !/^[1-9][0-9]*$/.test(amount)) {
+          return 'Blocked: amount must be a positive raw integer, or "all" for a non-SOL input.';
+        }
+        const trigger = Number(args.triggerPriceUsd);
+        if (!Number.isFinite(trigger) || trigger <= 0) return "Blocked: triggerPriceUsd must be a positive number.";
+        const slippageBps = Number(args.slippageBps ?? 100);
+        if (!Number.isInteger(slippageBps) || slippageBps < 1 || slippageBps > 500) return "Blocked: slippage must be 1-500 bps.";
+        const db = ctx.db.raw;
+        if (listOrders(db).filter((o) => o.status === "open").length >= MAX_OPEN_ORDERS) {
+          return `Blocked: ${MAX_OPEN_ORDERS} orders are already open; cancel some first.`;
+        }
+        const now = new Date();
+        const hours = Number(args.expiresHours);
+        const order: Order = {
+          id: `ord_${now.getTime().toString(36)}_${randomUUID().slice(0, 4)}`,
+          kind,
+          inputMint,
+          outputMint,
+          amount,
+          watchMint,
+          condition,
+          triggerPriceUsd: trigger,
+          slippageBps,
+          venue: args.venue === "raydium" ? "raydium" : "jupiter",
+          note: String(args.note ?? "").slice(0, 200),
+          createdAt: now.toISOString(),
+          expiresAt: Number.isFinite(hours) && hours > 0 ? new Date(now.getTime() + hours * 3_600_000).toISOString() : null,
+          status: "open",
+          attempts: 0,
+          updatedAt: now.toISOString(),
+        };
+        let current = "";
+        try {
+          const prices = await jupiterPrices([watchMint]);
+          if (prices[watchMint] !== undefined) {
+            current = ` Current price $${prices[watchMint]}.`;
+            if (isTriggered(order, prices[watchMint])) current += " WARNING: the condition is already met, it will execute at the next check.";
+          }
+        } catch {
+          current = " (current price unavailable)";
+        }
+        saveOrder(db, order);
+        return `Order ${order.id} created: ${kind} ${amount} of ${inputMint} -> ${outputMint} when ${watchMint} is ${condition} $${trigger}.${current}`;
+      },
+    },
+    {
+      name: "order_list",
+      description: "List your automatic orders (open first) with their status, trigger and last error.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: { all: { type: "boolean", description: "Include closed orders." } } },
+      execute: async (args, ctx) => {
+        const orders = listOrders(ctx.db.raw).filter((o) => args.all === true || o.status === "open" || o.status === "executing");
+        if (orders.length === 0) return "No open orders.";
+        return orders.map((o) =>
+          `${o.id} ${o.status} ${o.kind} ${o.amount} ${o.inputMint.slice(0, 6)}…->${o.outputMint.slice(0, 6)}… ` +
+          `when ${o.watchMint.slice(0, 6)}… ${o.condition} $${o.triggerPriceUsd}` +
+          `${o.lastError ? ` last error: ${o.lastError}` : ""}${o.note ? ` (${o.note})` : ""}`).join("\n");
+      },
+    },
+    {
+      name: "order_cancel",
+      description: "Cancel an open automatic order.",
+      category: "financial",
+      riskLevel: "caution",
+      parameters: { type: "object", properties: { id: { type: "string" } }, required: ["id"] },
+      execute: async (args, ctx) => {
+        const order = listOrders(ctx.db.raw).find((o) => o.id === String(args.id ?? ""));
+        if (!order) return `Unknown order ${String(args.id ?? "")}.`;
+        if (order.status !== "open") return `Order ${order.id} is ${order.status}, nothing to cancel.`;
+        saveOrder(ctx.db.raw, { ...order, status: "cancelled", updatedAt: new Date().toISOString() });
+        return `Order ${order.id} cancelled.`;
+      },
+    },
+  ];
+}
