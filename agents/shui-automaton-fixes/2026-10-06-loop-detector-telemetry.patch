+
+  it("does not flag writing different files on consecutive turns as a loop", () => {
+    const detector = new LoopDetector();
+    for (const file of ["app.py", "static/style.css", "templates/index.html", "vite.config.js", "README.md"]) {
+      detector.recordToolCall("write_file", JSON.stringify({ path: file, content: "x" }));
+      const result = detector.endTurn();
+      expect(result.blocked).toBe(false);
+      expect(result.reason).toBe("");
+    }
+  });
+
+  it("still flags rewriting the same file on consecutive turns", () => {
+    const detector = new LoopDetector();
+    for (let i = 0; i < 2; i++) {
+      detector.recordToolCall("write_file", JSON.stringify({ path: "app.py", content: `v${i}` }));
+      expect(detector.endTurn().reason).toBe("");
+    }
+    detector.recordToolCall("write_file", JSON.stringify({ path: "app.py", content: "v2" }));
+    expect(detector.endTurn().reason).toContain("repeated the tool pattern");
+    detector.recordToolCall("write_file", JSON.stringify({ path: "app.py", content: "v3" }));
+    expect(detector.endTurn().blocked).toBe(true);
+  });
 });
