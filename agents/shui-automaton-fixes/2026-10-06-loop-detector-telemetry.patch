+const TARGET_KEYS = ["path", "file", "filePath", "file_path", "target", "command", "url"];
+
+/**
+ * Turn-pattern signature of a call: the tool name plus its target (file path,
+ * command or URL) when it has one. Small models make one call per turn, so
+ * matching on the name alone flagged legitimate progress such as writing
+ * app.py, then style.css, then index.html as a "write_file" loop and killed
+ * the worker. Rewriting the same file or rerunning the same command is still
+ * detected.
+ */
+function callSignature(name: string, args: string): string {
+  try {
+    const parsed = JSON.parse(args) as Record<string, unknown>;
+    if (parsed && typeof parsed === "object") {
+      for (const key of TARGET_KEYS) {
+        const value = parsed[key];
+        if (typeof value === "string" && value.trim()) {
+          return `${name}(${value.trim().slice(0, 120)})`;
+        }
+      }
+    }
+  } catch {
+    // Unparseable arguments: fall back to the tool name.
+  }
+  return name;
+}
