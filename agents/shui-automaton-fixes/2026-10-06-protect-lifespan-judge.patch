@@ -0,0 +1,48 @@
+import { describe, expect, it } from "vitest";
+import { isProtectedFile } from "../self-mod/code.js";
+import { isForbiddenCommand } from "../agent/policy-rules/command-safety.js";
+
+const ROOT = "/home/automaton/workspace/automaton-main";
+
+describe("lifespan judge protection", () => {
+  it("protects the judge code and its call sites (source and compiled)", () => {
+    for (const file of [
+      "src/survival/lifespan.ts", "dist/survival/lifespan.js",
+      "src/solana/ledger.ts", "dist/solana/ledger.js",
+      "src/solana/journal.ts", "src/solana/pending-tx.ts",
+      "src/agent/loop.ts", "dist/agent/loop.js",
+      "src/index.ts", "dist/index.js",
+      "src/agent/policy-rules/command-safety.ts", "dist/agent/policy-rules/path-protection.js",
+    ]) {
+      expect(isProtectedFile(`${ROOT}/${file}`), file).toBe(true);
+    }
+  });
+
+  it("still allows normal work files", () => {
+    for (const file of ["arbitrage-api/app.py", "dashboard/app.py", "src/solana/raydium.ts", "solana-arb-monitor/README.md", "my-service/src/index.ts", "my-service/dist/index.js"]) {
+      expect(isProtectedFile(`${ROOT}/${file}`), file).toBe(false);
+    }
+  });
+
+  it("blocks shell access to the judge code and data", () => {
+    for (const command of [
+      "sed -i 's/-1/0/' src/survival/lifespan.ts",
+      "python3 -c \"open('dist/survival/lifespan.js','w')\"",
+      "cat dist/solana/ledger.js",
+      "sqlite3 ~/.automaton/state.db \"INSERT INTO shui_ledger VALUES (...)\"",
+      "python3 -c \"import sqlite3; sqlite3.connect('state.db').execute('update shui_lifespan_days set adjustment=1')\"",
+      "sqlite3 state.db \"delete from kv where key='lifespan.ended'\"",
+      "sed -i 's/runLifespanTick//' src/agent/loop.ts",
+      "cp /tmp/x.js dist/index.js",
+      "echo x > dist/agent/loop.js",
+    ]) {
+      expect(isForbiddenCommand(command), command).toBe(true);
+    }
+  });
+
+  it("does not block ordinary commands", () => {
+    for (const command of ["ls -la", "python3 -m venv .venv", ".venv/bin/pip install fastapi", "cat arbitrage-api/app.py", "node dist/index.js --help", "cp build/out.js my-service/dist/index.js", "echo x > my-service/src/index.ts"]) {
+      expect(isForbiddenCommand(command), command).toBe(false);
+    }
+  });
+});
