+
+/** Mirror memory writes, swaps and strategic decisions to the Control Center. */
+function mirrorToolToDashboard(
+  client: ReturnType<typeof createShuiEventClient>,
+  name: string,
+  args: Record<string, unknown>,
+  result: { id: string; result: string; error?: string },
+  thinking: string,
+): void {
+  try {
+    if (name === "remember_fact" && !result.error && args.category && args.key) {
+      emitMemoryFact(client, {
+        category: String(args.category),
+        key: String(args.key),
+        value: String(args.value ?? ""),
+        confidence: typeof args.confidence === "number" ? args.confidence : null,
+        source: typeof args.source === "string" ? args.source : null,
+      });
+    }
+    if (name === "save_procedure" && !result.error && args.name) {
+      emitProcedure(client, {
+        name: String(args.name),
+        description: String(args.description ?? ""),
+        steps: typeof args.steps === "string" ? args.steps : JSON.stringify(args.steps ?? ""),
+      });
+    }
+    if (name === "raydium_swap") {
+      const trade = tradeFromSwapResult(args, result.result, result.error);
+      client.emit({
+        type: trade.status === "confirmed" ? "trade_result" : "trade",
+        name,
+        message: `Swap ${String(trade.status)}`,
+        data: trade,
+      });
+    }
+    if (DECISION_TOOLS.has(name)) {
+      emitDecision(client, {
+        id: result.id || `${name}_${Date.now()}`,
+        tool: name,
+        args,
+        rationale: thinking,
+        result: result.result,
+        error: result.error ?? null,
+      });
+    }
+  } catch {
+    // The dashboard is optional: never let telemetry break the agent loop.
+  }
+}
diff --git a/src/integration/dashboard-bridge.ts b/src/integration/dashboard-bridge.ts
