index 0000000..da82843
--- /dev/null
+++ b/src/integration/dashboard-bridge.ts
@@ -0,0 +1,249 @@
+/**
+ * Bridge from SHUI's own state to the SHUI Control Center pages.
+ *
+ * The Control Center only shows what SHUI sends as typed telemetry events
+ * (memory_write, wallet, trade, decision). SHUI used to send only wake /
+ * think / tool events, so the Memory, Wallet, Trading and Strategy pages
+ * stayed empty. Field names follow the Control Center aggregator
+ * (projectMemory, projectWallet, projectTrade, projectDecision).
+ * Public data only: never a private key, never wallet.json.
+ */
+import type { Database } from "better-sqlite3";
+import type { ShuiEventClient } from "./automaton-event-client.js";
+
+/** SHUI semantic-memory category -> Control Center card. */
+const CATEGORY_TO_CARD: Record<string, string> = {
+  financial: "financial",
+  domain: "market",
+  environment: "technical",
+  agent: "operational",
+  self: "operational",
+  procedural_ref: "operational",
+  creator: "social",
+};
+
+export function memoryCard(category: string): string {
+  return CATEGORY_TO_CARD[category] ?? "operational";
+}
+
+export function emitMemoryFact(
+  client: ShuiEventClient,
+  fact: { category: string; key: string; value: string; confidence?: number | null; source?: string | null },
+): void {
+  client.emit({
+    type: "memory_write",
+    name: "remember_fact",
+    message: `${fact.key}: ${fact.value}`,
+    data: {
+      id: `fact:${fact.category}:${fact.key}`,
+      category: memoryCard(fact.category),
+      kind: "fact",
+      content: `[${fact.category}] ${fact.key}: ${fact.value}`,
+      source: fact.source ?? "shui",
+      confidence: fact.confidence ?? undefined,
+    },
+  });
+}
+
+export function emitProcedure(
+  client: ShuiEventClient,
+  procedure: { name: string; description: string; steps?: string | null },
+): void {
+  client.emit({
+    type: "memory_write",
+    name: "save_procedure",
+    message: procedure.name,
+    data: {
+      id: `procedure:${procedure.name}`,
+      category: "operational",
+      kind: "procedure",
+      content: `${procedure.name}: ${procedure.description}${procedure.steps ? `\n${procedure.steps}` : ""}`,
+      source: "shui",
+    },
+  });
+}
+
+/** Send every stored fact and procedure once (stable ids: no duplicates). */
+export function backfillMemory(client: ShuiEventClient, db: Database): number {
+  let sent = 0;
+  try {
+    const facts = db.prepare(
+      "SELECT category, key, value, confidence, source FROM semantic_memory ORDER BY created_at",
+    ).all() as Array<{ category: string; key: string; value: string; confidence: number; source: string }>;
+    for (const fact of facts) {
+      emitMemoryFact(client, fact);
+      sent += 1;
+    }
+  } catch {
+    // table missing: nothing to send
+  }
+  try {
+    const procedures = db.prepare(
+      "SELECT name, description, steps FROM procedural_memory ORDER BY created_at",
+    ).all() as Array<{ name: string; description: string; steps: string }>;
+    for (const procedure of procedures) {
+      emitProcedure(client, procedure);
+      sent += 1;
+    }
+  } catch {
+    // table missing: nothing to send
+  }
+  return sent;
+}
+
+export interface WalletSnapshot {
+  address: string;
+  sol: number;
+  usdc: number;
+  tokens: Array<{ mint: string; amount: number }>;
+  estimatedValueUsd: number | null;
+  valuedAt: string;
+}
+
+export function emitWallet(client: ShuiEventClient, snapshot: WalletSnapshot): void {
+  client.emit({
+    type: "wallet",
+    name: "central_wallet",
+    message: "Central wallet snapshot",
+    data: {
+      id: `wallet_${snapshot.valuedAt}`,
+      address: snapshot.address,
+      network: "solana:mainnet",
+      sol: snapshot.sol,
+      usdc: snapshot.usdc,
+      tokens: snapshot.tokens.map((t) => ({ mint: t.mint, amount: t.amount })),
+      estimatedValueUsd: snapshot.estimatedValueUsd ?? undefined,
+    },
+  });
+}
+
+/** Map a raydium_swap tool result to a Control Center trade (incl. blocked and dry runs). */
+export function tradeFromSwapResult(
+  args: Record<string, unknown>,
+  resultText: string,
+  error: string | undefined,
+  at: Date = new Date(),
+): Record<string, unknown> {
+  let parsed: Record<string, unknown> = {};
+  try {
+    parsed = JSON.parse(resultText) as Record<string, unknown>;
+  } catch {
+    parsed = {};
+  }
+  const status = error
+    ? "failed"
+    : parsed.dryRun === true
+      ? (parsed.wouldSucceed ? "simulated" : "simulation_failed")
+      : parsed.blocked === true
+        ? "blocked"
+        : parsed.success === true
+          ? "confirmed"
+          : "unknown";
+  const journal = (parsed.journal ?? {}) as Record<string, unknown>;
+  const signature = typeof parsed.signature === "string" ? parsed.signature : undefined;
+  return {
+    id: signature ?? `swap_${status}_${at.getTime()}`,
+    tokenIn: parsed.inputMint ?? args.inputMint,
+    tokenOut: parsed.outputMint ?? args.outputMint,
+    amountIn: parsed.inputAmount ?? args.amount,
+    amountOut: parsed.quotedOutputAmount ?? undefined,
+    slippage: parsed.slippageBps ?? args.slippageBps,
+    signature,
+    status,
+    result: error ?? (typeof parsed.reason === "string" ? parsed.reason : typeof parsed.error === "string" ? parsed.error : status),
+    pnl: typeof journal.realizedPnlUsd === "number" ? journal.realizedPnlUsd : undefined,
+    fees: typeof parsed.networkFeeLamports === "number" ? `${parsed.networkFeeLamports} lamports` : undefined,
+    route: "raydium",
+  };
+}
+
+/** Send the confirmed swaps already recorded in the ledger (ids = signatures). */
+export function backfillTrades(client: ShuiEventClient, db: Database): number {
+  try {
+    const rows = db.prepare(
+      `SELECT signature, ts, input_mint, input_amount_raw, output_mint, output_amount_raw, realized_pnl_usd
+       FROM shui_ledger WHERE kind = 'swap' ORDER BY ts`,
+    ).all() as Array<Record<string, unknown>>;
+    for (const row of rows) {
+      client.emit({
+        type: "trade_result",
+        name: "raydium_swap",
+        message: "Confirmed swap (ledger)",
+        data: {
+          id: row.signature,
+          signature: row.signature,
+          tokenIn: row.input_mint,
+          tokenOut: row.output_mint,
+          amountIn: row.input_amount_raw,
+          amountOut: row.output_amount_raw,
+          status: "confirmed",
+          pnl: row.realized_pnl_usd,
+          route: "raydium",
+        },
+      });
+    }
+    return rows.length;
+  } catch {
+    return 0;
+  }
+}
+
+/** Tools whose call is a strategic decision worth showing on the Strategy page. */
+export const DECISION_TOOLS = new Set([
+  "create_goal",
+  "cancel_goal",
+  "raydium_swap",
+  "solana_transfer",
+  "service_deploy",
+  "service_stop",
+  "payment_request",
+]);
+
+function describeDecision(tool: string, args: Record<string, unknown>): string {
+  switch (tool) {
+    case "create_goal":
+      return `New goal: ${String(args.title ?? "").slice(0, 200)}`;
+    case "cancel_goal":
+      return `Cancel goal: ${String(args.goal_id ?? args.goalId ?? args.title ?? "")}`;
+    case "raydium_swap":
+      return `${args.dryRun === true ? "Simulate" : "Swap"} ${String(args.amount ?? "")} ${String(args.inputMint ?? "").slice(0, 8)}… -> ${String(args.outputMint ?? "").slice(0, 8)}…`;
+    case "solana_transfer":
+      return `Transfer ${String(args.amount ?? "")} to ${String(args.to ?? args.recipient ?? "").slice(0, 12)}…`;
+    case "service_deploy":
+      return `Publish service ${String(args.name ?? "")} (port ${String(args.port ?? "")})`;
+    case "service_stop":
+      return `Stop service ${String(args.name ?? "")}`;
+    case "payment_request":
+      return `Request payment of ${String(args.amountUsdc ?? "")} USDC (${String(args.label ?? "")})`;
+    default:
+      return tool;
+  }
+}
+
+export function emitDecision(
+  client: ShuiEventClient,
+  params: {
+    id: string;
+    tool: string;
+    args: Record<string, unknown>;
+    rationale?: string | null;
+    result?: string | null;
+    error?: string | null;
+    goalId?: string | null;
+  },
+): void {
+  const goalFromResult = params.result?.match(/\(id: ([0-9A-Z]{26})/)?.[1];
+  client.emit({
+    type: "decision",
+    name: params.tool,
+    message: describeDecision(params.tool, params.args),
+    data: {
+      id: `dec_${params.id}`,
+      summary: describeDecision(params.tool, params.args),
+      action: params.tool,
+      rationale: params.rationale?.trim() ? params.rationale.trim().slice(0, 4000) : undefined,
+      result: (params.error ? `error: ${params.error}` : params.result ?? "").slice(0, 500) || undefined,
+      goalId: params.goalId ?? goalFromResult ?? undefined,
+    },
+  });
+}
