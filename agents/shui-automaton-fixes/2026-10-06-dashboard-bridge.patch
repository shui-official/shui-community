+import Database from "better-sqlite3";
+import { describe, expect, it } from "vitest";
+import {
+  backfillMemory, backfillTrades, emitDecision, emitMemoryFact, emitWallet, memoryCard, tradeFromSwapResult,
+} from "../integration/dashboard-bridge.js";
+
+const recorder = () => {
+  const events: any[] = [];
+  return { events, client: { emit: (e: any) => { events.push(e); return true; }, flush: async () => {}, close: async () => {} } as any };
+};
+
+describe("dashboard bridge", () => {
+  it("sends facts as memory_write with stable ids and Control Center cards", () => {
+    const { events, client } = recorder();
+    emitMemoryFact(client, { category: "financial", key: "initial_balance_usdc", value: "24.379481" });
+    expect(events[0]).toMatchObject({
+      type: "memory_write",
+      data: { id: "fact:financial:initial_balance_usdc", category: "financial", kind: "fact" },
+    });
+    expect(events[0].data.content).toContain("24.379481");
+    expect(memoryCard("domain")).toBe("market");
+    expect(memoryCard("agent")).toBe("operational");
+  });
+
+  it("backfills stored facts, procedures and ledger swaps", () => {
+    const db = new Database(":memory:");
+    db.exec(`CREATE TABLE semantic_memory (id TEXT, category TEXT, key TEXT, value TEXT, confidence REAL, source TEXT, created_at TEXT);
+      CREATE TABLE procedural_memory (id TEXT, name TEXT, description TEXT, steps TEXT, created_at TEXT);
+      CREATE TABLE shui_ledger (signature TEXT, ts TEXT, kind TEXT, input_mint TEXT, input_amount_raw TEXT, output_mint TEXT, output_amount_raw TEXT, realized_pnl_usd REAL);
+      INSERT INTO semantic_memory VALUES ('1','agent','primary_wallet_address','Bq..',1,'x','t');
+      INSERT INTO procedural_memory VALUES ('p','quote_check','read a quote','1. web_fetch','t');
+      INSERT INTO shui_ledger VALUES ('SIG','t','swap','SOL',' 1','USDC','2',0.5);
+      INSERT INTO shui_ledger VALUES ('IN','t','incoming',NULL,NULL,'USDC','3',0);`);
+    const { events, client } = recorder();
+    expect(backfillMemory(client, db)).toBe(2);
+    expect(backfillTrades(client, db)).toBe(1);
+    expect(events.map((e) => e.type)).toEqual(["memory_write", "memory_write", "trade_result"]);
+    expect(events[2].data).toMatchObject({ id: "SIG", status: "confirmed", pnl: 0.5 });
+  });
+
+  it("maps swap results to trades, including blocked and simulated swaps", () => {
+    const args = { inputMint: "SOL", outputMint: "USDC", amount: "100" };
+    expect(tradeFromSwapResult(args, JSON.stringify({ success: true, signature: "S1", inputMint: "SOL", outputMint: "USDC", inputAmount: "100", quotedOutputAmount: "12", journal: { realizedPnlUsd: 0 } }), undefined))
+      .toMatchObject({ id: "S1", status: "confirmed", amountOut: "12", pnl: 0 });
+    expect(tradeFromSwapResult(args, JSON.stringify({ blocked: true, reason: "INSUFFICIENT_CONFIRMED_ONCHAIN_BALANCE" }), undefined))
+      .toMatchObject({ status: "blocked", result: "INSUFFICIENT_CONFIRMED_ONCHAIN_BALANCE" });
+    expect(tradeFromSwapResult(args, JSON.stringify({ dryRun: true, wouldSucceed: true, networkFeeLamports: 6001 }), undefined))
+      .toMatchObject({ status: "simulated", fees: "6001 lamports" });
+    expect(tradeFromSwapResult(args, "", "rpc down")).toMatchObject({ status: "failed", result: "rpc down" });
+  });
+
+  it("sends wallet snapshots with public data only and decisions with their rationale", () => {
+    const { events, client } = recorder();
+    emitWallet(client, { address: "Bq", sol: 0.097, usdc: 24.38, tokens: [], estimatedValueUsd: 36.1, valuedAt: "2026-10-06T12:00:00Z" });
+    emitDecision(client, { id: "call-1", tool: "create_goal", args: { title: "Sell a price API" }, rationale: "Need revenue", result: 'Goal created: "x" (id: 01M48G9YYPMVDZZQA0PZ4G9VM7, status: active)' });
+    expect(events[0]).toMatchObject({ type: "wallet", data: { address: "Bq", usdc: 24.38, estimatedValueUsd: 36.1 } });
+    expect(JSON.stringify(events[0])).not.toMatch(/secret|private/i);
+    expect(events[1]).toMatchObject({ type: "decision", data: { summary: "New goal: Sell a price API", rationale: "Need revenue", goalId: "01M48G9YYPMVDZZQA0PZ4G9VM7" } });
+  });
+});
