+/**
+ * Refuse to publish what would be unsafe or cannot start: a debug console
+ * (Werkzeug/Flask debug=True gives remote code execution), listening on all
+ * interfaces instead of 127.0.0.1, or Python/Node dependencies that are not
+ * installed in the service folder (system pip is blocked, so it crash-loops).
+ */
+export async function checkServiceSafety(name: string, root = SERVICES_ROOT): Promise<string | null> {
+  const dir = path.join(root, name);
+  const problems: string[] = [];
+  for (const file of await listServiceFiles(dir)) {
+    let content: string;
+    try {
+      content = await fs.readFile(file, "utf8");
+    } catch {
+      continue;
+    }
+    const rel = path.relative(dir, file);
+    const debug = DEBUG_PATTERNS.exec(content);
+    if (debug) problems.push(`${rel}: debug mode ("${debug[0]}") must be off in a public service`);
+    const any = ALL_INTERFACES.exec(content);
+    if (any) problems.push(`${rel}: listens on all interfaces ("${any[0]}"); use 127.0.0.1 and $PORT`);
+  }
+  const exists = async (p: string) => fs.access(path.join(dir, p)).then(() => true, () => false);
+  if ((await exists("requirements.txt") || await exists("pyproject.toml")) && !(await exists(".venv"))) {
+    problems.push(
+      `Python dependencies are not installed: run \`cd ${dir} && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt\` ` +
+      "and start the app with .venv/bin/python in run.sh",
+    );
+  }
+  if (await exists("package.json") && !(await exists("node_modules"))) {
+    problems.push(`Node dependencies are not installed: run \`cd ${dir} && npm install --omit=dev\``);
+  }
+  return problems.length > 0 ? `Not deployed. Fix first:\n- ${problems.join("\n- ")}` : null;
