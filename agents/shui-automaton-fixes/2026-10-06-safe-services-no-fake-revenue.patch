+  return "";
+}
+
+export function shellQuote(value: string): string {
+  return `'${value.replace(/'/g, "'\\''")}'`;
+}
+
+/** Task workspace, created on demand; null if it cannot be created. */
+export async function workspaceDir(dir: string | undefined): Promise<string | null> {
+  if (!dir) return null;
+  try {
+    await fs.mkdir(dir, { recursive: true });
+    return dir;
+  } catch {
+    return null;
+  }
+}
+
+/** Binary content (e.g. a SQLite database) is not shown to the model. */
+export function binaryNotice(content: string): string | null {
+  if (!content.slice(0, 4096).includes("\u0000")) return null;
+  return `Binary file (${content.length} bytes), not shown. Inspect it with a proper tool ` +
+    `(for SQLite: python3 -c "import sqlite3; ...").`;
+}
