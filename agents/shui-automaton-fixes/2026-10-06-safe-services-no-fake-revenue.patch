+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { checkServiceSafety } from "../services/service-tools.js";
+import { binaryNotice, pathArg, shellQuote } from "../agent/harnesses/worker-environment.js";
+import { LoopDetector } from "../agent/loop-detector.js";
+import { HarnessRegistry } from "../agent/harness-registry.js";
+import { BaseHarness } from "../agent/harnesses/base-harness.js";
+import type { HarnessContext, HarnessTool } from "../agent/harness-types.js";
+import type { TaskNode } from "../orchestration/task-graph.js";
+import { AgentWorkspace } from "../orchestration/workspace.js";
+import { createInMemoryDb } from "./orchestration/test-db.js";
+import { createTestConfig, createTestIdentity, MockConwayClient } from "./mocks.js";
+
+let tmp: string | undefined;
+afterEach(() => { if (tmp) rmSync(tmp, { recursive: true, force: true }); tmp = undefined; });
+
+describe("service_deploy safety checks", () => {
+  it("refuses debug mode, 0.0.0.0 and missing dependencies; accepts a clean service", async () => {
+    tmp = mkdtempSync(path.join(os.tmpdir(), "svc-"));
+    mkdirSync(path.join(tmp, "bad"));
+    writeFileSync(path.join(tmp, "bad", "app.py"), "app.run(host='0.0.0.0', port=port, debug=True)\n");
+    writeFileSync(path.join(tmp, "bad", "requirements.txt"), "flask\n");
+    const bad = await checkServiceSafety("bad", tmp);
+    expect(bad).toContain("debug mode");
+    expect(bad).toContain("all interfaces");
+    expect(bad).toContain(".venv/bin/pip install");
+
+    mkdirSync(path.join(tmp, "good", ".venv"), { recursive: true });
+    writeFileSync(path.join(tmp, "good", "app.py"), "import os\napp.run(host='127.0.0.1', port=int(os.environ['PORT']))\n");
+    writeFileSync(path.join(tmp, "good", "requirements.txt"), "flask\n");
+    writeFileSync(path.join(tmp, "good", ".venv", "x.py"), "debug=True  # inside venv: ignored\n");
+    expect(await checkServiceSafety("good", tmp)).toBeNull();
+  });
+});
+
+describe("worker helpers", () => {
+  it("accepts the path names small models use, quotes shell paths, hides binary content", () => {
+    expect(pathArg({ path: "a.py" })).toBe("a.py");
+    expect(pathArg({ file_path: "b.py" })).toBe("b.py");
+    expect(pathArg({ paths: ["c.py"] })).toBe("c.py");
+    expect(pathArg({})).toBe("");
+    expect(shellQuote("/x/it's")).toBe("'/x/it'\\''s'");
+    expect(binaryNotice("SQLite format 3\u0000\u0000")).toContain("Binary file");
+    expect(binaryNotice("plain text")).toBeNull();
+  });
+
+  it("does not treat delegating different tasks as a loop", () => {
+    const detector = new LoopDetector();
+    for (const title of ["Check wallet", "Check ledger", "Check services", "Check quotes"]) {
+      detector.recordToolCall("delegate_task", JSON.stringify({ title }));
+      expect(detector.endTurn().reason).toBe("");
+    }
+  });
+
+  it("maps critic to the general harness and executor to the coding harness", () => {
+    const registry = new HarnessRegistry();
+    expect(registry.getHarnessIdForRole("critic")).toBe("general");
+    expect(registry.getHarnessIdForRole("executor")).toBe("coding");
+  });
+});
+
+class Writer extends BaseHarness {
+  readonly id = "test";
+  readonly description = "test";
+  buildSystemPrompt() { return "s"; }
+  getToolDefs(): HarnessTool[] {
+    return [
+      { name: "write_file", description: "w", parameters: { type: "object", properties: {} },
+        execute: async (args) => { const t = path.resolve(this.context.workspaceRoot, String(args.path)); writeFileSync(t, String(args.content)); return `Wrote 1 bytes to ${t}`; } },
+      { name: "task_done", description: "d", parameters: { type: "object", properties: {} },
+        execute: async (args) => `TASK_COMPLETE:${String(args.summary)}` },
+    ];
+  }
+}
+
+const call = (id: string, name: string, args: Record<string, unknown>) => ({ id, type: "function" as const, function: { name, arguments: JSON.stringify(args) } });
+
+async function runTurns(turns: unknown[][]) {
+  tmp = mkdtempSync(path.join(os.tmpdir(), "guard2-"));
+  const workspace = new AgentWorkspace("g", path.join(tmp, "ws"));
+  mkdirSync(workspace.basePath, { recursive: true });
+  let i = 0;
+  const context: HarnessContext = {
+    workspaceRoot: workspace.basePath, allowedEditRoot: workspace.basePath, workspace,
+    identity: createTestIdentity(), config: createTestConfig(), db: createInMemoryDb(), conway: new MockConwayClient(),
+    inference: { chat: async () => ({ content: "", toolCalls: (turns[i++] ?? []) as any }) },
+    budget: { maxTurns: 5, maxCostCents: 1, timeoutMs: 5000, turnsUsed: 0, costUsedCents: 0, startedAt: 0 },
+    wisdom: { conventions: [], successes: [], failures: [], gotchas: [] },
+    abortSignal: new AbortController().signal, goalId: "g",
+  };
+  const harness = new Writer();
+  await harness.initialize({ id: "t", parentId: null, goalId: "g", title: "t", description: "d", status: "assigned",
+    assignedTo: "local://w", agentRole: "generalist", priority: 1, dependencies: [], result: null,
+    metadata: { estimatedCostCents: 1, actualCostCents: 0, maxRetries: 0, retryCount: 0, timeoutMs: 5000,
+      createdAt: "", startedAt: null, completedAt: null } } as TaskNode, context);
+  return harness.execute();
+}
+
+describe("fake money is not a successful task", () => {
+  it("rejects fake payments written to a CSV", async () => {
+    const csv = "id,amount,status\ntest_payment_001,1.0,completed\n";
+    const result = await runTurns([
+      [call("1", "write_file", { path: "revenue.csv", content: csv }), call("2", "task_done", { summary: "report written", success: true })],
+      [call("3", "task_done", { summary: "report written", success: true })],
+    ]);
+    expect(result.success).toBe(false);
+    expect(result.output).toContain("test_payment");
+  });
+
+  it("rejects a revenue claim that the verified ledger does not show", async () => {
+    const result = await runTurns([
+      [call("1", "task_done", { summary: "Service live, generated $0.50 from the first customer", success: true })],
+      [call("2", "task_done", { summary: "Service live, generated $0.50 from the first customer", success: true })],
+    ]);
+    expect(result.success).toBe(false);
+    expect(result.output).toContain("verified ledger");
+  });
+
+  it("accepts an honest summary without revenue", async () => {
+    const result = await runTurns([[call("1", "task_done", { summary: "Built the quote API; no revenue yet ($0).", success: true })]]);
+    expect(result.success).toBe(true);
+  });
+});
