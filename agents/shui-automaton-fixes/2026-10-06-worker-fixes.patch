 }
+
+const PROGRESS_MARKER = "files already written: ";
+
+/** Parse the file list written by withProgress() in a previous failure. */
+export function extractProgressFiles(output: string): string[] {
+  const start = output.indexOf(PROGRESS_MARKER);
+  if (start < 0) return [];
+  const rest = output.slice(start + PROGRESS_MARKER.length);
+  const end = rest.indexOf(". Resume from these files");
+  const list = (end >= 0 ? rest.slice(0, end) : rest).replace(/ \(\+\d+ more\)$/, "");
+  return list.split(", ").map((file) => file.trim()).filter(Boolean);
+}
