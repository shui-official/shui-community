index 0000000..aa4334c
--- /dev/null
+++ b/src/__tests__/orchestration/worker-attempts.test.ts
@@ -0,0 +1,22 @@
+import { describe, expect, it } from "vitest";
+import { extractProgressFiles } from "../../agent/harnesses/base-harness.js";
+import { filterWorkerTools } from "../../orchestration/local-worker.js";
+import type { AutomatonTool } from "../../types.js";
+
+describe("worker attempts", () => {
+  it("extracts files written by a previous attempt", () => {
+    const output = "Budget exhausted: reached max turns (25/25). Task \"X\" did not complete within the turn budget. " +
+      "Progress kept — files already written: /a/DEPLOYMENT.md, /a/app_fixed.py, /a/start.sh. Resume from these files instead of starting over.";
+    expect(extractProgressFiles(output)).toEqual(["/a/DEPLOYMENT.md", "/a/app_fixed.py", "/a/start.sh"]);
+    expect(extractProgressFiles("Budget exhausted: timeout")).toEqual([]);
+    expect(extractProgressFiles("files already written: /a/x.py (+3 more). Resume from these files")).toEqual(["/a/x.py"]);
+  });
+
+  it("hides Conway-only tools from workers when not registered with Conway", () => {
+    const tool = (name: string) => ({ name } as AutomatonTool);
+    const tools = [tool("list_sandboxes"), tool("check_credits"), tool("exec"), tool("write_file")];
+    expect(filterWorkerTools(tools, { registeredWithConway: false })!.map((t) => t.name)).toEqual(["exec", "write_file"]);
+    expect(filterWorkerTools(tools, { registeredWithConway: true })).toBe(tools);
+    expect(filterWorkerTools(tools, {})).toBe(tools);
+  });
+});
