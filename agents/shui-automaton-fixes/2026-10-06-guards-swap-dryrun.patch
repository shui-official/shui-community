+    const result = await service.dryRunValidatedRaydiumSwap(fakeTx(), {
+      inputMint: NATIVE_SOL_MINT, outputMint: USDC_MINT, inputAmount: 1000n, minimumOutputAmount: 1n,
+    });
+
+    expect(result).toEqual({ wouldSucceed: true, error: null, unitsConsumed: 81234, networkFeeLamports: 5000, logsTail: ["a", "b"] });
+    expect(validate).toHaveBeenCalledTimes(1);
+    expect(sign).not.toHaveBeenCalled();
+    expect(sendRawTransaction).not.toHaveBeenCalled();
+  });
+
+  it("reports a failing simulation instead of throwing", async () => {
+    const service = serviceWith({
+      simulateTransaction: vi.fn().mockResolvedValue({ value: { err: { InstructionError: [2, "Custom"] }, logs: [] } }),
+      getFeeForMessage: vi.fn().mockRejectedValue(new Error("rpc down")),
+    });
+    vi.spyOn(service, "validateRaydiumSwapOrder").mockResolvedValue(undefined);
+    const result = await service.dryRunValidatedRaydiumSwap(fakeTx(), {
+      inputMint: NATIVE_SOL_MINT, outputMint: USDC_MINT, inputAmount: 1000n, minimumOutputAmount: 1n,
+    });
+    expect(result.wouldSucceed).toBe(false);
+    expect(result.error).toContain("InstructionError");
+    expect(result.networkFeeLamports).toBeNull();
+  });
+});
