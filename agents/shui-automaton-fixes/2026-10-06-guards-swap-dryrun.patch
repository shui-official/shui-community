+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { BaseHarness } from "../../agent/harnesses/base-harness.js";
+import type { HarnessContext, HarnessTool } from "../../agent/harness-types.js";
+import type { TaskNode } from "../../orchestration/task-graph.js";
+import { AgentWorkspace } from "../../orchestration/workspace.js";
+import { createInMemoryDb } from "../orchestration/test-db.js";
+import { createTestConfig, createTestIdentity, MockConwayClient } from "../mocks.js";
+
+class WritingHarness extends BaseHarness {
+  readonly id = "test";
+  readonly description = "test harness";
+  buildSystemPrompt(): string {
+    return "system";
+  }
+  getToolDefs(): HarnessTool[] {
+    return [
+      {
+        name: "write_file",
+        description: "write",
+        parameters: { type: "object", properties: { path: { type: "string" }, content: { type: "string" } } },
+        execute: async (args) => {
+          const target = path.resolve(this.context.workspaceRoot, String(args.path));
+          writeFileSync(target, String(args.content));
+          return `Wrote ${String(args.content).length} bytes to ${target}`;
+        },
+      },
+      {
+        name: "task_done",
+        description: "done",
+        parameters: { type: "object", properties: { summary: { type: "string" }, success: { type: "boolean" } } },
+        execute: async (args) => `TASK_COMPLETE:${args.summary as string}`,
+      },
+    ];
+  }
+}
+
+const call = (id: string, name: string, args: Record<string, unknown>) => ({
+  id, type: "function" as const, function: { name, arguments: JSON.stringify(args) },
+});
+
+describe("simulated work is not accepted as a successful task", () => {
+  let tempDir: string | undefined;
+  afterEach(() => {
+    if (tempDir) rmSync(tempDir, { recursive: true, force: true });
+    tempDir = undefined;
+  });
+
+  async function run(content: string, turns: unknown[][]) {
+    tempDir = mkdtempSync(path.join(os.tmpdir(), "sim-guard-"));
+    const workspace = new AgentWorkspace("goal-1", path.join(tempDir, "workspace"));
+    const { mkdirSync } = await import("node:fs");
+    mkdirSync(workspace.basePath, { recursive: true });
+    let turn = 0;
+    const context: HarnessContext = {
+      workspaceRoot: workspace.basePath,
+      allowedEditRoot: tempDir,
+      workspace,
+      identity: createTestIdentity(),
+      config: createTestConfig(),
+      db: createInMemoryDb(),
+      conway: new MockConwayClient(),
+      inference: {
+        chat: async () => ({ content: "", toolCalls: (turns[turn++] ?? []) as any }),
+      },
+      budget: { maxTurns: 5, maxCostCents: 50, timeoutMs: 5_000, turnsUsed: 0, costUsedCents: 0, startedAt: 0 },
+      wisdom: { conventions: [], successes: [], failures: [], gotchas: [] },
+      abortSignal: new AbortController().signal,
+      goalId: "goal-1",
+    };
+    const task = {
+      id: "t1", parentId: null, goalId: "goal-1", title: "Build service", description: "d", status: "assigned",
+      assignedTo: "local://w", agentRole: "generalist", priority: 50, dependencies: [], result: null,
+      metadata: { estimatedCostCents: 1, actualCostCents: 0, maxRetries: 0, retryCount: 0, timeoutMs: 5_000,
+        createdAt: new Date().toISOString(), startedAt: null, completedAt: null },
+    } as TaskNode;
+    const harness = new WritingHarness();
+    await harness.initialize(task, context);
+    void content;
+    return harness.execute();
+  }
+
+  const MOCK = "def quote():\n    # For now we're just simulating the execution\n    return {'tx_hash': 'mock_tx_hash_12345'}\n";
+  const REAL = "import requests\ndef quote():\n    return requests.get('https://transaction-v1.raydium.io/compute/swap-base-in').json()\n";
+
+  it("rejects the first success claim, then records failure if the mock stays", async () => {
+    const result = await run(MOCK, [
+      [call("1", "write_file", { path: "app.py", content: MOCK }), call("2", "task_done", { summary: "built it", success: true })],
+      [call("3", "task_done", { summary: "built it", success: true })],
+    ]);
+    expect(result.success).toBe(false);
+    expect(result.output).toContain("Not accepted as success");
+    expect(result.output).toContain("app.py");
+  });
+
+  it("accepts success once the simulated part is replaced", async () => {
+    const result = await run(MOCK, [
+      [call("1", "write_file", { path: "app.py", content: MOCK }), call("2", "task_done", { summary: "built it", success: true })],
+      [call("3", "write_file", { path: "app.py", content: REAL }), call("4", "task_done", { summary: "real now", success: true })],
+    ]);
+    expect(result.success).toBe(true);
+    expect(result.output).toBe("real now");
+  });
+
+  it("ignores mocks inside test files", async () => {
+    const result = await run(MOCK, [
+      [call("1", "write_file", { path: "test_app.py", content: MOCK }), call("2", "task_done", { summary: "tests", success: true })],
+    ]);
+    expect(result.success).toBe(true);
+  });
+});
