+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { createDatabase } from "../state/database.js";
+import { SolanaTradingService, SolanaTransactionExpiredError, SolanaTransactionUncertainError } from "../solana/trading.js";
+import { classifySwapResult, listOrders, runOrderTick, saveOrder, PAPER_MAX_AGE_MS, type Order } from "../solana/orders.js";
+import { cacheTtlMs } from "../solana/technical-analysis.js";
+import { ensureLedgerSchema, syncSolBasisToBalance } from "../solana/ledger.js";
+import { QWEN_MEMORY_BUDGET } from "../agent/loop.js";
+
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot9b-")), "s.db"));
+const fakeTx = () => ({ signatures: [new Uint8Array(64).fill(7)], message: { recentBlockhash: "BH" }, serialize: () => new Uint8Array([1, 2, 3]) }) as any;
+const broadcast = (connection: any, timeoutMs = 3_000) =>
+  SolanaTradingService.prototype.broadcastAndConfirm.call({ connection } as any, fakeTx(), timeoutMs, 10);
+
+describe("transactions that land", () => {
+  it("re-sends the same transaction until it is confirmed", async () => {
+    let polls = 0;
+    const connection = {
+      sendRawTransaction: vi.fn(async () => "sig"),
+      getSignatureStatuses: vi.fn(async () => ({ value: [++polls >= 3 ? { slot: 9, confirmationStatus: "confirmed", err: null } : null] })),
+      isBlockhashValid: vi.fn(async () => ({ value: true })),
+    };
+    const res = await broadcast(connection, 10_000);
+    expect(res.confirmationStatus).toBe("confirmed");
+    expect(connection.sendRawTransaction.mock.calls.length).toBeGreaterThanOrEqual(2);
+    expect(connection.sendRawTransaction.mock.calls[1][1]).toMatchObject({ skipPreflight: true, maxRetries: 0 });
+  }, 15_000);
+
+  it("reports a transaction that can no longer land as expired, not uncertain", async () => {
+    const connection = {
+      sendRawTransaction: vi.fn(async () => "sig"),
+      getSignatureStatuses: vi.fn(async () => ({ value: [null] })),
+      isBlockhashValid: vi.fn(async () => ({ value: false })),
+    };
+    await expect(broadcast(connection, 15_000)).rejects.toBeInstanceOf(SolanaTransactionExpiredError);
+  }, 20_000);
+
+  it("stays uncertain while the blockhash is still valid at the deadline", async () => {
+    const connection = {
+      sendRawTransaction: vi.fn(async () => "sig"),
+      getSignatureStatuses: vi.fn(async () => ({ value: [null] })),
+      isBlockhashValid: vi.fn(async () => ({ value: true })),
+    };
+    await expect(broadcast(connection, 2_000)).rejects.toBeInstanceOf(SolanaTransactionUncertainError);
+  }, 10_000);
+
+  it("lets an order retry after an expired transaction without spending an attempt", () => {
+    expect(classifySwapResult("error: TRANSACTION_EXPIRED: abc did not land")).toMatchObject({ done: false, transient: true });
+  });
+});
+
+describe("lighter scans and context", () => {
+  it("keeps 4h candles 30 min and 1h candles 10 min", () => {
+    expect(cacheTtlMs("https://api.geckoterminal.com/api/v2/networks/solana/pools/x/ohlcv/hour?aggregate=4&limit=300")).toBe(30 * 60_000);
+    expect(cacheTtlMs("https://api.geckoterminal.com/api/v2/networks/solana/pools/x/ohlcv/hour?aggregate=1&limit=300")).toBe(10 * 60_000);
+  });
+  it("injects at most 3,200 tokens of memory", () => {
+    expect(Object.values(QWEN_MEMORY_BUDGET).reduce((a, b) => a + b, 0)).toBe(3_200);
+  });
+});
+
+describe("small fixes", () => {
+  it("scales the SOL cost basis down to the real balance, never up", () => {
+    const db = freshDb().raw;
+    ensureLedgerSchema(db);
+    const SOL = "So11111111111111111111111111111111111111112";
+    db.prepare("INSERT INTO shui_cost_basis (mint, amount_raw, cost_usd) VALUES (?, '111413264', 12.0)").run(SOL);
+    expect(syncSolBasisToBalance(db, 109_859_184n)).toBe(true);
+    const row = db.prepare("SELECT amount_raw, cost_usd FROM shui_cost_basis WHERE mint = ?").get(SOL) as any;
+    expect(row.amount_raw).toBe("109859184");
+    expect(row.cost_usd).toBeCloseTo(12 * 109_859_184 / 111_413_264);
+    expect(syncSolBasisToBalance(db, 200_000_000n)).toBe(false);
+  });
+
+  it("expires paper simulations left open for 72 h", async () => {
+    const db = freshDb();
+    const old = new Date(Date.now() - PAPER_MAX_AGE_MS - 60_000).toISOString();
+    saveOrder(db.raw, {
+      id: "paper_x_stop", group: "paper_x", kind: "stop_loss", condition: "below", triggerPriceUsd: 1, inputMint: "orcaEKTdK7LKz57vaAYr9QeNsVEPfiu6QeMU1kektZE",
+      outputMint: "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v", amount: "0", watchMint: "orcaEKTdK7LKz57vaAYr9QeNsVEPfiu6QeMU1kektZE", slippageBps: 0,
+      venue: "jupiter", note: "paper", createdAt: old, expiresAt: null, status: "open", attempts: 0, updatedAt: old, paper: true, paperUnits: 1, paperEntryUsd: 2,
+    } as Order);
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({}), swap: vi.fn(), now: () => new Date() });
+    expect(listOrders(db.raw)[0].status).toBe("expired");
+  });
+});
