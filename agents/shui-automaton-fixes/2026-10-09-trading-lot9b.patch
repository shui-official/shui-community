   return true;
 }
 
+/**
+ * Lot 9b: fees and rent lower the SOL balance without a journal entry, so the
+ * SOL cost basis drifted above the real balance. Scale it down to what the
+ * wallet really holds (never up: deposits are journaled separately).
+ */
+export function syncSolBasisToBalance(db: Database, heldLamports: bigint): boolean {
+  ensureLedgerSchema(db);
+  const basis = getBasis(db, SOL_MINT);
+  if (basis.amountRaw <= heldLamports || basis.amountRaw === 0n) return false;
+  const costUsd = basis.costUsd * (Number(heldLamports) / Number(basis.amountRaw));
+  setBasis(db, SOL_MINT, { amountRaw: heldLamports, costUsd });
+  return true;
+}
