diff --git a/src/solana/trading-desk.ts b/src/solana/trading-desk.ts
new file mode 100644
index 0000000..27261fb
--- /dev/null
+++ b/src/solana/trading-desk.ts
@@ -0,0 +1,261 @@
+/**
+ * Trading desk: the tools SHUI needs when its only activity is trading.
+ * - setup_scan: scans a watchlist of liquid Solana tokens (4h trend + 1h
+ *   entry) and returns only long setups that follow the playbook.
+ * - journal_add / trade_stats: a trade journal and real performance stats
+ *   computed from the ledger (realized PnL of every sale into USDC).
+ * Spot only: in a downtrend the right position is USDC.
+ */
+import { randomUUID } from "node:crypto";
+import type { Database } from "better-sqlite3";
+import type { AutomatonTool } from "../types.js";
+import {
+  atr, emaSeries, fetchCandles, fibonacci, macd, rsi, swings, type Candle, type Fetcher, defaultFetcher,
+} from "./technical-analysis.js";
+import { USDC_MINT } from "./raydium.js";
+
+export const TRADING_FOCUS_HIDDEN_TOOLS = new Set([
+  "service_deploy", "service_stop", "service_status", "service_logs", "payment_request", "payment_check",
+]);
+
+export function isTradingFocus(env: NodeJS.ProcessEnv = process.env): boolean {
+  return (env.SHUI_FOCUS ?? "").trim().toLowerCase() === "trading";
+}
+
+export const TRADING_FOCUS_PROMPT = `--- FOCUS: TRADING ONLY (set by your creator) ---
+Your only activity is trading the tokens of your Solana wallet to grow its value in USDC. Do not build
+services, websites or payment pages. Realized profit (selling a token for more USDC than it cost) is what
+extends your life. Your method, every cycle:
+1. trade_stats: know your results; after 2 losing trades today, stop trading until tomorrow.
+2. setup_scan: find setups that follow the playbook (4h trend up, 1h entry, reward/risk >= 2).
+   No setup = stay in USDC and sleep; waiting is a valid decision.
+3. technical_analysis on the chosen token (4h and 1h) to confirm the plan.
+4. journal_add kind=plan BEFORE buying: token, entry, stop, target, size, reason.
+5. Buy with jupiter_swap (or raydium_swap), size so that hitting the stop loses at most 2% of the wallet.
+6. Immediately order_create a stop_loss and a take_profit on the bought token (inputMint = watchMint = the token).
+7. When an order executes you get an inbox notice: journal_add kind=lesson with what you learned.
+Never swap SOL <-> USDC back and forth: it only costs fees.`;
+
+export const DEFAULT_WATCHLIST: Array<{ symbol: string; mint: string }> = [
+  { symbol: "SOL", mint: "So11111111111111111111111111111111111111112" },
+  { symbol: "JUP", mint: "JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN" },
+  { symbol: "RAY", mint: "4k3Dyjzvzp8eMZWUXbBCjEvwSkkk59S5iCNLY3QrkX6R" },
+  { symbol: "PYTH", mint: "HZ1JovNiVvGrGNiiYvEozEVgZ58xaU3RKwX8eACQBCt3" },
+  { symbol: "ORCA", mint: "orcaEKTdK7LKz57vaAYr9QeNsVEPfiu6QeMU1kektZE" },
+  { symbol: "BONK", mint: "DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263" },
+  { symbol: "WIF", mint: "EKpQGSJtjMFqKZ9KQanSqYXRcF8fBopzLHYxdM65zcjm" },
+];
+
+const MIN_LIQUIDITY_USD = 50_000;
+const fmt = (x: number) => (x >= 1 ? x.toFixed(4) : x.toPrecision(4));
+
+export interface SetupResult {
+  symbol: string;
+  mint: string;
+  ok: boolean;
+  reason: string;
+  plan?: { entry: number; stop: number; target: number; rr: number; stopPct: number; targetPct: number };
+}
+
+/** Long setup from a 4h trend frame and a 1h entry frame. */
+export function evaluateSetup(symbol: string, mint: string, h4: Candle[], h1: Candle[], liquidityUsd: number): SetupResult {
+  const no = (reason: string): SetupResult => ({ symbol, mint, ok: false, reason });
+  if (liquidityUsd < MIN_LIQUIDITY_USD) return no(`liquidity $${Math.round(liquidityUsd)} < $50k`);
+  if (h4.length < 50 || h1.length < 50) return no("not enough candles");
+  const c4 = h4.map((c) => c.c);
+  const c1 = h1.map((c) => c.c);
+  const ema20h4 = emaSeries(c4, 20).at(-1)!;
+  const ema50h4 = emaSeries(c4, 50).at(-1)!;
+  const price = c1.at(-1)!;
+  if (!(ema20h4 > ema50h4 && price > ema50h4)) return no("4h trend not up (EMA20 below EMA50 or price below EMA50): stay out");
+  const r = rsi(c1);
+  if (r === null || r > 68) return no(`1h RSI ${r?.toFixed(0) ?? "?"} too high: wait for a pullback`);
+  if (r < 35) return no(`1h RSI ${r.toFixed(0)}: falling knife, wait for it to turn up`);
+  const m = macd(c1);
+  if (m && m.hist < 0 && m.hist < m.prevHist) return no("1h momentum still falling (MACD histogram down)");
+  const a = atr(h1);
+  if (!a) return no("no volatility data");
+  const { lows } = swings(h1);
+  const support = lows.filter((l) => l < price).sort((x, y) => y - x)[0];
+  const stop = Math.max(support !== undefined ? support - 0.5 * a : -Infinity, price - 2 * a);
+  // Target: next MAJOR resistance (4h swing high); minor 1h highs are passed through.
+  const resistances = swings(h4, 3).highs.filter((h) => h > price * 1.002).sort((x, y) => x - y);
+  const fib = fibonacci(h4);
+  const target = resistances[0] ?? (fib?.direction === "up" ? fib.extensions[0].price : price + 3 * a);
+  const rr = (target - price) / (price - stop);
+  const plan = {
+    entry: price, stop, target, rr,
+    stopPct: ((price - stop) / price) * 100,
+    targetPct: ((target - price) / price) * 100,
+  };
+  if (!(rr >= 2)) return { ...no(`reward/risk ${rr.toFixed(2)} < 2 (target ${fmt(target)} too close to resistance)`), plan };
+  return { symbol, mint, ok: true, reason: `4h uptrend, 1h RSI ${r.toFixed(0)}, reward/risk ${rr.toFixed(2)}`, plan };
+}
+
+export async function setupScan(
+  args: { mints?: string[] },
+  fetcher: Fetcher = defaultFetcher,
+  pauseMs = 400,
+): Promise<string> {
+  const list = Array.isArray(args.mints) && args.mints.length
+    ? args.mints.slice(0, 12).map((mint) => DEFAULT_WATCHLIST.find((w) => w.mint === mint) ?? { symbol: mint.slice(0, 6), mint })
+    : DEFAULT_WATCHLIST;
+  const results: SetupResult[] = [];
+  for (const token of list) {
+    try {
+      const h4 = await fetchCandles(token.mint, "4h", fetcher);
+      const h1 = h4 ? await fetchCandles(token.mint, "1h", fetcher) : null;
+      if (!h4 || !h1) {
+        results.push({ symbol: token.symbol, mint: token.mint, ok: false, reason: "no liquid pool" });
+      } else {
+        results.push(evaluateSetup(h4.symbol, token.mint, h4.candles, h1.candles, h4.liquidityUsd));
+      }
+    } catch (error) {
+      results.push({ symbol: token.symbol, mint: token.mint, ok: false, reason: `data error: ${error instanceof Error ? error.message : String(error)}` });
+    }
+    if (pauseMs) await new Promise((resolve) => setTimeout(resolve, pauseMs));
+  }
+  const setups = results.filter((r) => r.ok).sort((a, b) => (b.plan?.rr ?? 0) - (a.plan?.rr ?? 0));
+  const lines = setups.map((s) =>
+    `SETUP ${s.symbol} mint=${s.mint}: entry ~${fmt(s.plan!.entry)}, stop ${fmt(s.plan!.stop)} (-${s.plan!.stopPct.toFixed(2)}%), ` +
+    `target ${fmt(s.plan!.target)} (+${s.plan!.targetPct.toFixed(2)}%), R/R ${s.plan!.rr.toFixed(2)} — ${s.reason}`);
+  const skipped = results.filter((r) => !r.ok).map((r) => `- ${r.symbol}: ${r.reason}`);
+  return (setups.length
+    ? `${setups.length} setup(s) following the playbook:\n${lines.join("\n")}\nConfirm with technical_analysis, then journal_add a plan before buying.`
+    : "No setup follows the playbook right now: stay in USDC and check again later (sleep 1-4 h).") +
+    `\nSkipped:\n${skipped.join("\n")}`;
+}
+
+// ─── Journal and stats ─────────────────────────────────────────
+
+const JOURNAL_PREFIX = "journal.";
+
+export function addJournalEntry(db: Database, entry: { kind: string; text: string; mint?: string }, now = new Date()): string {
+  const id = `${now.toISOString()}_${randomUUID().slice(0, 6)}`;
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))")
+    .run(`${JOURNAL_PREFIX}${id}`, JSON.stringify({ at: now.toISOString(), kind: entry.kind, mint: entry.mint ?? null, text: entry.text.slice(0, 1000) }));
+  return id;
+}
+
+export function recentJournal(db: Database, limit = 5): Array<{ at: string; kind: string; mint: string | null; text: string }> {
+  const rows = db.prepare("SELECT value FROM kv WHERE key LIKE 'journal.%' ORDER BY key DESC LIMIT ?").all(limit) as Array<{ value: string }>;
+  return rows.map((r) => JSON.parse(r.value));
+}
+
+export interface TradeStats {
+  closedTrades: number;
+  wins: number;
+  losses: number;
+  winRate: number | null;
+  totalPnlUsd: number;
+  avgWinUsd: number | null;
+  avgLossUsd: number | null;
+  expectancyUsd: number | null;
+  todayPnlUsd: number;
+  lossStreakToday: number;
+}
+
+/** Closed trades = sales into USDC recorded in the ledger (realized PnL). */
+export function computeTradeStats(db: Database, today = new Date().toISOString().slice(0, 10)): TradeStats {
+  let rows: Array<{ day: string; pnl: number }> = [];
+  try {
+    rows = db.prepare(
+      `SELECT day, realized_pnl_usd AS pnl FROM shui_ledger
+       WHERE kind = 'swap' AND output_mint = ? AND input_mint != ? ORDER BY ts`,
+    ).all(USDC_MINT, USDC_MINT) as Array<{ day: string; pnl: number }>;
+  } catch {
+    rows = [];
+  }
+  const wins = rows.filter((r) => r.pnl > 0);
+  const losses = rows.filter((r) => r.pnl < 0);
+  const sum = (xs: Array<{ pnl: number }>) => xs.reduce((s, r) => s + r.pnl, 0);
+  const todayRows = rows.filter((r) => r.day === today);
+  let streak = 0;
+  for (const r of [...todayRows].reverse()) {
+    if (r.pnl < 0) streak += 1; else break;
+  }
+  const decided = wins.length + losses.length;
+  return {
+    closedTrades: rows.length,
+    wins: wins.length,
+    losses: losses.length,
+    winRate: decided ? wins.length / decided : null,
+    totalPnlUsd: sum(rows),
+    avgWinUsd: wins.length ? sum(wins) / wins.length : null,
+    avgLossUsd: losses.length ? sum(losses) / losses.length : null,
+    expectancyUsd: rows.length ? sum(rows) / rows.length : null,
+    todayPnlUsd: sum(todayRows),
+    lossStreakToday: streak,
+  };
+}
+
+export function formatTradeStats(s: TradeStats, journal: ReturnType<typeof recentJournal>): string {
+  const money = (x: number | null) => (x === null ? "?" : `${x >= 0 ? "+" : ""}$${x.toFixed(4)}`);
+  const lines = [
+    `Closed trades (sales into USDC): ${s.closedTrades} | wins ${s.wins} / losses ${s.losses} | win rate ${s.winRate === null ? "?" : `${(s.winRate * 100).toFixed(0)}%`}`,
+    `Realized PnL total ${money(s.totalPnlUsd)} | today ${money(s.todayPnlUsd)} | avg win ${money(s.avgWinUsd)} | avg loss ${money(s.avgLossUsd)} | expectancy per trade ${money(s.expectancyUsd)}`,
+  ];
+  if (s.lossStreakToday >= 2) lines.push(`STOP: ${s.lossStreakToday} losing trades in a row today. Playbook rule 12: no more trades until tomorrow.`);
+  else if (s.expectancyUsd !== null && s.closedTrades >= 10 && s.expectancyUsd < 0) {
+    lines.push("Your method loses money on average over 10+ trades: change it (stricter setups, wider targets) before trading more.");
+  }
+  if (journal.length) {
+    lines.push("Recent journal:");
+    for (const j of journal) lines.push(`- ${j.at.slice(0, 16)} [${j.kind}]${j.mint ? ` ${j.mint.slice(0, 6)}…` : ""} ${j.text.slice(0, 200)}`);
+  } else {
+    lines.push("Journal empty: write a plan with journal_add before each trade and a lesson after it.");
+  }
+  return lines.join("\n");
+}
+
+export function createTradingDeskTools(): AutomatonTool[] {
+  return [
+    {
+      name: "setup_scan",
+      description:
+        "Scan a watchlist of liquid Solana tokens (default SOL, JUP, RAY, PYTH, ORCA, BONK, WIF; or pass mints) on 4h (trend) " +
+        "and 1h (entry) and return only long setups that follow the playbook: 4h uptrend, 1h RSI 35-68, momentum turning, " +
+        "liquidity >= $50k, reward/risk >= 2, with entry, stop and target. Takes ~30 s.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: { mints: { type: "array", items: { type: "string" }, description: "Optional token mints (max 12)." } } },
+      execute: async (args) => {
+        try {
+          return await setupScan(args as { mints?: string[] });
+        } catch (error) {
+          return `setup_scan failed: ${error instanceof Error ? error.message : String(error)}`;
+        }
+      },
+    },
+    {
+      name: "journal_add",
+      description: "Write in your trade journal: kind=plan before a trade (token, entry, stop, target, size, reason), kind=lesson after it (what worked or not), kind=note otherwise.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: {
+        type: "object",
+        properties: {
+          kind: { type: "string", description: '"plan", "lesson" or "note".' },
+          text: { type: "string" },
+          mint: { type: "string", description: "Token mint, if any." },
+        },
+        required: ["kind", "text"],
+      },
+      execute: async (args, ctx) => {
+        const kind = ["plan", "lesson", "note"].includes(String(args.kind)) ? String(args.kind) : "note";
+        const text = String(args.text ?? "").trim();
+        if (!text) return "Blocked: text is required.";
+        addJournalEntry(ctx.db.raw, { kind, text, mint: args.mint ? String(args.mint) : undefined });
+        return `Journal ${kind} saved.`;
+      },
+    },
+    {
+      name: "trade_stats",
+      description: "Your real trading results from the ledger (closed trades, win rate, realized PnL, expectancy, today's losing streak) and your recent journal. Read it at the start of every trading cycle.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: {} },
+      execute: async (_args, ctx) => formatTradeStats(computeTradeStats(ctx.db.raw), recentJournal(ctx.db.raw)),
+    },
+  ];
+}
