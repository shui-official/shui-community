+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { createDatabase } from "../state/database.js";
+import { ensureLedgerSchema } from "../solana/ledger.js";
+import {
+  addJournalEntry, computeTradeStats, evaluateSetup, formatTradeStats, isTradingFocus, recentJournal, setupScan,
+} from "../solana/trading-desk.js";
+import type { Candle } from "../solana/technical-analysis.js";
+
+const USDC = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+const candles = (closes: number[], wick = 0.01): Candle[] =>
+  closes.map((c, i) => ({ t: i, o: c, h: c * (1 + wick), l: c * (1 - wick), c, v: 100 }));
+// Uptrend with pullbacks; ends after a dip so RSI is moderate.
+const uptrend = (n: number) => Array.from({ length: n }, (_, i) => 100 + i * 0.6 + Math.sin(i / 2.5) * 4);
+
+function freshDb() {
+  return createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "desk-")), "state.db"));
+}
+
+afterEach(() => { delete process.env.SHUI_FOCUS; });
+
+describe("setup evaluation", () => {
+  it("stays out of a downtrend and of thin pools", () => {
+    const down = candles(uptrend(120).reverse());
+    expect(evaluateSetup("X", "M", down, down, 1_000_000).reason).toMatch(/4h trend not up/);
+    expect(evaluateSetup("X", "M", down, down, 10_000).reason).toMatch(/liquidity/);
+  });
+
+  it("gives a plan with stop below entry and target above, and only accepts R/R >= 2", () => {
+    const h4 = candles(uptrend(120));
+    const h1 = candles(uptrend(120).map((c, i) => (i > 112 ? c - (i - 112) * 1.2 : c)));
+    const r = evaluateSetup("TKN", "MINT", h4, h1, 2_000_000);
+    if (r.plan) {
+      expect(r.plan.stop).toBeLessThan(r.plan.entry);
+      expect(r.plan.target).toBeGreaterThan(r.plan.entry);
+      expect(r.ok).toBe(r.plan.rr >= 2);
+    } else {
+      expect(r.ok).toBe(false);
+    }
+  });
+
+  it("scans a watchlist and reports skipped tokens with reasons", async () => {
+    const ohlcv = (closes: number[]) => ({ data: { attributes: { ohlcv_list: closes.map((c, i) => [i, c, c * 1.01, c * 0.99, c, 10]) } } });
+    const fetcher = async (url: string) => url.includes("dexscreener")
+      ? [{ chainId: "solana", pairAddress: "P", dexId: "orca", liquidity: { usd: 5_000_000 }, baseToken: { symbol: "DOWN" } }]
+      : ohlcv(uptrend(120).reverse());
+    const text = await setupScan({ mints: ["MINT1"] }, fetcher, 0);
+    expect(text).toMatch(/No setup follows the playbook/);
+    expect(text).toMatch(/DOWN: 4h trend not up/);
+  });
+});
+
+describe("journal and stats", () => {
+  it("computes win rate, PnL and the losing streak of the day from ledger sales", () => {
+    const db = freshDb();
+    ensureLedgerSchema(db.raw);
+    const today = new Date().toISOString().slice(0, 10);
+    const ins = db.raw.prepare(
+      "INSERT INTO shui_ledger (signature, ts, day, kind, input_mint, input_amount_raw, output_mint, output_amount_raw, realized_pnl_usd) VALUES (?, ?, ?, 'swap', ?, '1', ?, '1', ?)",
+    );
+    ins.run("a", "2026-10-01T00:00:00Z", "2026-10-01", "TOKEN", USDC, 1.5);
+    ins.run("b", `${today}T01:00:00Z`, today, "TOKEN", USDC, -0.4);
+    ins.run("c", `${today}T02:00:00Z`, today, "TOKEN", USDC, -0.2);
+    ins.run("buy", `${today}T00:30:00Z`, today, USDC, "TOKEN", 0);
+    const s = computeTradeStats(db.raw, today);
+    expect(s).toMatchObject({ closedTrades: 3, wins: 1, losses: 2, lossStreakToday: 2 });
+    expect(s.totalPnlUsd).toBeCloseTo(0.9, 6);
+    addJournalEntry(db.raw, { kind: "plan", text: "buy JUP at 0.5, stop 0.48, target 0.56", mint: "JUPy" });
+    const text = formatTradeStats(s, recentJournal(db.raw));
+    expect(text).toMatch(/win rate 33%/);
+    expect(text).toMatch(/STOP: 2 losing trades in a row today/);
+    expect(text).toMatch(/\[plan\] JUPy/);
+  });
+});
+
+describe("trading focus", () => {
+  it("hides services and payment tools only when SHUI_FOCUS=trading", async () => {
+    const { createBuiltinTools } = await import("../agent/tools.js");
+    const names = () => createBuiltinTools("").map((t) => t.name);
+    expect(names()).toContain("service_deploy");
+    process.env.SHUI_FOCUS = "trading";
+    expect(isTradingFocus()).toBe(true);
+    expect(names()).not.toContain("service_deploy");
+    expect(names()).not.toContain("payment_request");
+    expect(names()).toEqual(expect.arrayContaining(["setup_scan", "trade_stats", "journal_add", "jupiter_swap", "order_create"]));
+  });
+});
