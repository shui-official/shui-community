+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { createDatabase, claimInboxMessages } from "../state/database.js";
+import { atrSeries, backtest, entrySignals, rsiSeries } from "../solana/backtest.js";
+import { listStrategies, runStrategyTick, saveStrategy, type Strategy } from "../solana/strategies.js";
+import { listOrders, runOrderTick, saveOrder } from "../solana/orders.js";
+import { classifyRegime } from "../solana/market-regime.js";
+import type { Candle } from "../solana/technical-analysis.js";
+
+const TOKEN = "TokenMint1111111111111111111111111111111111";
+const mk = (closes: number[]): Candle[] => closes.map((c, i) => ({ t: i * 3600, o: c, h: c * 1.01, l: c * 0.99, c, v: 100 }));
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot2-")), "s.db"));
+
+describe("backtest", () => {
+  it("computes indicator series without look-ahead and finds EMA cross signals", () => {
+    const closes = [...Array.from({ length: 40 }, (_, i) => 100 - i * 0.5), ...Array.from({ length: 40 }, (_, i) => 80 + i)];
+    const candles = mk(closes);
+    expect(rsiSeries(closes)[13]).toBeNull();
+    expect(atrSeries(candles)[20]).toBeGreaterThan(0);
+    const signals = entrySignals("ema_cross", candles);
+    expect(signals.filter(Boolean).length).toBeGreaterThanOrEqual(1);
+    expect(signals.slice(0, 40).some(Boolean)).toBe(false);
+  });
+
+  it("scores a trending market as winning and a falling one as losing, net of fees", () => {
+    const up = mk(Array.from({ length: 300 }, (_, i) => 100 + i * 0.4 + Math.sin(i / 6) * 8));
+    const rUp = backtest("ema_cross", up, { rr: 2 });
+    expect(rUp.trades.length).toBeGreaterThan(3);
+    expect(rUp.totalReturnPct).toBeGreaterThan(0);
+    const down = mk(Array.from({ length: 300 }, (_, i) => 300 - i * 0.4 + Math.sin(i / 6) * 8));
+    const rDown = backtest("ema_cross", down, { rr: 2 });
+    expect(rDown.totalReturnPct).toBeLessThan(0);
+    expect(rDown.maxDrawdownPct).toBeGreaterThan(0);
+  });
+});
+
+describe("strategy runner", () => {
+  const strategy = (over: Partial<Strategy> = {}): Strategy => ({
+    id: "stgA", mint: TOKEN, symbol: "TKN", timeframe: "1h", rule: "ema_cross", params: {}, sizeUsd: 5, active: true,
+    state: "flat", group: null, lastSignalTs: null, trades: 0, note: "", lastError: null, createdAt: "", updatedAt: "", ...over,
+  });
+  // Last closed candle is an EMA9/EMA21 cross up; the final (forming) candle is ignored.
+  const crossing = (): Candle[] => {
+    const closes = [...Array.from({ length: 60 }, (_, i) => 100 - i * 0.3), ...Array.from({ length: 8 }, (_, i) => 82 + i * 1.5)];
+    const candles = mk(closes);
+    const sig = entrySignals("ema_cross", candles);
+    const last = sig.lastIndexOf(true);
+    return candles.slice(0, last + 2);
+  };
+
+  it("buys on a new closed-candle signal and protects the position with OCO orders, once per candle", async () => {
+    const db = freshDb();
+    saveStrategy(db.raw, strategy());
+    const swap = vi.fn(async () => JSON.stringify({ success: true, signature: "SIG", journal: { outputAmountRaw: "4200" } }));
+    const deps = { db, chainIdentity: {} as any, candles: async () => crossing(), swap };
+    expect(await runStrategyTick(deps)).toEqual(["stgA"]);
+    expect(swap).toHaveBeenCalledWith(expect.objectContaining({ id: "stgA" }), "5000000");
+    const orders = listOrders(db.raw);
+    expect(orders.map((o) => o.kind).sort()).toEqual(["stop_loss", "take_profit"]);
+    expect(orders.every((o) => o.amount === "4200" && o.group === orders[0].group)).toBe(true);
+    const [stop, tp] = [orders.find((o) => o.kind === "stop_loss")!, orders.find((o) => o.kind === "take_profit")!];
+    expect(stop.triggerPriceUsd).toBeLessThan(tp.triggerPriceUsd);
+    expect(listStrategies(db.raw)[0]).toMatchObject({ state: "long", trades: 1 });
+    expect(claimInboxMessages(db.raw, 5)[0].content).toMatch(/BOUGHT \$5/);
+    expect(await runStrategyTick(deps)).toEqual([]); // still long: no second buy
+  });
+
+  it("goes back to flat when its OCO orders are closed, and records a refused buy without retrying the candle", async () => {
+    const db = freshDb();
+    saveStrategy(db.raw, strategy({ state: "long", group: "g1" }));
+    saveOrder(db.raw, { id: "g1_stop", kind: "stop_loss", inputMint: TOKEN, outputMint: TOKEN, amount: "1", watchMint: TOKEN, condition: "below", triggerPriceUsd: 1, slippageBps: 100, venue: "jupiter", note: "", createdAt: "", expiresAt: null, status: "filled", attempts: 1, updatedAt: "", group: "g1" });
+    const swap = vi.fn(async () => JSON.stringify({ success: false, blocked: true, reason: "DRAWDOWN_PAUSE" }));
+    const deps = { db, chainIdentity: {} as any, candles: async () => crossing(), swap };
+    await runStrategyTick(deps);
+    expect(listStrategies(db.raw)[0]).toMatchObject({ state: "flat", lastError: "DRAWDOWN_PAUSE" });
+    await runStrategyTick(deps);
+    expect(swap).toHaveBeenCalledTimes(1);
+  });
+});
+
+describe("price alerts", () => {
+  it("wakes SHUI without trading", async () => {
+    const db = freshDb();
+    saveOrder(db.raw, { id: "alr1", kind: "alert", inputMint: TOKEN, outputMint: TOKEN, amount: "0", watchMint: TOKEN, condition: "above", triggerPriceUsd: 2, slippageBps: 0, venue: "jupiter", note: "check breakout", createdAt: "", expiresAt: null, status: "open", attempts: 0, updatedAt: new Date().toISOString() });
+    const swap = vi.fn();
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [TOKEN]: 2.1 }), swap });
+    expect(swap).not.toHaveBeenCalled();
+    expect(listOrders(db.raw)[0].status).toBe("filled");
+    expect(claimInboxMessages(db.raw, 5)[0].content).toMatch(/PRICE ALERT alr1.*check breakout/);
+  });
+});
+
+describe("market regime", () => {
+  it("classifies tailwinds and headwinds", () => {
+    const base = { btc24h: null, sol24h: null, solDexVolume24h: null };
+    expect(classifyRegime({ ...base, btc7d: 5, sol7d: 8, fearGreed: { value: 60, label: "Greed" }, solDexVolumeChange7d: 10, solDailyTrendUp: true }).regime).toBe("RISK-ON");
+    expect(classifyRegime({ ...base, btc7d: -6, sol7d: -12, fearGreed: { value: 20, label: "Extreme Fear" }, solDexVolumeChange7d: -40, solDailyTrendUp: false }).regime).toBe("RISK-OFF");
+    expect(classifyRegime({ ...base, btc7d: null, sol7d: null, fearGreed: null, solDexVolumeChange7d: null, solDailyTrendUp: null }).regime).toBe("NEUTRAL");
+  });
+});
