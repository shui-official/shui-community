@@ -0,0 +1,110 @@
+/**
+ * Market regime: is the whole market a tailwind or a headwind? Altcoins
+ * mostly follow SOL and BTC; buying them while both fall is fighting the
+ * tide. Free public sources (no key): CoinGecko (BTC/SOL 24h and 7d),
+ * alternative.me (Fear & Greed), DefiLlama (Solana DEX volume), SOL daily
+ * candles (trend). Each source can fail independently.
+ */
+import type { AutomatonTool } from "../types.js";
+import { fetchJson } from "./http-json.js";
+import { emaSeries, fetchCandles } from "./technical-analysis.js";
+
+export interface RegimeInputs {
+  btc7d: number | null;
+  btc24h: number | null;
+  sol7d: number | null;
+  sol24h: number | null;
+  fearGreed: { value: number; label: string } | null;
+  solDexVolume24h: number | null;
+  solDexVolumeChange7d: number | null;
+  solDailyTrendUp: boolean | null;
+}
+
+export function classifyRegime(x: RegimeInputs): { regime: "RISK-ON" | "NEUTRAL" | "RISK-OFF"; score: number; reasons: string[] } {
+  let score = 0;
+  const reasons: string[] = [];
+  if (x.solDailyTrendUp !== null) {
+    score += x.solDailyTrendUp ? 1 : -1;
+    reasons.push(`SOL daily trend ${x.solDailyTrendUp ? "up (EMA20 > EMA50)" : "down (EMA20 < EMA50)"}`);
+  }
+  if (x.sol7d !== null) { score += x.sol7d > 0 ? 1 : -1; reasons.push(`SOL 7d ${x.sol7d.toFixed(1)}%`); }
+  if (x.btc7d !== null) { score += x.btc7d > 0 ? 1 : -1; reasons.push(`BTC 7d ${x.btc7d.toFixed(1)}%`); }
+  if (x.fearGreed) {
+    reasons.push(`Fear & Greed ${x.fearGreed.value} (${x.fearGreed.label})`);
+    if (x.fearGreed.value >= 80) { score -= 1; reasons.push("extreme greed: tops form here, tighten stops"); }
+  }
+  if (x.solDexVolumeChange7d !== null) {
+    reasons.push(`Solana DEX volume 7d ${x.solDexVolumeChange7d >= 0 ? "+" : ""}${x.solDexVolumeChange7d.toFixed(1)}%`);
+    if (x.solDexVolumeChange7d < -30) score -= 1;
+  }
+  const regime = score >= 2 ? "RISK-ON" : score <= -2 ? "RISK-OFF" : "NEUTRAL";
+  return { regime, score, reasons };
+}
+
+export async function readRegimeInputs(get: (url: string) => Promise<unknown> = async (u) => (await fetchJson(u)).body): Promise<RegimeInputs> {
+  const out: RegimeInputs = {
+    btc7d: null, btc24h: null, sol7d: null, sol24h: null, fearGreed: null,
+    solDexVolume24h: null, solDexVolumeChange7d: null, solDailyTrendUp: null,
+  };
+  await Promise.all([
+    get("https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=bitcoin,solana&price_change_percentage=24h,7d")
+      .then((body) => {
+        for (const c of (Array.isArray(body) ? body : []) as Array<Record<string, any>>) {
+          const d7 = Number(c.price_change_percentage_7d_in_currency);
+          const d1 = Number(c.price_change_percentage_24h_in_currency ?? c.price_change_percentage_24h);
+          if (c.id === "bitcoin") { out.btc7d = Number.isFinite(d7) ? d7 : null; out.btc24h = Number.isFinite(d1) ? d1 : null; }
+          if (c.id === "solana") { out.sol7d = Number.isFinite(d7) ? d7 : null; out.sol24h = Number.isFinite(d1) ? d1 : null; }
+        }
+      }).catch(() => undefined),
+    get("https://api.alternative.me/fng/?limit=1")
+      .then((body) => {
+        const d = (body as { data?: Array<{ value: string; value_classification: string }> }).data?.[0];
+        if (d) out.fearGreed = { value: Number(d.value), label: d.value_classification };
+      }).catch(() => undefined),
+    get("https://api.llama.fi/overview/dexs/solana?excludeTotalDataChart=true&excludeTotalDataChartBreakdown=true")
+      .then((body) => {
+        const b = body as { total24h?: number; change_7d?: number; change_7dover7d?: number };
+        out.solDexVolume24h = typeof b.total24h === "number" ? b.total24h : null;
+        const c7 = b.change_7dover7d ?? b.change_7d;
+        out.solDexVolumeChange7d = typeof c7 === "number" ? c7 : null;
+      }).catch(() => undefined),
+  ]);
+  return out;
+}
+
+export async function marketRegime(): Promise<string> {
+  const inputs = await readRegimeInputs();
+  try {
+    const sol = await fetchCandles("So11111111111111111111111111111111111111112", "1d");
+    if (sol && sol.candles.length >= 50) {
+      const closes = sol.candles.map((c) => c.c);
+      inputs.solDailyTrendUp = emaSeries(closes, 20).at(-1)! > emaSeries(closes, 50).at(-1)!;
+    }
+  } catch {
+    // trend unavailable
+  }
+  const r = classifyRegime(inputs);
+  const advice = r.regime === "RISK-ON"
+    ? "Tailwind: setups on SOL and liquid altcoins are favoured; keep normal size and stops."
+    : r.regime === "RISK-OFF"
+      ? "Headwind: most altcoins fall with the market. Prefer USDC, or only the strongest setups at half size."
+      : "Mixed: trade only clean setups, normal size, no memecoins.";
+  return `Market regime: ${r.regime} (score ${r.score}). ${r.reasons.join("; ") || "no data"}.\n${advice}`;
+}
+
+export function createMarketRegimeTool(): AutomatonTool {
+  return {
+    name: "market_regime",
+    description: "Overall market weather before trading: SOL daily trend, SOL and BTC 7-day moves, Fear & Greed index, Solana DEX volume. Returns RISK-ON / NEUTRAL / RISK-OFF with advice. Check it once per cycle.",
+    category: "financial",
+    riskLevel: "safe",
+    parameters: { type: "object", properties: {} },
+    execute: async () => {
+      try {
+        return await marketRegime();
+      } catch (error) {
+        return `market_regime failed: ${error instanceof Error ? error.message : String(error)}`;
+      }
+    },
+  };
+}
