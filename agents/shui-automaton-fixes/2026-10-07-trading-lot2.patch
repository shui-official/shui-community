diff --git a/src/solana/strategies.ts b/src/solana/strategies.ts
new file mode 100644
index 0000000..85e979c
--- /dev/null
+++ b/src/solana/strategies.ts
@@ -0,0 +1,246 @@
+/**
+ * Automatic strategies: SHUI designs a rule, the code runs it. A model turn
+ * takes minutes and SHUI sleeps between turns; a strategy checks its token
+ * every few minutes on closed candles and, on an entry signal, buys a fixed
+ * USDC size through the safe swap engine and immediately protects the
+ * position with a linked stop-loss / take-profit (OCO). One position per
+ * strategy at a time. Creation runs a backtest first.
+ */
+import { randomUUID } from "node:crypto";
+import { PublicKey } from "@solana/web3.js";
+import type { Database } from "better-sqlite3";
+import type { AutomatonDatabase, AutomatonTool } from "../types.js";
+import type { ChainIdentity } from "../identity/chain.js";
+import { fetchCandles, type Candle } from "./technical-analysis.js";
+import { atrSeries, backtest, entrySignals, RULE_PARAM_SCHEMA, RULES, type Rule, type RuleParams } from "./backtest.js";
+import { runSwap } from "./swap-engine.js";
+import { jupiterVenue } from "./jupiter.js";
+import { USDC_MINT } from "./raydium.js";
+import { listOrders, saveOrder, type Order } from "./orders.js";
+import { queueSystemNotice } from "../integration/creator-chat.js";
+
+const PREFIX = "strategy.";
+export const MAX_ACTIVE_STRATEGIES = 3;
+export const STRATEGY_CHECK_MS = 5 * 60_000;
+
+export interface Strategy {
+  id: string;
+  mint: string;
+  symbol: string;
+  timeframe: string;
+  rule: Rule;
+  params: RuleParams;
+  sizeUsd: number;
+  active: boolean;
+  state: "flat" | "long";
+  group: string | null;
+  lastSignalTs: number | null;
+  trades: number;
+  note: string;
+  lastError: string | null;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export function saveStrategy(db: Database, s: Strategy): void {
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(`${PREFIX}${s.id}`, JSON.stringify(s));
+}
+
+export function listStrategies(db: Database): Strategy[] {
+  const rows = db.prepare("SELECT value FROM kv WHERE key LIKE 'strategy.%' ORDER BY key").all() as Array<{ value: string }>;
+  const out: Strategy[] = [];
+  for (const r of rows) {
+    try {
+      out.push(JSON.parse(r.value) as Strategy);
+    } catch {
+      // skip
+    }
+  }
+  return out;
+}
+
+export interface StrategyDeps {
+  db: AutomatonDatabase;
+  chainIdentity: ChainIdentity;
+  candles?: (mint: string, timeframe: string) => Promise<Candle[] | null>;
+  swap?: (s: Strategy, amountRaw: string) => Promise<string>;
+  now?: () => Date;
+  log?: (message: string) => void;
+}
+
+/** One pass over active strategies. Returns ids that acted. */
+export async function runStrategyTick(deps: StrategyDeps): Promise<string[]> {
+  const db = deps.db.raw;
+  const now = (deps.now ?? (() => new Date()))();
+  const acted: string[] = [];
+  for (const strategy of listStrategies(db).filter((s) => s.active)) {
+    let s = strategy;
+    if (s.state === "long") {
+      const stillOpen = s.group && listOrders(db).some((o) => o.group === s.group && (o.status === "open" || o.status === "executing"));
+      if (stillOpen) continue;
+      s = { ...s, state: "flat", group: null, updatedAt: now.toISOString() };
+      saveStrategy(db, s);
+    }
+    let candles: Candle[] | null;
+    try {
+      candles = deps.candles
+        ? await deps.candles(s.mint, s.timeframe)
+        : (await fetchCandles(s.mint, s.timeframe))?.candles ?? null;
+    } catch (error) {
+      saveStrategy(db, { ...s, lastError: `data: ${error instanceof Error ? error.message : String(error)}`, updatedAt: now.toISOString() });
+      continue;
+    }
+    if (!candles || candles.length < 60) continue;
+    const closed = candles.slice(0, -1); // the last candle may still be forming
+    const i = closed.length - 1;
+    if (s.lastSignalTs === closed[i].t) continue;
+    if (!entrySignals(s.rule, closed, s.params)[i]) continue;
+    const atr = atrSeries(closed)[i];
+    if (!atr) continue;
+
+    s = { ...s, lastSignalTs: closed[i].t, updatedAt: now.toISOString() };
+    saveStrategy(db, s); // never retry the same candle, whatever happens next
+    const amountRaw = String(Math.floor(s.sizeUsd * 1_000_000));
+    let text: string;
+    try {
+      text = await (deps.swap ?? ((st, amount) => runSwap(
+        { db: deps.db, chainIdentity: deps.chainIdentity },
+        { inputMint: USDC_MINT, outputMint: st.mint, amount, slippageBps: 100 },
+        jupiterVenue,
+      )))(s, amountRaw);
+    } catch (error) {
+      text = `error: ${error instanceof Error ? error.message : String(error)}`;
+    }
+    let parsed: Record<string, any> | null = null;
+    try {
+      parsed = JSON.parse(text);
+    } catch {
+      parsed = null;
+    }
+    if (parsed?.success !== true) {
+      const reason = String(parsed?.reason ?? text).slice(0, 200);
+      saveStrategy(db, { ...s, lastError: reason });
+      queueSystemNotice(db, "system:strategies", `Strategy ${s.id} (${s.symbol} ${s.rule}) had an entry signal but the buy did not happen: ${reason}`);
+      acted.push(s.id);
+      continue;
+    }
+    const bought = String(parsed.journal?.outputAmountRaw ?? parsed.quotedOutputAmount ?? "0");
+    const entry = closed[i].c;
+    const stopAtr = s.params.stopAtr ?? 1.5;
+    const rr = s.params.rr ?? 2;
+    const stop = entry - stopAtr * atr;
+    const target = entry + rr * (entry - stop);
+    const group = `stg_${s.id}_${now.getTime().toString(36)}`;
+    const base = {
+      inputMint: s.mint, outputMint: USDC_MINT, amount: bought, watchMint: s.mint, slippageBps: 150, venue: "jupiter" as const,
+      note: `strategy ${s.id}`, createdAt: now.toISOString(), expiresAt: null, status: "open" as const, attempts: 0,
+      updatedAt: now.toISOString(), group,
+    };
+    const stopOrder: Order = { ...base, id: `${group}_stop`, kind: "stop_loss", condition: "below", triggerPriceUsd: stop };
+    const tpOrder: Order = { ...base, id: `${group}_tp`, kind: "take_profit", condition: "above", triggerPriceUsd: target };
+    saveOrder(db, stopOrder);
+    saveOrder(db, tpOrder);
+    saveStrategy(db, { ...s, state: "long", group, trades: s.trades + 1, lastError: null });
+    acted.push(s.id);
+    deps.log?.(`[STRATEGY] ${s.id} bought ${s.symbol} ~${entry} (stop ${stop}, target ${target})`);
+    queueSystemNotice(db, "system:strategies",
+      `Strategy ${s.id} (${s.symbol} ${s.rule} ${s.timeframe}) BOUGHT $${s.sizeUsd} at ~${entry.toPrecision(6)}: ` +
+      `stop ${stop.toPrecision(6)}, target ${target.toPrecision(6)} (OCO ${group}). signature ${parsed.signature}. Write a journal plan.`);
+  }
+  return acted;
+}
+
+export function startStrategyRunner(deps: StrategyDeps): () => void {
+  let running = false;
+  const timer = setInterval(() => {
+    if (running) return;
+    running = true;
+    runStrategyTick(deps)
+      .catch((error) => deps.log?.(`[STRATEGY] tick failed: ${error instanceof Error ? error.message : String(error)}`))
+      .finally(() => { running = false; });
+  }, STRATEGY_CHECK_MS);
+  timer.unref?.();
+  return () => clearInterval(timer);
+}
+
+export function createStrategyTools(): AutomatonTool[] {
+  return [
+    {
+      name: "strategy_create",
+      description:
+        "Hand a tested rule to the code: it watches the token on closed candles every 5 min and, on each entry signal, " +
+        "buys sizeUsd of USDC worth of the token and protects it with a linked stop-loss/take-profit (OCO), one position " +
+        "at a time. A backtest runs first; a losing backtest is refused unless force=true. Max 3 active strategies. " +
+        "Size it so the stop loses at most 2% of the wallet.",
+      category: "financial",
+      riskLevel: "dangerous",
+      parameters: {
+        type: "object",
+        properties: {
+          mint: { type: "string" },
+          sizeUsd: { type: "number", description: "USDC spent per entry." },
+          ...RULE_PARAM_SCHEMA,
+          note: { type: "string" },
+          force: { type: "boolean", description: "Accept a strategy whose backtest is negative." },
+        },
+        required: ["mint", "rule", "sizeUsd"],
+      },
+      execute: async (args, ctx) => {
+        const mint = String(args.mint ?? "");
+        try { new PublicKey(mint); } catch { return "Blocked: invalid mint."; }
+        if (mint === USDC_MINT) return "Blocked: the strategy buys a token with USDC; mint cannot be USDC.";
+        const rule = String(args.rule ?? "") as Rule;
+        if (!RULES.includes(rule)) return `Blocked: rule must be one of ${RULES.join(", ")}.`;
+        const sizeUsd = Number(args.sizeUsd);
+        if (!(sizeUsd >= 1)) return "Blocked: sizeUsd must be at least 1 USDC.";
+        const db = ctx.db.raw;
+        if (listStrategies(db).filter((s) => s.active).length >= MAX_ACTIVE_STRATEGIES) return `Blocked: ${MAX_ACTIVE_STRATEGIES} strategies already active; stop one first.`;
+        const timeframe = ["15m", "1h", "4h", "1d"].includes(String(args.timeframe)) ? String(args.timeframe) : "1h";
+        const params: RuleParams = {
+          fast: args.fast as number | undefined, slow: args.slow as number | undefined, rsiLevel: args.rsiLevel as number | undefined,
+          lookback: args.lookback as number | undefined, stopAtr: args.stopAtr as number | undefined, rr: args.rr as number | undefined,
+          maxBars: args.maxBars as number | undefined,
+        };
+        const market = await fetchCandles(mint, timeframe).catch(() => null);
+        if (!market || market.candles.length < 60) return "Blocked: not enough market history for this token.";
+        const bt = backtest(rule, market.candles, params);
+        const summary = `backtest: ${bt.trades.length} trades, win rate ${bt.winRate === null ? "?" : (bt.winRate * 100).toFixed(0)}%, total ${bt.totalReturnPct.toFixed(2)}%, max drawdown -${bt.maxDrawdownPct.toFixed(2)}%`;
+        if (bt.totalReturnPct <= 0 && args.force !== true) return `Refused: ${summary}. This rule lost money on recent history. Change it, or pass force=true if you have a reason.`;
+        const now = new Date();
+        const strategy: Strategy = {
+          id: `stg${now.getTime().toString(36)}${randomUUID().slice(0, 3)}`,
+          mint, symbol: market.symbol, timeframe, rule, params, sizeUsd, active: true, state: "flat", group: null,
+          lastSignalTs: market.candles.length > 1 ? market.candles[market.candles.length - 2].t : null,
+          trades: 0, note: String(args.note ?? "").slice(0, 200), lastError: null, createdAt: now.toISOString(), updatedAt: now.toISOString(),
+        };
+        saveStrategy(db, strategy);
+        return `Strategy ${strategy.id} active: ${market.symbol} ${rule} ${timeframe}, $${sizeUsd} per entry (${summary}). It acts on the next new signal.`;
+      },
+    },
+    {
+      name: "strategy_list",
+      description: "List your automatic strategies: rule, state (flat/long), trades, last error.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: {} },
+      execute: async (_args, ctx) => {
+        const all = listStrategies(ctx.db.raw);
+        if (!all.length) return "No strategy.";
+        return all.map((s) => `${s.id} ${s.active ? "ACTIVE" : "stopped"} ${s.symbol} ${s.rule} ${s.timeframe} $${s.sizeUsd} | ${s.state}${s.group ? ` (${s.group})` : ""} | trades ${s.trades}${s.lastError ? ` | last error: ${s.lastError}` : ""}`).join("\n");
+      },
+    },
+    {
+      name: "strategy_stop",
+      description: "Stop a strategy (no new entries). An open position keeps its stop-loss/take-profit.",
+      category: "financial",
+      riskLevel: "caution",
+      parameters: { type: "object", properties: { id: { type: "string" } }, required: ["id"] },
+      execute: async (args, ctx) => {
+        const s = listStrategies(ctx.db.raw).find((x) => x.id === String(args.id ?? ""));
+        if (!s) return "Unknown strategy.";
+        saveStrategy(ctx.db.raw, { ...s, active: false, updatedAt: new Date().toISOString() });
+        return `Strategy ${s.id} stopped.${s.state === "long" ? " Its open position keeps its OCO orders." : ""}`;
+      },
+    },
+  ];
+}
