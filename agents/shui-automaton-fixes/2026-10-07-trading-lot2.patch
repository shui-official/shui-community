index 0000000..9f3dada
--- /dev/null
+++ b/src/solana/backtest.ts
@@ -0,0 +1,226 @@
+/**
+ * Backtest: test a simple long-only rule on past candles before risking
+ * money. Signals are computed on closed candles only (no look-ahead). Each
+ * trade gets a stop at entry - stopAtr x ATR and a target at rr x the risk;
+ * if both are touched in the same candle the stop counts (pessimistic).
+ * Fees and slippage: feePct per side. Shared with the strategy runner.
+ */
+import type { AutomatonTool } from "../types.js";
+import { emaSeries, fetchCandles, type Candle, type Fetcher, defaultFetcher } from "./technical-analysis.js";
+
+export type Rule = "ema_cross" | "rsi_rebound" | "breakout";
+export const RULES: Rule[] = ["ema_cross", "rsi_rebound", "breakout"];
+
+export interface RuleParams {
+  fast?: number;
+  slow?: number;
+  rsiLevel?: number;
+  lookback?: number;
+  stopAtr?: number;
+  rr?: number;
+  maxBars?: number;
+  feePct?: number;
+}
+
+const defaults = (p: RuleParams) => ({
+  fast: p.fast ?? 9,
+  slow: p.slow ?? 21,
+  rsiLevel: p.rsiLevel ?? 30,
+  lookback: p.lookback ?? 20,
+  stopAtr: p.stopAtr ?? 1.5,
+  rr: p.rr ?? 2,
+  maxBars: p.maxBars ?? 48,
+  feePct: p.feePct ?? 0.25,
+});
+
+export function rsiSeries(closes: number[], n = 14): Array<number | null> {
+  const out: Array<number | null> = closes.map(() => null);
+  if (closes.length <= n) return out;
+  let gain = 0;
+  let loss = 0;
+  for (let i = 1; i <= n; i++) {
+    const d = closes[i] - closes[i - 1];
+    if (d >= 0) gain += d; else loss -= d;
+  }
+  gain /= n;
+  loss /= n;
+  out[n] = loss === 0 ? 100 : 100 - 100 / (1 + gain / loss);
+  for (let i = n + 1; i < closes.length; i++) {
+    const d = closes[i] - closes[i - 1];
+    gain = (gain * (n - 1) + Math.max(d, 0)) / n;
+    loss = (loss * (n - 1) + Math.max(-d, 0)) / n;
+    out[i] = loss === 0 ? 100 : 100 - 100 / (1 + gain / loss);
+  }
+  return out;
+}
+
+export function atrSeries(candles: Candle[], n = 14): Array<number | null> {
+  const out: Array<number | null> = candles.map(() => null);
+  if (candles.length <= n) return out;
+  const tr = candles.map((c, i) => (i === 0 ? c.h - c.l : Math.max(c.h - c.l, Math.abs(c.h - candles[i - 1].c), Math.abs(c.l - candles[i - 1].c))));
+  let value = tr.slice(1, n + 1).reduce((s, x) => s + x, 0) / n;
+  out[n] = value;
+  for (let i = n + 1; i < candles.length; i++) {
+    value = (value * (n - 1) + tr[i]) / n;
+    out[i] = value;
+  }
+  return out;
+}
+
+/** Entry signals (true at index i = enter at the close of candle i). */
+export function entrySignals(rule: Rule, candles: Candle[], params: RuleParams = {}): boolean[] {
+  const p = defaults(params);
+  const closes = candles.map((c) => c.c);
+  const signals = candles.map(() => false);
+  if (rule === "ema_cross") {
+    const f = emaSeries(closes, p.fast);
+    const s = emaSeries(closes, p.slow);
+    for (let i = Math.max(p.slow, 1); i < candles.length; i++) signals[i] = f[i - 1] <= s[i - 1] && f[i] > s[i];
+  } else if (rule === "rsi_rebound") {
+    const r = rsiSeries(closes);
+    for (let i = 1; i < candles.length; i++) {
+      const a = r[i - 1];
+      const b = r[i];
+      signals[i] = a !== null && b !== null && a < p.rsiLevel && b >= p.rsiLevel;
+    }
+  } else if (rule === "breakout") {
+    const vols = candles.map((c) => c.v);
+    for (let i = p.lookback; i < candles.length; i++) {
+      const prevHigh = Math.max(...candles.slice(i - p.lookback, i).map((c) => c.h));
+      const avgVol = vols.slice(i - p.lookback, i).reduce((s, x) => s + x, 0) / p.lookback;
+      signals[i] = candles[i].c > prevHigh && (avgVol === 0 || candles[i].v >= avgVol);
+    }
+  }
+  return signals;
+}
+
+export interface BacktestTrade {
+  entryIndex: number;
+  exitIndex: number;
+  entry: number;
+  exit: number;
+  outcome: "target" | "stop" | "time";
+  returnPct: number;
+}
+
+export interface BacktestResult {
+  trades: BacktestTrade[];
+  winRate: number | null;
+  avgReturnPct: number | null;
+  totalReturnPct: number;
+  maxDrawdownPct: number;
+  buyHoldPct: number;
+  candles: number;
+}
+
+export function backtest(rule: Rule, candles: Candle[], params: RuleParams = {}): BacktestResult {
+  const p = defaults(params);
+  const signals = entrySignals(rule, candles, params);
+  const atr = atrSeries(candles);
+  const trades: BacktestTrade[] = [];
+  let i = 0;
+  while (i < candles.length - 1) {
+    const a = atr[i];
+    if (!signals[i] || a === null) {
+      i += 1;
+      continue;
+    }
+    const entry = candles[i].c;
+    const stop = entry - p.stopAtr * a;
+    const target = entry + p.rr * (entry - stop);
+    let exitIndex = Math.min(candles.length - 1, i + p.maxBars);
+    let exit = candles[exitIndex].c;
+    let outcome: BacktestTrade["outcome"] = "time";
+    for (let j = i + 1; j <= Math.min(candles.length - 1, i + p.maxBars); j++) {
+      if (candles[j].l <= stop) { exitIndex = j; exit = stop; outcome = "stop"; break; }
+      if (candles[j].h >= target) { exitIndex = j; exit = target; outcome = "target"; break; }
+    }
+    const returnPct = ((exit / entry) - 1) * 100 - 2 * p.feePct;
+    trades.push({ entryIndex: i, exitIndex, entry, exit, outcome, returnPct });
+    i = exitIndex + 1;
+  }
+  let equity = 1;
+  let peak = 1;
+  let maxDd = 0;
+  for (const t of trades) {
+    equity *= 1 + t.returnPct / 100;
+    peak = Math.max(peak, equity);
+    maxDd = Math.max(maxDd, (1 - equity / peak) * 100);
+  }
+  const wins = trades.filter((t) => t.returnPct > 0).length;
+  return {
+    trades,
+    winRate: trades.length ? wins / trades.length : null,
+    avgReturnPct: trades.length ? trades.reduce((s, t) => s + t.returnPct, 0) / trades.length : null,
+    totalReturnPct: (equity - 1) * 100,
+    maxDrawdownPct: maxDd,
+    buyHoldPct: candles.length > 1 ? ((candles[candles.length - 1].c / candles[0].c) - 1) * 100 : 0,
+    candles: candles.length,
+  };
+}
+
+export function formatBacktest(symbol: string, timeframe: string, rule: Rule, r: BacktestResult, params: RuleParams): string {
+  const p = defaults(params);
+  const pct = (x: number | null) => (x === null ? "?" : `${x >= 0 ? "+" : ""}${x.toFixed(2)}%`);
+  const verdict = r.trades.length < 5
+    ? "TOO FEW TRADES to conclude: try another timeframe or rule."
+    : r.totalReturnPct > 0 && r.totalReturnPct > r.buyHoldPct && (r.avgReturnPct ?? 0) > 0
+      ? "PROMISING: positive and better than holding. Still small sample: size small."
+      : r.totalReturnPct > 0
+        ? "POSITIVE but no better than simply holding."
+        : "LOSING on this history: do not use it as is.";
+  return `Backtest ${symbol} ${timeframe} rule=${rule} (stop ${p.stopAtr} ATR, target ${p.rr}R, max ${p.maxBars} candles, fees ${p.feePct}%/side) over ${r.candles} candles:\n` +
+    `trades ${r.trades.length} | win rate ${r.winRate === null ? "?" : `${(r.winRate * 100).toFixed(0)}%`} | avg/trade ${pct(r.avgReturnPct)} | ` +
+    `total ${pct(r.totalReturnPct)} | max drawdown -${r.maxDrawdownPct.toFixed(2)}% | buy & hold ${pct(r.buyHoldPct)}\n` +
+    `exits: ${r.trades.filter((t) => t.outcome === "target").length} target, ${r.trades.filter((t) => t.outcome === "stop").length} stop, ${r.trades.filter((t) => t.outcome === "time").length} time\n` +
+    `Verdict: ${verdict} Past results do not guarantee future ones.`;
+}
+
+export async function runBacktest(
+  args: { mint?: string; timeframe?: string; rule?: string } & RuleParams,
+  fetcher: Fetcher = defaultFetcher,
+): Promise<string> {
+  const mint = String(args.mint ?? "").trim();
+  const rule = String(args.rule ?? "ema_cross") as Rule;
+  if (!mint) return "Blocked: mint is required.";
+  if (!RULES.includes(rule)) return `Blocked: rule must be one of ${RULES.join(", ")}.`;
+  const market = await fetchCandles(mint, String(args.timeframe ?? "1h"), fetcher);
+  if (!market || market.candles.length < 60) return `Not enough history for ${mint}.`;
+  const params: RuleParams = {
+    fast: args.fast, slow: args.slow, rsiLevel: args.rsiLevel, lookback: args.lookback,
+    stopAtr: args.stopAtr, rr: args.rr, maxBars: args.maxBars, feePct: args.feePct,
+  };
+  return formatBacktest(market.symbol, market.timeframe, rule, backtest(rule, market.candles, params), params);
+}
+
+export const RULE_PARAM_SCHEMA = {
+  rule: { type: "string", description: '"ema_cross" (fast EMA crosses above slow), "rsi_rebound" (RSI crosses back above rsiLevel), "breakout" (close above the lookback high with volume).' },
+  timeframe: { type: "string", description: '"15m", "1h" (default), "4h" or "1d".' },
+  fast: { type: "number", description: "ema_cross fast EMA (default 9)." },
+  slow: { type: "number", description: "ema_cross slow EMA (default 21)." },
+  rsiLevel: { type: "number", description: "rsi_rebound level (default 30)." },
+  lookback: { type: "number", description: "breakout lookback candles (default 20)." },
+  stopAtr: { type: "number", description: "Stop distance in ATR (default 1.5)." },
+  rr: { type: "number", description: "Target in multiples of the risk (default 2)." },
+  maxBars: { type: "number", description: "Max candles in a trade before exiting at the close (default 48)." },
+};
+
+export function createBacktestTool(): AutomatonTool {
+  return {
+    name: "backtest",
+    description:
+      "Test a trading rule on the last ~300 real candles of a token before risking money: number of trades, win rate, " +
+      "average and total return after fees, max drawdown, comparison with simply holding, and a verdict. Use it before " +
+      "strategy_create or before trading a new pattern.",
+    category: "financial",
+    riskLevel: "safe",
+    parameters: { type: "object", properties: { mint: { type: "string" }, ...RULE_PARAM_SCHEMA }, required: ["mint"] },
+    execute: async (args) => {
+      try {
+        return await runBacktest(args as Parameters<typeof runBacktest>[0]);
+      } catch (error) {
+        return `backtest failed: ${error instanceof Error ? error.message : String(error)}`;
+      }
+    },
+  };
+}
