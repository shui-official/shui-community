+import { describe, expect, it } from "vitest";
+import fs from "fs";
+import path from "path";
+import { getCoreIdentity, getCoreRules } from "../agent/system-prompt.js";
+
+describe("core prompt text (SHUI runtime reality)", () => {
+  const rules = getCoreRules("solana");
+  const identity = getCoreIdentity("solana");
+  const source = fs.readFileSync(path.join(__dirname, "../agent/system-prompt.ts"), "utf8");
+
+  it("ties survival to the genesis lifespan rule, not to compute credits", () => {
+    expect(rules).toContain("Create value or your life runs out");
+    expect(rules).toContain("revenue received plus realized trading profit");
+    expect(identity).toContain("monitor your verified wallet state and your remaining lifespan");
+    expect(rules + identity).not.toMatch(/Pay for compute or die|Conway sandbox|compute credits/);
+  });
+
+  it("tells SHUI that trading is only one of its options", () => {
+    expect(rules).toContain("Trading is only one of your options");
+    expect(rules).toContain("change the type of activity");
+  });
+
+  it("keeps every self-preservation rule", () => {
+    for (const rule of [
+      "MUST NOT destroy yourself",
+      "MUST NOT delete your wallet, private key, or identity files",
+      "MUST NOT delete your own workspace or runtime",
+      "MUST NOT execute commands that would make you unable to recover",
+      "CAN modify your own code",
+    ]) {
+      expect(identity).toContain(rule);
+    }
+  });
+
+  it("no longer states false runtime facts", () => {
+    expect(source).not.toMatch(/git-versioned\. Every change is a commit|publishes your status to Conway|unlimited persistent storage|checks for new upstream\s+commits every 4 hours/);
+  });
+});
