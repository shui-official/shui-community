@@ -0,0 +1,22 @@
+import { describe, expect, it } from "vitest";
+import { failedTurnBackoffMs } from "../agent/loop.js";
+import { localTurnTimeoutMs } from "../inference/types.js";
+
+describe("failed turn backoff", () => {
+  it("waits for the circuit breaker instead of spinning", () => {
+    const now = Date.parse("2026-10-07T08:39:03.000Z");
+    const err = new Error("Circuit breaker is open until 2026-10-07T08:40:02.691Z");
+    expect(failedTurnBackoffMs(err, 4, now)).toBeCloseTo(60_691, -2);
+    expect(failedTurnBackoffMs(new Error("Circuit breaker is open until 2026-10-07T09:40:00.000Z"), 1, now)).toBe(300_000);
+  });
+  it("backs off exponentially on other errors", () => {
+    expect(failedTurnBackoffMs(new Error("boom"), 1)).toBe(5_000);
+    expect(failedTurnBackoffMs(new Error("boom"), 3)).toBe(20_000);
+    expect(failedTurnBackoffMs(new Error("boom"), 9)).toBe(60_000);
+  });
+  it("gives the local model 6 minutes by default, configurable", () => {
+    expect(localTurnTimeoutMs({})).toBe(360_000);
+    expect(localTurnTimeoutMs({ SHUI_OLLAMA_TIMEOUT_MS: "600000" })).toBe(600_000);
+    expect(localTurnTimeoutMs({ SHUI_OLLAMA_TIMEOUT_MS: "5" })).toBe(360_000);
+  });
+});
