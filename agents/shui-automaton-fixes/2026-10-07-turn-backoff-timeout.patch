 // === Per-Task Timeout Overrides (ms) ===
 
+/**
+ * A local model (Ollama on RunPod) must read the whole prompt (~25k tokens)
+ * before answering; after a restart or a prompt change nothing is cached and
+ * this can exceed 3 minutes. A timeout aborts the request, so the next try
+ * starts from zero again. Default 6 min, override with SHUI_OLLAMA_TIMEOUT_MS.
+ */
+export function localTurnTimeoutMs(env: NodeJS.ProcessEnv = process.env): number {
+  const value = Number(env.SHUI_OLLAMA_TIMEOUT_MS);
+  return Number.isFinite(value) && value >= 60_000 ? value : 360_000;
+}
