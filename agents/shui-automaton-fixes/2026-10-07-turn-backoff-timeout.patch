+/** Pause after a failed turn: until the circuit breaker closes, else 5 s, 10 s, 20 s… (max 60 s). */
+export function failedTurnBackoffMs(err: unknown, consecutiveErrors: number, now = Date.now()): number {
+  const match = /Circuit breaker is open until (\S+)/.exec(String((err as { message?: string })?.message ?? ""));
+  const reset = match ? Date.parse(match[1]) : NaN;
+  if (Number.isFinite(reset)) return Math.min(5 * 60_000, Math.max(1_000, reset - now + 1_000));
+  return Math.min(60_000, 5_000 * 2 ** Math.max(0, consecutiveErrors - 1));
+}
