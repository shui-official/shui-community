diff --git a/src/agent/web-fetch.ts b/src/agent/web-fetch.ts
new file mode 100644
index 0000000..320fc9d
--- /dev/null
+++ b/src/agent/web-fetch.ts
@@ -0,0 +1,56 @@
+// Read-only HTTP GET shared by SHUI and its workers.
+
+const WEB_FETCH_TIMEOUT_MS = 20_000;
+const WEB_FETCH_MAX_CHARS = 12_000;
+
+/**
+ * Plain read-only GET for workers. web_fetch used to be an alias of
+ * x402_fetch (a payment tool whose allowlist only contains conway.tech), so
+ * workers could not read any market API and wrote services on invented data.
+ * Local and private network addresses stay blocked.
+ */
+export async function readOnlyWebFetch(rawUrl: string): Promise<string> {
+  let url: URL;
+  try {
+    url = new URL(rawUrl.trim());
+  } catch {
+    return `Error: invalid URL "${rawUrl}"`;
+  }
+  if (url.protocol !== "https:" && url.protocol !== "http:") {
+    return `Error: only http(s) URLs are allowed`;
+  }
+  if (isPrivateHost(url.hostname)) {
+    return `Error: local or private network addresses are not allowed (${url.hostname})`;
+  }
+  try {
+    const response = await fetch(url, {
+      method: "GET",
+      redirect: "follow",
+      signal: AbortSignal.timeout(WEB_FETCH_TIMEOUT_MS),
+      headers: { "User-Agent": "shui-worker/1.0", Accept: "application/json, text/*;q=0.9, */*;q=0.5" },
+    });
+    const body = await response.text();
+    const truncated = body.length > WEB_FETCH_MAX_CHARS
+      ? `${body.slice(0, WEB_FETCH_MAX_CHARS)}\n[truncated: ${body.length} chars total]`
+      : body;
+    return `HTTP ${response.status} ${response.statusText}\n${truncated}`;
+  } catch (error) {
+    return `Error: fetch failed: ${error instanceof Error ? error.message : String(error)}`;
+  }
+}
+
+function isPrivateHost(hostname: string): boolean {
+  const host = hostname.toLowerCase().replace(/^\[|\]$/g, "");
+  if (host === "localhost" || host.endsWith(".localhost") || host.endsWith(".local") || host.endsWith(".internal")) {
+    return true;
+  }
+  if (host === "::1" || host === "::" || host.startsWith("fc") || host.startsWith("fd") || host.startsWith("fe80")) {
+    return host.includes(":");
+  }
+  const m = /^(\d+)\.(\d+)\.(\d+)\.(\d+)$/.exec(host);
+  if (!m) return false;
+  const [a, b] = [Number(m[1]), Number(m[2])];
+  return a === 0 || a === 10 || a === 127 || (a === 169 && b === 254)
+    || (a === 172 && b >= 16 && b <= 31) || (a === 192 && b === 168) || (a === 100 && b >= 64 && b <= 127);
+}
+
diff --git a/src/services/service-tools.ts b/src/services/service-tools.ts
new file mode 100644
index 0000000..36fbbc2
--- /dev/null
+++ b/src/services/service-tools.ts
@@ -0,0 +1,133 @@
+import { execFile } from "node:child_process";
+import { promises as fs, constants as fsConstants } from "node:fs";
+import path from "node:path";
+import type { AutomatonTool } from "../types.js";
+
+/**
+ * Public services for SHUI. The creator installs, once and as root, a helper
+ * (/usr/local/sbin/shui-service) that SHUI may run through sudo and nothing
+ * else. The helper runs each service as the unprivileged user `shui-svc` in a
+ * systemd sandbox without access to /home (the wallet key stays out of reach
+ * even if a service is compromised) and publishes it over HTTPS with Caddy.
+ */
+export const SERVICES_ROOT = "/srv/shui/services";
+export const SERVICE_HELPER = "/usr/local/sbin/shui-service";
+export const SERVICE_PORT_MIN = 8100;
+export const SERVICE_PORT_MAX = 8199;
+const NAME_PATTERN = /^[a-z][a-z0-9-]{1,30}$/;
+const HELPER_TIMEOUT_MS = 90_000;
+
+export function isValidServiceName(name: string): boolean {
+  return NAME_PATTERN.test(name);
+}
+
+export function isValidServicePort(port: number): boolean {
+  return Number.isInteger(port) && port >= SERVICE_PORT_MIN && port <= SERVICE_PORT_MAX;
+}
+
+export type HelperRunner = (args: string[]) => Promise<{ ok: boolean; output: string }>;
+
+export const runServiceHelper: HelperRunner = (args) =>
+  new Promise((resolve) => {
+    execFile("sudo", ["-n", SERVICE_HELPER, ...args], { timeout: HELPER_TIMEOUT_MS, maxBuffer: 512 * 1024 }, (error, stdout, stderr) => {
+      const output = `${stdout ?? ""}${stderr ? `\n${stderr}` : ""}`.trim();
+      if (error && /a password is required|no tty present|not allowed|command not found|No such file/i.test(output + error.message)) {
+        resolve({
+          ok: false,
+          output: "Service hosting is not installed on this server yet (the creator must run setup-services.sh once). " + output,
+        });
+        return;
+      }
+      resolve({ ok: !error, output: output || (error ? error.message : "ok") });
+    });
+  });
+
+async function checkRunScript(name: string): Promise<string | null> {
+  const runScript = path.join(SERVICES_ROOT, name, "run.sh");
+  try {
+    await fs.access(runScript, fsConstants.X_OK);
+    return null;
+  } catch {
+    return `Missing ${runScript} (or not executable). Put the service in ${path.join(SERVICES_ROOT, name)}/ ` +
+      `with an executable run.sh (chmod 755) that starts it in the foreground and listens on 127.0.0.1:$PORT ` +
+      `(for Python: create .venv there and use .venv/bin/python). Then call service_deploy again.`;
+  }
+}
+
+export function createServiceTools(runner: HelperRunner = runServiceHelper): AutomatonTool[] {
+  const nameParam = { type: "string", description: "Service name: lowercase letters, digits, dashes (2-31 chars)." };
+  return [
+    {
+      name: "service_deploy",
+      description:
+        `Publish a service on the internet over HTTPS so that people can use it (and pay for it). ` +
+        `Put the code in ${SERVICES_ROOT}/<name>/ with an executable run.sh that starts it in the foreground on ` +
+        `127.0.0.1:$PORT. It runs as a sandboxed user with no access to /home, restarts on failure and survives ` +
+        `reboots. Returns the public URL. Port must be ${SERVICE_PORT_MIN}-${SERVICE_PORT_MAX}. Redeploy to restart it.`,
+      category: "vm",
+      riskLevel: "caution",
+      parameters: {
+        type: "object",
+        properties: {
+          name: nameParam,
+          port: { type: "number", description: `Local port ${SERVICE_PORT_MIN}-${SERVICE_PORT_MAX}, passed to run.sh as $PORT.` },
+        },
+        required: ["name", "port"],
+      },
+      execute: async (args) => {
+        const name = String(args.name ?? "");
+        const port = Number(args.port);
+        if (!isValidServiceName(name)) return "Blocked: invalid service name.";
+        if (!isValidServicePort(port)) return `Blocked: port must be an integer between ${SERVICE_PORT_MIN} and ${SERVICE_PORT_MAX}.`;
+        const missing = await checkRunScript(name);
+        if (missing) return missing;
+        const result = await runner(["deploy", name, String(port)]);
+        return result.ok ? result.output : `Deploy failed: ${result.output}`;
+      },
+    },
+    {
+      name: "service_stop",
+      description: "Stop a published service and remove its public URL. Its files are kept.",
+      category: "vm",
+      riskLevel: "caution",
+      parameters: { type: "object", properties: { name: nameParam }, required: ["name"] },
+      execute: async (args) => {
+        const name = String(args.name ?? "");
+        if (!isValidServiceName(name)) return "Blocked: invalid service name.";
+        const result = await runner(["stop", name]);
+        return result.ok ? result.output : `Stop failed: ${result.output}`;
+      },
+    },
+    {
+      name: "service_status",
+      description: "List published services with their state, port and public URL (or one service if name is given).",
+      category: "vm",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: { name: nameParam } },
+      execute: async (args) => {
+        const name = args.name === undefined ? "" : String(args.name);
+        if (name && !isValidServiceName(name)) return "Blocked: invalid service name.";
+        const result = await runner(name ? ["status", name] : ["list"]);
+        return result.output;
+      },
+    },
+    {
+      name: "service_logs",
+      description: "Read the last log lines of a published service (to debug it).",
+      category: "vm",
+      riskLevel: "safe",
+      parameters: {
+        type: "object",
+        properties: { name: nameParam, lines: { type: "number", description: "Number of lines (max 200)." } },
+        required: ["name"],
+      },
+      execute: async (args) => {
+        const name = String(args.name ?? "");
+        if (!isValidServiceName(name)) return "Blocked: invalid service name.";
+        const lines = Math.min(200, Math.max(1, Math.floor(Number(args.lines ?? 80)) || 80));
+        const result = await runner(["logs", name, String(lines)]);
+        return result.output;
+      },
+    },
+  ];
+}
