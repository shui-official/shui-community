@@ -0,0 +1,156 @@
+import { Connection, Keypair, PublicKey } from "@solana/web3.js";
+import type { AutomatonDatabase, AutomatonTool, ToolContext } from "../types.js";
+import { DEFAULT_SOLANA_RPC } from "./trading.js";
+
+/**
+ * Solana Pay payment requests in USDC to SHUI's central wallet. A customer
+ * pays from any Solana wallet; incoming USDC is already counted as revenue by
+ * the ledger scan, these tools only create the link and confirm a payment.
+ */
+export const PAYMENT_USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+const USDC_DECIMALS = 6;
+const KV_PREFIX = "payment.request.";
+
+export interface PaymentRequest {
+  reference: string;
+  recipient: string;
+  amountUsdc: number;
+  label: string;
+  message: string;
+  createdAt: string;
+  status: "pending" | "paid";
+  signature?: string;
+  receivedUsdc?: number;
+}
+
+function walletAddress(ctx: ToolContext): string {
+  return ctx.identity.chainIdentity?.address ?? ctx.identity.address;
+}
+
+export function buildSolanaPayUrl(request: Pick<PaymentRequest, "recipient" | "amountUsdc" | "reference" | "label" | "message">): string {
+  const params = new URLSearchParams({
+    amount: request.amountUsdc.toFixed(USDC_DECIMALS).replace(/\.?0+$/, ""),
+    "spl-token": PAYMENT_USDC_MINT,
+    reference: request.reference,
+  });
+  if (request.label) params.set("label", request.label);
+  if (request.message) params.set("message", request.message);
+  return `solana:${request.recipient}?${params.toString()}`;
+}
+
+function save(db: AutomatonDatabase, request: PaymentRequest): void {
+  db.setKV(KV_PREFIX + request.reference, JSON.stringify(request));
+}
+
+function load(db: AutomatonDatabase, reference: string): PaymentRequest | null {
+  const raw = db.getKV(KV_PREFIX + reference);
+  if (!raw) return null;
+  try {
+    return JSON.parse(raw) as PaymentRequest;
+  } catch {
+    return null;
+  }
+}
+
+type ParsedTx = {
+  meta?: {
+    err?: unknown;
+    preTokenBalances?: Array<{ mint: string; owner?: string; uiTokenAmount: { amount: string } }>;
+    postTokenBalances?: Array<{ mint: string; owner?: string; uiTokenAmount: { amount: string } }>;
+  } | null;
+} | null;
+
+/** USDC received by `owner` in a parsed transaction (post - pre), in USDC. */
+export function usdcReceived(tx: ParsedTx, owner: string): number {
+  if (!tx?.meta || tx.meta.err) return 0;
+  const sum = (list?: Array<{ mint: string; owner?: string; uiTokenAmount: { amount: string } }>) =>
+    (list ?? [])
+      .filter((b) => b.mint === PAYMENT_USDC_MINT && b.owner === owner)
+      .reduce((total, b) => total + BigInt(b.uiTokenAmount.amount), 0n);
+  const delta = sum(tx.meta.postTokenBalances) - sum(tx.meta.preTokenBalances);
+  return delta > 0n ? Number(delta) / 10 ** USDC_DECIMALS : 0;
+}
+
+export interface PaymentChain {
+  findSignatures(reference: string): Promise<string[]>;
+  getParsed(signature: string): Promise<ParsedTx>;
+}
+
+function rpcChain(): PaymentChain {
+  const connection = new Connection(DEFAULT_SOLANA_RPC, "confirmed");
+  return {
+    findSignatures: async (reference) =>
+      (await connection.getSignaturesForAddress(new PublicKey(reference), { limit: 10 }, "confirmed"))
+        .filter((s) => !s.err)
+        .map((s) => s.signature),
+    getParsed: async (signature) =>
+      (await connection.getParsedTransaction(signature, { maxSupportedTransactionVersion: 0, commitment: "confirmed" })) as ParsedTx,
+  };
+}
+
+export function createPaymentTools(chain: () => PaymentChain = rpcChain): AutomatonTool[] {
+  return [
+    {
+      name: "payment_request",
+      description:
+        "Create a Solana Pay payment link asking a customer to pay an amount of USDC to your central wallet " +
+        "(works with Phantom, Solflare, etc.; show it as a link or QR code in your service). Returns the URL and a " +
+        "reference to check the payment with payment_check. Received USDC counts as revenue in your daily gain.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: {
+        type: "object",
+        properties: {
+          amountUsdc: { type: "number", description: "Amount to request in USDC, e.g. 2.5" },
+          label: { type: "string", description: "Short name shown to the payer (your service name)." },
+          message: { type: "string", description: "What the payment is for." },
+        },
+        required: ["amountUsdc"],
+      },
+      execute: async (args, ctx) => {
+        const amountUsdc = Number(args.amountUsdc);
+        if (!Number.isFinite(amountUsdc) || amountUsdc <= 0 || amountUsdc > 1_000_000) {
+          return "Blocked: amountUsdc must be a positive number.";
+        }
+        const request: PaymentRequest = {
+          reference: Keypair.generate().publicKey.toBase58(),
+          recipient: walletAddress(ctx),
+          amountUsdc: Math.round(amountUsdc * 10 ** USDC_DECIMALS) / 10 ** USDC_DECIMALS,
+          label: String(args.label ?? "SHUI").slice(0, 60),
+          message: String(args.message ?? "").slice(0, 140),
+          createdAt: new Date().toISOString(),
+          status: "pending",
+        };
+        save(ctx.db, request);
+        return JSON.stringify({ url: buildSolanaPayUrl(request), reference: request.reference, amountUsdc: request.amountUsdc });
+      },
+    },
+    {
+      name: "payment_check",
+      description: "Check whether a payment request created with payment_request has been paid on-chain.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: {
+        type: "object",
+        properties: { reference: { type: "string", description: "Reference returned by payment_request." } },
+        required: ["reference"],
+      },
+      execute: async (args, ctx) => {
+        const reference = String(args.reference ?? "");
+        const request = load(ctx.db, reference);
+        if (!request) return `Unknown payment reference "${reference}".`;
+        if (request.status === "paid") return JSON.stringify(request);
+        const rpc = chain();
+        for (const signature of await rpc.findSignatures(reference)) {
+          const received = usdcReceived(await rpc.getParsed(signature), request.recipient);
+          if (received + 1e-9 >= request.amountUsdc) {
+            const paid: PaymentRequest = { ...request, status: "paid", signature, receivedUsdc: received };
+            save(ctx.db, paid);
+            return JSON.stringify(paid);
+          }
+        }
+        return JSON.stringify({ ...request, status: "pending" });
+      },
+    },
+  ];
+}
