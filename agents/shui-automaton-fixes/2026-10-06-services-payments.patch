+import { describe, expect, it, vi } from "vitest";
+import { createServiceTools, isValidServiceName, isValidServicePort } from "../services/service-tools.js";
+import { buildSolanaPayUrl, createPaymentTools, PAYMENT_USDC_MINT, usdcReceived } from "../solana/payment-tools.js";
+
+const ctx = () => {
+  const kv = new Map<string, string>();
+  return {
+    identity: { address: "BqAnQqVdgz1CgDcfFprQ1CLfyEjbUUzVsS4szaZ49Rbo", chainIdentity: { address: "BqAnQqVdgz1CgDcfFprQ1CLfyEjbUUzVsS4szaZ49Rbo" } },
+    db: { getKV: (k: string) => kv.get(k), setKV: (k: string, v: string) => { kv.set(k, v); } },
+  } as any;
+};
+
+describe("service tools", () => {
+  it("validates names and ports before calling the root helper", async () => {
+    expect(isValidServiceName("arb-api")).toBe(true);
+    expect(isValidServiceName("x;rm -rf /")).toBe(false);
+    expect(isValidServicePort(8100)).toBe(true);
+    expect(isValidServicePort(22)).toBe(false);
+    const runner = vi.fn().mockResolvedValue({ ok: true, output: "url: https://a" });
+    const deploy = createServiceTools(runner).find((t) => t.name === "service_deploy")!;
+    expect(await deploy.execute({ name: "Bad Name", port: 8100 }, ctx())).toMatch(/^Blocked/);
+    expect(await deploy.execute({ name: "arb", port: 3333 }, ctx())).toMatch(/^Blocked/);
+    expect(runner).not.toHaveBeenCalled();
+  });
+
+  it("explains how to prepare run.sh when it is missing", async () => {
+    const runner = vi.fn();
+    const deploy = createServiceTools(runner).find((t) => t.name === "service_deploy")!;
+    const out = await deploy.execute({ name: "no-such-service-xyz", port: 8100 }, ctx());
+    expect(out).toContain("run.sh");
+    expect(out).toContain("127.0.0.1:$PORT");
+    expect(runner).not.toHaveBeenCalled();
+  });
+
+  it("lists services through the helper", async () => {
+    const runner = vi.fn().mockResolvedValue({ ok: true, output: "no published service" });
+    const status = createServiceTools(runner).find((t) => t.name === "service_status")!;
+    expect(await status.execute({}, ctx())).toBe("no published service");
+    expect(runner).toHaveBeenCalledWith(["list"]);
+  });
+});
+
+describe("payment tools (Solana Pay, USDC)", () => {
+  it("builds a Solana Pay URL to the central wallet", () => {
+    const url = buildSolanaPayUrl({ recipient: "WALLET", amountUsdc: 2.5, reference: "REF", label: "Arb API", message: "1 month" });
+    expect(url.startsWith("solana:WALLET?")).toBe(true);
+    expect(url).toContain("amount=2.5");
+    expect(url).toContain(`spl-token=${PAYMENT_USDC_MINT}`);
+    expect(url).toContain("reference=REF");
+  });
+
+  it("measures USDC received by the wallet in a transaction", () => {
+    const tx = { meta: { err: null,
+      preTokenBalances: [{ mint: PAYMENT_USDC_MINT, owner: "W", uiTokenAmount: { amount: "1000000" } }],
+      postTokenBalances: [{ mint: PAYMENT_USDC_MINT, owner: "W", uiTokenAmount: { amount: "3500000" } }] } };
+    expect(usdcReceived(tx, "W")).toBe(2.5);
+    expect(usdcReceived(tx, "OTHER")).toBe(0);
+    expect(usdcReceived({ meta: { ...tx.meta, err: { x: 1 } } }, "W")).toBe(0);
+  });
+
+  it("creates a request and confirms it once paid on-chain", async () => {
+    const c = ctx();
+    const chain = {
+      findSignatures: vi.fn().mockResolvedValue(["SIG"]),
+      getParsed: vi.fn().mockResolvedValue({ meta: { err: null,
+        preTokenBalances: [],
+        postTokenBalances: [{ mint: PAYMENT_USDC_MINT, owner: c.identity.address, uiTokenAmount: { amount: "2000000" } }] } }),
+    };
+    const [request, check] = createPaymentTools(() => chain);
+    const created = JSON.parse(await request.execute({ amountUsdc: 2, label: "Arb API" }, c));
+    expect(created.url).toContain(`solana:${c.identity.address}?`);
+    const paid = JSON.parse(await check.execute({ reference: created.reference }, c));
+    expect(paid.status).toBe("paid");
+    expect(paid.signature).toBe("SIG");
+    expect(await request.execute({ amountUsdc: -1 }, c)).toMatch(/^Blocked/);
+  });
+});
