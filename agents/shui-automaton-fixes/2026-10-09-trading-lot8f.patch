+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { createDatabase } from "../state/database.js";
+import { buyStatus, falseStopClaim } from "../solana/decisions.js";
+import { ensureLedgerSchema } from "../solana/ledger.js";
+import { createTradingDeskTools } from "../solana/trading-desk.js";
+import { listOrders, runOrderTick, saveOrder, type Order } from "../solana/orders.js";
+
+const USDC = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+const ORCA = "orcaEKTdK7LKz57vaAYr9QeNsVEPfiu6QeMU1kektZE";
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot8f-")), "s.db"));
+const setKv = (db: any, k: string, v: string) =>
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(k, v);
+const now = new Date("2026-10-09T05:30:00Z");
+const NIGHT_NOTE = "skip: After 2 losing trades today, I must stop trading today. New buys are blocked until 00:00 UTC.";
+
+function sale(db: any, sig: string, ts: string, pnl: number) {
+  db.prepare(
+    `INSERT INTO shui_ledger (signature, ts, day, kind, input_mint, input_amount_raw, output_mint, output_amount_raw, revenue_usd, realized_pnl_usd, incomplete, details)
+     VALUES (?, ?, ?, 'swap', ?, '1', ?, '1', 0, ?, 0, '{}')`,
+  ).run(sig, ts, ts.slice(0, 10), ORCA, USDC, pnl);
+}
+
+describe("the code's answer on buys", () => {
+  it("says buys are allowed when only paper or tiny losses happened, and refuses a false stop reason", () => {
+    const db = freshDb().raw;
+    ensureLedgerSchema(db);
+    setKv(db, "last_known_balance", JSON.stringify({ walletValueUsd: 56, walletValueComplete: true }));
+    sale(db, "met", "2026-10-09T00:39:05.000Z", -0.21); // 0.37% of capital: does not count
+    expect(buyStatus(db, now)).toMatchObject({ allowed: true });
+    expect(buyStatus(db, now).line).toMatch(/BUYS ALLOWED now .* 0\/2/);
+    expect(falseStopClaim(db, "note", NIGHT_NOTE, now)).toMatch(/^Blocked: this reason is false\. BUYS ALLOWED/);
+    expect(falseStopClaim(db, "note", "skip: stop inside normal 4h noise, R/R too low", now)).toBeNull();
+    expect(falseStopClaim(db, "lesson", "After 2 losing trades I stopped, which was right", now)).toBeNull();
+  });
+
+  it("accepts the reason when the code really blocks buys", () => {
+    const db = freshDb().raw;
+    ensureLedgerSchema(db);
+    setKv(db, "last_known_balance", JSON.stringify({ walletValueUsd: 56, walletValueComplete: true }));
+    sale(db, "a", "2026-10-09T01:00:00.000Z", -0.92);
+    sale(db, "b", "2026-10-09T02:00:00.000Z", -0.8);
+    expect(buyStatus(db, now)).toMatchObject({ allowed: false });
+    expect(buyStatus(db, now).line).toMatch(/BUYS BLOCKED until 2026-10-10T00:00/);
+    expect(falseStopClaim(db, "note", NIGHT_NOTE, now)).toBeNull();
+  });
+
+  it("journal_add rejects the false note and trade_stats starts with the truth", async () => {
+    const db = freshDb();
+    ensureLedgerSchema(db.raw);
+    const tools = createTradingDeskTools();
+    const ctx = { db } as any;
+    const journal = tools.find((t) => t.name === "journal_add")!;
+    expect(await journal.execute({ kind: "note", mint: ORCA, text: NIGHT_NOTE }, ctx)).toMatch(/^Blocked: this reason is false/);
+    expect(await journal.execute({ kind: "note", mint: ORCA, text: "skip: RSI overbought" }, ctx)).toBe("Journal note saved.");
+    const stats = await tools.find((t) => t.name === "trade_stats")!.execute({}, ctx);
+    expect(stats.split("\n")[0]).toMatch(/^BUYS ALLOWED now/);
+  });
+});
+
+describe("orphan orders", () => {
+  it("cancels the linked take-profit when the stop finds nothing left to sell", async () => {
+    const db = freshDb();
+    const base: Order = {
+      id: "", group: "oco_x", kind: "stop_loss", condition: "below", triggerPriceUsd: 2.43, inputMint: ORCA, outputMint: USDC,
+      amount: "0", watchMint: ORCA, slippageBps: 100, venue: "jupiter", note: "test", createdAt: now.toISOString(), expiresAt: null,
+      status: "open", attempts: 0, updatedAt: now.toISOString(),
+    } as Order;
+    saveOrder(db.raw, { ...base, id: "oco_x_stop" });
+    saveOrder(db.raw, { ...base, id: "oco_x_tp", kind: "take_profit", condition: "above", triggerPriceUsd: 3.08 });
+    const swap = vi.fn();
+    await runOrderTick({ db, chainIdentity: {} as any, prices: async () => ({ [ORCA]: 2.32 }), swap, now: () => now });
+    expect(swap).not.toHaveBeenCalled();
+    const status = Object.fromEntries(listOrders(db.raw).map((o) => [o.id, o.status]));
+    expect(status).toEqual({ oco_x_stop: "failed", oco_x_tp: "cancelled" });
+  });
+});
