 import type { Database } from "better-sqlite3";
 import { isMemecoin, tradeLimits } from "./trade-limits.js";
 import { listOrders } from "./orders.js";
+import { lossStopUntil, lossStreakToday, MAX_LOSS_STREAK, MEANINGFUL_LOSS_PCT, tradingPausedUntil } from "../survival/risk-guard.js";
 import { isCreatorToken } from "./token-policy.js";
 
 const PENDING_KEY = "decision.pending";
@@ -148,3 +149,32 @@ export function sleepGuard(db: Database, requestedS: number, trading: boolean, n
     ? { durationS: max, note: ` (capped from ${requested}s: in trading focus you sleep at most ${max / 3600} h)` }
     : { durationS: requested, note: "" };
 }
+
+/**
+ * Lot 8f: SHUI kept writing "after 2 losing trades I must stop" all night
+ * while the code allowed buys (paper losses and tiny losses never count).
+ * This is the code's own answer, shown with every decision.
+ */
+export function buyStatus(db: Database, now: Date = new Date()): { allowed: boolean; line: string } {
+  const paused = tradingPausedUntil(db, now);
+  if (paused) return { allowed: false, line: `BUYS BLOCKED by the drawdown pause until ${paused} (sales and stops still work).` };
+  const stop = lossStopUntil(db, now);
+  if (stop) return { allowed: false, line: `BUYS BLOCKED until ${stop}: ${MAX_LOSS_STREAK} real losing trades today (sales and stops still work).` };
+  const n = lossStreakToday(db, now);
+  return {
+    allowed: true,
+    line: `BUYS ALLOWED now (code check): real losing trades counted today ${n}/${MAX_LOSS_STREAK}. ` +
+      `Paper trades never count; real losses under ${MEANINGFUL_LOSS_PCT}% of capital do not count; the count restarts at 00:00 UTC.`,
+  };
+}
+
+const FALSE_STOP_RE = /(losing trades?|losses?)\b.{0,60}\b(stop|no more|cannot|can't|must not|blocked|not allowed)|stop(ped)? trading (for )?today|buys? (are )?(blocked|paused)|not tradable today/i;
+
+/** A skip or plan that claims a loss-streak stop the code does not apply. */
+export function falseStopClaim(db: Database, kind: string, text: string, now: Date = new Date()): string | null {
+  if (kind === "lesson" || !FALSE_STOP_RE.test(text)) return null;
+  const status = buyStatus(db, now);
+  return status.allowed
+    ? `Blocked: this reason is false. ${status.line} Decide again on the real merits of the setup (buy it, or skip for a market reason).`
+    : null;
+}
