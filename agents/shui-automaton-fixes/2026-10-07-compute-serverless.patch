@@ -0,0 +1,88 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { createDatabase } from "../state/database.js";
+import {
+  captureTopupRequest, checkLowBalance, computeCostOfDay, createComputeTools, fetchRunpodAccount, formatComputeLine,
+  readTopupRequest, recordRunpodReading, topupTransferArgs,
+} from "../integration/runpod.js";
+import { createCreatorChatHandler, listOutgoingCreatorMessages } from "../integration/creator-chat.js";
+
+const freshDb = () => createDatabase(path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lot9-")), "s.db"));
+const ADDR = "9xQeWvG816bUx9EPjHmaT23yvVM2ZWbrrpZb9PusVFin";
+
+describe("Runpod account", () => {
+  it("reads balance and spend rate, retrying with the api_key parameter", async () => {
+    const calls: string[] = [];
+    const fetchImpl = (async (url: string) => {
+      calls.push(String(url));
+      if (calls.length === 1) return new Response("", { status: 401 });
+      return new Response(JSON.stringify({ data: { myself: { clientBalance: 61.5, currentSpendPerHr: 0.494 } } }), { status: 200 });
+    }) as unknown as typeof fetch;
+    const acc = await fetchRunpodAccount("KEY", fetchImpl, new Date("2026-10-07T12:00:00Z"));
+    expect(acc).toMatchObject({ balanceUsd: 61.5, spendPerHr: 0.494 });
+    expect(acc.hoursLeft).toBeCloseTo(124.5, 0);
+    expect(calls[1]).toMatch(/api_key=KEY/);
+  });
+
+  it("accumulates today's compute cost and shows the NET result", () => {
+    const db = freshDb();
+    recordRunpodReading(db.raw, { balanceUsd: 61.5, spendPerHr: 0.5, hoursLeft: 123, at: "2026-10-07T12:00:00.000Z" });
+    recordRunpodReading(db.raw, { balanceUsd: 61.25, spendPerHr: 0.5, hoursLeft: 122.5, at: "2026-10-07T12:30:00.000Z" });
+    expect(computeCostOfDay(db.raw, "2026-10-07")).toBeCloseTo(0.25);
+    const line = formatComputeLine(db.raw, 0.1, new Date("2026-10-07T13:00:00Z"))!;
+    expect(line).toMatch(/balance \$61.25/);
+    expect(line).toMatch(/NET -\$0.15/);
+  });
+
+  it("warns SHUI and the creator once a day when the balance is low", () => {
+    const db = freshDb();
+    recordRunpodReading(db.raw, { balanceUsd: 10, spendPerHr: 0.5, hoursLeft: 20, at: new Date().toISOString() });
+    expect(checkLowBalance(db.raw)).toBe(true);
+    expect(checkLowBalance(db.raw)).toBe(false);
+    expect(listOutgoingCreatorMessages(db.raw).at(-1)!.content).toMatch(/TOPUP <address> <amount> USDC/);
+  });
+});
+
+describe("crypto top-up", () => {
+  it("only the authenticated creator chat creates a request, which expires", async () => {
+    const db = freshDb();
+    expect(captureTopupRequest(db.raw, "hello")).toBeNull();
+    expect(captureTopupRequest(db.raw, "TOPUP notAnAddress 20 USDC")).toBeNull();
+    const now = new Date("2026-10-07T12:00:00Z");
+    const r = captureTopupRequest(db.raw, `voilà :\nTOPUP ${ADDR} 20,5 USDC`, now)!;
+    expect(r).toMatchObject({ address: ADDR, amount: 20.5, token: "USDC", status: "pending" });
+    expect(topupTransferArgs(r)).toMatchObject({ amount: "20500000" });
+    expect(readTopupRequest(db.raw, new Date("2026-10-07T13:00:00Z"))!.status).toBe("expired");
+  });
+
+  it("pays a pending request once, within the cap, through the transfer tool", async () => {
+    const db = freshDb();
+    captureTopupRequest(db.raw, `TOPUP ${ADDR} 5 USDC`);
+    const transfer = { name: "solana_transfer", execute: vi.fn(async () => JSON.stringify({ success: true, signature: "SIG123" })) } as any;
+    const pay = createComputeTools(() => transfer).find((t) => t.name === "runpod_topup_pay")!;
+    const ctx = { db, identity: {} } as any;
+    expect(await pay.execute({}, ctx)).toMatch(/SIG123/);
+    expect(transfer.execute).toHaveBeenCalledWith(expect.objectContaining({ recipient: ADDR, amount: "5000000" }), ctx);
+    expect(readTopupRequest(db.raw)!.status).toBe("paid");
+    expect(await pay.execute({}, ctx)).toMatch(/is paid/);
+    captureTopupRequest(db.raw, `TOPUP ${ADDR} 500 USDC`);
+    expect(await pay.execute({}, ctx)).toMatch(/above the top-up cap/);
+  });
+
+  it("captures TOPUP from the chat endpoint", async () => {
+    const db = freshDb();
+    const handler = createCreatorChatHandler(db.raw, "t".repeat(32));
+    const body = JSON.stringify({ content: `TOPUP ${ADDR} 12 USDC` });
+    const res = await new Promise<{ status: number; body: string }>((resolve) => {
+      const req: any = new (require("node:events").EventEmitter)();
+      req.method = "POST"; req.url = "/chat"; req.headers = { authorization: `Bearer ${"t".repeat(32)}` };
+      const out: any = { writeHead: (s: number) => { out.status = s; }, end: (b: string) => resolve({ status: out.status, body: b }), writableEnded: false };
+      handler(req, out);
+      req.emit("data", Buffer.from(body)); req.emit("end");
+    });
+    expect(res.status).toBe(202);
+    expect(JSON.parse(res.body).topup).toMatch(/12 USDC/);
+  });
+});
