diff --git a/src/integration/runpod.ts b/src/integration/runpod.ts
new file mode 100644
index 0000000..fced01c
--- /dev/null
+++ b/src/integration/runpod.ts
@@ -0,0 +1,294 @@
+/**
+ * SHUI's compute "life": the Runpod account that pays for its GPU.
+ *
+ * - RUNPOD_API_KEY (read-only key is enough): balance and spend rate are read
+ *   every 15 min from Runpod's GraphQL API and cached in kv `compute.runpod`;
+ *   the GPU cost is accumulated per UTC day (kv `compute.cost.<day>`) so SHUI
+ *   sees its NET result (trading PnL minus compute).
+ * - Top-up in crypto: Runpod's "Pay with crypto" creates a one-time address
+ *   and amount in the creator's browser session; SHUI cannot create it. When
+ *   the balance runs low SHUI asks its creator, who pastes
+ *   "TOPUP <address> <amount> USDC|SOL" in the Control Center chat. Only that
+ *   authenticated message creates a payable request; runpod_topup_pay pays it
+ *   once, within a cap, through the normal transfer pipeline.
+ */
+import type { Database } from "better-sqlite3";
+import { PublicKey } from "@solana/web3.js";
+import type { AutomatonTool } from "../types.js";
+import { queueSystemNotice, saveOutgoingCreatorMessage } from "./creator-chat.js";
+
+const GRAPHQL_URL = "https://api.runpod.io/graphql";
+const CACHE_KEY = "compute.runpod";
+const COST_PREFIX = "compute.cost.";
+const TOPUP_KEY = "compute.topup_request";
+const LOW_ALERT_KEY = "compute.low_alert_day";
+const POLL_MS = 15 * 60_000;
+export const LOW_BALANCE_HOURS = 72;
+export const TOPUP_REQUEST_TTL_MS = 55 * 60_000;
+const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+const SOL_MINT = "So11111111111111111111111111111111111111112";
+
+export interface RunpodAccount {
+  balanceUsd: number;
+  spendPerHr: number;
+  /** Hours of compute left at the current spend rate (null = not spending). */
+  hoursLeft: number | null;
+  at: string;
+}
+
+export interface TopupRequest {
+  address: string;
+  amount: number;
+  token: "USDC" | "SOL";
+  at: string;
+  expiresAt: string;
+  status: "pending" | "paid" | "expired";
+  signature?: string;
+}
+
+const getKv = (db: Database, key: string) =>
+  (db.prepare("SELECT value FROM kv WHERE key = ?").get(key) as { value: string } | undefined)?.value ?? null;
+const setKv = (db: Database, key: string, value: string) =>
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(key, value);
+
+export function topupMaxUsd(env: NodeJS.ProcessEnv = process.env): number {
+  const v = Number(env.SHUI_TOPUP_MAX_USD);
+  return Number.isFinite(v) && v > 0 ? v : 50;
+}
+
+// ─── Runpod API ─────────────────────────────────────────────────
+
+export async function fetchRunpodAccount(
+  apiKey: string,
+  fetchImpl: typeof fetch = fetch,
+  now: Date = new Date(),
+): Promise<RunpodAccount> {
+  const body = JSON.stringify({ query: "query { myself { clientBalance currentSpendPerHr } }" });
+  const post = (url: string, headers: Record<string, string>) =>
+    fetchImpl(url, { method: "POST", headers: { "Content-Type": "application/json", ...headers }, body, signal: AbortSignal.timeout(15_000) });
+  let response = await post(GRAPHQL_URL, { Authorization: `Bearer ${apiKey}` });
+  if (response.status === 401 || response.status === 403) {
+    response = await post(`${GRAPHQL_URL}?api_key=${encodeURIComponent(apiKey)}`, {});
+  }
+  if (!response.ok) throw new Error(`Runpod API HTTP ${response.status}`);
+  const json = (await response.json()) as { data?: { myself?: { clientBalance?: number; currentSpendPerHr?: number } }; errors?: Array<{ message?: string }> };
+  const me = json.data?.myself;
+  if (!me || typeof me.clientBalance !== "number") {
+    throw new Error(`Runpod API: ${json.errors?.[0]?.message ?? "no account data"}`);
+  }
+  const spendPerHr = typeof me.currentSpendPerHr === "number" ? me.currentSpendPerHr : 0;
+  return {
+    balanceUsd: me.clientBalance,
+    spendPerHr,
+    hoursLeft: spendPerHr > 0 ? me.clientBalance / spendPerHr : null,
+    at: now.toISOString(),
+  };
+}
+
+export function readRunpodCache(db: Database): RunpodAccount | null {
+  try {
+    const raw = getKv(db, CACHE_KEY);
+    return raw ? (JSON.parse(raw) as RunpodAccount) : null;
+  } catch {
+    return null;
+  }
+}
+
+export function computeCostOfDay(db: Database, day: string): number {
+  return Number(getKv(db, `${COST_PREFIX}${day}`) ?? 0) || 0;
+}
+
+/** Store a fresh reading and add the compute spent since the previous one to today's cost. */
+export function recordRunpodReading(db: Database, account: RunpodAccount): void {
+  const prev = readRunpodCache(db);
+  if (prev) {
+    const hours = Math.min(1, Math.max(0, (Date.parse(account.at) - Date.parse(prev.at)) / 3_600_000));
+    const cost = hours * prev.spendPerHr;
+    if (cost > 0) {
+      const key = `${COST_PREFIX}${account.at.slice(0, 10)}`;
+      setKv(db, key, String(computeCostOfDay(db, account.at.slice(0, 10)) + cost));
+    }
+  }
+  setKv(db, CACHE_KEY, JSON.stringify(account));
+}
+
+/** One line for the status block, trade_stats and the daily report. */
+export function formatComputeLine(db: Database, todayPnlUsd: number | null = null, now: Date = new Date()): string | null {
+  const acc = readRunpodCache(db);
+  if (!acc) return null;
+  const day = now.toISOString().slice(0, 10);
+  const cost = computeCostOfDay(db, day);
+  const left = acc.hoursLeft === null ? "not spending now"
+    : acc.hoursLeft >= 48 ? `${(acc.hoursLeft / 24).toFixed(1)} days left` : `${acc.hoursLeft.toFixed(0)} h left`;
+  const signed = (x: number) => `${x >= 0 ? "+" : "-"}$${Math.abs(x).toFixed(2)}`;
+  const net = todayPnlUsd === null ? "" : ` | today: trading ${signed(todayPnlUsd)} − compute $${cost.toFixed(2)} = NET ${signed(todayPnlUsd - cost)}`;
+  return `Your GPU (Runpod, pays for your thinking): balance $${acc.balanceUsd.toFixed(2)}, burn $${acc.spendPerHr.toFixed(3)}/h ` +
+    `($${(acc.spendPerHr * 24).toFixed(2)}/day) → ${left}${net}. Your trading profits should cover it.`;
+}
+
+/** Warn SHUI and the creator once a day when the GPU balance gets low. */
+export function checkLowBalance(db: Database, now: Date = new Date()): boolean {
+  const acc = readRunpodCache(db);
+  if (!acc || acc.hoursLeft === null || acc.hoursLeft >= LOW_BALANCE_HOURS) return false;
+  const day = now.toISOString().slice(0, 10);
+  if (getKv(db, LOW_ALERT_KEY) === day) return false;
+  setKv(db, LOW_ALERT_KEY, day);
+  const text = `GPU balance low: $${acc.balanceUsd.toFixed(2)} (~${acc.hoursLeft.toFixed(0)} h at $${acc.spendPerHr.toFixed(3)}/h).`;
+  saveOutgoingCreatorMessage(db,
+    `${text} To let me pay it: Runpod → Billing → Pay with crypto (Solana, USDC), then send me here: ` +
+    "TOPUP <address> <amount> USDC (I pay it once, from my wallet, within the cap).", now);
+  queueSystemNotice(db, "system:compute", `${text} Your creator was asked for a top-up address. When a TOPUP request arrives, check your USDC and pay it with runpod_topup_pay.`, now);
+  return true;
+}
+
+// ─── Top-up requests (from the authenticated creator chat only) ──
+
+const TOPUP_RE = /^\s*TOPUP\s+([1-9A-HJ-NP-Za-km-z]{32,44})\s+([0-9]+(?:[.,][0-9]+)?)\s*(USDC|SOL)?\s*$/im;
+
+/** Called on each creator chat message: a "TOPUP <address> <amount> [USDC|SOL]" line creates a payable request. */
+export function captureTopupRequest(db: Database, content: string, now: Date = new Date()): TopupRequest | null {
+  const m = TOPUP_RE.exec(content);
+  if (!m) return null;
+  try {
+    new PublicKey(m[1]);
+  } catch {
+    return null;
+  }
+  const amount = Number(m[2].replace(",", "."));
+  if (!(amount > 0)) return null;
+  const request: TopupRequest = {
+    address: m[1],
+    amount,
+    token: (m[3]?.toUpperCase() as "USDC" | "SOL" | undefined) ?? "USDC",
+    at: now.toISOString(),
+    expiresAt: new Date(now.getTime() + TOPUP_REQUEST_TTL_MS).toISOString(),
+    status: "pending",
+  };
+  setKv(db, TOPUP_KEY, JSON.stringify(request));
+  return request;
+}
+
+export function readTopupRequest(db: Database, now: Date = new Date()): TopupRequest | null {
+  try {
+    const raw = getKv(db, TOPUP_KEY);
+    if (!raw) return null;
+    const r = JSON.parse(raw) as TopupRequest;
+    if (r.status === "pending" && Date.parse(r.expiresAt) <= now.getTime()) {
+      const expired = { ...r, status: "expired" as const };
+      setKv(db, TOPUP_KEY, JSON.stringify(expired));
+      return expired;
+    }
+    return r;
+  } catch {
+    return null;
+  }
+}
+
+/** Raw amount and mint for a request; SOL amounts are in SOL units. */
+export function topupTransferArgs(r: TopupRequest): { recipient: string; mint: string; amount: string } {
+  return r.token === "SOL"
+    ? { recipient: r.address, mint: SOL_MINT, amount: String(Math.round(r.amount * 1e9)) }
+    : { recipient: r.address, mint: USDC_MINT, amount: String(Math.round(r.amount * 1e6)) };
+}
+
+// ─── Tools and monitor ──────────────────────────────────────────
+
+export function createComputeTools(transferTool: () => AutomatonTool | undefined): AutomatonTool[] {
+  return [
+    {
+      name: "compute_status",
+      description: "Your GPU account (Runpod): balance, cost per hour/day, time left, today's NET result (trading − compute), and any pending top-up request from your creator.",
+      category: "financial",
+      riskLevel: "safe",
+      parameters: { type: "object", properties: {} },
+      execute: async (_args, ctx) => {
+        const db = ctx.db.raw;
+        const { computeTradeStats } = await import("../solana/trading-desk.js");
+        const line = formatComputeLine(db, computeTradeStats(db).todayPnlUsd)
+          ?? "Runpod not connected (RUNPOD_API_KEY missing): your GPU cost is not visible yet.";
+        const r = readTopupRequest(db);
+        const req = r
+          ? `\nTop-up request: ${r.amount} ${r.token} to ${r.address} — ${r.status}${r.status === "pending" ? ` (expires ${r.expiresAt}; pay with runpod_topup_pay)` : r.signature ? ` (tx ${r.signature})` : ""}`
+          : "\nNo top-up request.";
+        return line + req;
+      },
+    },
+    {
+      name: "runpod_topup_pay",
+      description:
+        "Pay the pending Runpod top-up request your creator sent in the chat (TOPUP <address> <amount> USDC|SOL), from your wallet. " +
+        `Pays it exactly once, before it expires, up to $${topupMaxUsd()} and at most 50% of your USDC. This is how you pay for your own GPU.`,
+      category: "financial",
+      riskLevel: "dangerous",
+      parameters: { type: "object", properties: {} },
+      execute: async (_args, ctx) => {
+        const db = ctx.db.raw;
+        const r = readTopupRequest(db);
+        if (!r) return "No top-up request. Ask your creator for one (message_creator) when your GPU balance is low.";
+        if (r.status !== "pending") return `The last top-up request is ${r.status}. Ask your creator for a new one.`;
+        const usd = r.token === "USDC" ? r.amount : r.amount * (await solPriceUsd());
+        if (!(usd > 0)) return "Blocked: SOL price unavailable.";
+        if (usd > topupMaxUsd()) return `Blocked: $${usd.toFixed(2)} is above the top-up cap ($${topupMaxUsd()}). Ask your creator for a smaller amount.`;
+        if (r.token === "USDC") {
+          const usdc = await walletUsdc(ctx);
+          if (usdc !== null && r.amount > usdc * 0.5) {
+            return `Blocked: ${r.amount} USDC is more than half of your USDC (${usdc.toFixed(2)}). Trade more first, or ask for a smaller top-up.`;
+          }
+        }
+        const tool = transferTool();
+        if (!tool) return "Blocked: transfer tool unavailable.";
+        const result = await tool.execute({ ...topupTransferArgs(r), reason: `Runpod GPU top-up (${r.amount} ${r.token})` }, ctx);
+        const signature = /"signature"\s*:\s*"([^"]+)"/.exec(String(result))?.[1];
+        if (signature) {
+          setKv(db, TOPUP_KEY, JSON.stringify({ ...r, status: "paid", signature }));
+          saveOutgoingCreatorMessage(db, `I paid my GPU: ${r.amount} ${r.token} sent for the Runpod top-up (tx ${signature}). The credit appears on Runpod after the network confirms.`);
+        }
+        return String(result);
+      },
+    },
+  ];
+}
+
+async function solPriceUsd(): Promise<number> {
+  try {
+    const { jupiterPrices } = await import("../solana/orders.js");
+    return (await jupiterPrices([SOL_MINT]))[SOL_MINT] ?? 0;
+  } catch {
+    return 0;
+  }
+}
+
+async function walletUsdc(ctx: { identity: { chainIdentity?: unknown } }): Promise<number | null> {
+  try {
+    const id = ctx.identity.chainIdentity as { chainType?: string } | undefined;
+    if (!id || id.chainType !== "solana") return null;
+    const { SolanaTradingService } = await import("../solana/trading.js");
+    const balances = await new SolanaTradingService(id as never).getTokenBalances();
+    return balances.filter((b) => b.mint === USDC_MINT).reduce((s, b) => s + (b.uiAmount ?? Number(b.amount) / 1e6), 0);
+  } catch {
+    return null;
+  }
+}
+
+export async function runComputeTick(db: Database, apiKey: string, fetchImpl: typeof fetch = fetch, now: Date = new Date()): Promise<RunpodAccount> {
+  const account = await fetchRunpodAccount(apiKey, fetchImpl, now);
+  recordRunpodReading(db, account);
+  checkLowBalance(db, now);
+  return account;
+}
+
+export function startComputeMonitor(db: Database, env: NodeJS.ProcessEnv = process.env, log: (m: string) => void = () => {}): NodeJS.Timeout | null {
+  const apiKey = (env.RUNPOD_API_KEY ?? "").trim();
+  if (!apiKey) return null;
+  const tick = async () => {
+    try {
+      await runComputeTick(db, apiKey);
+    } catch (error) {
+      log(`[COMPUTE] Runpod read failed: ${error instanceof Error ? error.message : String(error)}`);
+    }
+  };
+  const timer = setInterval(() => void tick(), POLL_MS);
+  timer.unref();
+  void tick();
+  return timer;
+}
