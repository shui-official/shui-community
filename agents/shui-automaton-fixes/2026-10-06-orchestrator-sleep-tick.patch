 // subsequent wake cycles can still recognize workers that are running.
 let persistentLocalWorkerPool: LocalWorkerPool | undefined;
 
+// The orchestrator used to advance only during agent turns. When the agent
+// slept (e.g. 3600s right after create_goal, told "the orchestrator will pick
+// this up on the next tick"), goals and workers stalled until the next wake.
+// Keep the last orchestrator so the main sleep loop can keep ticking it.
+let persistentOrchestrator: Orchestrator | undefined;
+let backgroundTickInFlight = false;
+
+/**
+ * Advance the orchestrator while the agent sleeps, without waking the agent.
+ * Returns null when there is no orchestrator or a tick is already running.
+ */
+export async function tickOrchestratorWhileSleeping(): Promise<
+  Awaited<ReturnType<Orchestrator["tick"]>> | null
+> {
+  if (!persistentOrchestrator || backgroundTickInFlight) {
+    return null;
+  }
+
+  backgroundTickInFlight = true;
+  try {
+    return await persistentOrchestrator.tick();
+  } finally {
+    backgroundTickInFlight = false;
+  }
+}
