index 0000000..2140e78
--- /dev/null
+++ b/src/maintenance/janitor.ts
@@ -0,0 +1,311 @@
+/**
+ * Automatic cleanup: keep only what is useful to SHUI's work.
+ *
+ * Runs in code every few hours (no model involved). Nothing is deleted at
+ * once: abandoned work goes to ~/archive/janitor-<date>/ and only those
+ * janitor archives are deleted after ARCHIVE_KEEP_DAYS. Never touched: wallet,
+ * ledger, lifespan, orders, chat, payment requests, SOUL, the agent's code,
+ * its facts and procedures (including what it learned does not work).
+ */
+import { execFile } from "node:child_process";
+import { promises as fs } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import type { Database } from "better-sqlite3";
+import { queueSystemNotice } from "../integration/creator-chat.js";
+import { runServiceHelper, SERVICES_ROOT, type HelperRunner } from "../services/service-tools.js";
+
+const HOUR = 3_600_000;
+export const JANITOR_INTERVAL_MS = 6 * HOUR;
+export const ENDED_WORKSPACE_MS = 24 * HOUR;
+export const STALE_GOAL_MS = 12 * HOUR;
+export const BROKEN_SERVICE_MS = 24 * HOUR;
+const BROKEN_SERVICE_MIN_CHECKS = 3;
+const UNDEPLOYED_SERVICE_MS = 48 * HOUR;
+const EVENT_KEEP_MS = 3 * 24 * HOUR;
+const ARCHIVE_KEEP_DAYS = 14;
+const REPO_JUNK = /arbitrage|trader|trading|api[_-]?server|defi|revenue|monetiz|deploy_service|value_creation|final_deployment|dashboard|analy[sz]er|scanner|monitor|bot[_-]/i;
+
+export interface JanitorPaths {
+  home: string;
+  workspaceRoot: string;
+  servicesRoot: string;
+  archiveRoot: string;
+  repoRoot: string;
+}
+
+export function defaultJanitorPaths(): JanitorPaths {
+  const home = os.homedir();
+  return {
+    home,
+    workspaceRoot: path.join(home, ".automaton", "workspace"),
+    servicesRoot: SERVICES_ROOT,
+    archiveRoot: path.join(home, "archive"),
+    repoRoot: process.cwd(),
+  };
+}
+
+export interface JanitorDeps {
+  db: Database;
+  now?: () => Date;
+  paths?: JanitorPaths;
+  helper?: HelperRunner;
+  /** HTTP status of a service URL, or null if it does not answer. */
+  probe?: (url: string) => Promise<number | null>;
+  /** Untracked top-level entries of the code repository. */
+  untracked?: (repoRoot: string) => Promise<string[]>;
+  notify?: boolean;
+  log?: (message: string) => void;
+}
+
+export interface JanitorReport {
+  cancelledGoals: string[];
+  archivedWorkspaces: string[];
+  stoppedServices: string[];
+  archivedServiceFolders: string[];
+  archivedRepoFiles: string[];
+  prunedEvents: number;
+  deletedArchives: string[];
+}
+
+const defaultProbe = async (url: string): Promise<number | null> => {
+  try {
+    const response = await fetch(url, { signal: AbortSignal.timeout(10_000) });
+    return response.status;
+  } catch {
+    return null;
+  }
+};
+
+const defaultUntracked = (repoRoot: string): Promise<string[]> =>
+  new Promise((resolve) => {
+    execFile("git", ["-C", repoRoot, "ls-files", "--others", "--directory", "--exclude-standard"], { timeout: 15_000 }, (error, stdout) => {
+      if (error) return resolve([]);
+      resolve([...new Set(stdout.split("\n").filter(Boolean).map((line) => line.split("/")[0]))]);
+    });
+  });
+
+async function moveToArchive(source: string, archiveDir: string): Promise<boolean> {
+  try {
+    await fs.mkdir(archiveDir, { recursive: true });
+    const target = path.join(archiveDir, source.replace(/^\/+/, "").replace(/\//g, "__"));
+    try {
+      await fs.rename(source, target);
+    } catch (error: any) {
+      if (error?.code !== "EXDEV") throw error;
+      await fs.cp(source, target, { recursive: true });
+      await fs.rm(source, { recursive: true, force: true });
+    }
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Newest modification time of a folder and its direct entries (edits inside files count). */
+async function latestMtime(dir: string): Promise<number | null> {
+  try {
+    let latest = (await fs.stat(dir)).mtimeMs;
+    for (const entry of await fs.readdir(dir)) {
+      try {
+        latest = Math.max(latest, (await fs.stat(path.join(dir, entry))).mtimeMs);
+      } catch {
+        // vanished
+      }
+    }
+    return latest;
+  } catch {
+    return null;
+  }
+}
+
+function tableExists(db: Database, name: string): boolean {
+  return !!db.prepare("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?").get(name);
+}
+
+/** Latest activity of a goal: its creation, its end, or any task movement. */
+function goalActivity(db: Database): Map<string, { status: string; title: string; last: number }> {
+  const out = new Map<string, { status: string; title: string; last: number }>();
+  if (!tableExists(db, "goals")) return out;
+  const goals = db.prepare("SELECT id, title, status, created_at, completed_at FROM goals").all() as Array<Record<string, string | null>>;
+  for (const g of goals) {
+    const times = [g.created_at, g.completed_at].map((t) => (t ? Date.parse(t) : NaN)).filter(Number.isFinite);
+    out.set(String(g.id), { status: String(g.status), title: String(g.title), last: Math.max(0, ...times) });
+  }
+  if (tableExists(db, "task_graph")) {
+    const tasks = db.prepare(
+      "SELECT goal_id, MAX(COALESCE(completed_at, started_at, created_at)) AS last FROM task_graph GROUP BY goal_id",
+    ).all() as Array<{ goal_id: string; last: string | null }>;
+    for (const t of tasks) {
+      const goal = out.get(t.goal_id);
+      const last = t.last ? Date.parse(t.last) : NaN;
+      if (goal && Number.isFinite(last)) goal.last = Math.max(goal.last, last);
+    }
+  }
+  return out;
+}
+
+/** Last time a task of the goal was completed (progress), or the goal's creation. */
+function lastProgress(db: Database, goalId: string, createdAt: string): number {
+  const row = db.prepare(
+    "SELECT MAX(completed_at) AS last FROM task_graph WHERE goal_id = ? AND status = 'completed'",
+  ).get(goalId) as { last: string | null } | undefined;
+  return Date.parse(row?.last ?? createdAt);
+}
+
+export async function runJanitor(deps: JanitorDeps): Promise<JanitorReport> {
+  const db = deps.db;
+  const now = (deps.now ?? (() => new Date()))();
+  const paths = deps.paths ?? defaultJanitorPaths();
+  const archiveDir = path.join(paths.archiveRoot, `janitor-${now.toISOString().slice(0, 10)}`);
+  const report: JanitorReport = {
+    cancelledGoals: [], archivedWorkspaces: [], stoppedServices: [], archivedServiceFolders: [],
+    archivedRepoFiles: [], prunedEvents: 0, deletedArchives: [],
+  };
+
+  // c) Abandoned goals: active, but no task completed for STALE_GOAL_MS.
+  if (tableExists(db, "goals") && tableExists(db, "task_graph")) {
+    const active = db.prepare("SELECT id, title, created_at FROM goals WHERE status = 'active'").all() as Array<{ id: string; title: string; created_at: string }>;
+    for (const goal of active) {
+      if (now.getTime() - lastProgress(db, goal.id, goal.created_at) < STALE_GOAL_MS) continue;
+      db.transaction(() => {
+        db.prepare("UPDATE goals SET status = 'failed', completed_at = ? WHERE id = ?").run(now.toISOString(), goal.id);
+        db.prepare("UPDATE task_graph SET status = 'cancelled' WHERE goal_id = ? AND status IN ('pending','assigned','running','blocked')").run(goal.id);
+        const state = db.prepare("SELECT value FROM kv WHERE key = 'orchestrator.state'").get() as { value: string } | undefined;
+        try {
+          if (state && JSON.parse(state.value).goalId === goal.id) {
+            db.prepare("UPDATE kv SET value = ?, updated_at = datetime('now') WHERE key = 'orchestrator.state'")
+              .run(JSON.stringify({ phase: "idle", goalId: null, replanCount: 0, failedTaskId: null, failedError: null }));
+          }
+        } catch {
+          // malformed state: leave it
+        }
+      })();
+      report.cancelledGoals.push(goal.title);
+    }
+  }
+
+  // a) Work folders of goals that ended (or no longer exist) ENDED_WORKSPACE_MS ago.
+  const goals = goalActivity(db);
+  let entries: string[] = [];
+  try {
+    entries = await fs.readdir(paths.workspaceRoot);
+  } catch {
+    entries = [];
+  }
+  for (const name of entries) {
+    const dir = path.join(paths.workspaceRoot, name);
+    const goal = goals.get(name);
+    if (goal?.status === "active") continue;
+    let last = goal?.last ?? 0;
+    if (!goal) {
+      const touched = await latestMtime(dir);
+      if (touched === null) continue;
+      last = touched;
+    }
+    if (now.getTime() - last < ENDED_WORKSPACE_MS) continue;
+    if (await moveToArchive(dir, archiveDir)) report.archivedWorkspaces.push(goal ? `${goal.title} (${goal.status})` : name);
+  }
+
+  // b) Published services that keep failing; folders never published.
+  const helper = deps.helper ?? runServiceHelper;
+  const listed = await helper(["list"]);
+  const deployed = new Map<string, { state: string; url: string }>();
+  for (const m of listed.output.matchAll(/^([a-z][a-z0-9-]{1,30}): (\S+) port=\d+ url=(https:\/\/\S+)/gm)) {
+    deployed.set(m[1], { state: m[2], url: m[3] });
+  }
+  for (const [name, svc] of deployed) {
+    const key = `janitor.service.${name}`;
+    const status = svc.state === "active" ? await (deps.probe ?? defaultProbe)(svc.url) : null;
+    if (status !== null && status < 500) {
+      db.prepare("DELETE FROM kv WHERE key = ?").run(key);
+      continue;
+    }
+    const prev = db.prepare("SELECT value FROM kv WHERE key = ?").get(key) as { value: string } | undefined;
+    const record = prev ? JSON.parse(prev.value) as { firstFailAt: string; checks: number } : { firstFailAt: now.toISOString(), checks: 0 };
+    record.checks += 1;
+    if (record.checks >= BROKEN_SERVICE_MIN_CHECKS && now.getTime() - Date.parse(record.firstFailAt) >= BROKEN_SERVICE_MS) {
+      const stopped = await helper(["stop", name]);
+      if (stopped.ok) {
+        db.prepare("DELETE FROM kv WHERE key = ?").run(key);
+        report.stoppedServices.push(`${name} (${status === null ? "no answer" : `HTTP ${status}`} since ${record.firstFailAt.slice(0, 16)})`);
+        if (await moveToArchive(path.join(paths.servicesRoot, name), archiveDir)) report.archivedServiceFolders.push(name);
+        continue;
+      }
+    }
+    db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(key, JSON.stringify(record));
+  }
+  let serviceDirs: string[] = [];
+  try {
+    serviceDirs = await fs.readdir(paths.servicesRoot);
+  } catch {
+    serviceDirs = [];
+  }
+  if (listed.ok) {
+    for (const name of serviceDirs) {
+      if (deployed.has(name) || report.archivedServiceFolders.includes(name)) continue;
+      const dir = path.join(paths.servicesRoot, name);
+      const touched = await latestMtime(dir);
+      if (touched === null || now.getTime() - touched < UNDEPLOYED_SERVICE_MS) continue;
+      if (await moveToArchive(dir, archiveDir)) report.archivedServiceFolders.push(`${name} (never published)`);
+    }
+  }
+
+  // d) Files SHUI left at the root of its own code repository.
+  for (const name of await (deps.untracked ?? defaultUntracked)(paths.repoRoot)) {
+    if (!REPO_JUNK.test(name)) continue;
+    if (await moveToArchive(path.join(paths.repoRoot, name), archiveDir)) report.archivedRepoFiles.push(name);
+  }
+
+  // e) Old planner "recent outcomes".
+  if (tableExists(db, "event_stream")) {
+    const cutoff = new Date(now.getTime() - EVENT_KEEP_MS).toISOString();
+    report.prunedEvents = db.prepare("DELETE FROM event_stream WHERE created_at < ?").run(cutoff).changes;
+  }
+
+  // f) Janitor archives older than ARCHIVE_KEEP_DAYS (only its own).
+  try {
+    for (const name of await fs.readdir(paths.archiveRoot)) {
+      const m = /^janitor-(\d{4}-\d{2}-\d{2})$/.exec(name);
+      if (!m || now.getTime() - Date.parse(m[1]) < ARCHIVE_KEEP_DAYS * 24 * HOUR) continue;
+      await fs.rm(path.join(paths.archiveRoot, name), { recursive: true, force: true });
+      report.deletedArchives.push(name);
+    }
+  } catch {
+    // no archive folder yet
+  }
+
+  const summary = summarizeJanitor(report);
+  if (summary && deps.notify !== false) queueSystemNotice(db, "system:janitor", summary);
+  if (summary) deps.log?.(`[JANITOR] ${summary}`);
+  return report;
+}
+
+export function summarizeJanitor(r: JanitorReport): string {
+  const parts: string[] = [];
+  if (r.cancelledGoals.length) parts.push(`cancelled ${r.cancelledGoals.length} goal(s) with no completed task for 12 h: ${r.cancelledGoals.join("; ")}`);
+  if (r.stoppedServices.length) parts.push(`stopped broken service(s): ${r.stoppedServices.join("; ")}`);
+  if (r.archivedServiceFolders.length) parts.push(`archived service folder(s): ${r.archivedServiceFolders.join(", ")}`);
+  if (r.archivedWorkspaces.length) parts.push(`archived ${r.archivedWorkspaces.length} old work folder(s)`);
+  if (r.archivedRepoFiles.length) parts.push(`archived stray files from your code folder: ${r.archivedRepoFiles.join(", ")}`);
+  if (r.prunedEvents) parts.push(`forgot ${r.prunedEvents} planner events older than 3 days`);
+  if (r.deletedArchives.length) parts.push(`deleted archives older than 14 days: ${r.deletedArchives.join(", ")}`);
+  if (parts.length === 0) return "";
+  return `Automatic cleanup: ${parts.join(". ")}. Archived files are in ~/archive for 14 days. Focus on one goal at a time and finish it.`;
+}
+
+export function startJanitor(deps: JanitorDeps, firstRunDelayMs = 10 * 60_000): () => void {
+  let running = false;
+  const tick = () => {
+    if (running) return;
+    running = true;
+    runJanitor(deps)
+      .catch((error) => deps.log?.(`[JANITOR] failed: ${error instanceof Error ? error.message : String(error)}`))
+      .finally(() => { running = false; });
+  };
+  const first = setTimeout(tick, firstRunDelayMs);
+  const timer = setInterval(tick, JANITOR_INTERVAL_MS);
+  first.unref?.();
+  timer.unref?.();
+  return () => { clearTimeout(first); clearInterval(timer); };
+}
