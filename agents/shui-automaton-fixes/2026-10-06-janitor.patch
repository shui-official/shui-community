+++ b/src/__tests__/janitor.test.ts
@@ -0,0 +1,119 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { createDatabase, claimInboxMessages } from "../state/database.js";
+import { runJanitor, type JanitorPaths } from "../maintenance/janitor.js";
+
+const HOUR = 3_600_000;
+
+function setup() {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "janitor-"));
+  const paths: JanitorPaths = {
+    home: root,
+    workspaceRoot: path.join(root, "workspace"),
+    servicesRoot: path.join(root, "services"),
+    archiveRoot: path.join(root, "archive"),
+    repoRoot: path.join(root, "repo"),
+  };
+  for (const p of [paths.workspaceRoot, paths.servicesRoot, paths.archiveRoot, paths.repoRoot]) fs.mkdirSync(p, { recursive: true });
+  const db = createDatabase(path.join(root, "state.db"));
+  return { root, paths, db };
+}
+
+function age(target: string, hours: number) {
+  const t = new Date(Date.now() - hours * HOUR);
+  fs.utimesSync(target, t, t);
+}
+
+function goal(db: any, id: string, status: string, createdHoursAgo: number, completedTaskHoursAgo?: number) {
+  const created = new Date(Date.now() - createdHoursAgo * HOUR).toISOString();
+  db.raw.prepare("INSERT INTO goals (id, title, description, status, created_at) VALUES (?, ?, 'd', ?, ?)").run(id, `goal ${id}`, status, created);
+  db.raw.prepare("INSERT INTO task_graph (id, goal_id, title, description, status, created_at, completed_at) VALUES (?, ?, 't', 'd', ?, ?, ?)")
+    .run(`task-${id}`, id, completedTaskHoursAgo === undefined ? "running" : "completed", created,
+      completedTaskHoursAgo === undefined ? null : new Date(Date.now() - completedTaskHoursAgo * HOUR).toISOString());
+}
+
+const noServices = async () => ({ ok: true, output: "no published service" });
+
+describe("janitor", () => {
+  it("cancels goals without progress for 12 h and keeps progressing ones", async () => {
+    const { db, paths } = setup();
+    goal(db, "STALE", "active", 20);
+    goal(db, "BUSY", "active", 20, 2);
+    const report = await runJanitor({ db: db.raw, paths, helper: noServices, untracked: async () => [] });
+    expect(report.cancelledGoals).toEqual(["goal STALE"]);
+    const status = Object.fromEntries((db.raw.prepare("SELECT id, status FROM goals").all() as any[]).map((g) => [g.id, g.status]));
+    expect(status).toEqual({ STALE: "failed", BUSY: "active" });
+    expect((db.raw.prepare("SELECT status FROM task_graph WHERE goal_id = 'STALE'").get() as any).status).toBe("cancelled");
+  });
+
+  it("archives work folders of goals ended more than 24 h ago only", async () => {
+    const { db, paths } = setup();
+    goal(db, "OLD", "completed", 60, 40);
+    goal(db, "RECENT", "failed", 30, 3);
+    goal(db, "LIVE", "active", 60, 1);
+    for (const g of ["OLD", "RECENT", "LIVE", "ORPHAN"]) fs.mkdirSync(path.join(paths.workspaceRoot, g));
+    fs.writeFileSync(path.join(paths.workspaceRoot, "ORPHAN", "x.py"), "x");
+    age(path.join(paths.workspaceRoot, "ORPHAN", "x.py"), 30);
+    age(path.join(paths.workspaceRoot, "ORPHAN"), 30);
+    const report = await runJanitor({ db: db.raw, paths, helper: noServices, untracked: async () => [] });
+    expect(fs.readdirSync(paths.workspaceRoot).sort()).toEqual(["LIVE", "RECENT"]);
+    expect(report.archivedWorkspaces).toHaveLength(2);
+    const archived = fs.readdirSync(path.join(paths.archiveRoot, fs.readdirSync(paths.archiveRoot)[0]));
+    expect(archived.length).toBe(2);
+  });
+
+  it("stops a service only after it failed 3 checks over 24 h, and keeps working ones", async () => {
+    const { db, paths } = setup();
+    fs.mkdirSync(path.join(paths.servicesRoot, "broken"));
+    fs.mkdirSync(path.join(paths.servicesRoot, "good"));
+    const stopped: string[] = [];
+    const helper = async (args: string[]) => {
+      if (args[0] === "stop") { stopped.push(args[1]); return { ok: true, output: "stopped" }; }
+      return { ok: true, output: "broken: active port=8101 url=https://broken.x\ngood: active port=8102 url=https://good.x" };
+    };
+    const probe = async (url: string) => (url.includes("broken") ? 502 : 200);
+    let t = Date.now();
+    for (let i = 0; i < 3; i++) {
+      await runJanitor({ db: db.raw, paths, helper, probe, untracked: async () => [], now: () => new Date(t) });
+      t += 13 * HOUR;
+    }
+    expect(stopped).toEqual(["broken"]);
+    expect(fs.readdirSync(paths.servicesRoot)).toEqual(["good"]);
+  });
+
+  it("archives never-published service folders untouched for 48 h, stray repo files, old events and archives", async () => {
+    const { db, paths } = setup();
+    const draft = path.join(paths.servicesRoot, "draft");
+    fs.mkdirSync(draft);
+    fs.writeFileSync(path.join(draft, "app.py"), "x");
+    age(path.join(draft, "app.py"), 50);
+    age(draft, 50);
+    fs.writeFileSync(path.join(paths.repoRoot, "arbitrage_bot.py"), "x");
+    fs.writeFileSync(path.join(paths.repoRoot, "notes.md"), "x");
+    fs.mkdirSync(path.join(paths.archiveRoot, "janitor-2020-01-01"));
+    fs.mkdirSync(path.join(paths.archiveRoot, "cleanup-20261006-114055"));
+    db.raw.prepare("INSERT INTO event_stream (id, type, agent_address, content, token_count, created_at) VALUES ('e1','x','a','c',1,?)")
+      .run(new Date(Date.now() - 5 * 24 * HOUR).toISOString());
+    const report = await runJanitor({
+      db: db.raw, paths, helper: noServices, untracked: async () => ["arbitrage_bot.py", "notes.md"],
+    });
+    expect(report.archivedServiceFolders).toEqual(["draft (never published)"]);
+    expect(report.archivedRepoFiles).toEqual(["arbitrage_bot.py"]);
+    expect(fs.existsSync(path.join(paths.repoRoot, "notes.md"))).toBe(true);
+    expect(report.prunedEvents).toBe(1);
+    expect(report.deletedArchives).toEqual(["janitor-2020-01-01"]);
+    expect(fs.existsSync(path.join(paths.archiveRoot, "cleanup-20261006-114055"))).toBe(true);
+    const [notice] = claimInboxMessages(db.raw, 10);
+    expect(notice.fromAddress).toBe("system:janitor");
+    expect(notice.content).toContain("Automatic cleanup");
+  });
+
+  it("stays silent when there is nothing to clean", async () => {
+    const { db, paths } = setup();
+    const report = await runJanitor({ db: db.raw, paths, helper: noServices, untracked: async () => [] });
+    expect(Object.values(report).every((v) => (Array.isArray(v) ? v.length === 0 : v === 0))).toBe(true);
+    expect(claimInboxMessages(db.raw, 10)).toHaveLength(0);
+  });
+});
