+describe("market API rate limits", () => {
+  it("retries a plain-text rate limit, then parses JSON", async () => {
+    const { fetchJson } = await import("../solana/http-json.js");
+    const replies = [new Response("Rate limit exceeded", { status: 429 }), new Response('{"success":true}', { status: 200 })];
+    const fetchImpl = vi.fn(async () => replies.shift()!) as unknown as typeof fetch;
+    const out = await fetchJson("https://transaction-v1.raydium.io/x", {}, { retryDelaysMs: [1], fetchImpl });
+    expect(out.body).toEqual({ success: true });
+    expect(fetchImpl).toHaveBeenCalledTimes(2);
+  });
