+  it("gives a readable error when the limit persists", async () => {
+    const { fetchJson } = await import("../solana/http-json.js");
+    const fetchImpl = (async () => new Response("Rate limit exceeded", { status: 429 })) as unknown as typeof fetch;
+    await expect(fetchJson("https://transaction-v1.raydium.io/x", {}, { retryDelaysMs: [1], fetchImpl })).rejects.toThrow(/rate-limiting.*Wait a minute/);
+  });
+});
diff --git a/src/solana/http-json.ts b/src/solana/http-json.ts
new file mode 100644
index 0000000..75970db
--- /dev/null
+++ b/src/solana/http-json.ts
@@ -0,0 +1,45 @@
+/**
+ * fetch + JSON for public market APIs (Raydium, Jupiter, GeckoTerminal…).
+ * They answer rate limits with HTTP 429 and a plain-text body ("Rate limit
+ * exceeded"), which made response.json() throw "Unexpected token 'R'".
+ * Rate limits and 5xx are retried after a short pause; a body that is not
+ * JSON becomes a readable error.
+ */
+const RETRY_DELAYS_MS = [1500, 4000];
+
+export class HttpJsonError extends Error {
+  constructor(message: string, readonly status: number) {
+    super(message);
+    this.name = "HttpJsonError";
+  }
+}
+
+export async function fetchJson(
+  url: string | URL,
+  init: RequestInit = {},
+  options: { timeoutMs?: number; retryDelaysMs?: number[]; fetchImpl?: typeof fetch } = {},
+): Promise<{ status: number; ok: boolean; body: unknown }> {
+  const delays = options.retryDelaysMs ?? RETRY_DELAYS_MS;
+  const doFetch = options.fetchImpl ?? fetch;
+  const host = new URL(String(url)).host;
+  for (let attempt = 0; ; attempt++) {
+    const response = await doFetch(url, { ...init, signal: AbortSignal.timeout(options.timeoutMs ?? 15_000) });
+    const text = await response.text();
+    const retryable = response.status === 429 || response.status >= 500 || /rate limit/i.test(text.slice(0, 200));
+    if (retryable && attempt < delays.length) {
+      await new Promise((resolve) => setTimeout(resolve, delays[attempt]));
+      continue;
+    }
+    try {
+      return { status: response.status, ok: response.ok, body: JSON.parse(text) };
+    } catch {
+      const snippet = text.slice(0, 120).replace(/\s+/g, " ");
+      throw new HttpJsonError(
+        retryable
+          ? `${host} is rate-limiting requests (HTTP ${response.status}: ${snippet}). Wait a minute before retrying.`
+          : `${host} answered HTTP ${response.status} with a non-JSON body: ${snippet}`,
+        response.status,
+      );
+    }
+  }
+}
