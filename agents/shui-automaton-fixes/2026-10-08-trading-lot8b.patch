diff --git a/src/solana/decisions.ts b/src/solana/decisions.ts
new file mode 100644
index 0000000..3dfc537
--- /dev/null
+++ b/src/solana/decisions.ts
@@ -0,0 +1,131 @@
+/**
+ * Lot 8b — SHUI must decide. The code never buys for it, but:
+ *   - every live trend setup found by setup_scan becomes a pending decision,
+ *     with a size already clamped to the code limits (amountUsd);
+ *   - sleep refuses (twice at most per scan) while a pending setup has
+ *     neither a buy nor a journal entry for its mint;
+ *   - in trading focus, sleep lasts 2 h at most (1 h with an open position).
+ */
+import type { Database } from "better-sqlite3";
+import { tradeLimits } from "./trade-limits.js";
+import { isCreatorToken } from "./token-policy.js";
+
+const PENDING_KEY = "decision.pending";
+const REFUSALS_PREFIX = "decision.sleep_refusals.";
+export const PENDING_TTL_MS = 6 * 3_600_000;
+export const MAX_SLEEP_REFUSALS = 2;
+export const MAX_SLEEP_S = 2 * 3600;
+export const MAX_SLEEP_WITH_POSITION_S = 3600;
+
+const SOL_MINT = "So11111111111111111111111111111111111111112";
+const USDC_MINT = "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v";
+const JITOSOL = "J1toso1uCk3RLmjorhTtrVwY9HJ7X8V9yYac6Y7kGCPn";
+
+export interface PendingSetup {
+  symbol: string;
+  mint: string;
+  entry: number;
+  stop: number;
+  target: number;
+  rr: number;
+  amountUsd: number;
+}
+
+const getKv = (db: Database, key: string): string | null =>
+  (db.prepare("SELECT value FROM kv WHERE key = ?").get(key) as { value: string } | undefined)?.value ?? null;
+const setKv = (db: Database, key: string, value: string): void => {
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(key, value);
+};
+
+/** Buy size within the code limits, or null when the limits leave less than the minimum. */
+export function clampBuyUsd(sizeUsd: number | null | undefined, capitalUsd: number | null, env: NodeJS.ProcessEnv = process.env): number | null {
+  if (!capitalUsd || capitalUsd <= 0) return null;
+  const L = tradeLimits(env);
+  const cap = (capitalUsd * L.maxTradePct) / 100;
+  const size = Math.min(sizeUsd && sizeUsd > 0 ? sizeUsd : cap, cap);
+  const rounded = Math.floor(size * 100) / 100;
+  return rounded >= L.minTradeUsd ? rounded : null;
+}
+
+export function recordPendingSetups(db: Database, setups: PendingSetup[], now: Date = new Date()): void {
+  if (!setups.length) return;
+  setKv(db, PENDING_KEY, JSON.stringify({ at: now.toISOString(), setups }));
+}
+
+/** Mints SHUI holds as positions (cost basis), without SOL, USDC, jitoSOL and the creator token. */
+export function openPositionMints(db: Database): string[] {
+  try {
+    return (db.prepare("SELECT mint FROM shui_cost_basis").all() as Array<{ mint: string }>)
+      .map((r) => r.mint)
+      .filter((m) => m !== SOL_MINT && m !== USDC_MINT && m !== JITOSOL && !isCreatorToken(m));
+  } catch {
+    return [];
+  }
+}
+
+function decidedSince(db: Database, mint: string, since: string): boolean {
+  const journaled = (db.prepare("SELECT value FROM kv WHERE key LIKE 'journal.%' AND key >= ?").all(`journal.${since}`) as Array<{ value: string }>)
+    .some((r) => {
+      try {
+        return (JSON.parse(r.value) as { mint?: string | null }).mint === mint;
+      } catch {
+        return false;
+      }
+    });
+  if (journaled) return true;
+  try {
+    return !!db.prepare("SELECT 1 FROM shui_ledger WHERE kind = 'swap' AND output_mint = ? AND ts >= ? LIMIT 1").get(mint, since);
+  } catch {
+    return false;
+  }
+}
+
+export function undecidedSetups(db: Database, now: Date = new Date()): { at: string; setups: PendingSetup[] } | null {
+  const raw = getKv(db, PENDING_KEY);
+  if (!raw) return null;
+  let pending: { at: string; setups: PendingSetup[] };
+  try {
+    pending = JSON.parse(raw);
+  } catch {
+    return null;
+  }
+  if (now.getTime() - Date.parse(pending.at) > PENDING_TTL_MS) return null;
+  const held = new Set(openPositionMints(db));
+  const setups = pending.setups.filter((s) => !held.has(s.mint) && !decidedSince(db, s.mint, pending.at));
+  return setups.length ? { at: pending.at, setups } : null;
+}
+
+const fmt = (x: number) => (x >= 100 ? x.toFixed(2) : x >= 1 ? x.toFixed(4) : x.toPrecision(4));
+
+export function decisionLine(s: PendingSetup): string {
+  return `${s.symbol}: BUY → jupiter_swap inputMint=${USDC_MINT} outputMint=${s.mint} amountUsd=${s.amountUsd}, ` +
+    `then protect_position mint=${s.mint} stopPriceUsd=${fmt(s.stop)} takeProfitPriceUsd=${fmt(s.target)}; ` +
+    `or SKIP → journal_add kind=note mint=${s.mint} text="skip: <your reason>"`;
+}
+
+/**
+ * Called by the sleep tool. Returns a refusal (string starting with "Blocked:")
+ * or the duration actually allowed.
+ */
+export function sleepGuard(db: Database, requestedS: number, trading: boolean, now: Date = new Date()):
+  { blocked: string } | { durationS: number; note: string } {
+  const requested = Number.isFinite(requestedS) && requestedS > 0 ? requestedS : 600;
+  if (!trading) return { durationS: requested, note: "" };
+  const pending = undecidedSetups(db, now);
+  if (pending) {
+    const key = `${REFUSALS_PREFIX}${pending.at}`;
+    const refusals = Number(getKv(db, key) ?? 0) || 0;
+    if (refusals < MAX_SLEEP_REFUSALS) {
+      setKv(db, key, String(refusals + 1));
+      return {
+        blocked: `Blocked: ${pending.setups.length} valid setup(s) from setup_scan have no decision. Decide each one now, then sleep:\n` +
+          pending.setups.map((s) => `- ${decisionLine(s)}`).join("\n") +
+          "\nThe size is already within the code limits. Buying or skipping is your choice, but you must choose.",
+      };
+    }
+  }
+  const max = openPositionMints(db).length ? MAX_SLEEP_WITH_POSITION_S : MAX_SLEEP_S;
+  return requested > max
+    ? { durationS: max, note: ` (capped from ${requested}s: in trading focus you sleep at most ${max / 3600} h)` }
+    : { durationS: requested, note: "" };
+}
