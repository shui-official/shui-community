+const later = (min: number) => new Date(t0.getTime() + min * 60_000);
+
+describe("buy size within the limits", () => {
+  it("clamps to 20% of capital and drops sizes under $5", () => {
+    expect(clampBuyUsd(25.3, 57.76)).toBe(11.55);
+    expect(clampBuyUsd(8, 57.76)).toBe(8);
+    expect(clampBuyUsd(null, 57.76)).toBe(11.55);
+    expect(clampBuyUsd(25, 20)).toBeNull(); // 20% of $20 = $4 < $5
+    expect(clampBuyUsd(10, null)).toBeNull();
+  });
+});
+
+describe("SHUI must decide before sleeping", () => {
+  it("refuses sleep twice while a setup has no decision, then lets it sleep", () => {
+    const db = freshDb();
+    recordPendingSetups(db, [setup("ORCA", ORCA), setup("RAY", RAY)], t0);
+    const first = sleepGuard(db, 14400, true, later(5));
+    expect("blocked" in first && first.blocked).toMatch(/2 valid setup\(s\).*\n- ORCA: BUY → jupiter_swap .*amountUsd=11.55, then protect_position mint=orcaE.* stopPriceUsd=2.7600 takeProfitPriceUsd=3.4700.*SKIP → journal_add kind=note mint=orcaE/s);
+    expect("blocked" in sleepGuard(db, 14400, true, later(6))).toBe(true);
+    expect(sleepGuard(db, 14400, true, later(7))).toMatchObject({ durationS: 7200 });
+  });
+
+  it("counts a journal entry or a buy of the mint as a decision", () => {
+    const db = freshDb();
+    ensureLedgerSchema(db);
+    recordPendingSetups(db, [setup("ORCA", ORCA), setup("RAY", RAY)], t0);
+    addJournalEntry(db, { kind: "note", mint: RAY, text: "skip: stop too wide" }, later(3));
+    expect(undecidedSetups(db, later(4))!.setups.map((s) => s.symbol)).toEqual(["ORCA"]);
+    db.prepare(
+      `INSERT INTO shui_ledger (signature, ts, day, kind, input_mint, input_amount_raw, output_mint, output_amount_raw, revenue_usd, realized_pnl_usd, incomplete, details)
+       VALUES ('sig1', ?, '2026-10-08', 'swap', 'EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v', '11550000', ?, '4000000', 0, 0, 0, '{}')`,
+    ).run(later(4).toISOString(), ORCA);
+    expect(undecidedSetups(db, later(5))).toBeNull();
+    expect(sleepGuard(db, 3600, true, later(5))).toMatchObject({ durationS: 3600 });
+  });
+
+  it("ignores a journal entry written before the scan and forgets scans older than 6 h", () => {
+    const db = freshDb();
+    addJournalEntry(db, { kind: "note", mint: ORCA, text: "old note" }, new Date(t0.getTime() - 60_000));
+    recordPendingSetups(db, [setup("ORCA", ORCA)], t0);
+    expect(undecidedSetups(db, later(1))).not.toBeNull();
+    expect(undecidedSetups(db, later(7 * 60))).toBeNull();
+  });
+
+  it("caps sleep at 1 h with an open position, and does nothing outside trading focus", () => {
+    const db = freshDb();
+    ensureLedgerSchema(db);
+    expect(sleepGuard(db, 14400, true, t0)).toMatchObject({ durationS: 7200 });
+    db.prepare("INSERT INTO shui_cost_basis (mint, amount_raw, cost_usd) VALUES (?, '4000000', 11.5)").run(ORCA);
+    expect(sleepGuard(db, 14400, true, t0)).toMatchObject({ durationS: 3600 });
+    recordPendingSetups(db, [setup("RAY", RAY)], t0);
+    expect(sleepGuard(db, 14400, false, later(1))).toMatchObject({ durationS: 14400 });
+  });
+
+  it("tells SHUI in its prompt", () => {
+    expect(tradingFocusPrompt({})).toMatch(/Sleep is refused until you decide/);
+    expect(tradingFocusPrompt({})).toMatch(/capped by code at 2 h/);
+  });
+});
