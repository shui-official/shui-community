+describe("forgetting what is no longer true", () => {
+  it("forgets unpaid payment links older than 3 days, keeps paid and recent ones", async () => {
+    const { db, paths } = setup();
+    const ins = db.raw.prepare("INSERT INTO semantic_memory (id, category, key, value, source, updated_at) VALUES (?, 'financial', ?, ?, 's', ?)");
+    ins.run("1", "payment_request_5usdc_pending", "Created payment request for $5 (pending)", "2020-01-01 00:00:00");
+    ins.run("2", "payment_request_sale", "Payment request was paid: 3 USDC", "2020-01-01 00:00:00");
+    ins.run("3", "payment_request_new", "Created payment request for $1", new Date().toISOString().replace("T", " ").slice(0, 19));
+    ins.run("4", "initial_balance_usdc", "24.37", "2020-01-01 00:00:00");
+    const report = await runJanitor({ db: db.raw, paths, helper: noServices, untracked: async () => [] });
+    expect(report.forgottenPaymentFacts).toBe(1);
+    expect((db.raw.prepare("SELECT key FROM semantic_memory ORDER BY key").all() as any[]).map((r) => r.key))
+      .toEqual(["initial_balance_usdc", "payment_request_new", "payment_request_sale"]);
+  });
+
+  it("forgets a tool's recorded failures once the tool works again", async () => {
+    const { MemoryIngestionPipeline } = await import("../memory/ingestion.js");
+    const { db } = setup();
+    db.raw.prepare("INSERT INTO semantic_memory (id, category, key, value, source) VALUES ('e', 'environment', 'tool_error:raydium_swap:BUILD_FAILED', 'raydium_swap fails', 's')").run();
+    db.raw.prepare("INSERT INTO semantic_memory (id, category, key, value, source) VALUES ('f', 'environment', 'tool_error:jupiter_swap:RATE_LIMIT', 'jupiter fails', 's')").run();
+    const turn = { id: "t", timestamp: new Date().toISOString(), state: "running", thinking: "", tokenUsage: { promptTokens: 0, completionTokens: 0, totalTokens: 0 }, costCents: 0,
+      toolCalls: [{ id: "c", name: "raydium_swap", arguments: {}, result: '{"dryRun":true,"wouldSucceed":true}', durationMs: 1 }] } as any;
+    new MemoryIngestionPipeline(db.raw).ingest("s", turn, turn.toolCalls);
+    expect((db.raw.prepare("SELECT key FROM semantic_memory WHERE key LIKE 'tool_error:%'").all() as any[]).map((r) => r.key))
+      .toEqual(["tool_error:jupiter_swap:RATE_LIMIT"]);
+  });
+});
