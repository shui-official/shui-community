+/**
+ * Lot 9a: refuses a protection when a swap is still unconfirmed, when the token
+ * is already protected (a second OCO sold nothing and failed), or when the
+ * wallet holds none of it on-chain.
+ */
+export async function protectionGuard(
+  ctx: { db: AutomatonDatabase; identity?: { chainIdentity?: ChainIdentity } },
+  mint: string,
+  balanceOf?: (mint: string) => Promise<bigint>,
+): Promise<string | null> {
+  if (readPendingTransaction(ctx.db)) {
+    return "Blocked: a swap is still unconfirmed. Check positions first: never protect a buy before it is confirmed on-chain.";
+  }
+  const existing = listOrders(ctx.db.raw).find((o) => o.status === "open" && !o.paper && o.watchMint === mint &&
+    (o.kind === "stop_loss" || o.kind === "trailing_stop"));
+  if (existing) {
+    return `Blocked: this token is already protected (${existing.id}, ${existing.kind} at $${existing.triggerPriceUsd}). ` +
+      "To change it, order_cancel both orders of that group first.";
+  }
+  const chain = ctx.identity?.chainIdentity;
+  const read = balanceOf ?? (chain
+    ? async (m: string) => (await new SolanaTradingService(chain).getTokenBalances())
+      .filter((t) => t.mint === m).reduce((sum, t) => sum + BigInt(t.amount), 0n)
+    : null);
+  if (!read || mint === NATIVE_SOL_MINT) return null;
+  let held: bigint;
+  try {
+    held = await read(mint);
+  } catch {
+    return null; // RPC trouble must not block a protection
+  }
+  return held > 0n ? null : "Blocked: you hold 0 of this token on-chain, so there is nothing to protect. If you just bought it, the buy did not land: read positions.";
+}
