+/** Lot 9a: errors that mean the model could not be reached (not a bad answer). */
+export function isInferenceOutage(err: unknown): boolean {
+  const msg = String((err as { message?: string })?.message ?? err ?? "");
+  return /fetch failed|Circuit breaker is open|Inference error|\b50[0234]\b|ECONN|ETIMEDOUT|UND_ERR|socket hang up|timed? ?out|aborted/i.test(msg);
