new file mode 100644
index 0000000..8416e57
--- /dev/null
+++ b/src/memory/stale.ts
@@ -0,0 +1,72 @@
+/**
+ * Lot 9a — false or outdated beliefs that SHUI kept re-reading and copying
+ * (audit of 2026-10-09): "after 2 losing trades I must stop" while buys were
+ * allowed, "529,000 SOL", the creator token seen as a position, and one
+ * sentence repeated in 251 thoughts. They are quarantined once (kept in
+ * memory_quarantine, so nothing is lost) and filtered out of everything that
+ * goes back into the model's context.
+ */
+import type { Database } from "better-sqlite3";
+
+export const STALE_PATTERNS: RegExp[] = [
+  /after \d+ losing trades?[^.]*\b(must stop|stop trading|blocked|not tradable)/i,
+  /\bI must stop trading today\b/i,
+  /not tradable today due to consecutive losses/i,
+  /\b529,?000 SOL\b/i,
+  /position in CnrMgN|CnrMgN[1-9A-HJ-NP-Za-km-z]* position/i,
+  /I need to actually execute a trading task rather than just creating files/i,
+];
+
+export function isStale(text: string | null | undefined): boolean {
+  return !!text && STALE_PATTERNS.some((re) => re.test(text));
+}
+
+/** Removes the sentences that carry a stale belief; keeps the rest. */
+export function scrubStale(text: string): string {
+  if (!isStale(text)) return text;
+  const kept = text
+    .split(/(?<=[.!?])\s+|\n+/)
+    .filter((sentence) => sentence.trim() && !isStale(sentence));
+  return kept.join(" ").trim();
+}
+
+const SOURCES: Array<{ table: string; text: string }> = [
+  { table: "working_memory", text: "content" },
+  { table: "episodic_memory", text: "summary || ' ' || COALESCE(detail, '')" },
+  { table: "semantic_memory", text: "value" },
+  { table: "knowledge_store", text: "content" },
+];
+
+const tableExists = (db: Database, name: string): boolean =>
+  !!db.prepare("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?").get(name);
+
+/** Once: move stale memories and journal notes to memory_quarantine. Returns how many were moved. */
+export function quarantineStaleMemoriesOnce(db: Database, now: Date = new Date()): number {
+  if (db.prepare("SELECT 1 FROM kv WHERE key = 'migration.lot9_memory'").get()) return 0;
+  db.exec(`CREATE TABLE IF NOT EXISTS memory_quarantine (
+    source TEXT NOT NULL, source_id TEXT NOT NULL, content TEXT NOT NULL, quarantined_at TEXT NOT NULL,
+    PRIMARY KEY (source, source_id))`);
+  const save = db.prepare("INSERT OR REPLACE INTO memory_quarantine (source, source_id, content, quarantined_at) VALUES (?, ?, ?, ?)");
+  let moved = 0;
+  const run = db.transaction(() => {
+    for (const { table, text } of SOURCES) {
+      if (!tableExists(db, table)) continue;
+      const rows = db.prepare(`SELECT id, ${text} AS t FROM ${table}`).all() as Array<{ id: string; t: string }>;
+      for (const row of rows.filter((r) => isStale(r.t))) {
+        save.run(table, row.id, row.t, now.toISOString());
+        db.prepare(`DELETE FROM ${table} WHERE id = ?`).run(row.id);
+        moved++;
+      }
+    }
+    const notes = db.prepare("SELECT key, value FROM kv WHERE key LIKE 'journal.%'").all() as Array<{ key: string; value: string }>;
+    for (const note of notes.filter((n) => isStale(n.value))) {
+      save.run("journal", note.key, note.value, now.toISOString());
+      db.prepare("DELETE FROM kv WHERE key = ?").run(note.key);
+      moved++;
+    }
+    db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES ('migration.lot9_memory', ?, datetime('now'))")
+      .run(JSON.stringify({ at: now.toISOString(), moved }));
+  });
+  run();
+  return moved;
+}
