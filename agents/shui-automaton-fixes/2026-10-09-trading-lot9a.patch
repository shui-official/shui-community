+export function alertModelOutage(db: DatabaseType, err: unknown, now: Date = new Date()): boolean {
+  if (db.prepare("SELECT 1 FROM kv WHERE key = ?").get(MODEL_OUTAGE_KEY)) return false;
+  db.prepare("INSERT OR REPLACE INTO kv (key, value, updated_at) VALUES (?, ?, datetime('now'))").run(MODEL_OUTAGE_KEY, now.toISOString());
+  const why = String((err as { message?: string })?.message ?? err).slice(0, 160);
+  saveOutgoingCreatorMessage(db,
+    `My model (Runpod endpoint) failed ${MODEL_ALERT_AFTER_FAILURES} turns in a row (${why}). I cannot think or decide until it answers; ` +
+    "my stops and take-profits keep running in code. Please check the endpoint workers (stuck in initializing? terminate the worker).", now);
+  return true;
+}
+
+export function clearModelOutage(db: DatabaseType, now: Date = new Date()): void {
+  const row = db.prepare("SELECT value FROM kv WHERE key = ?").get(MODEL_OUTAGE_KEY) as { value: string } | undefined;
+  if (!row) return;
+  db.prepare("DELETE FROM kv WHERE key = ?").run(MODEL_OUTAGE_KEY);
+  saveOutgoingCreatorMessage(db, `My model answers again (outage since ${row.value.slice(11, 16)} UTC).`, now);
+}
