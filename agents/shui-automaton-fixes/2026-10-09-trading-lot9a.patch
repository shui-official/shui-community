+export function releaseClaimWithoutRetry(db: DatabaseType, ids: string[]): void {
+  if (!ids.length) return;
+  const placeholders = ids.map(() => "?").join(",");
+  db.prepare(
+    `UPDATE inbox_messages SET status = 'received', retry_count = MAX(COALESCE(retry_count, 1) - 1, 0) WHERE id IN (${placeholders})`,
+  ).run(...ids);
